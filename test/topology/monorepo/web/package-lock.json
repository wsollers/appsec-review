{
  "name": "topology-web",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "topology-web",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@topology/api": {
      "resolved": "packages/api",
      "link": true
    },
    "node_modules/@topology/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/api": {
      "name": "@topology/api",
      "version": "0.1.0",
      "dependencies": {
        "@topology/ui": "0.1.0"
      }
    },
    "packages/ui": {
      "name": "@topology/ui",
      "version": "0.1.0"
    }
  }
}
