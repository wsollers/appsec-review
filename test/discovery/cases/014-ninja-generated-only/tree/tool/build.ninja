# This file is generated by meson; do not edit
ninja_required_version = 1.8
rule c_COMPILER
  command = cc $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
  deps = gcc
  depfile = $DEPFILE
rule c_LINKER
  command = cc $ARGS -o $out $in $LINK_ARGS
build tool.p/main.c.o: c_COMPILER ../main.c
  DEPFILE = tool.p/main.c.o.d
build tool: c_LINKER tool.p/main.c.o
