{
  "schema": "appsec-review/discovery-case/1",
  "case": "026-gradle-settings-only-kts-buildsrc",
  "matrix": "A8",
  "polarity": "mixed",
  "mirrors": "a Kotlin DSL Gradle build whose root holds only settings.gradle.kts (the projects carry the build files) and a buildSrc/ convention-plugin build: the root is the unit, cli and lib are its projects, and buildSrc is a build of the build (context), never a project or a member",
  "units": [
    {
      "root": ".",
      "build_system": "gradle",
      "family": "java",
      "profile": "java",
      "markers": [
        "settings.gradle.kts"
      ],
      "build_points": [
        {
          "name": "cli",
          "kind": "project",
          "evidence": "settings.gradle.kts:2"
        },
        {
          "name": "lib",
          "kind": "project",
          "evidence": "settings.gradle.kts:3"
        }
      ],
      "facts": {
        "drives": [
          {
            "path": "cli",
            "via": "settings_include",
            "evidence": "settings.gradle.kts:2"
          },
          {
            "path": "lib",
            "via": "settings_include",
            "evidence": "settings.gradle.kts:3"
          }
        ]
      }
    }
  ],
  "not_units": [
    {
      "root": "cli",
      "build_system": "gradle",
      "marker": "cli/build.gradle.kts",
      "role": "evidence_of:.|gradle#cli",
      "reason": "included by settings.gradle.kts; a project of the root build, dispatched through the root"
    },
    {
      "root": "lib",
      "build_system": "gradle",
      "marker": "lib/build.gradle.kts",
      "role": "evidence_of:.|gradle#lib",
      "reason": "included by settings.gradle.kts"
    },
    {
      "root": "buildSrc",
      "build_system": "gradle",
      "marker": "buildSrc/build.gradle.kts",
      "role": "context:.|gradle",
      "reason": "buildSrc is compiled by Gradle before the build is configured: it is a build of the build, read by the root unit, not a project of it and not a workspace member"
    }
  ],
  "assignment": {
    "settings.gradle.kts": "evidence_of:.|gradle",
    "gradle.properties": "context:.|gradle",
    "gradlew": "context:.|gradle",
    "gradle/wrapper/gradle-wrapper.properties": "context:.|gradle",
    "buildSrc/build.gradle.kts": "context:.|gradle",
    "buildSrc/src/main/kotlin/tools-conventions.gradle.kts": "context:.|gradle",
    "cli/build.gradle.kts": "evidence_of:.|gradle#cli",
    "cli/src/main/kotlin/tools/cli/Main.kt": "evidence_of:.|gradle#cli",
    "lib/build.gradle.kts": "evidence_of:.|gradle#lib",
    "lib/src/main/kotlin/tools/lib/Lib.kt": "evidence_of:.|gradle#lib"
  },
