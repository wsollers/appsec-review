{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/review-packages.schema.json",
  "title": "Pre-adjudication document and inference review packages, version 3",
  "oneOf": [
    {
      "$ref": "#/$defs/document_finding_lead"
    },
    {
      "$ref": "#/$defs/document_hunt"
    },
    {
      "$ref": "#/$defs/document_document_hunt"
    },
    {
      "$ref": "#/$defs/inference_finding_lead"
    },
    {
      "$ref": "#/$defs/inference_hunt"
    }
  ],
  "$defs": {
    "document_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "document_identity": {
      "type": "string",
      "pattern": "^asr:[a-z][a-z0-9_]*:[0-9a-f]{64}$"
    },
    "document_identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document_identity"
      },
      "uniqueItems": true
    },
    "document_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "producer",
        "scope",
        "state",
        "reason"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "missing",
            "skipped",
            "failed",
            "unavailable",
            "partial",
            "stale",
            "ambiguous",
            "truncated"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "document_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "relation",
        "shard_id",
        "shard_sha256",
        "resolution"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/document_identity"
        },
        "relation": {
          "enum": [
            "nominates",
            "supports",
            "contradicts",
            "qualifies"
          ]
        },
        "shard_id": {
          "type": "string",
          "minLength": 1
        },
        "shard_sha256": {
          "$ref": "#/$defs/document_sha"
        },
        "resolution": {
          "enum": [
            "source_line",
            "run_artifact",
            "unresolved"
          ]
        }
      }
    },
    "document_lead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "scanner",
        "rule_id",
        "category",
        "native_severity",
        "reported_severity",
        "severity_rule",
        "component_id",
        "suppression_status",
        "duplicate_of",
        "location_exact",
        "location"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/document_identity"
        },
        "scanner": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "native_severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "reported_severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "unknown"
          ]
        },
        "severity_rule": {
          "type": "string",
          "minLength": 1
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "suppression_status": {
          "enum": [
            "suppressed",
            "possibly_suppressed",
            "not_suppressed",
            "unknown"
          ]
        },
        "duplicate_of": {
          "oneOf": [
            {
              "$ref": "#/$defs/document_identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "location_exact": {
          "type": "boolean"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mapping_method"
          ],
          "properties": {
            "mapping_method": {
              "type": "string"
            },
            "source_path": {
              "type": "string"
            },
            "file_sha256": {
              "$ref": "#/$defs/document_sha"
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "flow_ids": {
          "$ref": "#/$defs/document_identities"
        }
      }
    },
    "document_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "trust_boundary_id",
        "build_unit_id",
        "partition_key",
        "source_ids",
        "artifact_ids"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_boundary_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_unit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "partition_key": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/document_identities"
        },
        "artifact_ids": {
          "$ref": "#/$defs/document_identities"
        }
      }
    },
    "document_retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indexes",
        "query_sets",
        "entity_ids",
        "max_page_size",
        "max_pages",
        "max_depth",
        "max_response_bytes"
      ],
      "properties": {
        "indexes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "query_sets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "entity_ids": {
          "$ref": "#/$defs/document_identities"
        },
        "max_page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        }
      }
    },
    "document_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope_id",
        "status",
        "producer",
        "algorithm_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "algorithm_version": {
          "type": "string",
          "minLength": 1
        },
        "window_days": {
          "type": "integer",
          "minimum": 0
        },
        "language": {
          "type": "string"
        },
        "source_sha256": {
          "$ref": "#/$defs/document_sha"
        },
        "gap_id": {
          "type": "string"
        }
      }
    },
    "document_build_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ids",
        "artifact_ids",
        "command_facts",
        "environment_facts",
        "bindings"
      ],
      "properties": {
        "action_ids": {
          "$ref": "#/$defs/document_identities"
        },
        "artifact_ids": {
          "$ref": "#/$defs/document_identities"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "function_scope_id",
              "source_path",
              "action_ids",
              "match"
            ],
            "properties": {
              "observation_id": {
                "$ref": "#/$defs/document_identity"
              },
              "function_scope_id": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/document_identity"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "action_ids": {
                "$ref": "#/$defs/document_identities"
              },
              "match": {
                "enum": [
                  "source_file",
                  "unresolved"
                ]
              }
            }
          }
        },
        "command_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "build_action_id",
              "tool_id",
              "ordered_tokens",
              "exact_artifact_sha256",
              "normalization_rule"
            ],
            "properties": {
              "build_action_id": {
                "type": "string"
              },
              "tool_id": {
                "type": "string"
              },
              "ordered_tokens": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ordinal",
                    "kind",
                    "redacted"
                  ],
                  "properties": {
                    "ordinal": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "kind": {
                      "type": "string"
                    },
                    "safe_value": {
                      "type": "string"
                    },
                    "redacted": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "exact_artifact_sha256": {
                "$ref": "#/$defs/document_sha"
              },
              "normalization_rule": {
                "type": "string"
              }
            }
          }
        },
        "environment_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "class",
              "present",
              "redacted"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "class": {
                "type": "string"
              },
              "present": {
                "type": "boolean"
              },
              "safe_value": {
                "type": "string"
              },
              "redacted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "document_tag_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignments",
        "cloud"
      ],
      "properties": {
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity_id",
              "tag",
              "basis",
              "family",
              "subject_id"
            ],
            "properties": {
              "entity_id": {
                "$ref": "#/$defs/document_identity"
              },
              "tag": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "subject_id": {
                "$ref": "#/$defs/document_identity"
              }
            }
          }
        },
        "cloud": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "assignment_count"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "assignment_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "document_compiled_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "kind",
          "name",
          "compile_unit_id",
          "source_path",
          "line"
        ],
        "properties": {
          "entity_id": {
            "$ref": "#/$defs/document_identity"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "compile_unit_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "document_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "package_id",
        "run_id",
        "manifest_sha256",
        "target_snapshot",
        "input_fingerprint",
        "assembly_rule",
        "scope",
        "lead_menu",
        "evidence",
        "context_ids",
        "metrics",
        "build_context",
        "tag_context",
        "compiled_context",
        "proof_obligations",
        "retrieval",
        "coverage_gaps",
        "truncation"
      ],
      "properties": {
        "schema": {
          "const": "appsec-review/review-package/3"
        },
        "kind": {
          "enum": [
            "finding_lead",
            "hunt",
            "document_hunt"
          ]
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/document_sha"
        },
        "target_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "input_fingerprint": {
          "$ref": "#/$defs/document_sha"
        },
        "assembly_rule": {
          "const": "appsec-review/assemble-review-packages/3"
        },
        "scope": {
          "$ref": "#/$defs/document_scope"
        },
        "lead_menu": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document_lead"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document_evidence"
          }
        },
        "context_ids": {
          "$ref": "#/$defs/document_identities"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document_metric"
          }
        },
        "build_context": {
          "$ref": "#/$defs/document_build_context"
        },
        "tag_context": {
          "$ref": "#/$defs/document_tag_context"
        },
        "compiled_context": {
          "$ref": "#/$defs/document_compiled_context"
        },
        "proof_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "retrieval": {
          "$ref": "#/$defs/document_retrieval"
        },
        "coverage_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document_gap"
          }
        },
        "truncation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "omitted_leads",
            "omitted_context",
            "next_partition"
          ],
          "properties": {
            "omitted_leads": {
              "type": "integer",
              "minimum": 0
            },
            "omitted_context": {
              "type": "integer",
              "minimum": 0
            },
            "next_partition": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "document_finding_lead": {
      "allOf": [
        {
          "$ref": "#/$defs/document_base"
        },
        {
          "properties": {
            "kind": {
              "const": "finding_lead"
            },
            "lead_menu": {
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      ]
    },
    "document_hunt": {
      "allOf": [
        {
          "$ref": "#/$defs/document_base"
        },
        {
          "properties": {
            "kind": {
              "const": "hunt"
            }
          }
        }
      ]
    },
    "document_document_hunt": {
      "allOf": [
        {
          "$ref": "#/$defs/document_base"
        },
        {
          "properties": {
            "kind": {
              "const": "document_hunt"
            },
            "lead_menu": {
              "maxItems": 0
            },
            "evidence": {
              "minItems": 1
            },
            "context_ids": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "inference_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inference_identity": {
      "type": "string",
      "pattern": "^asr:[a-z][a-z0-9_]*:[0-9a-f]{64}$"
    },
    "inference_identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inference_identity"
      },
      "uniqueItems": true
    },
    "inference_lead_family": {
      "enum": [
        "source_sast",
        "codeql",
        "artifact_scanner",
        "dependency_advisory",
        "ci_rule",
        "post_build_hardening",
        "owasp_control"
      ]
    },
    "inference_severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "unknown"
      ]
    },
    "inference_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "producer",
        "scope",
        "state",
        "reason"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "pattern": "^gap-[0-9a-f]{64}$"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "missing",
            "skipped",
            "failed",
            "unavailable",
            "partial",
            "stale",
            "ambiguous",
            "truncated"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "inference_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "relation",
        "shard_id",
        "shard_sha256",
        "resolution"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/inference_identity"
        },
        "relation": {
          "enum": [
            "nominates",
            "supports",
            "contradicts",
            "qualifies"
          ]
        },
        "shard_id": {
          "type": "string",
          "minLength": 1
        },
        "shard_sha256": {
          "$ref": "#/$defs/inference_sha"
        },
        "resolution": {
          "enum": [
            "source_line",
            "run_artifact",
            "unresolved"
          ]
        }
      }
    },
    "inference_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/inference_identity"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "role": {
          "enum": [
            "source",
            "artifact",
            "component",
            "build_unit",
            "duplicate_of",
            "flow",
            "priority",
            "history",
            "hotspot",
            "tag"
          ]
        }
      }
    },
    "inference_nullable_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "inference_probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "inference_cve_id": {
      "type": "string",
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
    },
    "inference_weakness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwe_id",
        "name",
        "abstraction",
        "source",
        "origin"
      ],
      "properties": {
        "cwe_id": {
          "type": "string",
          "pattern": "^CWE-[0-9]{1,5}$"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "abstraction": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "source": {
          "enum": [
            "mitre_catalog",
            "reference_intelligence",
            "unresolved"
          ]
        },
        "origin": {
          "enum": [
            "rule",
            "nvd"
          ]
        }
      }
    },
    "inference_cvss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "version",
        "vector",
        "base_score",
        "base_severity"
      ],
      "properties": {
        "family": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        },
        "vector": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "base_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "base_severity": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        }
      }
    },
    "inference_feed_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "snapshot_id",
        "stale"
      ],
      "properties": {
        "status": {
          "type": "string",
          "maxLength": 32
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "stale": {
          "type": "boolean"
        }
      }
    },
    "inference_advisory_summary": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cve_ids",
            "kev_listed",
            "epss_percentile",
