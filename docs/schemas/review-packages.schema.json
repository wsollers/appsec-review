    "inference_advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "advisory_id",
        "package",
        "version",
        "cve_ids",
        "osv",
        "nvd",
        "kev",
        "epss",
        "joins",
        "feeds",
        "gaps"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/inference_identity"
        },
        "advisory_id": {
