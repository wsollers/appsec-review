{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/review-packages.schema.json",
  "title": "Pre-adjudication review package contract, version 3",
  "oneOf": [
    { "$ref": "#/$defs/finding_lead" },
    { "$ref": "#/$defs/hunt" }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": { "type": "string", "pattern": "^asr:[a-z][a-z0-9_]*:[0-9a-f]{64}$" },
    "identities": { "type": "array", "items": { "$ref": "#/$defs/identity" }, "uniqueItems": true },
    "lead_family": {
      "enum": ["source_sast", "codeql", "artifact_scanner", "dependency_advisory", "ci_rule", "post_build_hardening", "owasp_control"]
    },
    "severity": { "enum": ["critical", "high", "medium", "low", "info", "unknown"] },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "producer", "scope", "state", "reason"],
      "properties": {
        "gap_id": { "type": "string", "pattern": "^gap-[0-9a-f]{64}$" },
        "producer": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "state": { "enum": ["missing", "skipped", "failed", "unavailable", "partial", "stale", "ambiguous", "truncated"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "relation", "shard_id", "shard_sha256", "resolution"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/identity" },
        "relation": { "enum": ["nominates", "supports", "contradicts", "qualifies"] },
        "shard_id": { "type": "string", "minLength": 1 },
        "shard_sha256": { "$ref": "#/$defs/sha" },
        "resolution": { "enum": ["source_line", "run_artifact", "unresolved"] }
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "role": { "enum": ["source", "artifact", "component", "build_unit", "duplicate_of", "flow", "priority", "history", "hotspot", "tag"] }
      }
    },
    "nullable_text": { "type": ["string", "null"], "maxLength": 512 },
    "probability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "cve_id": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
    "weakness": {
      "type": "object", "additionalProperties": false,
      "required": ["cwe_id", "name", "abstraction", "source", "origin"],
      "properties": {
        "cwe_id": { "type": "string", "pattern": "^CWE-[0-9]{1,5}$" },
        "name": { "type": ["string", "null"], "maxLength": 256 },
        "abstraction": { "type": ["string", "null"], "maxLength": 64 },
        "source": { "enum": ["mitre_catalog", "reference_intelligence", "unresolved"] },
        "origin": { "enum": ["rule", "nvd"] }
      }
    },
    "cvss": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "version", "vector", "base_score", "base_severity"],
      "properties": {
        "family": { "type": ["string", "null"], "maxLength": 64 },
        "version": { "type": ["string", "null"], "maxLength": 16 },
        "vector": { "type": ["string", "null"], "maxLength": 256 },
        "base_score": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "base_severity": { "type": ["string", "null"], "maxLength": 32 }
      }
    },
    "feed_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "snapshot_id", "stale"],
      "properties": {
        "status": { "type": "string", "maxLength": 32 },
        "snapshot_id": { "type": ["string", "null"], "maxLength": 80 },
        "stale": { "type": "boolean" }
      }
    },
    "advisory_summary": {
      "oneOf": [{ "type": "null" }, {
        "type": "object", "additionalProperties": false,
        "required": ["cve_ids", "kev_listed", "epss_percentile", "max_cvss"],
        "properties": {
          "cve_ids": { "type": "array", "items": { "$ref": "#/$defs/cve_id" }, "maxItems": 4, "uniqueItems": true },
          "kev_listed": { "type": ["boolean", "null"] },
          "epss_percentile": { "$ref": "#/$defs/probability" },
          "max_cvss": { "type": ["number", "null"], "minimum": 0, "maximum": 10 }
        }
      }]
    },
    "advisory": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "advisory_id", "package", "version", "cve_ids", "osv", "nvd", "kev", "epss", "joins", "feeds", "gaps"],
      "properties": {
        "fact_id": { "$ref": "#/$defs/identity" },
        "advisory_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "package": { "type": ["string", "null"], "maxLength": 256 },
        "version": { "type": ["string", "null"], "maxLength": 128 },
        "cve_ids": { "type": "array", "items": { "$ref": "#/$defs/cve_id" }, "maxItems": 4, "uniqueItems": true },
        "osv": {
          "oneOf": [{ "type": "null" }, {
            "type": "object", "additionalProperties": false,
            "required": ["known", "summary", "withdrawn", "fixed_versions", "aliases"],
            "properties": {
              "known": { "type": "boolean" },
              "summary": { "$ref": "#/$defs/nullable_text" },
              "withdrawn": { "type": ["string", "null"], "maxLength": 64 },
              "fixed_versions": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 5 },
              "aliases": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 10 }
            }
          }]
        },
        "nvd": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["cve_id", "status", "published", "last_modified", "description", "cwes", "cvss"],
            "properties": {
              "cve_id": { "$ref": "#/$defs/cve_id" },
              "status": { "type": ["string", "null"], "maxLength": 64 },
              "published": { "type": ["string", "null"], "maxLength": 64 },
              "last_modified": { "type": ["string", "null"], "maxLength": 64 },
              "description": { "$ref": "#/$defs/nullable_text" },
              "cwes": { "type": "array", "items": { "type": "string", "maxLength": 16 }, "maxItems": 8 },
              "cvss": { "type": "array", "items": { "$ref": "#/$defs/cvss" }, "maxItems": 6 }
            }
          }
        },
        "kev": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["cve_id", "listed", "date_added", "due_date", "known_ransomware_use", "vulnerability_name"],
            "properties": {
              "cve_id": { "$ref": "#/$defs/cve_id" },
              "listed": { "type": "boolean" },
              "date_added": { "type": ["string", "null"], "maxLength": 32 },
              "due_date": { "type": ["string", "null"], "maxLength": 32 },
              "known_ransomware_use": { "type": ["string", "null"], "maxLength": 32 },
              "vulnerability_name": { "type": ["string", "null"], "maxLength": 256 }
            }
          }
        },
        "epss": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["cve_id", "epss", "percentile", "score_date"],
            "properties": {
              "cve_id": { "$ref": "#/$defs/cve_id" },
              "epss": { "$ref": "#/$defs/probability" },
              "percentile": { "$ref": "#/$defs/probability" },
              "score_date": { "type": ["string", "null"], "maxLength": 32 }
            }
          }
        },
        "joins": {
          "type": "object", "additionalProperties": false, "required": ["nvd", "kev", "epss"],
          "properties": {
            "nvd": { "enum": ["joined", "stale", "unavailable", "no_cve_identity"] },
            "kev": { "enum": ["joined", "stale", "unavailable", "no_cve_identity"] },
            "epss": { "enum": ["joined", "stale", "unavailable", "no_cve_identity"] }
          }
        },
        "feeds": {
          "type": "object", "additionalProperties": false, "required": ["osv", "nvd", "kev", "epss"],
          "properties": {
            "osv": { "$ref": "#/$defs/feed_reference" },
            "nvd": { "$ref": "#/$defs/feed_reference" },
            "kev": { "$ref": "#/$defs/feed_reference" },
            "epss": { "$ref": "#/$defs/feed_reference" }
          }
        },
        "gaps": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 12 }
      }
    },
    "advisory_context": {
      "oneOf": [{ "type": "null" }, {
        "type": "object", "additionalProperties": false,
        "required": ["rule", "advisories", "omitted_advisories", "summary", "statement"],
        "properties": {
          "rule": { "const": "appsec-review/advisory-context/1" },
          "advisories": { "type": "array", "items": { "$ref": "#/$defs/advisory" }, "minItems": 1, "maxItems": 3 },
          "omitted_advisories": { "type": "integer", "minimum": 0 },
          "summary": {
            "type": "object", "additionalProperties": false,
            "required": ["cve_ids", "kev_listed", "epss_percentile", "max_cvss", "preferred_cvss"],
            "properties": {
              "cve_ids": { "type": "array", "items": { "$ref": "#/$defs/cve_id" }, "maxItems": 4, "uniqueItems": true },
              "kev_listed": { "type": ["boolean", "null"] },
              "epss_percentile": { "$ref": "#/$defs/probability" },
              "max_cvss": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
              "preferred_cvss": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cvss" }] }
            }
          },
          "statement": { "type": "string", "maxLength": 200 }
        }
      }]
    },
    "lead": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "lead_family", "scanner", "rule_id", "message", "rule_cwe", "native_severity", "reported_severity", "severity_rule", "severity_basis", "component_id", "build_unit_id", "suppression_status", "duplicate_of", "location_exact", "flow_ids", "weaknesses", "advisory_summary"],
      "properties": {
        "weaknesses": { "type": "array", "items": { "$ref": "#/$defs/weakness" }, "maxItems": 8 },
        "advisory_summary": { "$ref": "#/$defs/advisory_summary" },
        "advisory_context": { "$ref": "#/$defs/advisory_context" },
        "admission_reasons": {
          "type": "array", "items": { "enum": ["reported_severity", "kev_listed"] }, "minItems": 1, "maxItems": 2, "uniqueItems": true
        },
        "observation_id": { "$ref": "#/$defs/identity" },
        "lead_family": { "$ref": "#/$defs/lead_family" },
        "scanner": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "message": { "type": ["string", "null"], "maxLength": 1024 },
        "rule_cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-[0-9]{1,5}$" }, "uniqueItems": true },
        "native_severity": { "type": ["string", "null"], "maxLength": 128 },
        "reported_severity": { "$ref": "#/$defs/severity" },
        "severity_rule": { "type": "string", "pattern": "^appsec-review/lead-family/[a-z_]+/[0-9]+$" },
        "severity_basis": { "type": "string", "minLength": 1 },
        "component_id": { "type": "string", "minLength": 1 },
        "build_unit_id": { "type": ["string", "null"], "minLength": 1 },
        "suppression_status": { "enum": ["suppressed", "possibly_suppressed", "not_suppressed", "unknown"] },
        "duplicate_of": { "oneOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "location_exact": { "type": "boolean" },
        "flow_ids": { "$ref": "#/$defs/identities" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "trust_boundary_id", "build_unit_id", "partition_key", "source_ids", "artifact_ids"],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "trust_boundary_id": { "type": ["string", "null"] },
        "build_unit_id": { "type": ["string", "null"] },
        "partition_key": { "type": "string", "minLength": 1 },
        "source_ids": { "$ref": "#/$defs/identities" },
        "artifact_ids": { "$ref": "#/$defs/identities" }
      }
    },
    "rank": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "unit_count", "score", "rule", "basis"],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "unit_count": { "type": "integer", "minimum": 1 },
        "score": { "type": "integer", "minimum": 0 },
        "rule": { "const": "appsec-review/review-unit-rank/2" },
        "basis": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["signal", "value", "state", "reason"],
            "properties": {
              "signal": { "enum": ["lps", "sii", "hotspot", "tag_density", "lead_hints", "advisory_kev", "advisory_epss"] },
              "value": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000 },
              "state": { "enum": ["available", "unknown"] },
              "reason": { "enum": [null, "producer_unavailable", "no_record", "feed_unavailable"] }
            }
          }
        }
      }
    },
    "retrieval": {
      "type": "object", "additionalProperties": false,
      "required": ["indexes", "query_sets", "entity_ids", "max_page_size", "max_pages", "max_depth"],
      "properties": {
        "indexes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "query_sets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "entity_ids": { "$ref": "#/$defs/identities" },
        "max_page_size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_pages": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_depth": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "lane", "lead_family", "package_id", "run_id", "manifest_sha256", "target_snapshot", "input_fingerprint", "assembly_rule", "scope", "partition", "rank", "persona", "stack_profile", "lead_menu", "evidence", "context", "proof_obligations", "retrieval", "coverage_gaps", "truncation"],
      "properties": {
        "schema": { "const": "appsec-review/review-package/3" },
        "kind": { "enum": ["finding_lead", "hunt"] },
        "lane": { "enum": ["lead", "hunt"] },
        "lead_family": { "oneOf": [{ "$ref": "#/$defs/lead_family" }, { "type": "null" }] },
        "package_id": { "type": "string", "pattern": "^(finding_lead|hunt)-[0-9a-f]{64}$" },
        "run_id": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "$ref": "#/$defs/sha" },
        "target_snapshot": { "type": "string", "minLength": 1 },
        "input_fingerprint": { "$ref": "#/$defs/sha" },
        "assembly_rule": { "const": "appsec-review/assemble-review-packages/3" },
        "scope": { "$ref": "#/$defs/scope" },
        "partition": {
          "type": "object", "additionalProperties": false,
          "required": ["number", "count"],
          "properties": {
            "number": { "type": "integer", "minimum": 0 },
            "count": { "type": "integer", "minimum": 1 }
          }
        },
        "rank": { "oneOf": [{ "$ref": "#/$defs/rank" }, { "type": "null" }] },
        "persona": { "type": ["string", "null"], "minLength": 1 },
        "stack_profile": { "type": ["string", "null"], "minLength": 1 },
        "lead_menu": { "type": "array", "items": { "$ref": "#/$defs/lead" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "context": { "type": "array", "items": { "$ref": "#/$defs/context" } },
        "proof_obligations": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["affected_construct", "attacker_input_control", "source_to_sink_reachability", "missing_or_ineffective_guard", "configuration_enables", "security_impact"] }
        },
        "retrieval": { "$ref": "#/$defs/retrieval" },
        "coverage_gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
        "truncation": {
          "type": "object", "additionalProperties": false,
          "required": ["omitted_leads", "omitted_context", "next_partition"],
          "properties": {
            "omitted_leads": { "type": "integer", "minimum": 0 },
            "omitted_context": { "type": "integer", "minimum": 0 },
            "next_partition": { "type": ["string", "null"] }
          }
        }
      }
    },
    "finding_lead": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "properties": {
          "kind": { "const": "finding_lead" },
          "lane": { "const": "lead" },
          "lead_family": { "$ref": "#/$defs/lead_family" },
          "rank": { "type": "null" },
          "partition": { "properties": { "number": { "const": 0 }, "count": { "const": 1 } } },
          "lead_menu": { "minItems": 1, "maxItems": 1, "items": { "required": ["admission_reasons", "advisory_context"] } },
          "truncation": { "properties": { "omitted_leads": { "const": 0 }, "next_partition": { "type": "null" } } }
        }
      }]
    },
    "hunt": {
      "allOf": [{ "$ref": "#/$defs/base" }, {
        "properties": {
          "kind": { "const": "hunt" },
          "lane": { "const": "hunt" },
          "lead_family": { "type": "null" },
          "rank": { "$ref": "#/$defs/rank" },
          "lead_menu": { "items": { "not": { "anyOf": [{ "required": ["advisory_context"] }, { "required": ["admission_reasons"] }] } } }
        }
      }]
    }
  }
}
