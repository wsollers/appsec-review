{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["schema", "files"],
  "properties": {
    "schema": {"const": "appsec-review/remediation-exact-patch/1"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "before_sha256", "absence_proof", "edits"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240},
          "before_sha256": {"oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
          "absence_proof": {"type": "boolean"},
          "edits": {
            "type": "array", "minItems": 1, "maxItems": 256,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["start", "end", "old", "new"],
              "properties": {"start": {"type": "integer", "minimum": 0},
                             "end": {"type": "integer", "minimum": 0},
                             "old": {"type": "string"}, "new": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
