{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "appsec-review/build-selection-policy/1",
  "title": "Build intent, never observed native proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "ambiguity_policy", "rules"],
  "properties": {
    "schema": {"const": "appsec-review/build-selection-policy/1"},
    "policy_id": {"type": "string", "minLength": 1},
    "ambiguity_policy": {"const": "block"},
    "allowed_32bit_isas": {
      "description": "32-bit ISAs exempt from the 32-bit ban; omitted means [\"wasm32\"].",
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["x86", "armv7", "wasm32"]}
    },
    "rules": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["selectors", "axes", "provenance"],
        "properties": {
          "selectors": {
            "type": "object", "additionalProperties": false, "minProperties": 1,
            "properties": {
              "build_unit_id": {"type": "string", "minLength": 1},
              "build_system": {"type": "string", "minLength": 1},
              "declared_platform": {"type": "string", "minLength": 1},
              "root": {"type": "string", "minLength": 1}
            }
          },
          "axes": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "os": {"type": "string", "minLength": 1},
              "isa": {"type": "string", "minLength": 1},
              "abi": {"type": "string", "minLength": 1},
              "sdk": {"type": "string", "minLength": 1},
              "deployment": {"type": "string", "minLength": 1},
              "device_kind": {"type": "string", "minLength": 1},
              "hardware_generation": {"type": "string", "minLength": 1}
            }
          },
          "provenance": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "axes": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "isa", "abi", "sdk", "deployment", "device_kind", "hardware_generation"],
      "properties": {
        "os": {"type": ["string", "null"], "minLength": 1},
        "isa": {"type": ["string", "null"], "minLength": 1},
        "abi": {"type": ["string", "null"], "minLength": 1},
        "sdk": {"type": ["string", "null"], "minLength": 1},
        "deployment": {"type": ["string", "null"], "minLength": 1},
        "device_kind": {"type": ["string", "null"], "minLength": 1},
        "hardware_generation": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
