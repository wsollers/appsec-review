{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/sei-cert-multivuln-expectations.schema.json",
  "title": "SEI CERT rule-pack expectations on the pinned multivuln corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "scope",
    "expected_findings",
    "expected_exclusions",
    "known_false_negatives"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/sei-cert-multivuln-expectations/1"
    },
    "target": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "local_path"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "extensions"
      ]
    },
    "expected_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "path",
          "line",
          "cert"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "cert": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "rule_id": {
            "type": "string",
            "pattern": "^appsec-review\\.sei-cert\\.(c|cpp|java)\\.[a-z]{3}[0-9]{2}-(c|cpp|j)\\.[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    },
    "expected_exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "line",
          "cert"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "cert": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "known_false_negatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "line",
          "cert",
          "delegated_to"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "cert": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "delegated_to": {
            "enum": [
              "SUPPORTED",
              "PARTIAL",
              "UNSUPPORTED_SEMANTIC",
              "UNSUPPORTED_LANGUAGE",
              "DUPLICATE_EXISTING_RULE",
              "REQUIRES_DATAFLOW",
              "REQUIRES_COMPILER_OR_IR",
              "REQUIRES_CODEQL",
              "REQUIRES_MANUAL_REVIEW"
            ]
          }
        }
      }
    }
  }
}
