{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/inference-security-review/compact-investigation.schema.json",
  "title": "Bounded investigation details carried by compact review answers",
  "$defs": {
    "local_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "specialist": {
      "enum": [
        "authentication_session", "authorization_access_control", "cryptography_data_protection",
        "mobile_platform", "build_supply_chain", "memory_safety_native", "injection_interpreters",
        "parsing_deserialization", "network_api_surface", "filesystem_resources", "business_logic_abuse",
        "ci_cd_pipeline", "cloud_container_deployment", "generalist"
      ]
    },
    "requested_kind": {
      "oneOf": [
        {"enum": ["source_line", "compiled_view", "dataflow", "configuration", "build_provenance",
                  "deployment", "run_artifact", "other"]},
        {"$ref": "common.schema.json#/$defs/entity_kind"}
      ]
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["predicate", "requested_kind", "anchors", "question"],
      "properties": {
        "predicate": {"$ref": "common.schema.json#/$defs/predicate"},
        "requested_kind": {"$ref": "#/$defs/requested_kind"},
        "anchors": {"$ref": "common.schema.json#/$defs/labels"},
        "question": {"$ref": "common.schema.json#/$defs/compact_why"},
        "specialist": {"$ref": "#/$defs/specialist"}
      }
    },
    "requests": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/request"}},
    "obligations": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["predicate", "question", "cites"],
        "properties": {
          "predicate": {"$ref": "common.schema.json#/$defs/predicate"},
          "question": {"$ref": "common.schema.json#/$defs/compact_why"},
          "cites": {"$ref": "common.schema.json#/$defs/labels"}
        }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "role", "label", "why"],
      "properties": {
        "id": {"$ref": "#/$defs/local_id"},
        "role": {"enum": ["source", "transform", "sanitizer", "guard", "boundary", "sink"]},
        "label": {"oneOf": [{"$ref": "common.schema.json#/$defs/label"}, {"type": "null"}]},
        "why": {"$ref": "common.schema.json#/$defs/compact_why"},
        "guard_effect": {"enum": ["unknown", "potential_block", "potential_bypass"]}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "kind", "basis", "cites"],
      "properties": {
        "from": {"$ref": "#/$defs/local_id"},
        "to": {"$ref": "#/$defs/local_id"},
        "kind": {"enum": ["data", "call", "alias", "control", "cross_boundary"]},
        "basis": {"enum": ["accepted_tool_path", "source_mapped_analysis", "analyst_hypothesis"]},
        "cites": {"$ref": "common.schema.json#/$defs/labels"},
        "question": {"$ref": "common.schema.json#/$defs/compact_why"}
      }
    },
    "taint_paths": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source", "sink", "nodes", "edges"],
        "properties": {
          "source": {"$ref": "#/$defs/local_id"},
          "sink": {"$ref": "#/$defs/local_id"},
          "nodes": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"$ref": "#/$defs/node"}},
          "edges": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/edge"}}
        }
      }
    },
    "chain_seeds": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["objective", "steps", "links"],
        "properties": {
          "objective": {"$ref": "common.schema.json#/$defs/compact_why"},
          "steps": {
            "type": "array", "minItems": 2, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "claim", "description", "prerequisite", "resulting_state", "anchors"],
              "properties": {
                "id": {"$ref": "#/$defs/local_id"},
                "claim": {"oneOf": [{"$ref": "#/$defs/local_id"}, {"type": "null"}]},
                "description": {"$ref": "common.schema.json#/$defs/compact_why"},
                "prerequisite": {"$ref": "common.schema.json#/$defs/compact_why"},
                "resulting_state": {"$ref": "common.schema.json#/$defs/compact_why"},
                "anchors": {"$ref": "common.schema.json#/$defs/labels"}
              }
            }
          },
          "links": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["from", "to", "continuity_dimensions", "cites", "questions"],
              "properties": {
                "from": {"$ref": "#/$defs/local_id"},
                "to": {"$ref": "#/$defs/local_id"},
                "continuity_dimensions": {
                  "type": "array", "maxItems": 5, "uniqueItems": true,
                  "items": {"enum": ["identity", "privilege", "trust_boundary", "deployment_artifact", "temporal"]}
                },
                "cites": {"$ref": "common.schema.json#/$defs/labels"},
                "questions": {"type": "array", "maxItems": 8, "items": {"$ref": "common.schema.json#/$defs/compact_why"}}
              }
            }
          }
        }
      }
    }
  }
}
