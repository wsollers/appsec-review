{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/inference-security-review/handoff.schema.json",
  "title": "Accepted job manifest and handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "accepted_manifest_sha256",
    "configuration_sha256",
    "ledger_head_sha256",
    "projection_sha256",
    "status",
    "accounting",
    "shards",
    "finding_packages",
    "score_packages",
    "gap_ids",
    "remediation_intake",
    "verification_backlog",
    "ship_block",
    "verification",
    "planned_consumers",
    "lead_severity_triage",
    "poc_candidates",
    "package_manifest_sha256",
    "lead_package_manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/inference-review-handoff/2"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/short_text"
    },
    "accepted_manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "configuration_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "ledger_head_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "projection_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "DEGRADED",
        "EMPTY"
      ],
      "description": "DEGRADED whenever any gap or failed lane is accounted; never a clean verdict."
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact",
        "outcome",
        "review_incomplete",
        "incomplete_gap_ratio",
        "gap_ratio",
        "claims_total",
        "duplicate_proposals",
        "claims_by_state",
        "gaps_by_class",
        "evidence_requests_by_outcome",
        "lanes",
        "violations",
        "judge_verdicts"
      ],
      "properties": {
        "exact": {
          "const": true
        },
        "outcome": {
          "$ref": "common.schema.json#/$defs/pool_outcome"
        },
        "review_incomplete": {
          "type": "boolean"
        },
        "incomplete_gap_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gap_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "claims_total": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_proposals": {
          "type": "integer",
          "minimum": 0,
          "description": "Proposals of a claim id that merged into an existing claim (identity-only claim ids); they are not claims of their own and are never in the duplicate state."
        },
        "claims_by_state": {
          "$ref": "common.schema.json#/$defs/claims_by_state"
        },
        "gaps_by_class": {
          "$ref": "common.schema.json#/$defs/gaps_by_class"
        },
        "evidence_requests_by_outcome": {
          "$ref": "common.schema.json#/$defs/requests_by_outcome"
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lane",
              "outcome",
              "claims_total",
              "duplicate_proposals",
              "leads_expected",
              "leads_by_outcome",
              "claims_by_state",
              "cells_expected",
              "cells_by_status",
              "cells_missing",
              "packages_expected",
              "gapped_cells",
              "gapped_packages",
              "gap_ratio",
              "review_incomplete"
            ],
            "properties": {
              "lane": {
                "$ref": "common.schema.json#/$defs/lane"
              },
              "outcome": {
                "$ref": "common.schema.json#/$defs/pool_outcome"
              },
              "claims_total": {
                "type": "integer",
                "minimum": 0
              },
              "duplicate_proposals": {
                "type": "integer",
                "minimum": 0
              },
              "leads_expected": {
                "type": "integer",
                "minimum": 0,
                "description": "Package leads of the lane (one per package and lead)."
              },
              "leads_by_outcome": {
                "type": "object",
                "additionalProperties": false,
                "description": "red-discovery-result/1 lead accounting across each package's succeeded red cells. no_proposal is never clean coverage; unaccounted means no red cell of the package succeeded.",
                "required": [
                  "proposal",
                  "no_proposal",
                  "blocked",
                  "unaccounted"
                ],
                "properties": {
                  "proposal": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "no_proposal": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "blocked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unaccounted": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "claims_by_state": {
                "$ref": "common.schema.json#/$defs/claims_by_state"
              },
              "cells_expected": {
                "type": "integer",
                "minimum": 0
              },
              "cells_by_status": {
                "$ref": "common.schema.json#/$defs/cells_by_status"
              },
              "cells_missing": {
                "type": "integer",
                "minimum": 0
              },
              "packages_expected": {
                "type": "integer",
                "minimum": 0
              },
              "gapped_cells": {
                "type": "integer",
                "minimum": 0
              },
              "gapped_packages": {
                "type": "integer",
                "minimum": 0
              },
              "gap_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "review_incomplete": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 2,
          "minItems": 2
        },
        "violations": {
          "type": "array",
          "maxItems": 0
        },
        "judge_verdicts": {
          "$ref": "common.schema.json#/$defs/judge_accounting"
        }
      }
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "schema",
          "sha256",
          "rows"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!.*(^|/)[.][.]?(/|$))[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
            "maxLength": 512
          },
          "schema": {
            "$ref": "common.schema.json#/$defs/short_text"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "maxItems": 4096,
      "uniqueItems": true
    },
    "finding_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_package_id",
          "sha256"
        ],
        "properties": {
          "finding_package_id": {
            "$ref": "common.schema.json#/$defs/finding_package_id"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "remediation_intake": {
      "description": "Decision 4: confirmed finding packages only; the sole input of remediation planning.",
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_package_id",
          "sha256",
          "claim_id",
          "lane",
          "ship_block_status"
        ],
        "properties": {
          "finding_package_id": {
            "$ref": "common.schema.json#/$defs/finding_package_id"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "claim_id": {
            "$ref": "common.schema.json#/$defs/claim_id"
          },
          "lane": {
            "$ref": "common.schema.json#/$defs/lane"
          },
          "ship_block_status": {
            "enum": [
              "ship_blocking",
              "ship_blocking_pending_distinct_verification",
              "decision_pending",
              "not_ship_blocking"
            ]
          }
        }
      }
    },
    "verification_backlog": {
      "description": "Decision 4: supported finding packages, labelled unconfirmed; never remediation input.",
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_package_id",
          "sha256",
          "claim_id",
          "lane",
          "ship_block_status",
          "label",
          "missing_predicates",
          "gap_ids"
        ],
        "properties": {
          "finding_package_id": {
            "$ref": "common.schema.json#/$defs/finding_package_id"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "claim_id": {
            "$ref": "common.schema.json#/$defs/claim_id"
          },
          "lane": {
            "$ref": "common.schema.json#/$defs/lane"
          },
          "ship_block_status": {
            "enum": [
              "needs_verification",
              "decision_pending",
              "not_ship_blocking"
            ]
          },
          "label": {
            "const": "unconfirmed"
          },
          "missing_predicates": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/predicate"
            }
          },
          "gap_ids": {
            "$ref": "common.schema.json#/$defs/gap_ids"
          }
        }
      }
    },
    "ship_block": {
      "description": "ship-block-policy/1 counts per status, overall and per lane.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "policy_sha256",
        "by_status",
        "by_lane"
      ],
      "properties": {
        "policy": {
          "const": "ship-block-policy/1"
        },
        "policy_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "by_status": {
          "$ref": "common.schema.json#/$defs/ship_block_counts"
        },
        "by_lane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lead",
            "hunt"
          ],
          "properties": {
            "lead": {
              "$ref": "common.schema.json#/$defs/ship_block_counts"
            },
            "hunt": {
              "$ref": "common.schema.json#/$defs/ship_block_counts"
            }
          }
        }
      }
    },
    "verification": {
      "description": "Decision 2: configured verifier versus red model profiles. warning is set when distinct verification is required but the profiles resolve to the same model.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_distinct_model_for_ship_blocking",
        "verifier",
        "red",
        "distinct",
        "warning"
      ],
      "properties": {
        "require_distinct_model_for_ship_blocking": {
          "type": "boolean"
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model"
          ],
          "properties": {
            "provider": {
              "$ref": "common.schema.json#/$defs/short_text"
            },
            "model": {
              "$ref": "common.schema.json#/$defs/short_text"
            }
          }
        },
        "red": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hypothesis_hunter",
            "red_team_analyst"
          ],
          "properties": {
            "hypothesis_hunter": {
              "$ref": "#/properties/verification/properties/verifier"
            },
            "red_team_analyst": {
              "$ref": "#/properties/verification/properties/verifier"
            }
          }
        },
        "distinct": {
          "type": "boolean"
        },
        "warning": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "planned_consumers": {
      "description": "Decision 8: the downstream jobs fixed by name, with the handoff fields each reads.",
      "type": "array",
      "minItems": 4,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "status",
          "reads"
        ],
        "properties": {
          "job_id": {
            "enum": [
              "job_remediation_planning",
              "job_remediation_validation",
              "job_final_publication_gate",
              "job_final_report_publication"
            ]
          },
          "status": {
            "const": "planned"
          },
          "reads": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/token"
            }
          }
        }
      }
    },
    "score_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "score_id",
          "sha256"
        ],
        "properties": {
          "score_id": {
            "$ref": "common.schema.json#/$defs/score_id"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap_id"
      },
      "maxItems": 100000,
      "uniqueItems": true
    },
    "package_manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "lead_package_manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "coverage_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "rows"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*(^|/)[.][.]?(/|$))[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
          "maxLength": 512
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "possible_duplicates": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "$ref": "common.schema.json#/$defs/claim_id"
        }
      },
      "description": "Distinct claim ids nominated as possible duplicates (R7); slice 1 never merges them."
    },
    "poc_candidates": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/poc_candidate"
      },
      "description": "Claims that meet every proof-of-concept condition; consumed by job_poc_generation."
    },
    "lead_severity_triage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "rule_table_version", "unknown_leads", "rule_table", "cwe_catalog", "model_triage", "unresolved", "model_calls", "artifact"],
          "properties": {
            "enabled": {"const": true},
            "rule_table_version": {"const": "lead-severity-rules/1"},
            "unknown_leads": {"type": "integer", "minimum": 0},
            "rule_table": {"type": "integer", "minimum": 0},
            "cwe_catalog": {"type": "integer", "minimum": 0},
            "model_triage": {"type": "integer", "minimum": 0},
            "unresolved": {"type": "integer", "minimum": 0},
            "model_calls": {"type": "integer", "minimum": 0},
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1, "maxLength": 512},
                "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
              }
            }
          }
        }
      ]
    }
  }
}
