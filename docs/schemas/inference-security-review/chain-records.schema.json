{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/inference-security-review/chain-records.schema.json",
  "$defs": {
    "chain_id": {"type": "string", "pattern": "^chain-[0-9a-f]{64}$"},
    "challenge_id": {"type": "string", "pattern": "^chain_challenge-[0-9a-f]{64}$"},
    "dimension": {"enum": ["identity", "privilege", "trust_boundary", "artifact_deployment", "temporal"]},
    "outcome": {"enum": ["satisfied", "contradicted", "unresolved"]},
    "status": {"enum": ["confirmed", "qualified_supported", "refuted", "insufficient_evidence"]},
    "texts": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "worker_gaps": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(?![A-Za-z]:|/|.*\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "provider", "model", "conversation_id", "prior_response_sha256", "cache_key"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "provider": {"type": "string", "minLength": 1, "maxLength": 200},
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "conversation_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "prior_response_sha256": {"type": ["string", "null"]},
        "cache_key": {"type": ["string", "null"]}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "adjudication_id", "state", "missing_predicates", "requires_extra_verifier"],
      "properties": {
        "claim_id": {"$ref": "common.schema.json#/$defs/claim_id"},
        "adjudication_id": {"$ref": "common.schema.json#/$defs/adjudication_id"},
        "state": {"enum": ["confirmed", "supported"]},
        "missing_predicates": {"$ref": "#/$defs/texts"},
        "requires_extra_verifier": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_id", "index", "shard_id", "shard_sha256", "content_sha256", "outcome", "reason"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^rel:[0-9a-f]{64}$"},
        "index": {"type": "string", "minLength": 1, "maxLength": 200},
        "shard_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "shard_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "obligation": {
      "type": "object", "additionalProperties": false, "required": ["dimension", "evidence"],
      "properties": {
        "dimension": {"$ref": "#/$defs/dimension"},
        "evidence": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from_claim_id", "to_claim_id", "output_entity", "input_entity", "obligations"],
      "properties": {
        "from_claim_id": {"$ref": "common.schema.json#/$defs/claim_id"},
        "to_claim_id": {"$ref": "common.schema.json#/$defs/claim_id"},
        "output_entity": {"$ref": "common.schema.json#/$defs/entity_id"},
        "input_entity": {"$ref": "common.schema.json#/$defs/entity_id"},
        "obligations": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/obligation"}}
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["chain_id", "objective", "environment", "components", "edges", "prerequisites", "composer"],
      "properties": {
        "chain_id": {"$ref": "#/$defs/chain_id"},
        "objective": {"type": "string", "minLength": 1, "maxLength": 1000},
        "environment": {"type": "string", "minLength": 1, "maxLength": 2000},
        "components": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/component"}},
        "edges": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/edge"}},
        "prerequisites": {"$ref": "#/$defs/texts"},
        "composer": {"$ref": "#/$defs/actor"}
      }
    },
    "challenge": {
      "type": "object", "additionalProperties": false,
      "required": ["challenge_id", "chain_id", "kind", "actor", "status", "request_sha256", "receipt", "edges", "independent", "gaps"],
      "properties": {
        "challenge_id": {"$ref": "#/$defs/challenge_id"},
        "chain_id": {"$ref": "#/$defs/chain_id"},
        "kind": {"enum": ["refuter", "weakest_link_verifier"]},
        "actor": {"$ref": "#/$defs/actor"},
        "status": {"enum": ["succeeded", "failed", "timed_out", "invalid", "not_launched", "blocked", "canceled"]},
        "request_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "receipt": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "edges": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/edge"}},
        "independent": {"type": "boolean"},
        "gaps": {"$ref": "#/$defs/texts"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["chain_id", "status", "limitations", "challenge_ids", "artifact", "policy"],
      "properties": {
        "chain_id": {"$ref": "#/$defs/chain_id"},
        "status": {"$ref": "#/$defs/status"},
        "limitations": {"$ref": "#/$defs/texts"},
        "challenge_ids": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/challenge_id"}},
        "artifact": {"$ref": "#/$defs/artifact"},
        "policy": {"const": "attack-chain-continuity/1"}
      }
    }
  }
}
