{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/inference-security-review/hunting-campaign-plan.schema.json",
  "title": "Hunting campaign plan",
  "description": "The closed reply of the hunt_planner role (appsec-review/hunting-campaign-plan/1; review protocol v3 section 4, T-5030). Areas partition the attack surface the brief listed: each names a mission, closed weakness classes, a priority (1 is hunted first), an agent count and the F/N/E ids of the brief it covers. Every N and E id of the brief is in exactly one area or in unassigned with a reason; an id the brief did not list is refused. The application clamps agents to the configured budget, keeps areas beyond it as not_reached, and derives coverage from receipts, never from this plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "areas",
    "unassigned",
    "gaps"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/hunting-campaign-plan/1"
    },
    "areas": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area_id",
          "title",
          "mission",
          "weakness_classes",
          "priority",
          "agents",
          "files",
          "functions",
          "entry_points",
          "rationale"
        ],
        "properties": {
          "area_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "mission": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "What the hunters of this area look for and where; bounded text, never target text."
          },
          "weakness_classes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/security_predicate"
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "agents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          },
          "files": {
            "type": "array",
            "maxItems": 5000,
            "items": {
              "type": "string",
              "pattern": "^F[1-9][0-9]{0,5}$"
            }
          },
          "functions": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "pattern": "^N[1-9][0-9]{0,5}$"
            }
          },
          "entry_points": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "pattern": "^E[1-9][0-9]{0,5}$"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "unassigned": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[FNE][1-9][0-9]{0,5}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
