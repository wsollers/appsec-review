{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/dependency-intelligence/sca-reachability.schema.json",
  "title": "SCA Indexed Version Matching and Vulnerable-Symbol / FFI Reachability",
  "description": "Deterministic OSV version matching and target import/symbol/FFI reachability classification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_fingerprint",
    "configured_osv_mode",
    "osv_matching_mode",
    "advisories",
    "telemetry"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/sca-reachability/1"
    },
    "source_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "configured_osv_mode": {
      "type": "string",
      "enum": ["index", "exact", "disabled"]
    },
    "osv_matching_mode": {
      "type": "string",
      "enum": ["index", "exact", "disabled"]
    },
    "osv_fallback_reason": {
      "type": ["string", "null"]
    },
    "advisories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "advisory_id",
          "cve_ids",
          "package_name",
          "package_version",
          "purl",
          "ecosystem",
          "severity",
          "direct",
          "match_sources",
          "affected_symbols",
          "affected_modules",
          "reachability",
          "ffi_mechanisms",
          "call_sites",
          "dependency_ids"
        ],
        "properties": {
          "advisory_id": {
            "type": "string",
            "minLength": 1
          },
          "cve_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "package_name": {
            "type": "string",
            "minLength": 1
          },
          "package_version": {
            "type": ["string", "null"]
          },
          "purl": {
            "type": ["string", "null"]
          },
          "ecosystem": {
            "type": ["string", "null"]
          },
          "severity": {
            "type": ["string", "null"]
          },
          "direct": {
            "type": "boolean"
          },
          "match_sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "affected_symbols": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "affected_modules": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reachability": {
            "type": "string",
            "enum": [
              "symbol_reachable",
              "package_imported",
              "transitive_only",
              "unreachable_in_target"
            ]
          },
          "ffi_mechanisms": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "call_sites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line", "symbol"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string", "minLength": 1 },
                "kind": {
                  "type": "string",
                  "enum": ["symbol_call", "package_import", "ffi_boundary"]
                },
                "ffi_mechanism": {
                  "type": ["string", "null"]
                }
              }
            }
          },
          "dependency_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisories_matched",
        "osv_matching_mode",
        "symbol_reachable_count",
        "ffi_boundary_matches"
      ],
      "properties": {
        "advisories_matched": { "type": "integer", "minimum": 0 },
        "osv_matching_mode": {
          "type": "string",
          "enum": ["index", "exact", "disabled"]
        },
        "symbol_reachable_count": { "type": "integer", "minimum": 0 },
        "ffi_boundary_matches": { "type": "integer", "minimum": 0 },
        "package_imported_count": { "type": "integer", "minimum": 0 },
        "transitive_only_count": { "type": "integer", "minimum": 0 },
        "unreachable_in_target_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
