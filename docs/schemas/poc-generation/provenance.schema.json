{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/poc-generation/provenance.schema.json",
  "title": "provenance.json of one PoC candidate (appsec-review/poc-provenance/2)",
  "description": "Hashes tying the reproducer files to the brief, the review package, the source tree, the image, the settings and the model that wrote them.",
  "type": "object",
  "required": [
    "schema",
    "claim_id",
    "package_id",
    "finding_package",
    "state",
    "judge_verdict",
    "poc_basis_sha256",
    "brief_sha256",
    "package_sha256",
    "source_sha256",
    "settings_sha256",
    "status",
    "model",
    "upstream",
    "source_tree",
    "image",
    "files", "run_id", "execution", "runtime_verified", "result_id"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/poc-provenance/2"
    },
    "run_id": {"$ref": "common.schema.json#/$defs/short_text"},
    "execution": {"const": "not_performed_by_policy"},
    "runtime_verified": {"const": false},
    "result_id": {"type": "null"},
    "claim_id": {
      "$ref": "common.schema.json#/$defs/claim_id"
    },
    "package_id": {
      "$ref": "common.schema.json#/$defs/package_id"
    },
    "finding_package": {
      "type": "object",
      "required": [
        "finding_package_id",
        "sha256"
      ]
    },
    "state": {
      "$ref": "common.schema.json#/$defs/claim_state"
    },
    "judge_verdict": {
      "$ref": "common.schema.json#/$defs/judge_verdict"
    },
    "poc_basis_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "brief_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "package_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "source_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "settings_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "guidance_bundle_sha256": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "writer_receipt_sha256": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "reasoning"
      ]
    },
    "upstream": {
      "type": "object"
    },
    "source_tree": {
      "type": [
        "object",
        "null"
      ]
    },
    "image": {
      "type": "object"
    },
    "files": {
      "type": "object",
      "required": [
        "source",
        "compile",
        "readme"
      ]
    }
  }
}
