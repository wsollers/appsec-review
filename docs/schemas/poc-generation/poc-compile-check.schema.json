{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/poc-generation/poc-compile-check.schema.json",
  "title": "Lexical PoC preflight and Python-only AST parsing, never compiler verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "language",
    "status",
    "lexical_check_passed",
    "syntax_valid",
    "parser",
    "import_patterns_valid",
    "harness_entrypoint_detected",
    "oracle_or_control_pattern_detected",
    "target_symbol_text_present",
    "stub_patterns_absent",
    "prohibited_primitives",
    "violations",
    "generated_code_execution",
    "runtime_verified",
    "compiler_verified",
    "limitations"
  ],
  "allOf": [
    {
      "if": {"properties": {"syntax_valid": {"type": "boolean"}}},
      "then": {"properties": {"language": {"const": "python"}, "parser": {"const": "python_ast"}}},
      "else": {"properties": {"parser": {"const": null}}}
    }
  ],
  "properties": {
    "schema": {"const": "appsec-review/poc-compile-check/2"},
    "claim_id": {"type": ["string", "null"], "maxLength": 128},
    "language": {
      "enum": ["cpp", "java", "javascript", "python", "ruby", "go", "csharp", "rust", "php"]
    },
    "status": {"enum": ["static_checked", "static_check_failed", "policy_denied"]},
    "lexical_check_passed": {"type": "boolean"},
    "syntax_valid": {"type": ["boolean", "null"]},
    "parser": {"enum": ["python_ast", null]},
    "import_patterns_valid": {"type": "boolean"},
    "harness_entrypoint_detected": {"type": "boolean"},
    "oracle_or_control_pattern_detected": {"type": "boolean"},
    "target_symbol_text_present": {"type": ["boolean", "null"]},
    "stub_patterns_absent": {"type": "boolean"},
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "maxLength": 240}
    },
    "declared_entrypoints": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "matched_target_symbols": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "prohibited_primitives": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "violations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "detail"],
        "properties": {
          "rule": {"type": "string", "minLength": 1, "maxLength": 64},
          "detail": {"type": "string", "minLength": 1, "maxLength": 320}
        }
      }
    },
    "generated_code_execution": {"const": "not_performed_by_policy"},
    "compiler_verified": {"const": false},
    "runtime_verified": {"const": false}
  }
}
