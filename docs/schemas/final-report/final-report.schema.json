{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/final-report/final-report.schema.json",
  "title": "Final security review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "provenance",
    "status",
    "summary",
    "findings",
    "attack_chains",
    "poc_outcomes",
    "verification_backlog",
    "withheld",
    "limitations",
    "gap_ids",
    "renderers",
    "notices",
    "capabilities",
    "remediation_planning",
    "remediation_validation",
    "dossiers"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/final-report/2"
    },
    "capabilities": {
      "$ref": "common.schema.json#/$defs/capabilities"
    },
    "remediation_planning": {
      "$ref": "common.schema.json#/$defs/planning_section"
    },
    "remediation_validation": {
      "$ref": "common.schema.json#/$defs/validation_section"
    },
    "dossiers": {
      "$ref": "common.schema.json#/$defs/dossier_section"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/short_text"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_handoff",
        "gate_document",
        "review_handoff",
        "accepted_manifest_sha256",
        "configuration_sha256",
        "ledger_head_sha256",
        "ship_block_policy_sha256"
      ],
      "properties": {
        "configuration_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256"
          ],
          "properties": {
            "name": {
              "enum": [
                "dev",
                "prod"
              ]
            },
            "sha256": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "gate_handoff": {
          "$ref": "common.schema.json#/$defs/artifact_ref"
        },
        "gate_document": {
          "$ref": "common.schema.json#/$defs/artifact_ref"
        },
        "review_handoff": {
          "$ref": "common.schema.json#/$defs/artifact_ref"
        },
        "accepted_manifest_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "configuration_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "ledger_head_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "ship_block_policy_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "poc_handoff": {
          "$ref": "common.schema.json#/$defs/artifact_ref"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review",
        "review_incomplete",
        "publication",
        "review_complete"
      ],
      "properties": {
        "review": {
          "$ref": "common.schema.json#/$defs/review_status"
        },
        "review_incomplete": {
          "type": "boolean"
        },
        "publication": {
          "$ref": "common.schema.json#/$defs/publication_status"
        },
        "review_complete": {
          "type": "boolean"
        }
      },
      "description": "review_complete is true only for a COMPLETE review that is not review_incomplete and has no limitation of kind gap."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accounting",
        "package_counts",
        "ship_block",
        "coverage"
      ],
      "properties": {
        "accounting": {
          "$ref": "common.schema.json#/$defs/accounting_summary"
        },
        "package_counts": {
          "$ref": "common.schema.json#/$defs/package_counts"
        },
        "ship_block": {
          "$ref": "common.schema.json#/$defs/ship_block_summary"
        },
        "coverage": {
          "$ref": "common.schema.json#/$defs/coverage_summary"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/finding_projection"
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "attack_chains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "none_available",
            "available"
          ]
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/chain_attachment"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "required": [
            "admitted",
            "confirmed",
            "qualified_supported",
            "refuted",
            "insufficient_evidence"
          ]
        }
      }
    },
    "poc_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "none_available",
            "available"
          ]
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding_package_id",
              "status",
              "result_id",
              "claim_id",
              "description",
              "functions",
              "files",
              "execution",
              "runtime_verified"
            ],
            "properties": {
              "execution": {
                "const": "not_performed_by_policy"
              },
              "runtime_verified": {
                "const": false
              },
              "finding_package_id": {
                "$ref": "common.schema.json#/$defs/finding_package_id"
              },
              "status": {
                "enum": [
                  "compile_verified",
                  "compile_failed",
                  "artifact_generated",
                  "policy_denied",
                  "insufficient_evidence",
                  "not_applicable",
                  "unsafe_to_attempt"
                ]
              },
              "result_id": {
                "type": "null"
              },
              "claim_id": {
                "$ref": "common.schema.json#/$defs/claim_id"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "functions": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "test_function",
                      "negative_control"
                    ],
                    "properties": {
                      "test_function": {
                        "$ref": "common.schema.json#/$defs/short_text"
                      },
                      "negative_control": {
                        "$ref": "common.schema.json#/$defs/short_text"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "files": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "compile",
                      "readme",
                      "provenance"
                    ],
                    "properties": {
                      "source": {
                        "$ref": "common.schema.json#/$defs/artifact_ref"
                      },
                      "compile": {
                        "$ref": "common.schema.json#/$defs/artifact_ref"
                      },
                      "readme": {
                        "$ref": "common.schema.json#/$defs/artifact_ref"
                      },
                      "provenance": {
                        "$ref": "common.schema.json#/$defs/artifact_ref"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 10000,
          "uniqueItems": true
        },
        "poc_handoff": {
          "$ref": "common.schema.json#/$defs/artifact_ref"
        }
      }
    },
    "verification_backlog": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/finding_projection"
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "withheld": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/finding_projection"
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/limitation"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap_id"
      },
      "maxItems": 100000,
      "uniqueItems": true
    },
    "renderers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markdown",
        "pdf"
      ],
      "properties": {
        "markdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "renderer"
          ],
          "properties": {
            "file": {
              "const": "final-report.md"
            },
            "renderer": {
              "$ref": "common.schema.json#/$defs/token"
            }
          }
        },
        "pdf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "not_rendered",
                "rendered",
                "render_failed"
              ]
            },
            "reason": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "file": {
              "$ref": "common.schema.json#/$defs/ref_or_null"
            },
            "sha256": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "latex": {
              "$ref": "common.schema.json#/$defs/ref_or_null"
            },
            "receipt": {
              "$ref": "common.schema.json#/$defs/ref_or_null"
            }
          },
          "description": "The executive PDF's state. final-report.json is assembled before report.render_pdf runs and always records not_rendered here; the publish handoff's pdf field carries the actual outcome from the receipt (rendered with file/sha256, render_failed or not_rendered by policy)."
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/text"
      },
      "maxItems": 16,
      "uniqueItems": true,
      "minItems": 1
    },
    "executive_posture": {
      "$ref": "#/$defs/executive_posture"
    },
    "radar_tracker": {
      "$ref": "#/$defs/radar_tracker"
    },
    "attack_chain_cards": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/attack_chain_card"
      }
    },
    "remediation_roadmap": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/remediation_roadmap_item"
      }
    },
    "named_coverage_gaps": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/named_coverage_gap"
      }
    }
  },
  "$defs": {
    "radar_tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "axis_count",
        "series_ids",
        "unclassified_packages",
        "coverage_confidence",
        "axes"
      ],
      "properties": {
        "schema": {
          "const": "appsec-review/security-radar-tracker/1"
        },
        "axis_count": {
          "const": 12
        },
        "series_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "enum": [
              "surface_exposure",
              "verified_coverage",
              "corroborated_leads",
              "confirmed_high_critical"
            ]
          }
        },
        "unclassified_packages": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verified_axes",
            "gap_axes",
            "confidence_score",
            "review_complete",
            "global_gap_ids",
            "summary_statement"
          ],
          "properties": {
            "verified_axes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "gap_axes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "confidence_score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "review_complete": {
              "type": "boolean"
            },
            "global_gap_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "summary_statement": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "axes": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain_id",
              "key",
              "label",
              "owasp_2025",
              "predicates",
              "coverage_status",
              "gap_reasons",
              "series"
            ],
            "properties": {
              "domain_id": {
                "enum": [
                  "authentication_session",
                  "authorization_access_control",
                  "injection_interpreters",
                  "memory_safety_native",
                  "parsing_deserialization",
                  "cryptography_secrets",
                  "network_api_surface",
                  "filesystem_path_resources",
                  "business_logic_state",
                  "supply_chain_dependencies",
                  "ci_cd_build_integrity",
                  "container_deployment_hardening"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "owasp_2025": {
                "type": "string",
                "minLength": 1
              },
              "predicates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "coverage_status": {
                "enum": [
                  "verified_no_findings",
                  "verified_findings",
                  "partial_coverage_gap",
                  "unverified_gap"
                ]
              },
              "gap_reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "series": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "surface_exposure",
                  "verified_coverage",
                  "corroborated_leads",
                  "confirmed_high_critical"
                ],
                "properties": {
                  "surface_exposure": {
                    "$ref": "#/$defs/series_metric"
                  },
                  "verified_coverage": {
                    "$ref": "#/$defs/coverage_metric"
                  },
                  "corroborated_leads": {
                    "$ref": "#/$defs/series_metric"
                  },
                  "confirmed_high_critical": {
                    "$ref": "#/$defs/confirmed_metric"
                  }
                }
              }
            }
          }
        }
      }
    },
    "executive_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_readiness",
        "confirmed_by_severity",
        "chain_elevated_findings_count",
        "reachable_supply_chain_advisories_count",
        "ship_blocking_count",
        "coverage_confidence_index"
      ],
      "properties": {
        "release_readiness": {
          "enum": [
            "BLOCK_RELEASE",
            "REVIEW_REQUIRED_GAPS_PRESENT",
            "READY_WITH_RESIDUAL_ACCEPTANCE"
          ]
        },
        "confirmed_by_severity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critical",
            "high",
            "medium",
            "low",
            "unrated"
          ],
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "unrated": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "chain_elevated_findings_count": {
          "type": "integer",
          "minimum": 0
        },
        "reachable_supply_chain_advisories_count": {
          "type": "integer",
          "minimum": 0
        },
        "ship_blocking_count": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_confidence_index": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score",
            "verified_axes",
            "gap_axes",
            "unverified_axis_ids",
            "statement"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "verified_axes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "gap_axes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "unverified_axis_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "attack_chain_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "status",
        "composed_severity",
        "trust_boundary_crossed",
        "step_count",
        "steps",
        "gap_count"
      ],
      "properties": {
        "chain_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "composed_severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "unrated"
          ]
        },
        "trust_boundary_crossed": {
          "type": "string",
          "minLength": 1
        },
        "step_count": {
          "type": "integer",
          "minimum": 0
        },
        "gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_index",
              "role",
              "claim_id",
              "finding_package_id",
              "title",
              "domain_id",
              "technical_severity"
            ],
            "properties": {
              "step_index": {
                "type": "integer",
                "minimum": 1
              },
              "role": {
                "enum": [
                  "entry",
                  "hop",
                  "sink"
                ]
              },
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "finding_package_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "domain_id": {
                "type": "string",
                "minLength": 1
              },
              "technical_severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "unrated"
                ]
              }
            }
          }
        }
      }
    },
    "remediation_roadmap_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "finding_package_id",
        "claim_id",
        "title",
        "priority_tier",
        "technical_severity",
        "ship_block_status",
        "domain_id",
        "chain_participating",
        "validation_status",
        "poc_posture"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "finding_package_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority_tier": {
          "enum": [
            "critical",
            "high",
            "chain_elevated",
            "quick_win_dependency_or_config",
            "residual_confirmed"
          ]
        },
        "technical_severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "unrated"
          ]
        },
        "ship_block_status": {
          "type": "string",
          "minLength": 1
        },
        "domain_id": {
          "type": "string",
          "minLength": 1
        },
        "chain_participating": {
          "type": "boolean"
        },
        "validation_status": {
          "enum": [
            "build_checked",
            "in_memory_patch_and_syntax_verified",
            "manual_design_required"
          ]
        },
        "poc_posture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "generated_code_execution"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "generated_code_execution": {
              "const": "not_performed_by_policy"
            }
          }
        }
      }
    },
    "named_coverage_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "category",
        "affected_scope",
        "disposition",
        "statement"
      ],
      "properties": {
        "gap_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "affected_scope": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "series_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_count",
        "score",
        "unit"
      ],
      "properties": {
        "raw_count": {
          "type": "integer",
          "minimum": 0
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "unit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "coverage_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_count",
        "score",
        "unit",
        "is_gap"
      ],
      "properties": {
        "raw_count": {
          "type": "integer",
          "minimum": 0
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
