{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "appsec-review/build-recipe-replay/1",
  "description": "Immutable detached trial receipt. Runtime validation additionally resolves the exact failure, source, graph, configuration/releases, upstream products, captured commands and retained generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "context", "candidate", "candidate_key", "network", "status", "reason"],
  "properties": {
    "schema": {"const": "appsec-review/build-recipe-replay/1"},
    "context": {"$ref": "#/$defs/reference"},
    "candidate": {"$ref": "#/$defs/reference"},
    "candidate_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "network": {"enum": ["bridge", "none"]},
    "status": {"enum": ["STOPPED", "BLOCKED", "FAILED", "UNFINISHED", "SUCCEEDED"]},
    "reason": {"type": ["string", "null"]},
    "intent": {"$ref": "#/$defs/reference"},
    "topology_refinement": {"$ref": "#/$defs/reference"},
    "cleanup_complete": {"type": "boolean"},
    "binding": {"type": "object"},
    "generation_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "products": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]},
    "verified_interfaces": {"type": "array", "items": {"type": "object"}},
    "commands": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "argv", "exit_code", "timed_out", "capture", "stdout", "stderr"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
          "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "maxLength": 2048}},
          "working_directory": {"type": "string", "minLength": 1, "maxLength": 512},
          "exit_code": {"type": ["integer", "null"]},
          "timed_out": {"type": "boolean"},
          "capture": {"$ref": "#/$defs/reference"},
          "stdout": {"$ref": "#/$defs/reference"},
          "stderr": {"$ref": "#/$defs/reference"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["SUCCEEDED", "FAILED", "UNFINISHED"]}}},
      "then": {"required": ["intent", "topology_refinement", "cleanup_complete", "binding", "generation_identity", "products", "verified_interfaces", "commands"]}
    },
    {
      "if": {"properties": {"status": {"const": "SUCCEEDED"}}},
      "then": {
        "properties": {
          "cleanup_complete": {"const": true},
          "reason": {"type": "null"},
          "products": {"$ref": "#/$defs/reference"},
          "verified_interfaces": {"minItems": 1},
          "commands": {"minItems": 1, "items": {"properties": {"exit_code": {"const": 0}, "timed_out": {"const": false}}}}
        }
      }
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^(artifacts|data)/[^\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "recipe", "evidence", "reason", "products"],
      "properties": {
        "schema": {"const": "appsec-review/build-recipe-candidate/1"},
        "recipe": {"type": "object", "description": "Validated with the existing accepted build recipe contract, not this schema alone."},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/reference"}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
        "products": {"type": ["array", "null"], "maxItems": 64, "items": {"type": "object"}}
      }
    }
  }
}
