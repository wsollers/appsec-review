{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "appsec-review/owasp-control-gap/1",
  "title": "Verified OWASP Control Gap Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "assessment_mode",
    "controls_assessed",
    "verified_gaps_indexed",
    "gaps_by_verdict",
    "control_gaps",
    "coverage_gaps",
    "telemetry"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/owasp-control-gap/1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "assessment_mode": {
      "type": "string",
      "enum": ["qualification", "assessment"]
    },
    "controls_assessed": {
      "type": "integer",
      "minimum": 0
    },
    "verified_gaps_indexed": {
      "type": "integer",
      "minimum": 0
    },
    "gaps_by_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_satisfied"],
      "properties": {
        "not_satisfied": { "type": "integer", "minimum": 0 }
      }
    },
    "control_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "row_id",
          "component_id",
          "control_identity",
          "asvs_id",
          "verdict",
          "control_status",
          "verification_status",
          "lead_eligible",
          "cwe_ids",
          "mechanisms",
          "subject_spans"
        ],
        "properties": {
          "gap_id": { "type": "string", "minLength": 1 },
          "row_id": { "type": "string", "minLength": 1 },
          "component_id": { "type": "string", "minLength": 1 },
          "control_identity": { "type": "string", "minLength": 1 },
          "asvs_id": { "type": "string", "minLength": 1 },
          "verdict": { "const": "not_satisfied" },
          "control_status": { "const": "not_satisfied" },
          "verification_status": { "const": "independently_assessed" },
          "lead_eligible": { "type": "boolean" },
          "cwe_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mechanisms": {
            "type": "array",
            "items": { "type": "string" }
          },
          "subject_spans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["citation_type", "ref", "evidence_reference"],
              "properties": {
                "citation_type": { "type": "string" },
                "ref": { "type": "string" },
                "path": { "type": ["string", "null"] },
                "start_line": { "type": ["integer", "null"], "minimum": 1 },
                "end_line": { "type": ["integer", "null"], "minimum": 1 },
                "evidence_reference": {
                  "type": "object",
                  "description": "Exact typed reference re-resolved through the accepted OWASP evidence resolver, including publication and content pins.",
                  "required": ["schema", "source_identity", "publication", "locator", "content_sha256"],
                  "properties": {
                    "schema": { "const": "appsec-review/owasp-evidence-reference/1" },
                    "source_identity": { "type": "string", "pattern": "^asr:[a-z_]+:[0-9a-f]{64}$" },
                    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "publication": { "type": "object", "required": ["manifest_sha256", "index", "shard_id", "sha256"] },
                    "locator": { "type": "object", "required": ["kind"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_id", "code", "summary"],
        "properties": {
          "row_id": { "type": "string", "minLength": 1 },
          "code": { "const": "unresolved_control_evidence" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owasp.controls_assessed",
        "owasp.verified_gaps_indexed"
      ],
      "properties": {
        "owasp.controls_assessed": { "type": "integer", "minimum": 0 },
        "owasp.verified_gaps_indexed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
