{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "appsec-review/target-analysis-plan/1",
  "title": "Accepted target analysis plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_fingerprint", "catalog_handoff_sha256", "summary_sha256", "provenance", "components", "scanner_selections", "scanner_non_selections", "build_topology", "prerequisites", "expected_artifact_families", "confidence", "contradictions", "coverage_gaps", "model"],
  "properties": {
    "schema": {"const": "appsec-review/target-analysis-plan/1"},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "catalog_handoff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"enum": ["deterministic", "model-assisted"]},
    "components": {"type": "array"},
    "scanner_selections": {"type": "array"},
    "scanner_non_selections": {"type": "array"},
    "build_topology": {
      "type": "object",
      "required": ["executable_graph"],
      "properties": {
        "executable_graph": {
          "oneOf": [
            {"$ref": "build-topology-v2.schema.json"},
            {"$ref": "build-topology.schema.json"}
          ]
        },
        "evidence_bundle": {"type": "object"},
        "planning_refinement": {"$ref": "build-topology-refinement.schema.json"}
      }
    },
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "expected_artifact_families": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "coverage_gaps": {"type": "array", "items": {"type": "string"}},
    "build_environment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "workflow", "expected_producer", "mode", "reference", "reason",
                   "availability", "artifact", "evidence"],
      "properties": {
        "schema": {"const": "appsec-review/build-environment-availability/1"},
        "workflow": {"type": "string", "minLength": 1},
        "expected_producer": {"enum": [null, "job_build_environment_analysis"]},
        "mode": {"enum": ["EXPECTED_CURRENT", "OPTIONAL_PRIOR", "DISABLED", "NOT_RUN"]},
        "reference": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "reason": {"type": "string", "minLength": 1},
        "availability": {"enum": ["AVAILABLE", "UNAVAILABLE", "ABSENT", "DISABLED"]},
        "artifact": {"type": ["object", "null"]},
        "evidence": {"oneOf": [{"type": "null"}, {"$ref": "build-environment-analysis.schema.json"}]}
      }
    },
    "planning_evidence": {"type": "array", "items": {"type": "object"}},
    "feedback": {"type": "array", "maxItems": 512, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["cache_key", "cache_hit", "calls", "status", "metrics"],
      "properties": {
        "cache_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "cache_hit": {"type": "boolean"},
        "calls": {"type": "integer", "minimum": 0, "maximum": 4},
        "status": {"enum": ["ACCEPTED", "PARTIAL", "BUDGET_EXCEEDED"]},
        "metrics": {"type": "object", "additionalProperties": false,
          "required": ["request_bytes", "response_bytes", "evidence_bytes", "evidence_rounds", "elapsed_seconds"],
          "properties": {
            "request_bytes": {"type": "integer", "minimum": 0},
            "response_bytes": {"type": "integer", "minimum": 0},
            "evidence_bytes": {"type": "integer", "minimum": 0, "maximum": 262144},
            "evidence_rounds": {"type": "integer", "minimum": 0, "maximum": 3},
            "elapsed_seconds": {"type": "number", "minimum": 0}
          }}
      }}},
    "history_priority": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "handoff_sha256", "history_identity", "ranking", "components", "files"],
      "properties": {
        "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
        "reason": {"type": ["string", "null"]},
        "handoff_sha256": {"type": ["string", "null"]},
        "history_identity": {"type": ["string", "null"]},
        "ranking": {"type": ["string", "null"]},
        "components": {"type": "array"},
        "files": {"type": "array"},
        "changelog": {
          "description": "Change-log-derived file ranks (source: changelog), never merged into files.",
          "type": "object", "additionalProperties": false,
          "required": ["status", "source", "role", "identity", "reason", "files"],
          "properties": {
            "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
            "source": {"const": "changelog"},
            "role": {"enum": ["primary", "supplement", null]},
            "identity": {"type": ["string", "null"]},
            "reason": {"type": ["string", "null"]},
            "files": {"type": "array"}
          }
        }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "proposal_sha256"],
      "properties": {
        "status": {"enum": ["NOT_NEEDED", "DISABLED", "UNAVAILABLE", "ACCEPTED", "PARTIAL", "REJECTED", "FAILED"]},
        "proposal_sha256": {"type": ["string", "null"]},
        "groups": {
          "description": "One entry per language-family/build-system inference partition, in sorted partition order; present only when recipe inference ran.",
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["status"],
            "properties": {"status": {"enum": ["ACCEPTED", "PARTIAL", "REJECTED", "FAILED", "BUDGET_EXCEEDED"]}}
          }
        }
      }
    }
  }
}
