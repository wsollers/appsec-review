{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "appsec-review/build-recipe/1",
  "title": "Validated inferred build recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "build_unit_id", "image_profile", "source_dir", "build_dir", "system_packages", "environment", "dependency_files", "configure_commands", "build_commands", "expected_outputs", "network_required", "reason"],
  "properties": {
    "schema": {"const": "appsec-review/build-recipe/1"},
    "build_unit_id": {"type": "string", "pattern": "^build-unit-[0-9a-f]{20}$"},
    "image_profile": {"enum": ["native", "rust", "go", "java", "node", "dotnet", "python", "php", "wasm"]},
    "source_dir": {"type": "string", "minLength": 1, "maxLength": 512},
    "build_dir": {"type": "string", "minLength": 1, "maxLength": 512},
    "system_packages": {"type": "array", "uniqueItems": true, "maxItems": 64, "items": {"type": "string", "maxLength": 128}},
    "environment": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "maxLength": 1024}},
    "dependency_files": {"type": "array", "uniqueItems": true, "maxItems": 64, "items": {"type": "string", "maxLength": 512}},
    "configure_commands": {"$ref": "#/$defs/commands"},
    "build_commands": {"$ref": "#/$defs/commands", "minItems": 1},
    "expected_outputs": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 512}},
    "network_required": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "$defs": {"commands": {"type": "array", "maxItems": 16, "items": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "maxLength": 2048}}}}
}
