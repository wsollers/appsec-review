{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "appsec-review/build-topology/1",
  "title": "Source-bound executable build topology",
  "description": "A partial target build graph, not the review-job DAG or attempt chain. topology_id excludes per-node recipe_revision; the accepted document hash binds all fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_fingerprint", "topology_id", "nodes", "edges", "external_requirements", "coverage_gaps"],
  "properties": {
    "schema": {"const": "appsec-review/build-topology/1"},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "topology_id": {"$ref": "#/$defs/hash"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}, "uniqueItems": true},
    "external_requirements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["consumer_build_unit_id", "interface", "status", "evidence"],
        "properties": {
          "consumer_build_unit_id": {"type": "string", "minLength": 1},
          "interface": {"type": "string", "minLength": 1},
          "status": {"const": "unresolved"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "build_unit_ids", "reason", "blocking", "evidence"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "build_unit_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "reason": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "knownOrUnknown": {"type": ["string", "null"], "minLength": 1},
    "variant": {
      "type": "object", "additionalProperties": false,
      "description": "Null is unknown, never a wildcard or proof of compatible ABI/configuration.",
      "required": ["configuration", "target_arch", "execution_role", "linkage", "toolchain", "abi"],
      "properties": {
        "configuration": {"$ref": "#/$defs/knownOrUnknown"},
        "target_arch": {"$ref": "#/$defs/knownOrUnknown"},
        "execution_role": {"enum": ["host", "target", null]},
        "linkage": {"$ref": "#/$defs/knownOrUnknown"},
        "toolchain": {"$ref": "#/$defs/knownOrUnknown"},
        "abi": {"$ref": "#/$defs/knownOrUnknown"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "relationship", "line", "declaration"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "relationship": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "declaration": {"type": ["string", "null"]}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}},
    "product": {
      "type": "object", "additionalProperties": false,
      "description": "An expected interface, not proof that an output exists. Readiness separately verifies durable producer path/hash records.",
      "required": ["product_id", "kind", "interface", "variant"],
      "properties": {
        "product_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["library", "executable", "headers", "package_metadata", "generated_source"]},
        "interface": {"type": "string", "minLength": 1},
        "variant": {"$ref": "#/$defs/variant"}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["build_unit_id", "root", "family", "build_system", "disposition", "owner_build_unit_id", "variant", "products", "recipe_revision", "evidence"],
      "properties": {
        "build_unit_id": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "build_system": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["independent", "contained", "unsupported", "unresolved"]},
        "owner_build_unit_id": {"type": ["string", "null"], "minLength": 1},
        "variant": {"$ref": "#/$defs/variant"},
        "products": {"type": "array", "items": {"$ref": "#/$defs/product"}, "uniqueItems": true},
        "recipe_revision": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_build_unit_id", "consumer_build_unit_id", "kind", "requirement", "evidence"],
      "properties": {
        "producer_build_unit_id": {"type": "string", "minLength": 1},
        "consumer_build_unit_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["requires_product", "requires_generated_source", "requires_host_tool", "order_only"]},
        "requirement": {"anyOf": [{"$ref": "#/$defs/product"}, {"type": "null"}]},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "if": {"properties": {"kind": {"const": "order_only"}}},
      "then": {"properties": {"requirement": {"type": "null"}}},
      "else": {"properties": {"requirement": {"$ref": "#/$defs/product"}}}
    }
  }
}
