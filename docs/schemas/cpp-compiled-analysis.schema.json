{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/cpp-compiled-analysis.schema.json",
  "title": "Accepted C/C++ compiled-analysis summary",
  "type": "object",
  "required": ["schema", "project_count", "branch_count", "physical_shard_count", "gaps", "dispositions"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "appsec-review/cpp-compiled-analysis/2"},
    "project_count": {"type": "integer", "minimum": 0},
    "branch_count": {"const": 5, "description": "len(BRANCHES): compiled, ast, ir, infer, binary"},
    "physical_shard_count": {"type": "integer", "minimum": 0},
    "gaps": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
    "dispositions": {
      "type": "object",
      "description": "Per-project branch status keyed '<case-id>:<branch>'; a blocked or failed upstream case is recorded as COMPLETED_WITH_GAPS with its gap.",
      "propertyNames": {"pattern": ":(compiled|ast|ir|infer|binary)$"},
      "additionalProperties": {"enum": ["SUCCEEDED", "COMPLETED_WITH_GAPS"]}
    }
  }
}
