{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/review-input-package.schema.json",
  "title": "Bounded review input package",
  "description": "Pre-adjudication finding-lead or hunt context; scanner severity is reported priority, not technical finding severity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "package_id", "kind", "run_id", "manifest_sha256",
    "target_snapshot_sha256", "producer", "scope", "lead_menu",
    "metrics", "context_refs", "build_context", "evidence_refs",
    "proof_obligations", "retrieval_scope", "coverage", "truncation"
  ],
  "properties": {
    "schema": {"const": "appsec-review/review-input-package/1"},
    "package_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["finding_lead", "hunt"]},
    "run_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "target_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "rule_version", "input_fingerprint"],
      "properties": {
        "job_id": {"type": "string"},
        "rule_version": {"type": "string"},
        "input_fingerprint": {"type": "string"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "partition_key"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "trust_boundary_id": {"type": ["string", "null"]},
        "partition_key": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "artifact_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "lead_menu": {"type": "array", "items": {"$ref": "#/$defs/lead"}},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "context_refs": {"type": "array", "items": {"$ref": "#/$defs/context"}},
    "build_context": {
      "type": "object", "additionalProperties": false,
      "required": ["action_ids", "artifact_ids", "command_facts", "environment_facts"],
      "properties": {
        "action_ids": {"type": "array", "items": {"type": "string"}},
        "artifact_ids": {"type": "array", "items": {"type": "string"}},
        "command_facts": {"type": "array", "items": {"$ref": "#/$defs/command"}},
        "environment_facts": {"type": "array", "items": {"$ref": "#/$defs/environment"}}
      }
    },
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "proof_obligations": {"type": "array", "items": {"type": "string"}},
    "retrieval_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_ids", "query_sets", "max_records"],
      "properties": {
        "entity_ids": {"type": "array", "items": {"type": "string"}},
        "query_sets": {"type": "array", "items": {"type": "string"}},
        "max_records": {"type": "integer", "minimum": 1}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "gaps"],
      "properties": {
        "status": {"enum": ["complete", "partial", "unavailable"]},
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
      }
    },
    "truncation": {
      "type": "object", "additionalProperties": false,
      "required": ["truncated", "omitted_leads", "omitted_context"],
      "properties": {
        "truncated": {"type": "boolean"},
        "omitted_leads": {"type": "integer", "minimum": 0},
        "omitted_context": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"},
        "next_partition": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "finding_lead"}}},
      "then": {"properties": {"lead_menu": {"minItems": 1, "maxItems": 1}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(sha256:)?[a-fA-F0-9]{64}$"},
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["exact", "mapping_method"],
      "properties": {
        "source_id": {"type": "string"},
        "artifact_id": {"type": "string"},
        "path": {"type": "string"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "exact": {"type": "boolean"},
        "mapping_method": {"type": "string"},
        "ambiguity": {"type": "string"}
      }
    },
    "lead": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "scanner", "rule_id", "category", "native_severity", "normalized_reported_severity", "severity_rule", "suppressed", "flow_ids", "location"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "scanner": {"type": "string"},
        "rule_id": {"type": "string"},
        "category": {"type": "string"},
        "native_severity": {"type": "string"},
        "normalized_reported_severity": {"enum": ["critical", "high", "medium", "low", "info", "unknown"]},
        "severity_rule": {"type": "string"},
        "suppressed": {"type": "boolean"},
        "duplicate_of": {"type": ["string", "null"]},
        "flow_ids": {"type": "array", "items": {"type": "string"}},
        "location": {"$ref": "#/$defs/location"}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "scope_id", "status", "producer", "algorithm_version"],
      "properties": {
        "name": {"type": "string"},
        "scope_id": {"type": "string"},
        "value": {"type": ["number", "string", "null"]},
        "status": {"enum": ["available", "partial", "unavailable"]},
        "producer": {"type": "string"},
        "algorithm_version": {"type": "string"},
        "window_days": {"type": "integer", "minimum": 0},
        "language": {"type": "string"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "gap_id": {"type": "string"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "entity_id", "producer", "coverage"],
      "properties": {
        "kind": {"type": "string"},
        "entity_id": {"type": "string"},
        "producer": {"type": "string"},
        "coverage": {"enum": ["complete", "partial", "unavailable"]},
        "location": {"$ref": "#/$defs/location"},
        "ordered_step": {"type": "integer", "minimum": 0}
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["build_action_id", "tool_id", "ordered_tokens", "exact_artifact_sha256", "normalization_rule"],
      "properties": {
        "build_action_id": {"type": "string"},
        "tool_id": {"type": "string"},
        "ordered_tokens": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["ordinal", "kind", "redacted"],
            "properties": {
              "ordinal": {"type": "integer", "minimum": 0},
              "kind": {"type": "string"},
              "safe_value": {"type": "string"},
              "redacted": {"type": "boolean"}
            }
          }
        },
        "exact_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_rule": {"type": "string"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "class", "present", "redacted"],
      "properties": {
        "name": {"type": "string"},
        "class": {"type": "string"},
        "present": {"type": "boolean"},
        "safe_value": {"type": "string"},
        "redacted": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "relation", "producer"],
      "properties": {
        "entity_id": {"type": "string"},
        "relation": {"enum": ["supports", "contradicts", "qualifies", "nominates"]},
        "producer": {"type": "string"}
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "producer", "scope_id", "reason"],
      "properties": {
        "gap_id": {"type": "string"},
        "producer": {"type": "string"},
        "scope_id": {"type": "string"},
        "reason": {"type": "string"}
      }
    }
  }
}
