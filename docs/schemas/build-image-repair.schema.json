{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "appsec-review/build-image-repair/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "system_packages", "environment", "package_manager", "dependency_restores", "reason"],
  "properties": {
    "schema": {"const": "appsec-review/build-image-repair/2"},
    "system_packages": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9+.-]*(?::[a-z0-9][a-z0-9-]*)?(?:=[A-Za-z0-9.+:~_-]+)?$"
      }
    },
    "environment": {
      "description": "Complete repair environment. Names and value patterns are the per-family allowlist REPAIR_ENVIRONMENT in src/appsec_review/jobs/job_project_build/repair.py.",
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9._=,:+/ -]{1,512}$"}
    },
    "package_manager": {
      "description": "null, or a package manager the family build image already pins (PINNED_PACKAGE_MANAGERS in src/appsec_review/container_runtime/project_images.py).",
      "type": ["string", "null"],
      "maxLength": 32
    },
    "dependency_restores": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest"],
        "properties": {"manifest": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
