{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/threat-model/generated-dfd.schema.json",
  "title": "Generated data-flow diagram",
  "$comment": "Closed schema of a document job_threat_model_generation publishes (design: docs/architecture/dfd-and-threat-model-generation.md, section 6). The record shapes are the dataclasses of src/appsec_review/threat_model/contract.py; tests/test_threat_model_schemas.py fails when they drift. Arrays are sorted by id in the canonical bytes, which a schema cannot express. Every element, flow and boundary cites at least one evidence reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "origin",
    "elements",
    "flows",
    "boundaries",
    "unknowns"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/generated-dfd/1"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Element"
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Flow"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Boundary"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Unknown"
      }
    }
  },
  "$defs": {
    "id": {
      "description": "contract.element_id: <prefix>:<first 16 hex of the SHA-256 of the canonical native identity>.",
      "type": "string",
      "pattern": "^[a-z]+:[0-9a-f]{16}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "pattern": "\\u0000"
      }
    },
    "Basis": {
      "description": "contract.Basis (closed vocabulary).",
      "enum": [
        "verified_semantic",
        "declared",
        "observed_syntax",
        "derived"
      ]
    },
    "ElementKind": {
      "description": "contract.ElementKind (closed vocabulary).",
      "enum": [
        "process",
        "data_store",
        "external_entity"
      ]
    },
    "NameBasis": {
      "description": "contract.NameBasis (closed vocabulary).",
      "enum": [
        "artifact_name",
        "declared_name",
        "derived",
        "model_label"
      ]
    },
    "Interaction": {
      "description": "contract.Interaction (closed vocabulary).",
      "enum": [
        "network_listen",
        "network_receive",
        "network_connect",
        "file_read",
        "file_write",
        "datastore_query",
        "code_load",
        "process_spawn",
        "environment_read",
        "argument_read",
        "local_ipc",
        "privilege_change"
      ]
    },
    "BoundaryKind": {
      "description": "contract.BoundaryKind (closed vocabulary).",
      "enum": [
        "network",
        "file_content",
        "local_user",
        "launch_environment",
        "process",
        "deployment_exposure",
        "privilege",
        "loaded_code"
      ]
    },
    "UnknownKind": {
      "description": "contract.UnknownKind (closed vocabulary).",
      "enum": [
        "runtime_role_unknown",
        "peer_unidentified",
        "flow_endpoint_unresolved",
        "protocol_unknown",
        "datastore_unidentified",
        "boundary_not_established",
        "deployment_not_described",
        "authentication_not_located",
        "asset_sensitivity_unknown",
        "uncited_model_inference",
        "evidence_request_unserved",
        "no_element_established"
      ]
    },
    "Origin": {
      "description": "contract.Origin: a generated model is never target-supplied and never more than routing context.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "attempt_id",
        "target_snapshot",
        "reference_data",
        "model",
        "kind",
        "target_supplied",
        "producer",
        "authority"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/text"
        },
        "attempt_id": {
          "$ref": "#/$defs/text"
        },
        "target_snapshot": {
          "$ref": "#/$defs/text"
        },
        "reference_data": {
          "description": "SHA-256 of each reference data file the attempt read.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interaction_catalog_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "threat_templates_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "crosswalk_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "model": {
          "description": "null, or the model identity when elaboration ran.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "guidance_bundle_sha256"
          ],
          "properties": {
            "provider": {
              "$ref": "#/$defs/text"
            },
            "model": {
              "$ref": "#/$defs/text"
            },
            "guidance_bundle_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "kind": {
          "const": "generated"
        },
        "target_supplied": {
          "const": false
        },
        "producer": {
          "const": "job_threat_model_generation"
        },
        "authority": {
          "const": "routing_context"
        }
      }
    },
    "Publication": {
      "description": "contract.Publication: the accepted shard or artifact a record was read from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job",
        "output_kind",
        "index",
        "shard_id",
        "sha256"
      ],
      "properties": {
        "job": {
          "$ref": "#/$defs/text"
        },
        "output_kind": {
          "$ref": "#/$defs/text"
        },
        "index": {
          "type": [
            "string",
            "null"
          ]
        },
        "shard_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "EvidenceRef": {
      "description": "contract.EvidenceRef: one citation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "kind",
        "entity_id",
        "entity_kind",
        "publication",
        "locator",
        "content_sha256",
        "basis",
        "rule"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "index_entity",
            "run_artifact"
          ]
        },
        "entity_id": {
          "type": "string"
        },
        "entity_kind": {
          "type": "string"
        },
        "publication": {
          "$ref": "#/$defs/Publication"
        },
        "locator": {
          "description": "path:start-end#bstart-end@file_sha256, or null when the record has no source span.",
          "type": [
            "string",
            "null"
          ]
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "rule": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "Unknown": {
      "description": "contract.Unknown: a statement about the model, not about an input.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "subject_ids",
        "statement",
        "would_resolve"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/UnknownKind"
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "would_resolve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Element": {
      "description": "contract.Element",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "name_basis",
        "basis",
        "evidence",
        "attributes",
        "component_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/ElementKind"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "name_basis": {
          "$ref": "#/$defs/NameBasis"
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "description": "At least one evidence reference: a record without evidence cannot be published."
        },
        "attributes": {
          "description": "Open object by design: element attributes depend on the element kind and the lane that established it.",
          "type": "object",
          "additionalProperties": true
        },
        "component_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Flow": {
      "description": "contract.Flow",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "interaction",
        "basis",
        "evidence",
        "crosses",
        "data",
        "attributes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "interaction": {
          "$ref": "#/$defs/Interaction"
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "description": "At least one evidence reference: a record without evidence cannot be published."
        },
        "crosses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "data": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "description": "Open object by design: flow attributes depend on the interaction and the lane that established it.",
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Boundary": {
      "description": "contract.Boundary",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "inside",
        "basis",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/BoundaryKind"
        },
        "inside": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "description": "At least one evidence reference: a record without evidence cannot be published."
        }
      }
    }
  }
}
