      <bpmndi:BPMNShape id="Shape_ChainRefute" bpmnElement="Task_ChainRefute"><dc:Bounds x="2440" y="590" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ChainMerge" bpmnElement="Gateway_ChainMerge" isMarkerVisible="true"><dc:Bounds x="2640" y="605" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReportJoin" bpmnElement="Gateway_ReportJoin"><dc:Bounds x="2730" y="805" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Codeql" bpmnElement="Note_Codeql"><dc:Bounds x="400" y="885" width="440" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Chains" bpmnElement="Note_Chains"><dc:Bounds x="2150" y="885" width="440" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CveReach" bpmnElement="Task_CveReach"><dc:Bounds x="430" y="280" width="200" height="65"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PocFix" bpmnElement="Task_PocFix"><dc:Bounds x="2330" y="410" width="190" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Cve" bpmnElement="Note_Cve"><dc:Bounds x="20" y="975" width="520" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Poc" bpmnElement="Note_Poc"><dc:Bounds x="2640" y="975" width="440" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start_Run"><dc:Bounds x="60" y="132" width="36" height="36"/></bpmndi:BPMNShape>
