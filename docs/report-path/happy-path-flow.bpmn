      <bpmndi:BPMNEdge id="Edge_Assoc_Adapters" bpmnElement="Assoc_Adapters"><di:waypoint x="1860" y="885"/><di:waypoint x="1900" y="490"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Assoc_Final" bpmnElement="Assoc_Final"><di:waypoint x="3280" y="885"/><di:waypoint x="3340" y="850"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Codeql" bpmnElement="Flow_Codeql"><di:waypoint x="210" y="280"/><di:waypoint x="210" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_08B" bpmnElement="Flow_08B"><di:waypoint x="2080" y="450"/><di:waypoint x="2120" y="450"/></bpmndi:BPMNEdge>
