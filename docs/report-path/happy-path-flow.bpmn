      <bpmndi:BPMNShape id="Shape_EvidenceSplit" bpmnElement="Gateway_EvidenceSplit"><dc:Bounds x="330" y="125" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ThreatInitial" bpmnElement="Task_ThreatInitial"><dc:Bounds x="430" y="35" width="170" height="65"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ThreatReconcile" bpmnElement="Task_ThreatReconcile"><dc:Bounds x="650" y="35" width="180" height="65"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Owasp" bpmnElement="Task_Owasp"><dc:Bounds x="540" y="117" width="180" height="65"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Stig" bpmnElement="Task_Stig"><dc:Bounds x="430" y="200" width="170" height="65"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Deployment" bpmnElement="Task_Deployment"><dc:Bounds x="650" y="200" width="180" height="65"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EvidenceJoin" bpmnElement="Gateway_EvidenceJoin"><dc:Bounds x="880" y="125" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Admission" bpmnElement="Task_Admission"><dc:Bounds x="980" y="410" width="190" height="80"/></bpmndi:BPMNShape>
