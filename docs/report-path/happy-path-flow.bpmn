      <bpmndi:BPMNShape id="Shape_End" bpmnElement="End_Draft"><dc:Bounds x="3500" y="792" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Standalone" bpmnElement="Note_Standalone"><dc:Bounds x="1040" y="885" width="400" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Adapters" bpmnElement="Note_Adapters"><dc:Bounds x="1650" y="885" width="420" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Note_Final" bpmnElement="Note_Final"><dc:Bounds x="3060" y="885" width="440" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_01" bpmnElement="Flow_01"><di:waypoint x="78" y="168"/><di:waypoint x="78" y="312"/><di:waypoint x="130" y="312"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_02A" bpmnElement="Flow_02A"><di:waypoint x="290" y="150"/><di:waypoint x="330" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_02B" bpmnElement="Flow_02B"><di:waypoint x="380" y="150"/><di:waypoint x="540" y="150"/></bpmndi:BPMNEdge>
