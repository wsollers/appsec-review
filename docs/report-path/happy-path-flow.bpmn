      <bpmndi:BPMNEdge id="Edge_ThreatA" bpmnElement="Flow_ThreatA"><di:waypoint x="355" y="125"/><di:waypoint x="355" y="67"/><di:waypoint x="430" y="67"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ThreatB" bpmnElement="Flow_ThreatB"><di:waypoint x="600" y="67"/><di:waypoint x="650" y="67"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_03A" bpmnElement="Flow_03A"><di:waypoint x="830" y="67"/><di:waypoint x="905" y="125"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_03B" bpmnElement="Flow_03B"><di:waypoint x="720" y="150"/><di:waypoint x="880" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_StigDeploy" bpmnElement="Flow_StigDeploy"><di:waypoint x="600" y="232"/><di:waypoint x="650" y="232"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_03C" bpmnElement="Flow_03C"><di:waypoint x="830" y="232"/><di:waypoint x="905" y="175"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_03" bpmnElement="Flow_03"><di:waypoint x="930" y="150"/><di:waypoint x="950" y="150"/><di:waypoint x="950" y="450"/><di:waypoint x="980" y="450"/></bpmndi:BPMNEdge>
