      <bpmndi:BPMNEdge id="Edge_07" bpmnElement="Flow_07"><di:waypoint x="1770" y="450"/><di:waypoint x="1810" y="450"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_08" bpmnElement="Flow_08"><di:waypoint x="1990" y="450"/><di:waypoint x="2030" y="450"/></bpmndi:BPMNEdge>
