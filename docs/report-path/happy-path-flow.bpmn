<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ReportHappyPath" targetNamespace="https://example.invalid/appsec-review/report-path">
  <bpmn:process id="Process_ReportHappyPath" name="Evidence-backed draft report happy path" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ReportPath">
      <bpmn:lane id="Lane_Evidence" name="Accepted evidence trust boundary">
        <bpmn:flowNodeRef>Start_Run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CodeqlSast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EvidenceSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Component</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThreatInitial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThreatReconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Owasp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CveReach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deployment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EvidenceJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Claims" name="Append-only claim and decision boundary">
        <bpmn:flowNodeRef>Task_Admission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Red</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Blue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Append</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ChainSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PocFix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chains" name="Attack-chain candidates (lane 14, ADR-0016)">
        <bpmn:flowNodeRef>Task_ChainCompose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ChainSeeds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChainRefute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ChainMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Publication" name="Draft publication trust boundary">
        <bpmn:flowNodeRef>Gateway_ReportJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportInput</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Synthesis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Draft</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Run" name="Exact run generation ready"/>
    <bpmn:parallelGateway id="Gateway_EvidenceSplit" name="Run independent evidence branches"/>
    <bpmn:task id="Task_CodeqlSast" name="02-codeql-sast: CodeQL per language (build-mode none); leads to evidence assembly and claim ledger"/>
    <bpmn:task id="Task_Component" name="Validate accepted F03 component map"/>
    <bpmn:task id="Task_ThreatInitial" name="L6A deterministic DFD/STRIDE core plus threat workbench persona cells (waves 1-2)"/>
    <bpmn:task id="Task_ThreatReconcile" name="L6B reconcile threat model, conflicts and coverage"/>
    <bpmn:task id="Task_Owasp" name="Run OWASP worklist and publish ASVS/MASVS matrix"/>
    <bpmn:task id="Task_CveReach" name="06-cve-reachability: dependency reachability per SCA match (CPG, CodeQL, LSP engines)"/>
    <bpmn:task id="Task_Stig" name="Run separate STIG/SRG validation worklist"/>
    <bpmn:task id="Task_Deployment" name="Assess deployment hardening from accepted worklist"/>
    <bpmn:parallelGateway id="Gateway_EvidenceJoin" name="Wait for exact accepted sources"/>
    <bpmn:task id="Task_Admission" name="L01 admit threat, control, tool-lead and hunter candidates; record origin head"/>
    <bpmn:task id="Task_Red" name="07 record adversarial hypotheses"/>
    <bpmn:task id="Task_Blue" name="08 refute or narrow each hypothesis"/>
    <bpmn:task id="Task_Verify" name="09 independently verify, refute or block"/>
    <bpmn:task id="Task_Append" name="L01 append exact accepted decisions; record current head"/>
    <bpmn:task id="Task_Score" name="12 score independently verified claims only"/>
    <bpmn:task id="Task_PocFix" name="12b-poc-and-fix: light PoC and proposed fix for verified, CRITICAL, REACHABLE findings"/>
    <bpmn:parallelGateway id="Gateway_ChainSplit" name="Score and compose chains in parallel"/>
    <bpmn:task id="Task_ChainCompose" name="14-attack-chain-composition: seed from 09 claims, entry points and threat-model actors; composer pool; derive chains"/>
    <bpmn:exclusiveGateway id="Gateway_ChainSeeds" name="Any chain seeds?"/>
    <bpmn:task id="Task_ChainRefute" name="14-attack-chain-refutation: refuter pool; publish attack-chain ledger"/>
    <bpmn:exclusiveGateway id="Gateway_ChainMerge"/>
    <bpmn:parallelGateway id="Gateway_ReportJoin" name="Wait for 12, 12b and lane 14 (12b and 14 optional)"/>
    <bpmn:task id="Task_ReportInput" name="Revalidate exact accepted synthesis inputs"/>
    <bpmn:task id="Task_Synthesis" name="10 publish hash-bound evidence-backed draft"/>
    <bpmn:task id="Task_Draft" name="Hash immutable DRAFT_EVIDENCE_BACKED package"/>
    <bpmn:endEvent id="End_Draft" name="Draft ready for human review; not final"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Run" targetRef="Task_CodeqlSast"/>
    <bpmn:sequenceFlow id="Flow_Codeql" sourceRef="Task_CodeqlSast" targetRef="Task_Component"/>
    <bpmn:sequenceFlow id="Flow_02A" sourceRef="Task_Component" targetRef="Gateway_EvidenceSplit"/>
    <bpmn:sequenceFlow id="Flow_02B" sourceRef="Gateway_EvidenceSplit" targetRef="Task_Owasp"/>
    <bpmn:sequenceFlow id="Flow_02C" sourceRef="Gateway_EvidenceSplit" targetRef="Task_Stig"/>
    <bpmn:sequenceFlow id="Flow_ThreatA" sourceRef="Gateway_EvidenceSplit" targetRef="Task_ThreatInitial"/>
    <bpmn:sequenceFlow id="Flow_ThreatB" sourceRef="Task_ThreatInitial" targetRef="Task_ThreatReconcile"/>
    <bpmn:sequenceFlow id="Flow_03A" sourceRef="Task_ThreatReconcile" targetRef="Gateway_EvidenceJoin"/>
    <bpmn:sequenceFlow id="Flow_03B" sourceRef="Task_Owasp" targetRef="Gateway_EvidenceJoin"/>
    <bpmn:sequenceFlow id="Flow_CveA" sourceRef="Gateway_EvidenceSplit" targetRef="Task_CveReach"/>
    <bpmn:sequenceFlow id="Flow_CveB" sourceRef="Task_CveReach" targetRef="Gateway_EvidenceJoin"/>
    <bpmn:sequenceFlow id="Flow_StigDeploy" sourceRef="Task_Stig" targetRef="Task_Deployment"/>
    <bpmn:sequenceFlow id="Flow_03C" sourceRef="Task_Deployment" targetRef="Gateway_EvidenceJoin"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_EvidenceJoin" targetRef="Task_Admission"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Admission" targetRef="Task_Red"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Red" targetRef="Task_Blue"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Blue" targetRef="Task_Verify"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Verify" targetRef="Task_Append"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Append" targetRef="Gateway_ChainSplit"/>
    <bpmn:sequenceFlow id="Flow_08B" sourceRef="Gateway_ChainSplit" targetRef="Task_Score"/>
    <bpmn:sequenceFlow id="Flow_Chain1" sourceRef="Gateway_ChainSplit" targetRef="Task_ChainCompose"/>
    <bpmn:sequenceFlow id="Flow_Chain2" sourceRef="Task_ChainCompose" targetRef="Gateway_ChainSeeds"/>
    <bpmn:sequenceFlow id="Flow_Chain3" name="chains composed" sourceRef="Gateway_ChainSeeds" targetRef="Task_ChainRefute"/>
    <bpmn:sequenceFlow id="Flow_Chain4" name="no chain seeds: SKIPPED" sourceRef="Gateway_ChainSeeds" targetRef="Gateway_ChainMerge"/>
    <bpmn:sequenceFlow id="Flow_Chain5" sourceRef="Task_ChainRefute" targetRef="Gateway_ChainMerge"/>
    <bpmn:sequenceFlow id="Flow_Chain6" sourceRef="Gateway_ChainMerge" targetRef="Gateway_ReportJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Score" targetRef="Task_PocFix"/>
    <bpmn:sequenceFlow id="Flow_Poc" sourceRef="Task_PocFix" targetRef="Gateway_ReportJoin"/>
    <bpmn:sequenceFlow id="Flow_09B" sourceRef="Gateway_ReportJoin" targetRef="Task_ReportInput"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReportInput" targetRef="Task_Synthesis"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Synthesis" targetRef="Task_Draft"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Draft" targetRef="End_Draft"/>
    <bpmn:textAnnotation id="Note_Standalone"><bpmn:text>L6A and L6B are executable and qualified. OWASP T03-T14 is qualified. OWASP, STIG/SRG and deployment hardening remain distinct processes.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Adapters"><bpmn:text>Component-derived full-review inputs are revalidated and first-wave requests dispatch automatically. SKIPPED_NA is explicit; reinvoke after SBOM, licence and SCA prerequisites for later dependency waves. Automatic OWASP dispatch-fact derivation remains open.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Final"><bpmn:text>The package is DRAFT_EVIDENCE_BACKED only. One real accepted end-to-end run and human final authorization are still required.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Codeql"><bpmn:text>ADR-0017. Go and any language without a registered image are per-language gaps (OK_WITH_GAPS). Traced C/C++ (codeql-cpp-traced) exists in code but is not wired into full_review. Not live-qualified.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Chains"><bpmn:text>Chains are candidates, never findings. 10 reads the refuted ledger as an optional input and states SKIPPED or ABSENT with a reason. Unit-tested only; nothing has run live.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Cve"><bpmn:text>ADR-0022. Model text never decides reachability; unreachable only from a complete CPG search; everything else unknown with a gap. Critical requires REACHABLE (ADR-0020).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Poc"><bpmn:text>Optional input of 10: SKIPPED not-applicable-no-eligible-findings when nothing qualifies; a failed pool never holds the report. Unit-tested only.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Cve" sourceRef="Note_Cve" targetRef="Task_CveReach"/>
    <bpmn:association id="Assoc_Poc" sourceRef="Note_Poc" targetRef="Task_PocFix"/>
    <bpmn:association id="Assoc_Codeql" sourceRef="Note_Codeql" targetRef="Task_CodeqlSast"/>
    <bpmn:association id="Assoc_Chains" sourceRef="Note_Chains" targetRef="Task_ChainRefute"/>
    <bpmn:association id="Assoc_Standalone" sourceRef="Note_Standalone" targetRef="Task_Red"/>
    <bpmn:association id="Assoc_Adapters" sourceRef="Note_Adapters" targetRef="Task_Append"/>
    <bpmn:association id="Assoc_Final" sourceRef="Note_Final" targetRef="Task_Draft"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ReportHappyPath">
    <bpmndi:BPMNPlane id="Plane_ReportHappyPath" bpmnElement="Process_ReportHappyPath">
      <bpmndi:BPMNShape id="Shape_Lane_Evidence" bpmnElement="Lane_Evidence" isHorizontal="true"><dc:Bounds x="20" y="20" width="3600" height="340"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Claims" bpmnElement="Lane_Claims" isHorizontal="true"><dc:Bounds x="20" y="360" width="3600" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Publication" bpmnElement="Lane_Publication" isHorizontal="true"><dc:Bounds x="20" y="720" width="3600" height="330"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Chains" bpmnElement="Lane_Chains" isHorizontal="true"><dc:Bounds x="20" y="540" width="3600" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CodeqlSast" bpmnElement="Task_CodeqlSast"><dc:Bounds x="130" y="280" width="200" height="65"/></bpmndi:BPMNShape>
