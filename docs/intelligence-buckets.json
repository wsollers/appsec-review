{
  "buckets": {
    "artifacts_and_binary": {
      "definition": "Produced or supplied artifacts, archive members and binary-derived representations retain byte identities distinct from source evidence."
    },
    "build_and_deployment": {
      "definition": "Build plans, environments, actions, workspaces and deployment-related checks describe how artifacts are prepared and configured."
    },
    "dataflow": {
      "definition": "Graph, alias and flow representations describe possible propagation and reachability while retaining each producer's precision and coverage limits."
    },
    "dependencies_and_advisories": {
      "definition": "Package identities, advisory feeds, SBOMs and dependency provenance support bounded supply-chain reasoning."
    },
    "documents_and_retrieval": {
      "definition": "Target documents and shared retrieval inventories, links and derived products organize accepted evidence without changing its authority."
    },
    "history": {
      "definition": "Version-control, change-log, review and deployment-history signals describe past changes without proving present behavior."
    },
    "metrics": {
      "definition": "Operational health, coverage, profile and accounting measurements describe observed process state rather than security conclusions."
    },
    "review_products": {
      "definition": "Review routing context, hypotheses, decisions, findings, developer artifacts and reports retain their original assurance and evidence-authority distinctions."
    },
    "scanner_observations": {
      "definition": "Scanner observations and their raw, coverage and summary artifacts retain tool judgments before review adjudication."
    },
    "source_snapshot": {
      "definition": "Acquisition identities, accepted source bytes and component catalogs establish what repository snapshot is in scope."
    },
    "symbols_and_calls": {
      "definition": "Declarations, symbols, layouts and directly resolved calls describe named program entities and their relationships."
    },
    "syntax": {
      "definition": "Concrete or compiler syntax trees and their bounded source backing describe program structure without claiming semantic flow."
    }
  },
