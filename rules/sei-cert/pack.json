    "rules/c/err34-c.yml",
    "rules/c/fio30-c.yml",
    "rules/c/msc30-c.yml",
    "rules/c/pos34-c.yml",
    "rules/c/pos36-c.yml",
    "rules/c/pos37-c.yml",
    "rules/c/pos44-c.yml",
    "rules/c/pos47-c.yml",
    "rules/c/str31-c.yml",
