    "rules/cpp/mem51-cpp.yml",
    "rules/cpp/mem56-cpp.yml",
    "rules/cpp/msc50-cpp.yml",
    "rules/cpp/msc51-cpp.yml",
    "rules/cpp/str51-cpp.yml",
