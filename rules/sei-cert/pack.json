  "engines": {
    "semgrep": {
      "distribution": "Semgrep Community Edition (PyPI semgrep)",
      "version": "1.178.0",
      "license": "LGPL-2.1-or-later",
      "catalog_tool": "tool-semgrep"
    },
    "opengrep": {
      "distribution": "OpenGrep release binary opengrep_manylinux_x86",
      "version": "1.30.2",
      "license": "LGPL-2.1",
      "artifact_url": "https://github.com/opengrep/opengrep/releases/download/v1.30.2/opengrep_manylinux_x86",
      "artifact_sha256": "a66aa3278457f02b287b985a45b6762aebcaba5000f2689245fd1ed86d1456c7",
      "catalog_tool": "tool-opengrep"
    }
  },
  "portable_syntax": {
    "rule_keys": [
      "id",
      "languages",
      "severity",
      "message",
      "metadata",
      "mode",
      "pattern",
      "patterns",
      "pattern-either",
      "pattern-regex",
      "pattern-sources",
      "pattern-sinks",
      "pattern-sanitizers"
    ],
    "operators": [
      "pattern",
      "patterns",
      "pattern-either",
      "pattern-inside",
      "pattern-not",
      "pattern-not-inside",
      "pattern-regex",
      "pattern-not-regex",
      "metavariable-regex",
      "metavariable-pattern",
      "focus-metavariable"
    ],
    "modes": [
      "search",
      "taint"
    ],
    "forbidden_keys": [
      "fix",
      "fix-regex",
      "join",
      "extract",
      "options",
      "paths",
      "interfile",
      "min-version",
      "max-version",
      "product",
      "r2c-internal-project-depends-on"
    ]
  },
  "severity_values": [
    "ERROR",
    "WARNING",
    "INFO"
  ],
  "confidence_values": [
    "HIGH",
    "MEDIUM",
    "LOW"
  ],
  "precision_values": [
    "high",
    "medium",
    "low"
  ],
  "statuses": [
    "SUPPORTED",
    "PARTIAL",
    "UNSUPPORTED_SEMANTIC",
    "UNSUPPORTED_LANGUAGE",
    "DUPLICATE_EXISTING_RULE",
    "REQUIRES_DATAFLOW",
    "REQUIRES_COMPILER_OR_IR",
    "REQUIRES_CODEQL",
    "REQUIRES_MANUAL_REVIEW"
  ],
  "global_limitations": [
    "Neither engine preprocesses C or C++: code produced by macro expansion, conditional compilation, or generators is not analyzed as expanded.",
    "Analysis is per file and, except for the IDS07-J taint rule, per function; no rule follows values across functions or translation units.",
    "Calls through function pointers, method references, or reflection are not resolved.",
    "Files or regions the engine cannot parse are reported as engine errors or warnings and are coverage gaps, not clean results.",
    "A finding is a rule-pack observation tied to a CERT rule; it is not an accepted vulnerability, and an absence of findings is not evidence of CERT conformance."
  ]
}
