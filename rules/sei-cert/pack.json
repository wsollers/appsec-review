        "cpp"
      ]
    },
    "java": {
      "mapping": "mappings/java.json",
      "engine_languages": [
        "java"
      ]
    },
    "android": {
      "mapping": "mappings/android.json",
      "engine_languages": []
    }
  },
  "source_index": "sources/cert-source-index.json",
  "multivuln": "multivuln.json",
  "rule_files": [
