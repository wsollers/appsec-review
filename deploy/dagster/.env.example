DAGSTER_POSTGRES_PASSWORD=replace-with-a-generated-secret
# Linux and WSL only; bootstrap.py records the invoking operator automatically.
APPSEC_UID=0
APPSEC_GID=0
# Optional; defaults to /opt/app/targets/appsec-multi-vuln inside the deployment.
APPSEC_REVIEW_TARGET=/opt/app/targets/appsec-multi-vuln
# Optional profile: dev (default), prod (larger models/limits), copilot-prod (production via Copilot), or copilot-dev (Haiku through the
# dedicated Copilot login). See docs/operations/model-profiles.md.
# APPSEC_REVIEW_PROFILE=dev
# Linux and WSL overlay only; bootstrap.py records them when Claude is installed and signed in.
# Native Windows uses the pinned Linux Claude CLI in the container and a persistent named home volume.
APPSEC_CLAUDE_BINARY=/home/operator/.local/share/claude/versions/current
APPSEC_CLAUDE_CONFIG_DIR=/home/operator/.claude
APPSEC_CLAUDE_STATE_FILE=/home/operator/.claude.json
# Copilot profiles only; bootstrap records the dedicated worker login directory when present.
# Never use a GitHub CLI configuration directory or store tokens here.
# APPSEC_COPILOT_CONFIG_DIR=/home/operator/.config/appsec-review/copilot
# Optional; passed only to the code location for models configured with provider = "anthropic-api".
# ANTHROPIC_API_KEY=
