# Keep portable source and shell scripts LF, regardless of core.autocrlf.
* text=auto eol=lf
*.sh text eol=lf

# Only Windows command-processor scripts need CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# These are byte-pinned inputs, not text to normalize. Preserve the committed
# bytes (including upstream CRLF and mixed endings) on every platform.
rules/** -text
data/** -text
tests/fixtures/** -text
test/acceptance/** -text

# CodeQL packs are hashed over their LF bytes and compiled inside Linux containers.
rules/codeql-graph-export/** text eol=lf
# The asset lock is pinned by its exact bytes (asset_lock_sha256 in appsec-review.toml).
containers/tools/codeql/assets.lock.json text eol=lf
# Official SPDX resources are hash-pinned and must retain their upstream bytes.
src/appsec_review/jobs/job_dependency_intelligence/schemas/spdx-2.3.schema.json -text
src/appsec_review/jobs/job_dependency_intelligence/schemas/SPDX-LICENSE.txt -text
