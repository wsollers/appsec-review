*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
*.ps1 text eol=crlf
# Content-addressed reference snapshots must retain their exact bytes on every
# platform. Raw upstream material is intentionally opaque to Git's text diff,
# including upstream whitespace that would otherwise trip `git diff --check`.
data/reference/owasp/** -text
data/reference/opencre/** -text
data/reference/owasp/**/raw/** -diff
data/reference/opencre/**/raw/** -diff
data/reference/owasp/**/LICENSE-or-usage.txt -diff
data/reference/opencre/**/LICENSE-or-usage.txt -diff
# Redaction test templates: the suite normalizes their newlines when loading them, and this keeps
# the files on disk LF on every platform so a Windows checkout matches what the fixture README says.
appsec-review-process/tests/fixtures/evidence-redaction/** text eol=lf
