{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "build-image.schema.json",
  "title": "Immutable host-local build image catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "image_id", "tag", "local_image_id", "digest_kind",
    "spec_fingerprint_sha256", "dockerfile", "dockerfile_sha256", "base",
    "base_digest", "apt_packages", "apt_mirror", "validated_builds"
  ],
  "properties": {
    "schema": {"const": "appsec-review/build-image/1"},
    "image_id": {"type": "string", "pattern": "^image_build_[0-9a-f]{12}\\Z"},
    "tag": {"type": "string", "pattern": "^appsec-build/image-build-[0-9a-f]{12}:local\\Z"},
    "local_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
    "digest_kind": {"const": "image-id"},
    "spec_fingerprint_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
    "dockerfile": {"type": "string", "minLength": 1},
    "dockerfile_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
    "base": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}\\Z"},
    "base_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
    "apt_packages": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]{0,127}\\Z"}
    },
    "apt_mirror": {
      "type": "object", "additionalProperties": false,
      "required": ["scheme", "host", "port", "suite", "components"],
      "properties": {
        "scheme": {"const": "http"}, "host": {"const": "archive.ubuntu.com"},
        "port": {"const": 80}, "suite": {"const": "noble"},
        "components": {"const": ["main", "universe"]}
      }
    },
    "validated_builds": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["run_id", "source_revision", "plan_sha256", "attempt_id", "validated_at"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}\\Z"},
          "plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
          "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9:+._-]{1,120}\\Z"},
          "validated_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
