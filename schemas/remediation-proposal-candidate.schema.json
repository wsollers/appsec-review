{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remediation-proposal-candidate.schema.json",
  "description": "A reviewer's remediation proposal at 12-scoring-prioritization (ADR-0020). Candidate only: never applied, never retested; always PATCH_PROPOSED_UNVALIDATED (design-v3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "source",
    "objective",
    "patch_proposal"
  ],
  "properties": {
    "status": {
      "const": "PATCH_PROPOSED_UNVALIDATED"
    },
    "source": {
      "const": "12-scoring-prioritization reviewer proposal"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "patch_proposal": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    }
  }
}
