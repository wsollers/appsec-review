{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "ir-capture.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "run_id", "source_revision", "source_snapshot_sha256", "native_build", "variants", "status", "modules", "coverage_gaps"],
  "properties": {
    "schema": {"const": "appsec-review/ir-capture/1"}, "run_id": {"type": "string"},
    "source_revision": {"type": "string"}, "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "native_build": {"$ref": "ir-upstream-lineage.schema.json"},
    "variants": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["unit_id", "variant_sha256", "compile_database_sha256", "image_id", "image_digest"],
      "properties": {"unit_id": {"type": "string"}, "variant_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "compile_database_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "image_id": {"type": "string"},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "status": {"enum": ["OK", "OK_WITH_GAPS"]},
    "modules": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["module_id", "unit_id", "compile_index", "source_path", "source_sha256", "compiler", "compiler_argv_sha256", "variant_sha256", "path", "sha256", "size_bytes"],
      "properties": {"module_id": {"type": "string"}, "unit_id": {"type": "string"}, "compile_index": {"type": "integer"},
        "source_path": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "compiler": {"type": "string"}, "compiler_argv_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "variant_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "size_bytes": {"type": "integer"}}}},
    "coverage_gaps": {"type": "array", "items": {"type": "object"}}
  }
}
