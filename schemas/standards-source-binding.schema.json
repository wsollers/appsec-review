{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standards-source-binding.schema.json",
  "title": "Standards Source Ingest Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "selected_snapshots", "unselected_families"],
  "properties": {
    "schema": {"const": "appsec-review/standards-source-binding/1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "selected_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "edition", "snapshot_id", "manifest_sha256", "selection_basis"],
        "properties": {
          "family": {"type": "string", "minLength": 1},
          "edition": {"type": "string", "minLength": 1},
          "snapshot_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{16}$"},
          "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "selection_basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "unselected_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "reason"],
        "properties": {
          "family": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
