{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vendor-b13-execution-receipt.schema.json",
  "title": "Authenticated vendor B13 execution projection receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "tool_id", "attempt_id", "request_sha256", "result_sha256", "output_sha256",
    "permission_sha256", "permission_fingerprint_sha256", "image_id", "image_digest",
    "argv", "tool_version", "tool_name"
  ],
  "properties": {
    "schema": {"const": "appsec-review/vendor-b13-execution-receipt/1"},
    "tool_id": {"type": "string", "pattern": "^[0-9a-z][0-9a-z._-]{0,95}$"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "permission_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "permission_fingerprint_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "image_id": {"type": "string", "pattern": "^[0-9a-z][0-9a-z._-]{0,95}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "argv": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "tool_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"},
    "tool_name": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}$"}
  }
}
