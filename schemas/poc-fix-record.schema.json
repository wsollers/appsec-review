{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poc-fix-record.schema.json",
  "title": "Lane-12b PoC-and-fix record (derived, strict)",
  "description": "One unvalidated static PoC and proposed fix for one eligible finding. The pipeline never executes the PoC; the fix is PATCH_PROPOSED_UNVALIDATED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "poc_fix_id",
    "request_id",
    "claim_id",
    "label",
    "poc",
    "explanation",
    "explanation_status",
    "cited_lines",
    "fix",
    "author",
    "claim_limits"
  ],
  "properties": {
    "poc_fix_id": {
      "type": "string",
      "pattern": "^pocfix-[0-9a-f]{24}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^pocreq-[0-9a-f]{16}$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "label": {
      "const": "UNVALIDATED"
    },
    "poc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "kind",
        "language",
        "text",
        "expected_effect",
        "trigger_condition",
        "text_sha256",
        "reason",
        "denylist_hits"
      ],
      "properties": {
        "status": {
          "enum": [
            "PROPOSED_UNVALIDATED",
            "REJECTED_DENYLIST",
            "NOT_PROVIDED"
          ]
        },
        "kind": {
          "enum": [
            "input",
            "call",
            "test",
            null
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9+#.-]{1,24}$"
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2400
        },
        "expected_effect": {
          "enum": [
            "crash",
            "overflow",
            "faulty_control_flow",
            null
          ]
        },
        "trigger_condition": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "text_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "denylist_hits": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "field",
              "line"
            ],
            "properties": {
              "rule": {
                "enum": [
                  "process-spawn",
                  "network",
                  "file-write",
                  "destructive",
                  "encoded-blob",
                  "interpreter-pipe",
                  "credentials",
                  "persistence",
                  "code-injection",
                  "obfuscation"
                ]
              },
              "field": {
                "enum": [
                  "poc.text",
                  "poc.trigger_condition",
                  "explanation",
                  "fix.diff",
                  "fix.rationale"
                ]
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "explanation_status": {
      "enum": [
        "ACCEPTED",
        "REJECTED_DENYLIST"
      ]
    },
    "cited_lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "start_line",
          "end_line",
          "role",
          "source_sha256",
          "hash_basis"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": [
              "source",
              "propagation",
              "sink",
              "guard"
            ]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "hash_basis": {
            "enum": [
              "finding-citation",
              "cpg",
              "projected-checkout"
            ]
          }
        }
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "diff",
        "rationale",
        "files",
        "diff_sha256",
        "denylist_hits"
      ],
      "properties": {
        "status": {
          "enum": [
            "PATCH_PROPOSED_UNVALIDATED",
            "REJECTED_DENYLIST"
          ]
        },
        "diff": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 6000
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1500
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "diff_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "denylist_hits": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "field",
              "line"
            ],
            "properties": {
              "rule": {
                "enum": [
                  "process-spawn",
                  "network",
                  "file-write",
                  "destructive",
                  "encoded-blob",
                  "interpreter-pipe",
                  "credentials",
                  "persistence",
                  "code-injection",
                  "obfuscation"
                ]
              },
              "field": {
                "enum": [
                  "poc.text",
                  "poc.trigger_condition",
                  "explanation",
                  "fix.diff",
                  "fix.rationale"
                ]
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id",
        "persona_id",
        "request_sha256"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "persona_id": {
          "type": "string"
        },
        "request_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "validated",
        "target_modified",
        "fixed_claimed",
        "hostile_content_permitted"
      ],
      "properties": {
        "executed": {
          "const": false
        },
        "validated": {
          "const": false
        },
        "target_modified": {
          "const": false
        },
        "fixed_claimed": {
          "const": false
        },
        "hostile_content_permitted": {
          "const": false
        }
      }
    }
  }
}
