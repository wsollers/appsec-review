{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-sast-tool.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["tool_id", "tool", "version", "image_id", "image_digest", "config_sha256", "status", "translation_units", "analyzed_units", "records", "raw_evidence"],
  "properties": {
    "tool_id": {"enum": ["clang-tidy", "cppcheck", "clang-static-analyzer"]},
    "tool": {"enum": ["clang-tidy", "cppcheck", "clang-static-analyzer"]},
    "version": {"type": "string", "minLength": 1}, "image_id": {"const": "audit-native"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["COMPLETE", "PARTIAL", "ERROR"]},
    "translation_units": {"type": "integer", "minimum": 1},
    "analyzed_units": {"type": "integer", "minimum": 0}, "records": {"type": "integer", "minimum": 0},
    "raw_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "native-sast-artifact.schema.json"}}
  }
}
