{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-component-map-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "attempt_id", "artifact_path", "artifact_sha256", "accepted_pointer_path", "accepted_pointer_sha256", "source_snapshot_sha256", "generation_sha256"],
  "properties": {
    "job_id": {"const": "01-component-characterization"},
    "attempt_id": {"type": "string"},
    "artifact_path": {"type": "string"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "accepted_pointer_path": {"const": "jobs/01-component-characterization/accepted.json"},
    "accepted_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generation_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
