{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-intel-lane-in-request.schema.json",
  "title": "OWASP workbench accepted-intelligence lane-in request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "selection", "permissions", "entries", "nvd", "completeness_gaps"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-intel-lane-in-request/1.0"},
    "run_id": {"type": "string"},
    "selection": {"$ref": "standard-selection.schema.json"},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static_inspection", "dynamic_execution", "manual_observation", "network_access", "target_mutation"],
      "properties": {
        "static_inspection": {"const": true},
        "dynamic_execution": {"const": false},
        "manual_observation": {"const": false},
        "network_access": {"const": false},
        "target_mutation": {"const": false}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id", "evidence_class", "kind", "admission", "artifact", "producer",
          "source_artifacts", "source_snapshot", "derivation_status", "freshness",
          "redaction_status", "caveats", "use"
        ],
        "properties": {
          "input_id": {"type": "string"},
          "evidence_class": {"enum": ["raw_evidence", "derived_intelligence"]},
          "kind": {"type": "string"},
          "admission": {"enum": ["accepted_run_output", "explicit_import"]},
          "artifact": {"$ref": "owasp-run-artifact-ref.schema.json"},
          "producer": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["job_id", "attempt_id", "accepted_pointer_path", "accepted_pointer_sha256"],
            "properties": {
              "job_id": {"type": "string"},
              "attempt_id": {"type": "string"},
              "accepted_pointer_path": {"type": "string"},
              "accepted_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "source_artifacts": {"type": "array", "items": {"$ref": "owasp-run-artifact-ref.schema.json"}},
          "source_snapshot": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["snapshot_id", "captured_at"],
            "properties": {
              "snapshot_id": {"type": "string"},
              "captured_at": {"type": "string"}
            }
          },
          "derivation_status": {"type": ["string", "null"], "enum": ["complete", "partial", null]},
          "freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assessed_at", "status"],
            "properties": {
              "assessed_at": {"type": "string"},
              "status": {"enum": ["current", "stale_accepted", "not_time_sensitive"]}
            }
          },
          "redaction_status": {"enum": ["not_required", "applied", "reviewed", "contains_restricted_data"]},
          "caveats": {"type": "array", "items": {"type": "string"}},
          "use": {"enum": ["canonical_evidence", "locator_only"]}
        }
      }
    },
    "nvd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "snapshot_id", "manifest_sha256", "advisory_freshness_seconds"],
      "properties": {
        "requested": {"type": "boolean"},
        "snapshot_id": {"type": ["string", "null"], "pattern": "^sha256-[0-9a-f]{16}$"},
        "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "advisory_freshness_seconds": {"type": ["integer", "null"]}
      }
    },
    "completeness_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "kind", "summary", "affected_scope"],
        "properties": {
          "gap_id": {"type": "string"},
          "kind": {"type": "string"},
          "summary": {"type": "string"},
          "affected_scope": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
