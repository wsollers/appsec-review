{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-review-input-assembly.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "job_id", "attempt_id", "source_generation", "plan_sha256", "accepted_sources", "requests", "skipped"],
  "properties": {
    "schema": {"const": "appsec-review/full-review-input-assembly/1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"const": "02-full-review-input-assembly"},
    "attempt_id": {"type": "string", "minLength": 1},
    "source_generation": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "accepted_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "job_id", "attempt_id", "artifact_path", "artifact_sha256", "accepted_pointer_sha256"],
        "properties": {
          "alias": {"type": "string", "minLength": 1},
          "job_id": {"type": "string", "minLength": 1},
          "attempt_id": {"type": "string", "minLength": 1},
          "artifact_path": {"type": "string", "minLength": 1},
          "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "accepted_pointer_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "adapter", "path", "sha256", "accepted_source_aliases"],
        "properties": {
          "job_id": {"type": "string", "minLength": 1},
          "adapter": {"enum": ["bounded", "vendor", "dependency"]},
          "path": {"type": "string", "pattern": "^requests/[0-9A-Za-z._-]+\\.json$"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "accepted_source_aliases": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["job_id", "status", "reason"],
        "properties": {
          "job_id": {"type": "string", "minLength": 1},
          "status": {"const": "SKIPPED_NA"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
