{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "owasp-control-status-row.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["row_index", "assignment_id", "target_id", "standard_family", "standard_version", "profile_or_level", "control_id", "component_id", "domain_id", "applicability_status", "applicability_rationale", "applicability_citations", "decision_source", "override_ids", "source_completeness", "rescope_state", "rescope_actions", "invalidated_result_ids", "crosswalk_lineage", "batch_ids", "proof_obligations", "dispatch_disposition", "joined_status", "assessment_results", "dynamic_candidate_ids", "gap_ids", "dissent_ids", "candidate_route_ids"],
  "properties": {
    "row_index": {"type": "integer", "minimum": 0}, "assignment_id": {"type": "string"}, "target_id": {"type": "string"},
    "standard_family": {"type": "string"}, "standard_version": {"type": "string"}, "profile_or_level": {"type": ["string", "null"]},
    "control_id": {"type": "string"}, "component_id": {"type": "string"}, "domain_id": {"type": "string"},
    "applicability_status": {"enum": ["applicable", "conditional", "not_applicable", "cannot_determine", "out_of_scope"]},
    "applicability_rationale": {"type": "string"}, "applicability_citations": {"type": "array", "items": {"$ref": "owasp-applicability-citation.schema.json"}},
    "decision_source": {"type": "string"}, "override_ids": {"type": "array", "items": {"type": "string"}},
    "source_completeness": {"enum": ["adequate", "partial", "unknown", "not_evaluated"]}, "rescope_state": {"enum": ["none", "required"]},
    "rescope_actions": {"type": "array", "items": {"type": "string"}}, "invalidated_result_ids": {"type": "array", "items": {"type": "string"}},
    "crosswalk_lineage": {"type": "array", "items": {"$ref": "owasp-crosswalk-lineage.schema.json"}},
    "batch_ids": {"type": "array", "items": {"type": "string"}}, "proof_obligations": {"type": "array", "items": {"$ref": "owasp-batch-proof-obligation.schema.json"}},
    "dispatch_disposition": {"type": "string"},
    "joined_status": {"enum": ["satisfied", "partially_satisfied", "not_satisfied", "cannot_verify", "dynamic_test_required", "human_decision_required", "not_assessed", "not_applicable", "cannot_determine", "out_of_scope"]},
    "assessment_results": {"type": "array", "items": {"$ref": "owasp-control-assessment-result.schema.json"}},
    "dynamic_candidate_ids": {"type": "array", "items": {"type": "string"}}, "gap_ids": {"type": "array", "items": {"type": "string"}},
    "dissent_ids": {"type": "array", "items": {"type": "string"}}, "candidate_route_ids": {"type": "array", "items": {"type": "string"}}
  }
}
