{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-candidate-search.schema.json",
  "title": "Accepted 04-owasp-candidate-search result: deterministic per-chapter ASVS candidates (ADR-0034)",
  "description": "Python decides the search universe: every chapter V1..V17 is listed with the rules it evaluated and their hit counts (zero included); every hit becomes either a function/symbol-level candidate or an excluded item with its reason. A source language the rule table does not cover or the index did not parse makes coverage incomplete, which the universe reports as a gap, never as not applicable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "job_id", "source_snapshot_sha256", "status", "rule_table", "inputs", "coverage",
               "chapters", "candidates", "excluded", "gaps"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-candidate-search/1.0"},
    "run_id": {"$ref": "common/formats.schema.json#/$defs/run_id"},
    "job_id": {"const": "04-owasp-candidate-search"},
    "source_snapshot_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
    "status": {"$ref": "common/formats.schema.json#/$defs/ok_status"},
    "rule_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rules_id", "version", "sha256"],
      "properties": {
        "path": {"const": "data/owasp-asvs/category-rules-v1.json"},
        "rules_id": {"$ref": "common/formats.schema.json#/$defs/slug"},
        "version": {"$ref": "common/formats.schema.json#/$defs/semver"},
        "sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_hex"}
      }
    },
    "inputs": {
      "description": "The accepted upstream publications read, one per job; an optional upstream that was not accepted is listed with accepted false and named in gaps.",
      "type": "array", "minItems": 3, "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "required", "accepted", "attempt_id", "artifact_path", "artifact_sha256"],
        "properties": {
          "job_id": {"enum": ["02-code-index", "02-code-property-graph", "02-treesitter-ast", "02-source-sast"]},
          "required": {"type": "boolean"},
          "accepted": {"type": "boolean"},
          "attempt_id": {"oneOf": [{"type": "null"}, {"$ref": "common/formats.schema.json#/$defs/attempt_id"}]},
          "artifact_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
          "artifact_sha256": {"oneOf": [{"type": "null"}, {"$ref": "common/formats.schema.json#/$defs/sha256_hex"}]}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "searched_languages", "unsearched_languages", "sast_available"],
      "properties": {
        "complete": {"type": "boolean"},
        "searched_languages": {"type": "array", "uniqueItems": true, "items": {"$ref": "owasp-category-rules.schema.json#/$defs/language"}},
        "unsearched_languages": {
          "description": "Source present in the snapshot that no rule covers or no index parsed (tree-sitter no-grammar/grammar-unavailable gaps included).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "file_count", "reason"],
            "properties": {
              "language": {"type": "string", "minLength": 1, "maxLength": 40},
              "file_count": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
              "reason": {"enum": ["no_rules_for_language", "not_indexed", "no_grammar", "index_truncated"]}
            }
          }
        },
        "sast_available": {"type": "boolean"}
      }
    },
    "chapters": {
      "description": "Exactly the 17 ASVS 5.0.0 chapters, in order V1..V17, each with its search basis.",
      "type": "array", "minItems": 17, "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter_id", "candidate_count", "excluded_count", "coverage_complete", "search_basis"],
        "properties": {
          "chapter_id": {"$ref": "owasp-category-rules.schema.json#/$defs/chapter_id"},
          "candidate_count": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
          "excluded_count": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
          "coverage_complete": {"type": "boolean"},
          "search_basis": {
            "description": "Every rule of the chapter that was evaluated, with its raw hit count (before exclusions), plus propagation when the chapter has it.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule_id", "kind", "hits"],
              "properties": {
                "rule_id": {"$ref": "owasp-category-rules.schema.json#/$defs/rule_id"},
                "kind": {"$ref": "#/$defs/match_kind"},
                "hits": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"}
              }
            }
          }
        }
      }
    },
    "candidates": {
      "description": "One row per (chapter, enclosing function); a function may be a candidate in several chapters. Sorted by chapter, file, start_line, symbol.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "chapter_id", "symbol", "file", "file_sha256", "language", "start_line", "end_line",
                     "span_source", "matches"],
        "properties": {
          "candidate_id": {"$ref": "#/$defs/candidate_id"},
          "chapter_id": {"$ref": "owasp-category-rules.schema.json#/$defs/chapter_id"},
          "symbol": {"type": "string", "minLength": 1, "maxLength": 1000},
          "file": {"$ref": "#/$defs/path"},
          "file_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref_or_hex"},
          "language": {"$ref": "owasp-category-rules.schema.json#/$defs/language"},
          "start_line": {"$ref": "#/$defs/line"},
          "end_line": {"$ref": "#/$defs/line"},
          "span_source": {"description": "treesitter: real function span; cpg-first-line: CPG method with no tree-sitter span (end_line = start_line); module-scope: a hit outside any function (an import, a global initializer), symbol <module> and span = the hit line.", "enum": ["treesitter", "cpg-first-line", "module-scope"]},
          "matches": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule_id", "kind", "file", "line", "detail"],
              "properties": {
                "rule_id": {"$ref": "owasp-category-rules.schema.json#/$defs/rule_id"},
                "kind": {"$ref": "#/$defs/match_kind"},
                "file": {"$ref": "#/$defs/path"},
                "line": {"$ref": "#/$defs/line"},
                "detail": {"type": "string", "maxLength": 500}
              }
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter_id", "rule_id", "symbol", "file", "line", "reason", "detail"],
        "properties": {
          "chapter_id": {"$ref": "owasp-category-rules.schema.json#/$defs/chapter_id"},
          "rule_id": {"$ref": "owasp-category-rules.schema.json#/$defs/rule_id"},
          "symbol": {"type": ["string", "null"], "maxLength": 1000},
          "file": {"$ref": "#/$defs/path"},
          "line": {"$ref": "#/$defs/line"},
          "reason": {"enum": ["test_code", "documentation", "example_code", "vendored_third_party", "generated_code",
                              "build_system"]},
          "detail": {"type": "string", "maxLength": 500}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "kind", "chapter_ids", "statement"],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^gap-[0-9a-f]{20}\\Z"},
          "kind": {"enum": ["language_not_searched", "index_incomplete", "sast_unavailable", "treesitter_unavailable",
                            "rule_without_index_support", "rows_truncated"]},
          "chapter_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "owasp-category-rules.schema.json#/$defs/chapter_id"}},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^[^/\\\\\\r\\n][^\\\\\\r\\n]{0,1023}\\Z"},
    "line": {"type": "integer", "minimum": 1},
    "candidate_id": {"type": "string", "pattern": "^cand-V(?:[1-9]|1[0-7])-[0-9a-f]{16}\\Z"},
    "match_kind": {"enum": ["calls_to", "symbol_regex", "identifier_regex", "literal_regex", "import_regex", "sast_rule_ids",
                            "entry_point", "propagation"]}
  }
}
