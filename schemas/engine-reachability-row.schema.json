{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-reachability-row.schema.json",
  "title": "One SCA match's verdict from one reachability engine (ADR-0023 decision 5)",
  "description": "verdict is reachable only with a non-empty hash-bound witness; unreachable only from the ir engine with a hash-bound target; tier is direct (the vulnerable call is in application code) or through-dependency (inside the vendored dependency source), null unless reachable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "match_id",
    "component_ref",
    "advisory_id",
    "ecosystem",
    "language",
    "verdict",
    "tier",
    "symbols",
    "resolved",
    "resolution",
    "witness",
    "taint_paths",
    "target",
    "database_ids",
    "reason",
    "gaps"
  ],
  "properties": {
    "match_id": {
      "type": "string",
      "pattern": "^VM-[0-9]{6}\\Z"
    },
    "component_ref": {
      "type": "string",
      "pattern": "^SC-[0-9]{6}\\Z"
    },
    "advisory_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{1,15}-[0-9A-Za-z][0-9A-Za-z-]{0,47}\\Z"
    },
    "ecosystem": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "enum": [
        null,
        "cpp",
        "go",
        "java",
        "csharp",
        "javascript",
        "python",
        "ruby",
        "rust",
        "php"
      ]
    },
    "verdict": {
      "enum": [
        "reachable",
        "unreachable",
        "unknown"
      ]
    },
    "tier": {
      "enum": [
        null,
        "direct",
        "through-dependency"
      ]
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "symbol",
          "source"
        ],
        "properties": {
          "package": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9@_][A-Za-z0-9@._+~/:-]{0,199}\\Z"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$.:<>~-]{0,199}\\Z"
          },
          "source": {
            "enum": [
              "reviewed-map",
              "osv"
            ]
          }
        }
      }
    },
    "resolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "symbol",
          "via"
        ],
        "properties": {
          "package": {
            "type": "string",
            "pattern": "^[A-Za-z0-9@_][A-Za-z0-9@._+~/:-]{0,199}\\Z"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$.:<>~-]{0,199}\\Z"
          },
          "via": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{0,200}\\Z"
          }
        }
      }
    },
    "resolution": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\x00-\\x1f\\x7f]{0,300}\\Z"
      }
    },
    "witness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "function",
          "file",
          "line",
          "sha256"
        ],
        "properties": {
          "function": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{0,200}\\Z"
          },
          "file": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{1,1024}\\Z"
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "calls_next_at": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{0,200}\\Z"
          },
          "resolution": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{0,200}\\Z"
          },
          "note": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{0,200}\\Z"
          }
        }
      }
    },
    "taint_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "sink"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{0,1100}\\Z"
          },
          "sink": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{0,1100}\\Z"
          }
        }
      }
    },
    "target": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "function",
        "file",
        "line",
        "sha256"
      ],
      "properties": {
        "function": {
          "type": "string",
          "pattern": "^[^\\x00-\\x1f\\x7f]{0,200}\\Z"
        },
        "file": {
          "type": "string",
          "pattern": "^[^\\x00-\\x1f\\x7f]{0,1024}\\Z"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}\\Z"
        }
      }
    },
    "database_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^codeqldb_[0-9a-f]{16}\\Z"
      }
    },
    "reason": {
      "type": "string",
      "pattern": "^[^\\x00-\\x1f\\x7f]{0,1024}\\Z"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\x00-\\x1f\\x7f]{0,512}\\Z"
      }
    }
  }
}
