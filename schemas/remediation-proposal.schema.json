{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remediation-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "job_id", "attempt_id", "status", "source_generation", "verification", "environment", "proposals", "no_op", "gaps", "claim_limits"],
  "properties": {
    "schema": {"const": "appsec-review/remediation-proposal/1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"const": "11-remediation-proposal"},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["OK_WITH_GAPS", "SKIPPED_NA"]},
    "source_generation": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verification": {"$ref": "claim-lifecycle-upstream.schema.json"},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "attempt_id", "accepted_pointer_sha256", "envelope_sha256", "artifact_path", "artifact_sha256", "source_revision", "source_generation", "units", "environment_sha256"],
      "properties": {
        "job_id": {"const": "02-native-build"}, "attempt_id": {"type": "string", "minLength": 1},
        "accepted_pointer_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "envelope_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_revision": {"type": "string", "minLength": 1},
        "source_generation": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "environment_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "units": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["unit_id", "image_id", "image_digest", "compile_database_sha256", "binary_sha256"],
          "properties": {"unit_id": {"type": "string", "minLength": 1}, "image_id": {"type": "string", "minLength": 1},
            "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "compile_database_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "binary_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}}
      }
    },
    "proposals": {"type": "array", "maxItems": 5000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "claim_id", "status", "hypothesis", "component_ids", "source_generation", "component_generation", "remediation_objective", "evidence", "proof_obligations", "dissent_ids", "patch_status", "target_modified", "retest"],
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^remediation-[0-9a-f]{24}$"},
        "claim_id": {"type": "string", "minLength": 1}, "status": {"const": "PROPOSED_REVIEW_REQUIRED"},
        "hypothesis": {"type": "string", "minLength": 1},
        "component_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_generation": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "component_generation": {"type": "string", "minLength": 1},
        "remediation_objective": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "claim-lifecycle-citation.schema.json"}},
        "proof_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "claim-lifecycle-proof-obligation.schema.json"}},
        "dissent_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "patch_status": {"const": "NOT_GENERATED"}, "target_modified": {"const": false},
        "retest": {"type": "object", "additionalProperties": false,
          "required": ["status", "required", "same_environment_required", "environment_sha256", "source_revision", "required_verifier_role", "next_job_id"],
          "properties": {"status": {"const": "NOT_RUN"}, "required": {"const": true},
            "same_environment_required": {"const": true}, "environment_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "source_revision": {"type": "string", "minLength": 1}, "required_verifier_role": {"const": "independent-verifier"},
            "next_job_id": {"const": "remediation-retest-feedback"}}}
      }
    }},
    "no_op": {"type": "object", "additionalProperties": false, "required": ["applicable", "reason"],
      "properties": {"applicable": {"type": "boolean"}, "reason": {"enum": ["no-independently-verified-claims", null]}}},
    "gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "claim_limits": {"const": {"target_modified": false, "patch_generated": false, "retest_executed": false, "fixed_claimed": false}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SKIPPED_NA"}}},
      "then": {"properties": {
        "proposals": {"maxItems": 0},
        "no_op": {"properties": {
          "applicable": {"const": true},
          "reason": {"const": "no-independently-verified-claims"}
        }}
      }}
    },
    {
      "if": {"properties": {"status": {"const": "OK_WITH_GAPS"}}},
      "then": {"properties": {
        "proposals": {"minItems": 1},
        "no_op": {"properties": {
          "applicable": {"const": false},
          "reason": {"type": "null"}
        }},
        "gaps": {"minItems": 1}
      }}
    }
  ]
}
