{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standards-source-extract.schema.json",
  "title": "Standards Source Extract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "job_id", "attempt_id", "status", "source_snapshot_sha256", "source_lock", "snapshots", "records", "coverage_gaps", "claim_boundary"],
  "properties": {
    "schema": {"const": "appsec-review/standards-source-extract/1.0"},
    "run_id": {"type": "string"},
    "job_id": {"const": "02-standards-source-ingest"},
    "attempt_id": {"type": "string"},
    "status": {"enum": ["OK", "OK_WITH_GAPS"]},
    "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_lock": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"const": "data/reference/source-lock.json"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "snapshots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family", "edition", "snapshot_id", "manifest_path", "manifest_sha256", "license_path", "license_sha256", "content_digest", "extractor", "record_count"],
        "properties": {
          "family": {"type": "string"}, "edition": {"type": "string"},
          "snapshot_id": {"type": "string"}, "manifest_path": {"type": "string"},
          "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "license_path": {"type": "string"}, "license_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "extractor": {"type": "object", "additionalProperties": false, "required": ["name", "version", "source_path"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "source_path": {"type": "string"}}},
          "record_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "records": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family", "record_type", "record_id", "path", "sha256"],
        "properties": {
          "family": {"type": "string"}, "record_type": {"type": "string"}, "record_id": {"type": "string"},
          "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "coverage_gaps": {"type": "array", "items": {"type": "string"}},
    "claim_boundary": {"const": "REFERENCE_MATERIAL_ONLY_NOT_PROOF_OR_COMPLIANCE"}
  }
}
