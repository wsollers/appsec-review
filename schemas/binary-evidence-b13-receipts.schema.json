{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"binary-evidence-b13-receipts.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema","run_id","job_id","native_build","image_id","image_digest","image_record_sha256","boundary_sha256","network_mode","target_execution","operations"],
  "properties":{
    "schema":{"const":"appsec-review/binary-b13-receipts/1.0"},
    "run_id":{"type":"string","minLength":1},
    "job_id":{"enum":["02-debug-symbol-index","02-binary-triage","02-binary-cfg"]},
    "native_build":{"$ref":"binary-evidence-native.schema.json"},
    "image_id":{"const":"audit-binary-analysis"},
    "image_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "image_record_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "boundary_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "network_mode":{"const":"none"},"target_execution":{"const":false},
    "operations":{"type":"array","items":{"type":"object","additionalProperties":false,
      "required":["binary_id","binary_sha256","adapter_attempt_id","trial_path","request_sha256","expected_result_sha256","output_files"],
      "properties":{"binary_id":{"type":"string","minLength":1},"binary_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "adapter_attempt_id":{"type":"string","minLength":1},"trial_path":{"type":"string","pattern":"^tools/[0-9]{4}$"},
        "request_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"expected_result_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "output_files":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{
          "path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}}}}}
  }
}
