{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-discovery.schema.json",
  "title": "Repository Project Discovery Result",
  "type": "object",
  "required": ["schema", "target", "source_revision", "projects", "safe_command_plan", "coverage_gaps"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "appsec-review/project-discovery/1.0"},
    "target": {"type": "string"},
    "source_revision": {"type": "string"},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_id", "root", "languages", "manifests", "lockfiles", "candidate_buildenv_images", "commands", "evidence_citations", "confidence"],
        "additionalProperties": false,
        "properties": {
          "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "root": {"type": "string"},
          "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "manifests": {"type": "array", "items": {"type": "string"}},
          "lockfiles": {"type": "array", "items": {"type": "string"}},
          "candidate_buildenv_images": {"type": "array", "items": {"type": "string"}},
          "commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_citations": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-citation.schema.json"}},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "safe_command_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_id", "purpose", "argv", "authorization", "side_effects", "evidence_citations"],
        "additionalProperties": false,
        "properties": {
          "project_id": {"type": "string"},
          "purpose": {"type": "string"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "authorization": {"type": "string", "enum": ["read-only", "network-required", "script-execution-required"]},
          "side_effects": {"type": "array", "items": {"type": "string"}},
          "evidence_citations": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-citation.schema.json"}}
        }
      }
    },
    "coverage_gaps": {"type": "array", "items": {"type": "string"}, "description": "What could not be determined or examined. Only these make the job OK_WITH_GAPS."},
    "absence_observations": {"type": "array", "items": {"$ref": "#/$defs/discovery_note"}, "description": "Verified absence: something the job searched for and the target does not declare (no CI/CD workflow, no IaC, no registry). Reported, never a coverage gap."},
    "informational_notes": {"type": "array", "items": {"$ref": "#/$defs/discovery_note"}, "description": "By-design or scope notes that are not gaps (vendored tree built by its parent, no lockfile because dependencies are vendored, a capability the plan needs)."}
  },
  "$defs": {
    "discovery_note": {
      "type": "object",
      "required": ["statement", "basis"],
      "additionalProperties": false,
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "basis": {
          "type": "object",
          "description": "What was searched, so the note is evidenced (AGENTS.md rule 2): repository-relative path globs, how many listed target files in that scope declare what the statement is about (0 for an absence), and the files read, if any.",
          "required": ["search_scope", "inventory_count", "evidence_citations"],
          "additionalProperties": false,
          "properties": {
            "search_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "inventory_count": {"type": "integer", "minimum": 0},
            "evidence_citations": {"type": "array", "items": {"$ref": "evidence-citation.schema.json"}}
          }
        }
      }
    }
  }
}
