{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-skip.schema.json",
  "description": "ADR-0014: a job with nothing to do publishes this instead of its result document. 'why' is prose; the envelope's skip_reason carries the machine reason.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "job_id",
    "status",
    "reason",
    "why",
    "upstream"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/evidence-skip/1"
    },
    "run_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "status": {
      "const": "SKIPPED"
    },
    "reason": {
      "type": "string",
      "pattern": "^not-applicable-[a-z0-9-]+$"
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "upstream": {
      "type": "object"
    }
  }
}
