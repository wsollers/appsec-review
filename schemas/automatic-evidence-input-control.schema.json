{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/appsec-review/automatic-evidence-input-control.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "offline_snapshots", "dependency_lifecycle"],
  "properties": {
    "schema": {"const": "appsec-review/automatic-evidence-input-control/1"},
    "offline_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_path", "max_database_age_seconds"],
      "properties": {
        "registry_path": {"type": "string", "minLength": 1},
        "max_database_age_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "dependency_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_table_path", "max_reference_age_days"],
      "properties": {
        "reference_table_path": {"type": "string", "minLength": 1},
        "max_reference_age_days": {"type": "integer", "minimum": 0}
      }
    }
  }
}
