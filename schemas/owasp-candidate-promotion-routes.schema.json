{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "owasp-candidate-promotion-routes.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "run_id", "selection_id", "finding_promotion", "routes"],
  "properties": {"schema": {"const": "appsec-review/owasp-candidate-promotion-routes/1.0"}, "run_id": {"type": "string"}, "selection_id": {"type": "string"},
    "finding_promotion": {"const": "not_performed"},
    "routes": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["route_id", "dedupe_key", "component_id", "mechanism_or_impact_hypothesis", "proof_obligation_ids", "evidence_citations", "source_rows", "crosswalk_aliases", "next_route", "candidate_only", "finding_created", "severity_assigned", "runtime_claimed"],
      "properties": {"route_id": {"type": "string"}, "dedupe_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "component_id": {"type": "string"},
        "mechanism_or_impact_hypothesis": {"type": "string", "minLength": 12}, "proof_obligation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_citations": {"type": "array", "minItems": 1, "items": {"$ref": "owasp-assessment-evidence-citation.schema.json"}},
        "source_rows": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["row_index", "target_id", "control_id", "result_id", "source_route_id"],
          "properties": {"row_index": {"type": "integer"}, "target_id": {"type": "string"}, "control_id": {"type": "string"}, "result_id": {"type": "string"}, "source_route_id": {"type": "string"}}}},
        "crosswalk_aliases": {"type": "array", "items": {"$ref": "owasp-crosswalk-lineage.schema.json"}}, "next_route": {"const": "09-independent-verification"},
        "candidate_only": {"const": true}, "finding_created": {"const": false}, "severity_assigned": {"const": false}, "runtime_claimed": {"const": false}}}}
  }
}
