{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-recall-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "status", "authority", "source_snapshot_sha256", "source_tree_sha256", "generation_bindings", "embedding_model", "index", "redaction", "limits", "coverage_gaps"],
  "properties": {
    "schema": {"const": "appsec-review/semantic-recall-index/1.0"},
    "run_id": {"type": "string", "minLength": 1}, "status": {"enum": ["OK", "OK_WITH_GAPS"]},
    "authority": {"const": "SEMANTIC_RECALL_ONLY_LOCATORS_REQUIRE_DEREFERENCE"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_tree_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generation_bindings": {"type": "object", "additionalProperties": false, "required": ["symbol_index_sha256", "cpg_sha256", "ir_facts_sha256"], "properties": {"symbol_index_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "cpg_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "ir_facts_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "embedding_model": {"type": "object", "additionalProperties": false, "required": ["model_id", "artifact_sha256", "preseeded", "network"], "properties": {"model_id": {"type": "string", "minLength": 1}, "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "preseeded": {"const": true}, "network": {"const": "none"}}},
    "index": {"type": "object", "additionalProperties": false, "required": ["engine", "table", "tree_sha256", "rows"], "properties": {"engine": {"const": "lancedb-vector"}, "table": {"const": "chunks"}, "tree_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "rows": {"type": "integer", "minimum": 1, "maximum": 200000}}},
    "redaction": {"const": "required-before-embedding"},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_rows", "max_chunk_chars", "max_results"], "properties": {"max_rows": {"const": 200000}, "max_chunk_chars": {"const": 4000}, "max_results": {"const": 100}}},
    "coverage_gaps": {"type": "array", "items": {"type": "string"}}
  }
}
