{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-component-routing.schema.json",
  "title": "Projection of the accepted OWASP universe into OWASP applicability (ADR-0034)",
  "description": "One synthetic component asvs-V<n> per ASVS 5.0.0 chapter target of the accepted 04-owasp-universe, scoped to that chapter's controls. Nothing is inferred from component classification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "selection_id", "source_snapshot_sha256", "universe", "input_manifest", "component_count", "selected_control_count", "expected_target_count", "planned_validator_calls", "component_ids", "rule_ids", "gaps", "claim_limits"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-component-routing/2.0"},
    "run_id": {"type": "string"},
    "selection_id": {"type": "string"},
    "source_snapshot_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
    "universe": {"$ref": "owasp-applicability-request.schema.json#/$defs/universe_binding"},
    "input_manifest": {"$ref": "owasp-input-manifest-binding.schema.json"},
    "component_count": {"const": 17},
    "selected_control_count": {"type": "integer", "minimum": 1},
    "expected_target_count": {"type": "integer", "minimum": 1},
    "planned_validator_calls": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
    "component_ids": {"type": "array", "minItems": 17, "maxItems": 17, "uniqueItems": true, "items": {"type": "string", "pattern": "^asvs-V(?:[1-9]|1[0-7])\\Z"}},
    "rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "component_id", "kind", "summary", "rescope_required"],
      "properties": {
        "gap_id": {"type": "string"}, "component_id": {"type": ["string", "null"]},
        "kind": {"enum": ["cannot_determine", "family_not_projected"]}, "summary": {"type": "string"},
        "rescope_required": {"const": true}
      }
    }},
    "claim_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
