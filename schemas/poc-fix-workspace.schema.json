{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poc-fix-workspace.schema.json",
  "title": "Lane-12b request workspace (readable input 0 of one poc-and-fix cell)",
  "description": "One eligible finding (verified, Critical, REACHABLE): its locations, reachability witness, the files and line windows it may cite with the hashes Python pinned, and hash-verified redacted snippets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "claim_id",
    "title",
    "severity",
    "cwe",
    "reachability",
    "locations",
    "citable",
    "snippets",
    "observed_facts",
    "bounds"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/poc-fix-workspace/1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^pocreq-[0-9a-f]{16}$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "maxLength": 600
    },
    "severity": {
      "const": "CRITICAL"
    },
    "cwe": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "reachability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason",
        "witness"
      ],
      "properties": {
        "state": {
          "const": "REACHABLE"
        },
        "reason": {
          "type": "string"
        },
        "witness": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "function",
              "file",
              "line",
              "calls_next_at"
            ],
            "properties": {
              "function": {
                "type": "string"
              },
              "file": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "calls_next_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "end_line"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "citable": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_sha256",
          "hash_basis",
          "windows"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "hash_basis": {
            "enum": [
              "finding-citation",
              "cpg",
              "projected-checkout"
            ]
          },
          "windows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "snippets": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "start",
          "end",
          "source"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "type": "array",
            "maxItems": 41,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "observed_facts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poc_chars",
        "poc_lines",
        "explanation_chars",
        "fix_chars",
        "fix_lines",
        "cited_lines_max",
        "span_lines_max"
      ],
      "properties": {
        "poc_chars": {
          "type": "integer",
          "minimum": 1
        },
        "poc_lines": {
          "type": "integer",
          "minimum": 1
        },
        "explanation_chars": {
          "type": "integer",
          "minimum": 1
        },
        "fix_chars": {
          "type": "integer",
          "minimum": 1
        },
        "fix_lines": {
          "type": "integer",
          "minimum": 1
        },
        "cited_lines_max": {
          "type": "integer",
          "minimum": 1
        },
        "span_lines_max": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
