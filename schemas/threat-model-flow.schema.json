{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threat-model-flow.schema.json",
  "title": "Threat-model data-flow edge",
  "type": "object",
  "required": [
    "flow_id",
    "source_element_id",
    "destination_element_id",
    "protocol",
    "auth_context",
    "data_class_ids",
    "boundary_ids",
    "direction",
    "evidence_class",
    "confidence",
    "citations",
    "originating_workcell_id"
  ],
  "additionalProperties": false,
  "properties": {
    "flow_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source_element_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "destination_element_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "protocol": {
      "type": [
        "string",
        "null"
      ]
    },
    "auth_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_class_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "boundary_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "direction": {
      "type": "string",
      "enum": [
        "request",
        "response",
        "bidirectional",
        "push",
        "pull",
        "event"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "DIRECT_EVIDENCE",
        "STRONG_INFERENCE",
        "WEAK_INFERENCE",
        "FOLLOW_ON_REQUIRED"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "threat-model-citation.schema.json"
      }
    },
    "originating_workcell_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
