{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-parity-job.schema.json",
  "type": "object",
  "required": ["id", "design_refs", "graph", "registry", "execution", "output", "permissions", "dagster", "resource_pool", "readiness", "qualification", "gaps", "next_prerequisite"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9a-z][0-9a-z-]*$"},
    "design_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "graph": {
      "type": "object",
      "required": ["node", "implemented", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "node": {"type": "string"},
        "implemented": {"type": "boolean"},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "registry": {
      "type": ["object", "null"],
      "required": ["template", "persona", "role", "domain", "tooling_profile", "output_contract"],
      "additionalProperties": false,
      "properties": {
        "template": {"type": "string"}, "persona": {"type": "string"},
        "role": {"type": "string"}, "domain": {"type": "string"},
        "tooling_profile": {"type": "string"}, "output_contract": {"type": "string"}
      }
    },
    "execution": {
      "type": "object",
      "required": ["mode", "worker", "validator"],
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["deterministic_python", "pinned_container", "persona", "pool_coordinator", "supplied_artifact", "join_controller", "none"]},
        "worker": {"type": ["string", "null"]},
        "validator": {"type": ["string", "null"]}
      }
    },
    "output": {
      "type": "object",
      "required": ["contract", "contract_file", "schema_file", "claim_class"],
      "additionalProperties": false,
      "properties": {
        "contract": {"type": "string"},
        "contract_file": {"type": ["string", "null"]},
        "schema_file": {"type": ["string", "null"]},
        "claim_class": {"type": "string"}
      }
    },
    "permissions": {"type": "array", "items": {"type": "string"}},
    "dagster": {
      "type": "object",
      "required": ["standalone_jobs", "lifecycle_binding", "launcher_jobs", "sensor_jobs"],
      "additionalProperties": false,
      "properties": {
        "standalone_jobs": {"type": "array", "items": {"type": "string"}},
        "lifecycle_binding": {
          "type": "object",
          "required": ["kind", "entrypoint"],
          "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "enum": ["actual_worker", "supplied_gate", "blocked_op", "controller"]},
            "entrypoint": {"type": "string"}
          }
        },
        "launcher_jobs": {"type": "array", "items": {"type": "string"}},
        "sensor_jobs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resource_pool": {"type": "string"},
    "readiness": {"type": "string", "enum": ["implemented_and_qualified", "implemented_not_qualified", "standalone_only", "supplied_artifact_gate", "registered_planned_not_executable", "missing_prerequisites", "decision_blocked", "not_applicable_design_decision"]},
    "qualification": {
      "type": "object",
      "required": ["levels", "references"],
      "additionalProperties": false,
      "properties": {
        "levels": {"type": "array", "items": {"type": "string", "enum": ["unit", "host_integration", "linux_integration", "live_dagster", "fault_recovery", "none"]}},
        "references": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gaps": {"type": "array", "items": {"type": "string"}},
    "next_prerequisite": {"type": ["string", "null"]}
  }
}
