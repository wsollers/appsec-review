{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "language-census.schema.json",
  "title": "Accepted 02-language-census result: one deterministic class per snapshot file",
  "description": "Every regular file of the staged snapshot gets exactly one class (program:<language>, build_system, documentation, data_config, binary_media, patch_diff, generated, vendored, unknown_text), decided by path glob, exact name, suffix, shebang, then content sniff, and recorded with that basis. Counts cover every file; rows are bounded by limits.max_rows and unlisted rows, unreadable files and skipped links are gaps. languages_needing_server lists the program languages whose language server tooling/buildenv-catalog.json names. Classes are file-level facts, never findings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "job_id", "source_snapshot_sha256", "source_tree_sha256", "status", "rule_table",
               "limits", "totals", "classes", "languages", "languages_needing_server", "files", "gaps",
               "claim_boundary", "content_sha256"],
  "properties": {
    "schema": {"const": "appsec-review/language-census/1.0"},
    "run_id": {"$ref": "common/formats.schema.json#/$defs/run_id"},
    "job_id": {"const": "02-language-census"},
    "source_snapshot_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
    "source_tree_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
    "status": {"$ref": "common/formats.schema.json#/$defs/ok_status"},
    "rule_table": {
      "description": "The rule table whose vendored and generated exclusion globs classify by path.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "data/owasp-asvs/category-rules-v1.json"},
        "sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_hex"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_rows", "head_bytes"],
      "properties": {
        "max_rows": {"type": "integer", "minimum": 1},
        "head_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "bytes", "listed", "unlisted"],
      "properties": {
        "files": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
        "bytes": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
        "listed": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
        "unlisted": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"}
      }
    },
    "classes": {
      "description": "Every class present with its file count over all classified files (listed or not), sorted by class.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "file_count"],
        "properties": {
          "class": {"$ref": "#/$defs/class"},
          "file_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "languages": {
      "description": "Program languages with their file counts (class program:<language> only), sorted by language.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "file_count"],
        "properties": {
          "language": {"$ref": "#/$defs/language"},
          "file_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "languages_needing_server": {
      "description": "Program languages present whose buildenv-catalog image ships a language server: the catalog language, the first such image in catalog order and its servers.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "catalog_language", "file_count", "image", "servers"],
        "properties": {
          "language": {"$ref": "#/$defs/language"},
          "catalog_language": {"type": "string", "minLength": 1, "maxLength": 40},
          "file_count": {"type": "integer", "minimum": 1},
          "image": {"type": "string", "minLength": 1, "maxLength": 200},
          "servers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
        }
      }
    },
    "files": {
      "description": "One row per classified file, sorted by path, at most limits.max_rows.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "class", "language", "basis", "interpreter"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
          "bytes": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
          "class": {"$ref": "#/$defs/class"},
          "language": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/language"}]},
          "basis": {"enum": ["path", "name", "suffix", "shebang", "sniff"]},
          "interpreter": {"description": "The shebang interpreter when basis is shebang.",
                          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 40}]}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "detail"],
        "properties": {
          "kind": {"enum": ["path-outside-root", "symlink-skipped", "not-a-file", "unreadable", "rows-overflow",
                            "unknown-text"]},
          "path": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 1024}]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "claim_boundary": {"const": "FILE_CLASSIFICATION_NOT_FINDING"},
    "content_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^[^/\\\\\\r\\n][^\\\\\\r\\n]{0,1023}\\Z"},
    "language": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_+-]{0,39}\\Z"},
    "class": {"oneOf": [{"enum": ["build_system", "documentation", "data_config", "binary_media", "patch_diff",
                                  "generated", "vendored", "unknown_text"]},
                        {"type": "string", "pattern": "^program:[a-z0-9][a-z0-9_+-]{0,39}\\Z"}]}
  }
}
