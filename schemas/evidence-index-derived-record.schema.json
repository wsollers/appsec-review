{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-index-derived-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "producer_job_id", "producer_attempt_id", "producer_contract", "artifact_path", "artifact_sha256", "record_path", "record_sha256", "type_label", "authority", "redaction", "source_snapshot_sha256", "build_lineage_sha256", "partition_ids", "component_ids", "search_text"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^derived_[0-9a-f]{24}$"},
    "producer_job_id": {"type": "string"}, "producer_attempt_id": {"type": "string"},
    "producer_contract": {"type": "string"}, "artifact_path": {"type": "string"},
    "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_path": {"type": "string"}, "record_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "type_label": {"type": "string"},
    "authority": {"enum": ["derived_evidence", "derived_characterization", "untrusted_documented_intent"]},
    "redaction": {"enum": ["unchanged", "redacted", "withheld"]},
    "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "build_lineage_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "partition_ids": {"type": "array", "items": {"type": "string"}},
    "component_ids": {"type": "array", "items": {"type": "string"}},
    "search_text": {"type": "string", "maxLength": 1000}
  }
}
