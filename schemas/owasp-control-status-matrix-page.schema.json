{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-control-status-matrix-page.schema.json",
  "title": "Bounded ordered page of an OWASP control status matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "selection_id", "page_index", "first_row_index", "last_row_index", "row_count", "rows"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-control-status-matrix-page/1.0"},
    "run_id": {"type": "string"},
    "selection_id": {"type": "string"},
    "page_index": {"type": "integer", "minimum": 0},
    "first_row_index": {"type": "integer", "minimum": 0},
    "last_row_index": {"type": "integer", "minimum": 0},
    "row_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "owasp-control-status-row.schema.json"}}
  }
}
