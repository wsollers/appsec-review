{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-review.local/schemas/nvd-snapshot-manifest.schema.json",
  "title": "Immutable NVD JSON 2.0 snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot_id", "feed_id", "feed_schema", "mode", "parent_snapshot_id", "captured_at", "coverage", "cursor", "record_count", "layers", "limitations"],
  "properties": {
    "schema": {"const": "appsec-review/nvd-snapshot-manifest/1"},
    "snapshot_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{16}$"},
    "feed_id": {"const": "nvd"},
    "feed_schema": {"const": "NVD_CVE/2.0"},
    "mode": {"enum": ["bootstrap", "incremental"]},
    "parent_snapshot_id": {"type": ["string", "null"], "pattern": "^sha256-[0-9a-f]{16}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "coverage": {"type": "object"},
    "cursor": {"type": "string", "format": "date-time"},
    "record_count": {"type": "integer", "minimum": 0},
    "layers": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
