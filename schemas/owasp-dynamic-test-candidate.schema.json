{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-dynamic-test-candidate.schema.json",
  "title": "Inert proposed OWASP dynamic-test candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "fragment_id", "target_id", "control_id", "component_id", "obligation_id", "reason_static_is_insufficient", "test_type", "target_environment", "prerequisites", "identity_and_data_requirements", "safety_constraints", "observation_criteria", "pass_criteria", "fail_criteria", "inconclusive_criteria", "capture_requirements", "redaction_requirements", "owner", "reentry_path", "state", "authorization", "execution", "target_contacted", "target_mutated"],
  "properties": {
    "candidate_id": {"type": "string"}, "fragment_id": {"type": "string"},
    "target_id": {"type": "string"}, "control_id": {"type": "string"},
    "component_id": {"type": "string"}, "obligation_id": {"type": "string"},
    "reason_static_is_insufficient": {"type": "string"}, "test_type": {"type": "string"},
    "target_environment": {"type": "string"},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "identity_and_data_requirements": {"type": "array", "items": {"type": "string"}},
    "safety_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observation_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pass_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "fail_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inconclusive_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "capture_requirements": {"type": "array", "items": {"type": "string"}},
    "redaction_requirements": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string"}, "reentry_path": {"type": "string"},
    "state": {"const": "proposed"}, "authorization": {"const": "not_authorized"},
    "execution": {"const": "not_executed"}, "target_contacted": {"const": false},
    "target_mutated": {"const": false}
  }
}
