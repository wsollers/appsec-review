{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-review-pool-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "stage", "decision", "reason", "pool_directory", "pool_outcome", "instance_count", "expansion_sha256", "terminal_manifest_sha256", "merge_sha256"],
  "properties": {
    "schema": {"const": "appsec-review/claim-review-pool-receipt/1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["07-red-team-adversarial", "08-blue-team-refutation", "09-independent-verification", "12-scoring-prioritization"]},
    "decision": {"enum": ["APPLICABLE", "SKIPPED_NA"]},
    "reason": {"type": "string", "minLength": 1},
    "pool_directory": {"type": "string", "minLength": 1},
    "pool_outcome": {"enum": ["EMPTY", "COMPLETE", "DEGRADED", "FAILED", "CANCELED"]},
    "instance_count": {"type": "integer"},
    "expansion_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "terminal_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "merge_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
