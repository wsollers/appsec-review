{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "test-results.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "run_id",
        "execution",
        "raw_sha256",
        "format",
        "outcomes",
        "counts",
        "coverage_gaps"
    ],
    "properties": {
        "schema": {
            "const": "appsec-review/test-results/1"
        },
        "run_id": {
            "type": "string"
        },
        "execution": {
            "$ref": "test-execution-lineage.schema.json"
        },
        "raw_sha256": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "format": {
            "enum": [
                "junit-xml",
                "unsupported"
            ]
        },
        "outcomes": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "test_id",
                    "name",
                    "outcome",
                    "duration_seconds"
                ],
                "properties": {
                    "test_id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "outcome": {
                        "enum": [
                            "passed",
                            "failed",
                            "skipped"
                        ]
                    },
                    "duration_seconds": {
                        "type": "number",
                        "minimum": 0
                    }
                }
            }
        },
        "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passed", "failed", "skipped"],
            "properties": {
                "passed": {"type": "integer", "minimum": 0},
                "failed": {"type": "integer", "minimum": 0},
                "skipped": {"type": "integer", "minimum": 0}
            }
        },
        "coverage_gaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
