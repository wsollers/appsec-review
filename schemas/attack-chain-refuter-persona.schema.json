{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attack-chain-refuter-persona.schema.json",
  "description": "Model-facing reply of one attack-chain-refuter cell (one refutation batch). Judgment only: one outcome per chain of the batch. broken and narrowed name the link or edge (target), the mechanism (which check, sanitisation, validation or precondition at which hop) and at least one citation id: a citation id or fact ref of that chain, or a pinned supporting-evidence file as 'supporting-evidence:<path>[#locator]'. holds and cannot_assess need no target. The orchestrator derives the refuter identity, canonical citations and the chain state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chains"
  ],
  "properties": {
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain_id",
          "disposition"
        ],
        "properties": {
          "chain_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "broken",
              "narrowed",
              "holds",
              "cannot_assess"
            ]
          },
          "target": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "kind",
              "index"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "link",
                  "edge"
                ]
              },
              "index": {
                "type": "integer"
              }
            }
          },
          "mechanism": {
            "type": [
              "string",
              "null"
            ]
          },
          "citation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
