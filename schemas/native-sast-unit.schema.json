{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-sast-unit.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["unit_id", "build_variant", "compile_database", "tools", "leads", "coverage_gaps"],
  "properties": {
    "unit_id": {"type": "string", "minLength": 1},
    "build_variant": {
      "type": "object", "additionalProperties": false,
      "required": ["variant_id", "source", "image_id", "image_digest", "commands_sha256"],
      "properties": {
        "variant_id": {"type": "string", "pattern": "^locked-[0-9a-f]{16}$"},
        "source": {"const": "accepted-native-build-unit"},
        "image_id": {"type": "string", "minLength": 1},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "commands_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "compile_database": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "entries", "adapted_path", "adapted_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "entries": {"type": "integer", "minimum": 1},
        "adapted_path": {"type": "string", "pattern": "^adapted-inputs/[0-9a-f]{16}/compile_commands\\.json$"},
        "adapted_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "tools": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "native-sast-tool.schema.json"}},
    "leads": {"type": "array", "items": {"$ref": "native-sast-lead.schema.json"}},
    "coverage_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
