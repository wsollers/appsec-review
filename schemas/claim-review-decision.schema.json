{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-review-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "decision"],
  "properties": {
    "stage": {"enum": ["07-red-team-adversarial", "08-blue-team-refutation", "09-independent-verification", "12-scoring-prioritization"]},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "reviewer": {"$ref": "claim-lifecycle-actor.schema.json"},
        "verifier": {"$ref": "claim-lifecycle-actor.schema.json"},
        "attacker_case": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["REFUTED", "SURVIVING", "VERIFIED", "UNRESOLVED", "BLOCKED"]},
        "rationale": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "proof_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "claim-lifecycle-proof-obligation.schema.json"}},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "claim-lifecycle-citation.schema.json"}},
        "dissent_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "factors": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["impact", "exploitability", "exposure", "confidence"],
          "properties": {
            "impact": {"enum": [0, 1, 2, 3, 4]},
            "exploitability": {"enum": [0, 1, 2, 3, 4]},
            "exposure": {"enum": [0, 1, 2, 3, 4]},
            "confidence": {"enum": [0, 1, 2, 3, 4]}
          }
        }
      }
    }
  }
}
