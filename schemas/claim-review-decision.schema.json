{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-review-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "decision"],
  "properties": {
    "stage": {"enum": ["07-red-team-adversarial", "08-blue-team-refutation", "09-independent-verification", "12-scoring-prioritization"]},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "cwe": {"type": "object", "additionalProperties": false, "required": ["cwe_id", "rationale"], "properties": {"cwe_id": {"type": "string", "pattern": "^(CWE-)?[1-9][0-9]{0,4}$"}, "rationale": {"type": "string", "minLength": 1}}},
        "cvss_v4": {"type": "object", "additionalProperties": false, "required": ["metrics", "rationale"], "properties": {"metrics": {"type": "object", "additionalProperties": false, "required": ["AV", "AC", "AT", "PR", "UI", "VC", "VI", "VA", "SC", "SI", "SA"], "properties": {"AV": {"enum": ["N", "A", "L", "P"]}, "AC": {"enum": ["L", "H"]}, "AT": {"enum": ["N", "P"]}, "PR": {"enum": ["N", "L", "H"]}, "UI": {"enum": ["N", "P", "A"]}, "VC": {"enum": ["H", "L", "N"]}, "VI": {"enum": ["H", "L", "N"]}, "VA": {"enum": ["H", "L", "N"]}, "SC": {"enum": ["H", "L", "N"]}, "SI": {"enum": ["H", "L", "N"]}, "SA": {"enum": ["H", "L", "N"]}}}, "rationale": {"type": "object", "additionalProperties": false, "required": ["AV", "AC", "AT", "PR", "UI", "VC", "VI", "VA", "SC", "SI", "SA"], "properties": {"AV": {"type": "string", "minLength": 1}, "AC": {"type": "string", "minLength": 1}, "AT": {"type": "string", "minLength": 1}, "PR": {"type": "string", "minLength": 1}, "UI": {"type": "string", "minLength": 1}, "VC": {"type": "string", "minLength": 1}, "VI": {"type": "string", "minLength": 1}, "VA": {"type": "string", "minLength": 1}, "SC": {"type": "string", "minLength": 1}, "SI": {"type": "string", "minLength": 1}, "SA": {"type": "string", "minLength": 1}}}}},
        "remediation": {"type": "object", "additionalProperties": false, "required": ["objective"], "properties": {"objective": {"type": "string", "minLength": 1}, "patch_proposal": {"type": ["string", "null"]}}},
        "reviewer": {"$ref": "claim-lifecycle-actor.schema.json"},
        "verifier": {"$ref": "claim-lifecycle-actor.schema.json"},
        "attacker_case": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["REFUTED", "SURVIVING", "VERIFIED", "UNRESOLVED", "BLOCKED"]},
        "rationale": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "proof_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "claim-lifecycle-proof-obligation.schema.json"}},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "claim-lifecycle-citation.schema.json"}},
        "dissent_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "factors": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["impact", "exploitability", "exposure", "confidence"],
          "properties": {
            "impact": {"enum": [0, 1, 2, 3, 4]},
            "exploitability": {"enum": [0, 1, 2, 3, 4]},
            "exposure": {"enum": [0, 1, 2, 3, 4]},
            "confidence": {"enum": [0, 1, 2, 3, 4]}
          }
        }
      }
    }
  }
}
