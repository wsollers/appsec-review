{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "binary-intelligence.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "run_id",
        "job_id",
        "attempt_id",
        "status",
        "native_build",
        "upstream",
        "authority",
        "image",
        "tool",
        "records",
        "coverage_gaps"
    ],
    "properties": {
        "schema": {
            "const": "appsec-review/binary-intelligence/1"
        },
        "run_id": {
            "type": "string"
        },
        "job_id": {
            "const": "02-binary-intelligence-ingest"
        },
        "attempt_id": {
            "type": "string"
        },
        "status": {
            "enum": ["OK", "OK_WITH_GAPS"]
        },
        "native_build": {"$ref": "binary-evidence-native.schema.json"},
        "upstream": {
            "type":"object","additionalProperties":false,
            "required":["02-binary-triage","02-binary-cfg"],
            "properties":{"02-binary-triage":{"$ref":"binary-evidence-upstream.schema.json"},"02-binary-cfg":{"$ref":"binary-evidence-upstream.schema.json"}}
        },
        "authority": {"$ref": "binary-evidence-authority.schema.json"},
        "image": {"$ref": "binary-evidence-image.schema.json"},
        "tool": {"$ref": "binary-evidence-tool.schema.json"},
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "binary_id",
                    "binary_sha256",
                    "build_identity_sha256",
                    "lead_id",
                    "lead_type",
                    "subject",
                    "citations",
                    "proof_obligation",
                    "gaps"
                ],
                "properties": {
                    "binary_id": {
                        "type": "string"
                    },
                    "binary_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "build_identity_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "lead_id": {
                        "type": "string",
                        "pattern": "^blead_[0-9a-f]{16}$"
                    },
                    "lead_type": {
                        "enum": [
                            "attack-surface",
                            "defense",
                            "dependency",
                            "symbol",
                            "follow-up"
                        ]
                    },
                    "subject": {
                        "type": "string"
                    },
                    "citations": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "job_id",
                                "result_sha256",
                                "binary_id",
                                "record_identity"
                            ],
                            "properties": {
                                "job_id": {
                                    "enum": [
                                        "02-binary-triage",
                                        "02-binary-cfg"
                                    ]
                                },
                                "result_sha256": {
                                    "type": "string",
                                    "pattern": "^sha256:[0-9a-f]{64}$"
                                },
                                "binary_id": {
                                    "type": "string"
                                },
                                "record_identity": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "proof_obligation": {
                        "type": "string",
                        "minLength": 1
                    },
                    "gaps": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "coverage_gaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
