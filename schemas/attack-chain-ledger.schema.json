{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attack-chain-ledger.schema.json",
  "description": "Lane-14 hash-linked attack-chain ledger (ADR-0016 decision 7), bound to the claim-ledger head and the 09 accepted pointer it read. chains[] is the ranked projection of published (non-refuted) chains: each is an attack-chain-record plus its rank (checked in code); refuted chains are counted in dropped[] with the reason. Chains are prioritisation context, never verified findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "claim_ledger_head_sha256",
    "verification_pointer_sha256",
    "entries",
    "head_hash",
    "chains",
    "dropped",
    "gaps",
    "coverage",
    "claim_limits",
    "note"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/attack-chain-ledger/1.0"
    },
    "run_id": {
      "type": "string"
    },
    "claim_ledger_head_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_pointer_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "event_type",
          "chain_id",
          "payload",
          "previous_entry_hash",
          "entry_hash"
        ],
        "properties": {
          "sequence": {
            "type": "integer"
          },
          "event_type": {
            "enum": [
              "chain_composed",
              "chain_refutation",
              "chain_state_derived"
            ]
          },
          "chain_id": {
            "type": "string",
            "pattern": "^chain-[0-9a-f]{24}$"
          },
          "payload": {
            "type": "object"
          },
          "previous_entry_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "entry_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "head_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chain_id",
          "state",
          "rank",
          "causal_claim_ids",
          "links",
          "edges",
          "weakest",
          "refutation",
          "boundaries_crossed"
        ],
        "properties": {
          "rank": {
            "type": "integer"
          },
          "state": {
            "enum": [
              "supported",
              "plausible",
              "hypothesis"
            ]
          },
          "boundaries_crossed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain_id",
          "cluster_id",
          "reason"
        ],
        "properties": {
          "chain_id": {
            "type": "string"
          },
          "cluster_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "id",
          "reason",
          "detail"
        ],
        "properties": {
          "scope": {
            "enum": [
              "input",
              "cluster",
              "chain"
            ]
          },
          "id": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "no-native-facts",
              "input-missing",
              "cluster-cap",
              "cluster-claims-cap",
              "cluster-facts-cap",
              "composer-failed",
              "composer-no-chain",
              "merge-conflict",
              "refutation-cap",
              "refuter-failed",
              "refutation-skipped-budget",
              "synthetic-edge"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object"
    },
    "claim_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_created",
        "severity_assigned"
      ],
      "properties": {
        "finding_created": {
          "const": false
        },
        "severity_assigned": {
          "const": false
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
