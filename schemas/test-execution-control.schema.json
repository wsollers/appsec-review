{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "test-execution-control.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "command_profile_id",
        "unit_id",
        "argv",
        "environment",
        "timeout_seconds",
        "authorization_time",
        "result_format",
        "result_path",
        "coverage_format",
        "coverage_path",
        "grants"
    ],
    "properties": {
        "schema": {
            "const": "appsec-review/test-execution-control/1"
        },
        "command_profile_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "unit_id": {
            "type": "string"
        },
        "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string"
            }
        },
        "environment": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "value"
                ],
                "properties": {
                    "name": {
                        "enum": [
                            "LANG",
                            "LC_ALL",
                            "NO_COLOR",
                            "SOURCE_DATE_EPOCH",
                            "TZ",
                            "XDG_CACHE_HOME"
                        ]
                    },
                    "value": {
                        "type": "string"
                    }
                }
            }
        },
        "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
        },
        "authorization_time": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "result_format": {
            "enum": [
                "junit-xml",
                "unsupported"
            ]
        },
        "result_path": {
            "type": [
                "string",
                "null"
            ]
        },
        "coverage_format": {
            "enum": [
                "lcov",
                "unsupported",
                "none"
            ]
        },
        "coverage_path": {
            "type": [
                "string",
                "null"
            ]
        },
        "grants": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "permission-grant.schema.json"
            }
        }
    }
}
