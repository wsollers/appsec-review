{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-source-lock.schema.json",
  "title": "Pinned Reference Source Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "captured_for", "sources"],
  "properties": {
    "schema": {"const": "appsec-review/reference-source-lock/1.0"},
    "captured_for": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family", "edition", "source_kind", "upstream_url", "immutable_ref",
          "resolved_commit", "tag_object", "license_identifier", "license_path", "raw_includes",
          "expected_record_count"
        ],
        "properties": {
          "family": {"type": "string"},
          "edition": {"type": "string"},
          "source_kind": {"enum": ["asvs_flat_json", "masvs_markdown", "mastg_markdown", "context_markdown", "opencre_csv"]},
          "upstream_url": {"type": "string"},
          "immutable_ref": {"type": "string"},
          "resolved_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "tag_object": {"type": ["string", "null"]},
          "license_identifier": {"type": "string"},
          "license_path": {"type": "string"},
          "raw_includes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "expected_record_count": {"type": "integer"},
          "generated_inputs": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
