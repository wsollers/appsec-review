{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hunter-hypothesis.schema.json",
  "title": "One derived hunter record (the assertion of a hunter candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "hunter",
    "path",
    "start_line",
    "end_line",
    "file_sha256",
    "vulnerability_class",
    "cwe",
    "mechanism",
    "attacker_preconditions",
    "confidence",
    "evidence",
    "component_id",
    "location_check",
    "drop_reason"
  ],
  "properties": {
    "kind": {
      "enum": [
        "hypothesis",
        "dropped"
      ]
    },
    "hunter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "persona_id",
        "shard_id"
      ],
      "properties": {
        "mode": {
          "enum": [
            "general",
            "known-list"
          ]
        },
        "persona_id": {
          "type": "string"
        },
        "shard_id": {
          "type": "string"
        }
      }
    },
    "path": {
      "type": "string"
    },
    "start_line": {
      "type": [
        "integer",
        "null"
      ]
    },
    "end_line": {
      "type": [
        "integer",
        "null"
      ]
    },
    "file_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "vulnerability_class": {
      "type": "string"
    },
    "cwe": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CWE-[0-9]+$"
    },
    "mechanism": {
      "type": "string"
    },
    "attacker_preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "kind",
          "root",
          "path",
          "start_line",
          "end_line"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "target-range",
              "target-deferred",
              "pinned-input",
              "unresolved"
            ]
          },
          "root": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "component_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "location_check": {
      "enum": [
        "pinned",
        "deferred",
        "rejected"
      ]
    },
    "drop_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
