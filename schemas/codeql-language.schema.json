{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codeql-language.schema.json",
  "title": "One CodeQL language node: security-suite leads and retained database pointers (02-codeql-<lang>, ADR-0023)",
  "description": "SKIPPED only with skip_reason not-applicable-language-absent. A compiled language that could not be built, an unsupported extractor, a timeout, OOM or non-zero exit is a coverage gap (OK_WITH_GAPS), never a failure. databases lists every retained database; consumers re-verify tree_sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "job_id",
    "attempt_id",
    "language",
    "source_snapshot_sha256",
    "status",
    "skip_reason",
    "build_modes",
    "tools",
    "leads",
    "databases",
    "coverage_gaps"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/codeql-language/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
    },
    "job_id": {
      "enum": [
        "02-codeql-cpp",
        "02-codeql-csharp",
        "02-codeql-go",
        "02-codeql-java",
        "02-codeql-javascript",
        "02-codeql-python",
        "02-codeql-ruby",
        "02-codeql-rust"
      ]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
    },
    "language": {
      "enum": [
        "cpp",
        "csharp",
        "go",
        "java",
        "javascript",
        "python",
        "ruby",
        "rust"
      ]
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}\\Z"
    },
    "status": {
      "enum": [
        "OK",
        "OK_WITH_GAPS",
        "SKIPPED"
      ]
    },
    "skip_reason": {
      "enum": [
        null,
        "not-applicable-language-absent"
      ]
    },
    "build_modes": {
      "type": "array",
      "items": {
        "enum": [
          "none",
          "traced",
          "autobuild"
        ]
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "tool",
          "version",
          "language",
          "build_mode",
          "query_suite",
          "image_id",
          "image_digest",
          "tool_metadata_sha256",
          "lane_script_sha256",
          "records",
          "dropped_records"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "pattern": "^codeql-[a-z]+(-traced)?\\Z"
          },
          "tool": {
            "const": "codeql"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9][0-9A-Za-z.+_-]{0,31}\\Z"
          },
          "language": {
            "enum": [
              "cpp",
              "csharp",
              "go",
              "java",
              "javascript",
              "python",
              "ruby",
              "rust"
            ]
          },
          "build_mode": {
            "enum": [
              "none",
              "traced",
              "autobuild"
            ]
          },
          "query_suite": {
            "type": "string",
            "pattern": "^codeql/[a-z]+-queries:codeql-suites/[a-z]+-security-extended\\.qls\\Z"
          },
          "image_id": {
            "enum": [
              "audit-codeql",
              "audit-codeql-native"
            ]
          },
          "image_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "tool_metadata_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "lane_script_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "dropped_records": {
            "type": "integer",
            "minimum": 0
          },
          "unit_id": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{1,256}\\Z"
          },
          "database_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^codeqldb_[0-9a-f]{16}\\Z"
          },
          "replay": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "total",
              "ok",
              "failed",
              "refused"
            ],
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "ok": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "refused": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "leads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lead_id",
          "tool_id",
          "rule_id",
          "path",
          "start_line",
          "end_line",
          "source_sha256",
          "language",
          "category"
        ],
        "properties": {
          "lead_id": {
            "type": "string",
            "pattern": "^lead_[0-9a-f]{16}\\Z"
          },
          "tool_id": {
            "type": "string",
            "pattern": "^codeql-[a-z]+(-traced)?\\Z"
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[^\\r\\n]{1,256}\\Z"
          },
          "rule_name": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{1,256}\\Z"
          },
          "cwe": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^CWE-[1-9][0-9]{0,5}\\Z"
            }
          },
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\][^\\r\\n]{0,1023}\\Z"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "language": {
            "enum": [
              "cpp",
              "csharp",
              "go",
              "java",
              "javascript",
              "python",
              "ruby",
              "rust"
            ]
          },
          "category": {
            "const": "codeql-security-query"
          }
        }
      }
    },
    "databases": {
      "type": "array",
      "items": {
        "$ref": "codeql-database-pointer.schema.json"
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
