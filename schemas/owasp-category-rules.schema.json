{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-category-rules.schema.json",
  "title": "OWASP ASVS chapter candidate-search rule table (ADR-0034)",
  "description": "Deterministic rules 04-owasp-candidate-search evaluates per ASVS chapter over the accepted code index, tree-sitter AST and source-SAST results. Every rule kind is answered by one fixed source: calls_to -> code_index calls.callee_name and ts_calls.callee (last name segment, exact); symbol_regex -> methods.name/qualified and ts_functions.name; identifier_regex -> identifiers.name; literal_regex -> literals.value; import_regex -> imports.text; sast_rule_ids -> accepted 02-source-sast results rule_id; entry_point -> methods whose name is a program or framework entry of dep_reachability_engines.ENTRY_POINT_SOURCES[language].names, or a method joined by exports.method_id. Regexes are Python re, applied with re.search to the column value. A hit becomes a candidate at its enclosing function (methods span, else ts_functions span). Path globs are repository-root anchored with component_characterization._glob_regex semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rules_id", "version", "standard", "languages", "exclusions", "chapters"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-category-rules/1.0"},
    "rules_id": {"$ref": "common/formats.schema.json#/$defs/slug"},
    "version": {"$ref": "common/formats.schema.json#/$defs/semver"},
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "edition"],
      "properties": {
        "family": {"const": "owasp_asvs"},
        "edition": {"const": "5.0.0"}
      }
    },
    "languages": {
      "description": "Languages this table has rules for. A source language present in the target but absent here, or not indexed, makes the search incomplete (a gap), never an empty chapter.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/language"}
    },
    "exclusions": {
      "description": "Path classes whose hits are published as excluded with this reason, never dropped silently.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exclusion_id", "reason", "path_globs"],
        "properties": {
          "exclusion_id": {"$ref": "common/formats.schema.json#/$defs/slug"},
          "reason": {"$ref": "#/$defs/exclusion_reason"},
          "path_globs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/glob"}}
        }
      }
    },
    "chapters": {
      "description": "Exactly the 17 ASVS 5.0.0 chapters, in order V1..V17.",
      "type": "array", "minItems": 17, "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter_id", "chapter_name", "scope_note", "rules", "propagation"],
        "properties": {
          "chapter_id": {"$ref": "#/$defs/chapter_id"},
          "chapter_name": {"type": "string", "minLength": 1, "maxLength": 80},
          "scope_note": {"type": "string", "minLength": 1, "maxLength": 600},
          "rules": {
            "description": "May be empty only when scope_note says why no code construct can evidence the chapter for the listed languages; such a chapter is a coverage gap, not N/A.",
            "type": "array",
            "items": {"$ref": "#/$defs/rule"}
          },
          "semantic_queries": {
            "description": "Optional bounded natural-language queries run against the semantic recall index; hits are locators that only widen the candidate set (ADR-0034 addition).",
            "type": "array", "maxItems": 4, "uniqueItems": true,
            "items": {"type": "string", "minLength": 3, "maxLength": 200}
          },
          "propagation": {
            "description": "Optional widening from seed rules of this chapter along resolved code_index calls (resolution not escape/external). V2 uses it from input sources.",
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["seed_rule_ids", "direction", "max_depth"],
                "properties": {
                  "seed_rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/rule_id"}},
                  "direction": {"enum": ["callees", "callers"]},
                  "max_depth": {"type": "integer", "minimum": 1, "maximum": 3}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "chapter_id": {"enum": ["V1", "V2", "V3", "V4", "V5", "V6", "V7", "V8", "V9", "V10", "V11", "V12", "V13", "V14", "V15", "V16", "V17"]},
    "section_id": {"type": "string", "pattern": "^V(?:[1-9]|1[0-7])\\.[1-9][0-9]?\\Z"},
    "language": {"enum": ["c", "cpp", "c_sharp", "go", "java", "javascript", "typescript", "tsx", "php", "python", "ruby", "rust"]},
    "exclusion_reason": {"enum": ["test_code", "documentation", "example_code", "vendored_third_party", "generated_code", "build_system"]},
    "glob": {"type": "string", "pattern": "^[^/\\\\\\r\\n][^\\\\\\r\\n]{0,255}\\Z"},
    "rule_id": {"type": "string", "pattern": "^V(?:[1-9]|1[0-7])-[a-z0-9][a-z0-9-]{0,63}\\Z"},
    "regex": {"type": "string", "minLength": 1, "maxLength": 400},
    "common": {
      "type": "object",
      "required": ["rule_id", "kind", "languages", "sections", "rationale"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/rule_id"},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/language"}},
        "sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/section_id"}},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "rule": {
      "oneOf": [
        {
          "allOf": [{"$ref": "#/$defs/common"}],
          "type": "object",
          "additionalProperties": false,
          "required": ["names"],
          "properties": {
            "rule_id": true, "languages": true, "sections": true, "rationale": true,
            "kind": {"const": "calls_to"},
            "names": {"type": "array", "minItems": 1, "uniqueItems": true,
                      "items": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,127}\\Z"}}
          }
        },
        {
          "allOf": [{"$ref": "#/$defs/common"}],
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern"],
          "properties": {
            "rule_id": true, "languages": true, "sections": true, "rationale": true,
            "kind": {"enum": ["symbol_regex", "identifier_regex", "literal_regex", "import_regex"]},
            "pattern": {"$ref": "#/$defs/regex"}
          }
        },
        {
          "allOf": [{"$ref": "#/$defs/common"}],
          "type": "object",
          "additionalProperties": false,
          "required": ["sast_rule_ids"],
          "properties": {
            "rule_id": true, "languages": true, "sections": true, "rationale": true,
            "kind": {"const": "sast_rule_ids"},
            "sast_rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
                              "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\\Z"}}
          }
        },
        {
          "allOf": [{"$ref": "#/$defs/common"}],
          "type": "object",
          "additionalProperties": false,
          "required": ["entry"],
          "properties": {
            "rule_id": true, "languages": true, "sections": true, "rationale": true,
            "kind": {"const": "entry_point"},
            "entry": {"enum": ["program_main", "framework_handler", "exported_symbol"]}
          }
        }
      ]
    }
  }
}
