{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "test-intelligence.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "run_id",
        "job_id",
        "attempt_id",
        "status",
        "source",
        "sources",
        "records",
        "coverage_gaps",
        "static_only",
        "test_kind_totals"
    ],
    "$defs": {
        "test_kind": {
            "description": "P45: closed test kind from static signals; unknown when no framework is recognised.",
            "enum": ["unit", "integration", "acceptance", "system", "load", "fuzz", "property", "smoke", "unknown"]
        },
        "framework": {
            "description": "P45: closed test framework (static_intelligence_core.FRAMEWORK_SIGNALS).",
            "enum": ["libfuzzer", "cargo-fuzz", "go-fuzz", "atheris", "hypothesis", "proptest", "quickcheck",
                     "k6", "locust", "jmeter", "gatling", "artillery", "wrk", "vegeta",
                     "playwright", "cypress", "selenium", "gherkin", "robot-framework", "behave", "cucumber",
                     "testng", "junit", "nunit", "xunit", "mstest", "go-test", "cargo-test",
                     "googletest", "doctest", "catch2", "unity", "cunit", "ctest", "vitest", "jest", "mocha",
                     "phpunit", "bats", "pester", "autotest", "pytest", "unittest", "shell", "c-harness", "unknown"]
        },
        "test_record": {
            "description": "static-intelligence-record plus the test classification and a path:line citation.",
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "kind", "path", "source_sha256", "locator", "summary", "semantics",
                         "test_kind", "framework", "citation"],
            "properties": {
                "record_id": {"type": "string", "pattern": "^intel_[0-9a-f]{16}\\Z"},
                "kind": {"enum": ["test-entrypoint", "documented-test"]},
                "path": {"type": "string", "minLength": 1},
                "source_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
                "locator": {"type": "string", "pattern": "^(?:file|line:[1-9][0-9]*)\\Z"},
                "summary": {"type": "string"},
                "semantics": {"const": "DOCUMENTED_STATIC_INTENT"},
                "test_kind": {"$ref": "#/$defs/test_kind"},
                "framework": {"$ref": "#/$defs/framework"},
                "citation": {"type": "string", "pattern": "^.+:[1-9][0-9]*\\Z"}
            }
        }
    },
    "properties": {
        "schema": {
            "const": "appsec-review/test-intelligence/1"
        },
        "run_id": {
            "type": "string"
        },
        "job_id": {
            "const": "02-test-intelligence-ingest"
        },
        "attempt_id": {
            "type": "string"
        },
        "status": {
            "$ref": "common/formats.schema.json#/$defs/publishable_status"
        },
        "applicability": {
            "enum": [
                "APPLICABLE",
                "SKIPPED_NA_NO_APPLICABLE_INPUTS"
            ]
        },
        "inventory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "files_examined",
                "non_file_entries",
                "candidates"
            ],
            "properties": {
                "files_examined": {"type": "integer", "minimum": 0},
                "non_file_entries": {"type": "integer", "minimum": 0},
                "candidates": {"type": "integer", "minimum": 0}
            }
        },
        "source": {"$ref":"static-intelligence-binding.schema.json"},
        "sources": {
            "type": "array",
            "items": {
                "$ref": "static-intelligence-source.schema.json"
            }
        },
        "records": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/test_record"
            }
        },
        "test_kind_totals": {
            "description": "P45: test files per test_kind (every kind present, zero when none).",
            "type": "object",
            "additionalProperties": false,
            "required": ["unit", "integration", "acceptance", "system", "load", "fuzz", "property", "smoke", "unknown"],
            "properties": {
                "unit": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
                "integration": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
                "acceptance": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
                "system": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
                "load": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
                "fuzz": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
                "property": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
                "smoke": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
                "unknown": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"}
            }
        },
        "coverage_gaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "static_only": {
            "const": true
        }
    },
    "allOf": [
        {
            "if": {"properties": {"status": {"const": "SKIPPED"}}, "required": ["status"]},
            "then": {
                "required": ["applicability", "inventory"],
                "properties": {
                    "applicability": {"const": "SKIPPED_NA_NO_APPLICABLE_INPUTS"},
                    "inventory": {"properties": {"non_file_entries": {"const": 0}, "candidates": {"const": 0}}},
                    "records": {"maxItems": 0},
                    "coverage_gaps": {"maxItems": 0}
                }
            }
        }
    ]
}
