{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threat-model-reconciliation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "job_id", "attempt_id", "source_snapshot_sha256", "status", "baseline", "current", "citations", "comparison", "unresolved_assumptions", "external_inputs", "conflicts", "actions", "coverage"],
  "properties": {
    "schema": {"const": "appsec-review/threat-model-reconciliation/1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"},
    "job_id": {"const": "03-threat-model-reconciliation"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"},
    "source_snapshot_sha256": {"$ref": "threat-model-reconciliation-sha.schema.json"},
    "status": {"enum": ["OK", "OK_WITH_GAPS"]},
    "baseline": {"$ref": "threat-model-reconciliation-binding.schema.json"},
    "current": {"$ref": "threat-model-reconciliation-binding.schema.json"},
    "citations": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "threat-model-reconciliation-citation.schema.json"}},
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_reproducible", "source_generation_changed", "component_generation_changed", "evidence_generation_changed", "components", "relationships", "model_records"],
      "properties": {
        "baseline_reproducible": {"const": true},
        "source_generation_changed": {"type": "boolean"},
        "component_generation_changed": {"type": "boolean"},
        "evidence_generation_changed": {"type": "boolean"},
        "components": {"$ref": "threat-model-reconciliation-delta.schema.json"},
        "relationships": {"$ref": "threat-model-reconciliation-delta.schema.json"},
        "model_records": {"$ref": "threat-model-reconciliation-delta.schema.json"}
      }
    },
    "unresolved_assumptions": {"type": "array", "items": {"$ref": "threat-model-reconciliation-unresolved.schema.json"}},
    "external_inputs": {"type": "array", "maxItems": 100, "items": {"$ref": "threat-model-reconciliation-external.schema.json"}},
    "conflicts": {"type": "array", "items": {"$ref": "threat-model-reconciliation-conflict.schema.json"}},
    "actions": {"type": "array", "items": {"$ref": "threat-model-reconciliation-action.schema.json"}},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_elements", "baseline_flows", "baseline_hypotheses", "current_components", "current_relationships", "unresolved_assumptions", "external_inputs", "external_inputs_accounted", "citation_ids"],
      "properties": {
        "baseline_elements": {"type": "integer", "minimum": 0},
        "baseline_flows": {"type": "integer", "minimum": 0},
        "baseline_hypotheses": {"type": "integer", "minimum": 0},
        "current_components": {"type": "integer", "minimum": 0},
        "current_relationships": {"type": "integer", "minimum": 0},
        "unresolved_assumptions": {"type": "integer", "minimum": 0},
        "external_inputs": {"type": "integer", "minimum": 0},
        "external_inputs_accounted": {"type": "boolean"},
        "citation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "attempt_id", "accepted_pointer_sha256", "envelope_sha256", "result_sha256", "input_fingerprint", "component_map_sha256", "evidence_manifest_sha256", "source_snapshot_sha256"],
      "properties": {
        "job_id": {"type": "string"}, "attempt_id": {"type": "string"},
        "accepted_pointer_sha256": {"$ref": "#/$defs/sha"}, "envelope_sha256": {"$ref": "#/$defs/sha"},
        "result_sha256": {"$ref": "#/$defs/sha"}, "input_fingerprint": {"$ref": "#/$defs/sha"},
        "component_map_sha256": {"$ref": "#/$defs/sha"}, "evidence_manifest_sha256": {"$ref": "#/$defs/sha"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["citation_id", "producer_job_id", "attempt_id", "path", "sha256", "purpose"],
      "properties": {
        "citation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "producer_job_id": {"type": "string"}, "attempt_id": {"type": "string"},
        "path": {"type": "string", "pattern": "^[^/\\\\](?:[^\\\\]*[^/\\\\])?$"},
        "sha256": {"$ref": "#/$defs/sha"}, "purpose": {"type": "string"}
      }
    },
    "delta": {
      "type": "object", "additionalProperties": false,
      "required": ["added", "removed", "changed", "citation_ids"],
      "properties": {
        "added": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "removed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "changed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "citation_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["assumption_id", "statement", "affected_record_ids", "related_input_ids", "status", "citation_ids"],
      "properties": {
        "assumption_id": {"type": "string"}, "statement": {"type": "string"},
        "affected_record_ids": {"type": "array", "items": {"type": "string"}},
        "related_input_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"const": "unresolved"},
        "citation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "external": {
      "type": "object", "additionalProperties": false,
      "required": ["input_id", "origin", "target_record_id", "statement", "source_identity", "model_identity_sha256", "prompt_sha256", "disposition", "claim_effect", "citation_ids"],
      "properties": {
        "input_id": {"type": "string"}, "origin": {"enum": ["reviewer", "model"]},
        "target_record_id": {"type": ["string", "null"]}, "statement": {"type": "string"},
        "source_identity": {"type": "string"}, "model_identity_sha256": {"type": ["string", "null"]},
        "prompt_sha256": {"type": ["string", "null"]}, "disposition": {"const": "unresolved"},
        "claim_effect": {"const": "none"}, "citation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["conflict_id", "kind", "record_ids", "input_ids", "statement", "status", "citation_ids"],
      "properties": {
        "conflict_id": {"type": "string"}, "kind": {"enum": ["component-change", "relationship-change", "evidence-generation-change", "source-generation-change", "review-input"]},
        "record_ids": {"type": "array", "items": {"type": "string"}}, "input_ids": {"type": "array", "items": {"type": "string"}},
        "statement": {"type": "string"}, "status": {"const": "unresolved"},
        "citation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "kind", "record_ids", "statement", "citation_ids"],
      "properties": {
        "action_id": {"type": "string"}, "kind": {"enum": ["regenerate-l6a", "review-assumption", "review-external-input"]},
        "record_ids": {"type": "array", "items": {"type": "string"}}, "statement": {"type": "string"},
        "citation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
