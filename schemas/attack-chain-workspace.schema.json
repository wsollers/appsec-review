{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attack-chain-workspace.schema.json",
  "description": "One lane-14 cluster request (ADR-0016 decision 5): the link-candidate claims, entry and edge facts, and the seeded adjacency a composer may use. Built by attack_chain_seeds.py and hash-bound into the persona request. Target-derived text (hypotheses, labels) is data, never instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "cluster_id",
    "bounds",
    "rank",
    "claims",
    "facts",
    "adjacency"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/attack-chain-workspace/1.0"
    },
    "run_id": {
      "type": "string"
    },
    "cluster_id": {
      "type": "string",
      "pattern": "^cluster-[0-9a-f]{16}$"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_links_max",
        "chains_per_cluster_max"
      ],
      "properties": {
        "chain_links_max": {
          "type": "integer"
        },
        "chains_per_cluster_max": {
          "type": "integer"
        }
      }
    },
    "rank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p1_claims",
        "verified_claims",
        "boundaries_crossed"
      ],
      "properties": {
        "p1_claims": {
          "type": "integer"
        },
        "verified_claims": {
          "type": "integer"
        },
        "boundaries_crossed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "route_id",
          "source_kind",
          "tier",
          "link_state",
          "verification_status",
          "hypothesis",
          "confidence",
          "component_ids",
          "locations",
          "citation_ids",
          "entry"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "route_id": {
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "tool-lead",
              "hunter",
              "owasp-route",
              "threat-model"
            ]
          },
          "tier": {
            "enum": [
              "P1",
              "P2",
              "P3",
              null
            ]
          },
          "link_state": {
            "enum": [
              "verified",
              "narrowed",
              "open"
            ]
          },
          "verification_status": {
            "enum": [
              "VERIFIED",
              "UNRESOLVED",
              "BLOCKED"
            ]
          },
          "hypothesis": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "unknown",
              "low",
              "medium",
              "high"
            ]
          },
          "component_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "start_line"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "start_line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          },
          "citation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entry": {
            "type": "boolean"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "item_id",
          "locator",
          "kind",
          "label",
          "path",
          "line",
          "function",
          "component_ids",
          "deterministic",
          "entry",
          "entry_reason",
          "artifact"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^[0-9a-z][0-9a-z-]*#.+$"
          },
          "item_id": {
            "type": "string"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "cpg-method",
              "cpg-call",
              "cpg-identifier",
              "ir-pointer-arithmetic",
              "ir-memory-read",
              "ir-memory-write",
              "ir-memory-intrinsic",
              "tm-element",
              "tm-flow",
              "cm-relationship"
            ]
          },
          "label": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "function": {
            "type": [
              "string",
              "null"
            ]
          },
          "component_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "deterministic": {
            "type": "boolean"
          },
          "entry": {
            "type": "boolean"
          },
          "entry_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "adjacency": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "from",
          "to",
          "basis",
          "fact_refs",
          "reason"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "pattern": "^adj-[0-9a-f]{16}$"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "code_fact",
              "model_flow",
              "co_located"
            ]
          },
          "fact_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
