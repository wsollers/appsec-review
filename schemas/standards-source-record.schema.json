{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standards-source-record.schema.json",
  "title": "Run-owned Standards Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "family", "edition", "snapshot_id", "manifest_sha256", "license", "extractor", "record_type", "record_id", "record_sha256", "source", "record"],
  "properties": {
    "schema": {"const": "appsec-review/standards-source-record/1.0"},
    "family": {"type": "string"},
    "edition": {"type": "string"},
    "snapshot_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{16}$"},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "path", "sha256"],
      "properties": {
        "identifier": {"type": "string"}, "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "extractor": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "source_path"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "source_path": {"type": "string"}}
    },
    "record_type": {"enum": ["control", "test", "context_category", "crosswalk"]},
    "record_id": {"type": "string", "minLength": 1},
    "record_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_path", "catalog_sha256", "raw_paths"],
      "properties": {
        "catalog_path": {"const": "normalized/catalog.json"},
        "catalog_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "raw_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "record": {"type": "object"}
  }
}
