{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "binary-cfg.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "run_id",
        "job_id",
        "attempt_id",
        "status",
        "native_build",
        "upstream",
        "authority",
        "image",
        "tool",
        "records",
        "coverage_gaps"
    ],
    "properties": {
        "schema": {
            "const": "appsec-review/binary-cfg/1"
        },
        "run_id": {
            "type": "string"
        },
        "job_id": {
            "const": "02-binary-cfg"
        },
        "attempt_id": {
            "type": "string"
        },
        "status": {
            "enum": ["OK", "OK_WITH_GAPS"]
        },
        "native_build": {"$ref": "binary-evidence-native.schema.json"},
        "upstream": {
            "type":"object","additionalProperties":false,
            "required":["02-debug-symbol-index","02-binary-triage"],
            "properties":{"02-debug-symbol-index":{"$ref":"binary-evidence-upstream.schema.json"},"02-binary-triage":{"$ref":"binary-evidence-upstream.schema.json"}}
        },
        "authority": {"$ref": "binary-evidence-authority.schema.json"},
        "image": {"$ref": "binary-evidence-image.schema.json"},
        "tool": {"$ref": "binary-evidence-tool.schema.json"},
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "binary_id",
                    "binary_sha256",
                    "build_identity_sha256",
                    "architecture",
                    "functions",
                    "edges",
                    "gaps"
                ],
                "properties": {
                    "binary_id": {
                        "type": "string"
                    },
                    "binary_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "build_identity_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "architecture": {
                        "type": "string"
                    },
                    "functions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "address",
                                "name",
                                "block_count",
                                "symbol_id",
                                "function_id"
                            ],
                            "properties": {
                                "address": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "block_count": {
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "symbol_id": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "function_id": {
                                    "type": "string",
                                    "pattern": "^fn_[0-9a-f]{16}$"
                                }
                            }
                        }
                    },
                    "edges": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "caller_function_id",
                                "callee_function_id",
                                "call_site"
                                ,"edge_id"
                            ],
                            "properties": {
                                "caller_function_id": {
                                    "type": "string"
                                },
                                "callee_function_id": {
                                    "type": "string"
                                },
                            "call_site": {
                                "type": "string"
                            },
                            "edge_id": {"type":"string","pattern":"^edge_[0-9a-f]{16}$"}
                            }
                        }
                    },
                    "gaps": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "coverage_gaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "$defs": {
        "upstream": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "attempt_id",
                "contract_id",
                "result_sha256",
                "envelope_sha256"
            ],
            "properties": {
                "attempt_id": {
                    "type": "string"
                },
                "contract_id": {
                    "type": "string"
                },
                "result_sha256": {
                    "$ref": "debug-symbol-index.schema.json#/$defs/hash"
                },
                "envelope_sha256": {
                    "$ref": "debug-symbol-index.schema.json#/$defs/hash"
                }
            }
        }
    }
}
