    "handoff": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "accepted_pointer_path", "accepted_pointer_sha256", "handoff_set_path", "handoff_set_sha256", "member_path", "member_sha256"], "properties": {"attempt_id": {"type": "string"}, "accepted_pointer_path": {"type": "string"}, "accepted_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "handoff_set_path": {"type": "string"}, "handoff_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "member_path": {"type": "string"}, "member_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
