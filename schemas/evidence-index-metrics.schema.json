              "TypeScript",
              "VHDL",
              "Verilog",
              "Visual Basic",
              "Vue",
              "XML",
              "YAML",
              "Zig",
              "gettext",
              "reStructuredText",
              "unclassified"
            ]
          },
          "files": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "text_files": {
            "type": "integer"
          },
          "lines": {
            "type": "integer"
          },
          "blank_lines": {
            "type": "integer"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "language",
          "content",
          "files",
          "bytes",
          "lines",
          "blank_lines"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "first-party",
              "generated",
              "review-evidence",
              "vendored"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "Assembly",
              "Batch",
              "C",
              "C#",
              "C++",
              "C/C++ Header",
              "CMake",
              "CSS",
              "CSV",
              "Clojure",
