              "undecodable"
            ]
          },
          "files": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "lines": {
            "type": [
              "integer",
              "null"
            ]
          },
          "blank_lines": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
