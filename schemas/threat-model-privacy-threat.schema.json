{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threat-model-privacy-threat.schema.json",
  "title": "Threat-model privacy threat (LINDDUN candidate)",
  "description": "L13 privacy overlay (ADR-0019): a LINDDUN-category candidate threat keyed to DFD elements, flows and data classes. regulatory_candidate_notes are candidate mappings only, never a compliance verdict.",
  "type": "object",
  "required": [
    "privacy_threat_id",
    "linddun_category",
    "statement",
    "target_element_ids",
    "target_flow_ids",
    "data_class_ids",
    "proof_obligations",
    "regulatory_candidate_notes",
    "evidence_class",
    "confidence",
    "citations",
    "originating_workcell_id"
  ],
  "additionalProperties": false,
  "properties": {
    "privacy_threat_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "linddun_category": {
      "type": "string",
      "enum": [
        "linking",
        "identifying",
        "non_repudiation",
        "detecting",
        "data_disclosure",
        "unawareness",
        "non_compliance"
      ]
    },
    "statement": {
      "type": "string"
    },
    "target_element_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "target_flow_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "data_class_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "proof_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regulatory_candidate_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "DIRECT_EVIDENCE",
        "STRONG_INFERENCE",
        "WEAK_INFERENCE",
        "FOLLOW_ON_REQUIRED"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "threat-model-citation.schema.json"
      }
    },
    "originating_workcell_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
