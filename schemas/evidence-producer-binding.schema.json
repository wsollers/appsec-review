{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence-producer-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "producer_job_id", "accepted_pointer_sha256", "envelope_sha256", "permission_sha256", "lineage_sha256"],
  "properties": {
    "schema": {"const": "appsec-review/evidence-producer-binding/1.0"},
    "producer_job_id": {"type": "string", "pattern": "^02-[a-z0-9][a-z0-9-]{0,92}\\Z"},
    "accepted_pointer_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
    "envelope_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
    "permission_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
    "lineage_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"}
  }
}
