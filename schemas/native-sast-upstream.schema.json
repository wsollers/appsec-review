{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-sast-upstream.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["job_id", "attempt_id", "fingerprint", "pointer_sha256", "envelope_sha256", "result_sha256", "source_revision"],
  "properties": {
    "job_id": {"const": "02-native-build"}, "attempt_id": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pointer_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "envelope_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "minLength": 1}
  }
}
