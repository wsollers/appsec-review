{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-review-pool-persona.schema.json",
  "description": "Model-facing reply for the stage claim-review pool (07/08/09/12). The reviewer supplies judgment only: one decision per upstream claim_id, the upstream citation ids and proof-obligation ids it relies on, and its verdict text. The orchestrator derives candidate ids, reviewer/verifier identity, canonical citation objects, obligation statements and the serialized assertion, then validates claim-review-pool-candidates.schema.json and claim-review-decision.schema.json. Which optional fields a stage requires is stated by the trusted runtime block.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "attack_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}, "description": "Optional at 07: MITRE ATT&CK technique ids (T<nnnn> or T<nnnn>.<nnn>) labelling the attacker case. A label, never evidence; validated against the pinned MITRE snapshot and dropped with a recorded gap when unknown, deprecated or when the snapshot is missing or stale."},
          "capec_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}, "description": "Optional at 07: CAPEC ids (CAPEC-<n>) labelling the attack pattern. A label, never evidence; validated like attack_refs."},
          "cwe": {"type": "object", "additionalProperties": false, "required": ["cwe_id", "rationale"], "properties": {"cwe_id": {"type": "string", "pattern": "^(CWE-)?[1-9][0-9]{0,4}$"}, "rationale": {"type": "string", "minLength": 1}}, "description": "Optional at 07/09/12: the weakness this claim instantiates, as CWE-<n> from the pinned catalog, with a one-line rationale. Omit when unsure; never guess."},
          "cvss_v4": {"type": "object", "additionalProperties": false, "required": ["metrics", "rationale"], "properties": {"metrics": {"type": "object", "additionalProperties": false, "required": ["AV", "AC", "AT", "PR", "UI", "VC", "VI", "VA", "SC", "SI", "SA"], "properties": {"AV": {"enum": ["N", "A", "L", "P"]}, "AC": {"enum": ["L", "H"]}, "AT": {"enum": ["N", "P"]}, "PR": {"enum": ["N", "L", "H"]}, "UI": {"enum": ["N", "P", "A"]}, "VC": {"enum": ["H", "L", "N"]}, "VI": {"enum": ["H", "L", "N"]}, "VA": {"enum": ["H", "L", "N"]}, "SC": {"enum": ["H", "L", "N"]}, "SI": {"enum": ["H", "L", "N"]}, "SA": {"enum": ["H", "L", "N"]}}}, "rationale": {"type": "object", "additionalProperties": false, "required": ["AV", "AC", "AT", "PR", "UI", "VC", "VI", "VA", "SC", "SI", "SA"], "properties": {"AV": {"type": "string", "minLength": 1}, "AC": {"type": "string", "minLength": 1}, "AT": {"type": "string", "minLength": 1}, "PR": {"type": "string", "minLength": 1}, "UI": {"type": "string", "minLength": 1}, "VC": {"type": "string", "minLength": 1}, "VI": {"type": "string", "minLength": 1}, "VA": {"type": "string", "minLength": 1}, "SC": {"type": "string", "minLength": 1}, "SI": {"type": "string", "minLength": 1}, "SA": {"type": "string", "minLength": 1}}}}, "description": "12 only, VERIFIED claims: the eleven CVSS v4.0 base metric values and one justification per metric. The orchestrator computes the vector, score and severity; do not supply them."},
          "remediation": {"type": "object", "additionalProperties": false, "required": ["objective"], "properties": {"objective": {"type": "string", "minLength": 1}, "patch_proposal": {"type": ["string", "null"]}}, "description": "12 only, VERIFIED claims, optional: remediation objective and an optional patch proposal. Published as PATCH_PROPOSED_UNVALIDATED."},
          "attacker_case": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["REFUTED", "SURVIVING", "VERIFIED", "UNRESOLVED", "BLOCKED"]},
          "rationale": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "citation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "proof_obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["obligation_id", "status"],
              "properties": {
                "obligation_id": {"type": "string", "minLength": 1},
                "status": {"enum": ["OPEN", "SATISFIED", "FAILED", "UNRESOLVED"]},
                "citation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "dissent_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "factors": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["impact", "exploitability", "exposure", "confidence"],
            "properties": {
              "impact": {"enum": [0, 1, 2, 3, 4]},
              "exploitability": {"enum": [0, 1, 2, 3, 4]},
              "exposure": {"enum": [0, 1, 2, 3, 4]},
              "confidence": {"enum": [0, 1, 2, 3, 4]}
            }
          }
        }
      }
    }
  }
}
