{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "claim-decision-ledger.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "run_id", "job_id", "attempt_id", "source_generation", "component_generation", "entries", "head_hash", "claim_states", "claim_limits"],
  "properties": {
    "schema": {"const": "appsec-review/claim-decision-ledger/1.0"}, "run_id": {"type": "string"}, "job_id": {"const": "claim-ledger-routing"}, "attempt_id": {"type": "string"},
    "source_generation": {"type": "string"}, "component_generation": {"type": "string"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "claim-ledger-entry.schema.json"}},
    "head_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claim_states": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "latest_event_id", "status"], "properties": {"claim_id": {"type": "string"}, "latest_event_id": {"type": "string"}, "status": {"enum": ["candidate", "under_review", "narrowed", "verified", "refuted", "unresolved", "superseded"]}}}},
    "claim_limits": {"type": "object", "additionalProperties": false, "required": ["candidate_only", "finding_created", "severity_assigned", "runtime_claimed", "compliance_claimed"], "properties": {"candidate_only": {"const": true}, "finding_created": {"const": false}, "severity_assigned": {"const": false}, "runtime_claimed": {"const": false}, "compliance_claimed": {"const": false}}}
  }
}
