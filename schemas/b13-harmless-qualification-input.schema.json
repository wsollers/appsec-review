{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "b13-harmless-qualification-input.schema.json",
  "title": "B13 harmless-container qualification input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "permission"],
  "properties": {
    "schema": {"const": "appsec-review/b13-harmless-qualification-input/1.0"},
    "mode": {"type": "string", "enum": ["success", "exit-nonzero"]},
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "grants"],
      "properties": {
        "requirement": {"$ref": "permission-requirement.schema.json"},
        "grants": {"type": "array", "items": {"$ref": "permission-grant.schema.json"}}
      }
    }
  }
}
