{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intel-manifest-producer.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["job_id", "contract", "disposition", "attempt_id", "input_fingerprint", "execution_status", "accepted_pointer_sha256", "envelope_sha256", "source_snapshot_sha256", "producer_source_snapshot_sha256", "build_lineage_sha256", "permissions", "artifacts", "gaps", "skip_reason"],
  "properties": {
    "job_id": {"type": "string"}, "contract": {"type": "string"},
    "disposition": {"enum": ["accepted", "authorized-skip", "missing"]},
    "attempt_id": {"type": ["string", "null"]}, "input_fingerprint": {"type": ["string", "null"]},
    "execution_status": {"type": ["string", "null"]},
    "accepted_pointer_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "envelope_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_snapshot_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "producer_source_snapshot_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "build_lineage_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"$ref": "intel-manifest-artifact.schema.json"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "skip_reason": {"type": ["string", "null"]}
  }
}
