{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output-contract.schema.json",
  "title": "Composable Review Output Contract",
  "type": "object",
  "required": [
    "schema",
    "contract_id",
    "display_name",
    "required_files",
    "required_status_fields",
    "validation_rules"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "appsec-review/output-contract/0.1"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string"
    },
    "required_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_status_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_schema": {
      "type": "object",
      "required": ["artifact", "schema_file"],
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string"
        },
        "schema_file": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*\\.schema\\.json$"
        }
      }
    },
    "claim_class": {
      "type": "object",
      "required": ["claim_class_id", "allowed_assertions", "forbidden_promotions"],
      "additionalProperties": false,
      "properties": {
        "claim_class_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "allowed_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "forbidden_promotions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["finding", "severity", "runtime-state"]
          }
        }
      }
    }
  }
}
