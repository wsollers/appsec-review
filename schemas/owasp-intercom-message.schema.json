{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-intercom-message.schema.json",
  "title": "Accepted T08 structured intercom message",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "message_id", "run_id", "selection_id", "applicability_identity", "worklist_identity", "batch_identity", "handoff_identity", "hashes", "producer", "sender", "recipient", "message_type", "claim_class", "subject", "citations", "evidence_locators", "requested_action", "response_to", "disputed_identity", "current_decision", "mapping_lineage", "tool_activity", "derived_outputs", "corroborates_message_ids", "assertions", "limitations", "contradictions", "unresolved_conditions", "occurred_at", "t07_reference", "acknowledgements", "publication"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-intercom-message/1.0"},
    "message_id": {"type": "string", "pattern": "^intercom-[0-9a-f]{20}$"},
    "run_id": {"type": "string"}, "selection_id": {"type": "string"},
    "applicability_identity": {"type": "object"}, "worklist_identity": {"type": "object"},
    "batch_identity": {"type": "object"}, "handoff_identity": {"type": "object"},
    "hashes": {"type": "object"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["producer_id", "producer_kind"], "properties": {"producer_id": {"type": "string"}, "producer_kind": {"enum": ["validator", "external_validator", "reviewer", "workcell"]}}},
    "sender": {"type": "object", "additionalProperties": false, "required": ["identity", "role"], "properties": {"identity": {"type": ["string", "null"]}, "role": {"type": "string"}}},
    "recipient": {"type": "object", "additionalProperties": false, "required": ["identity", "role"], "properties": {"identity": {"type": ["string", "null"]}, "role": {"type": "string"}}},
    "message_type": {"enum": ["evidence_locator", "applicability_challenge", "component_classification_challenge", "assistance_request", "assistance_response", "duplicate_crosswalk_notice", "dissent", "dynamic_test_candidate"]},
    "claim_class": {"enum": ["navigation_hint", "proposal", "assistance", "routing_metadata", "dissent", "proposed_dynamic_request"]},
    "subject": {"type": "object", "additionalProperties": false, "required": ["control_ids", "component_ids", "fragment_ids", "proof_obligation_ids"], "properties": {"control_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "component_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "fragment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "proof_obligation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "citations": {"type": "array", "items": {"$ref": "owasp-intercom-citation.schema.json"}},
    "evidence_locators": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["locator_id", "input_id", "artifact_path", "artifact_sha256", "locator", "canonical_evidence"], "properties": {"locator_id": {"type": "string"}, "input_id": {"type": "string"}, "artifact_path": {"type": "string"}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "locator": {"type": "string"}, "canonical_evidence": {"const": false}}}},
    "requested_action": {"type": "string", "minLength": 1}, "response_to": {"type": ["string", "null"]},
    "disputed_identity": {"type": ["object", "null"]}, "current_decision": {"type": ["object", "null"]},
    "mapping_lineage": {"type": "array", "items": {"type": "object"}},
    "tool_activity": {"type": "array", "items": {"type": "object"}},
    "derived_outputs": {"type": "array", "items": {"type": "object"}},
    "corroborates_message_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "assertions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "unresolved_conditions": {"type": "array", "items": {"type": "string"}}, "occurred_at": {"type": "string"},
    "t07_reference": {"type": ["object", "null"]},
    "acknowledgements": {"type": "object", "additionalProperties": false, "required": ["messages_are_not_evidence_or_authority", "referenced_artifacts_untrusted", "prohibited_claims_acknowledged", "dynamic_execution_authorized", "dynamic_execution_performed", "manual_observation_authorized", "manual_observation_performed", "target_contacted", "target_mutated", "crosswalks_are_not_evidence", "authority_unchanged", "personal_data_minimized", "secrets_included"], "properties": {"messages_are_not_evidence_or_authority": {"const": true}, "referenced_artifacts_untrusted": {"const": true}, "prohibited_claims_acknowledged": {"const": true}, "dynamic_execution_authorized": {"const": false}, "dynamic_execution_performed": {"const": false}, "manual_observation_authorized": {"const": false}, "manual_observation_performed": {"const": false}, "target_contacted": {"const": false}, "target_mutated": {"const": false}, "crosswalks_are_not_evidence": {"const": true}, "authority_unchanged": {"const": true}, "personal_data_minimized": {"const": true}, "secrets_included": {"const": false}}},
    "publication": {"type": "object", "additionalProperties": false, "required": ["sequence", "candidate_path", "candidate_sha256", "previous_ledger_head_id", "previous_ledger_head_hash", "published_at"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "candidate_path": {"type": "string"}, "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "previous_ledger_head_id": {"type": ["string", "null"]}, "previous_ledger_head_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "published_at": {"type": "string"}}}
  }
}
