{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-control-status-matrix.schema.json",
  "title": "Deterministically joined OWASP control status matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "selection_id", "selection", "permissions", "evidence_admitted_at", "provenance", "denominators", "applicability_counts", "assessment_counts", "dispatch_cells", "rows", "claim_limits"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-control-status-matrix/1.0"},
    "run_id": {"type": "string"},
    "selection_id": {"type": "string"},
    "selection": {"$ref": "standard-selection.schema.json"},
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["static_inspection", "dynamic_execution", "manual_observation", "network_access", "target_mutation"],
      "properties": {"static_inspection": {"const": true}, "dynamic_execution": {"const": false}, "manual_observation": {"const": false}, "network_access": {"const": false}, "target_mutation": {"const": false}}
    },
    "evidence_admitted_at": {"type": "string"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["dispatch_attempt_id", "dispatch_accounting_sha256", "handoff_attempt_id", "handoff_set_sha256", "worklist_sha256", "applicability_model_sha256", "input_manifest_sha256"],
      "properties": {
        "dispatch_attempt_id": {"type": "string"}, "dispatch_accounting_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "handoff_attempt_id": {"type": "string"}, "handoff_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "worklist_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "applicability_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "denominators": {
      "type": "object", "additionalProperties": false,
      "required": ["selected", "applicable", "assessed", "satisfied"],
      "properties": {"selected": {"type": "integer", "minimum": 0}, "applicable": {"type": "integer", "minimum": 0}, "assessed": {"type": "integer", "minimum": 0}, "satisfied": {"type": "integer", "minimum": 0}}
    },
    "applicability_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["applicable", "conditional", "not_applicable", "cannot_determine", "out_of_scope"],
      "properties": {"applicable": {"type": "integer", "minimum": 0}, "conditional": {"type": "integer", "minimum": 0}, "not_applicable": {"type": "integer", "minimum": 0}, "cannot_determine": {"type": "integer", "minimum": 0}, "out_of_scope": {"type": "integer", "minimum": 0}}
    },
    "assessment_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["satisfied", "partially_satisfied", "not_satisfied", "cannot_verify", "dynamic_test_required", "human_decision_required", "not_assessed", "not_applicable", "cannot_determine", "out_of_scope"],
      "properties": {"satisfied": {"type": "integer", "minimum": 0}, "partially_satisfied": {"type": "integer", "minimum": 0}, "not_satisfied": {"type": "integer", "minimum": 0}, "cannot_verify": {"type": "integer", "minimum": 0}, "dynamic_test_required": {"type": "integer", "minimum": 0}, "human_decision_required": {"type": "integer", "minimum": 0}, "not_assessed": {"type": "integer", "minimum": 0}, "not_applicable": {"type": "integer", "minimum": 0}, "cannot_determine": {"type": "integer", "minimum": 0}, "out_of_scope": {"type": "integer", "minimum": 0}}
    },
    "dispatch_cells": {"type": "array", "items": {"$ref": "owasp-dispatch-cell.schema.json"}},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "owasp-control-status-row.schema.json"}},
    "claim_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_created", "severity_assigned", "runtime_state_claimed", "compliance_certified", "status_upgrade_permitted"],
      "properties": {"finding_created": {"const": false}, "severity_assigned": {"const": false}, "runtime_state_claimed": {"const": false}, "compliance_certified": {"const": false}, "status_upgrade_permitted": {"const": false}}
    }
  }
}
