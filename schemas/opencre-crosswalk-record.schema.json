{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opencre-crosswalk-record.schema.json",
  "title": "OpenCRE Crosswalk Reference Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "record_type", "record_id", "cre_path", "cre_leaf_id", "description", "tags", "mappings", "source"],
  "properties": {
    "schema": {"const": "appsec-review/opencre-crosswalk-record/1.0"},
    "record_type": {"const": "crosswalk"},
    "record_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cre_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cre_id", "title"],
        "properties": {"cre_id": {"type": "string"}, "title": {"type": "string"}}
      }
    },
    "cre_leaf_id": {"type": "string"},
    "description": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["standard", "section_id", "section_name", "version", "link_type"],
        "properties": {
          "standard": {"type": "string"},
          "section_id": {"type": "string"},
          "section_name": {"type": "string"},
          "subsection": {"type": "string"},
          "hyperlink": {"type": "string"},
          "description": {"type": "string"},
          "version": {"type": "string"},
          "tooltype": {"type": "string"},
          "link_type": {"type": "string"}
        }
      }
    },
    "source": {"$ref": "owasp-source-citation.schema.json"}
  }
}
