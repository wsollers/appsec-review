{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "binary-hardening-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "source_snapshot_sha256",
    "native_build",
    "binaries"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/binary-hardening-input/1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "native_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "pointer_sha256",
        "result_sha256",
        "envelope_sha256"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "pointer_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "envelope_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "binaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_artifact_path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^binaries/[^/].*"
          },
          "source_artifact_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
