{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dependency-reachability.schema.json",
  "title": "Per-match dependency reachability (06-cve-reachability outputs/dependency-reachability.json, ADR-0022, ADR-0023)",
  "description": "One record per accepted SCA match: the advisory symbols used (with their source), each engine's state, the joined verdict and, for reachable, a hash-bound witness from an entry point to the call into the vulnerable dependency symbol. Everything is derived by dep_reachability.py; there is no free-text judgement field. unknown is never 'not vulnerable'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "job_id",
    "attempt_id",
    "source_snapshot_sha256",
    "sca_binding",
    "engines",
    "osv",
    "entry_points",
    "counts",
    "matches",
    "coverage_gaps",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/dependency-reachability/1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
    },
    "job_id": {
      "const": "06-cve-reachability"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}\\Z"
    },
    "sca_binding": {
      "type": "object"
    },
    "engines": {
      "type": "object",
      "description": "Identity (hashes) of every engine input the attempt read."
    },
    "osv": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "data_timestamp",
        "gaps"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "data_timestamp": {
          "type": "string"
        },
        "gaps": {
          "type": "array"
        }
      }
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reachable",
        "unreachable",
        "unknown"
      ],
      "properties": {
        "reachable": {
          "type": "integer",
          "minimum": 0
        },
        "unreachable": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "conflict": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "$ref": "dependency-reachability-match.schema.json"
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "claim_ceiling": {
      "const": "EVIDENCE_LEADS_ONLY"
    }
  }
}
