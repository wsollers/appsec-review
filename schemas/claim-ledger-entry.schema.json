{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "claim-ledger-entry.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["sequence", "event_id", "event_type", "claim_id", "route_id", "claim_class", "hypothesis", "status", "confidence", "component_ids", "source_generation", "component_generation", "producer", "citations", "proof_obligations", "dissent_ids", "causal_claim_ids", "supersedes_claim_id", "from_status", "decision_authority", "previous_entry_hash", "entry_hash"],
  "properties": {
    "sequence": {"type": "integer", "minimum": 0}, "event_id": {"type": "string", "pattern": "^event-[0-9a-f]{24}$"},
    "event_type": {"enum": ["candidate_admitted", "status_decision"]}, "claim_id": {"type": "string", "pattern": "^claim-[0-9a-f]{24}$"},
    "route_id": {"type": "string"}, "claim_class": {"const": "candidate_only"}, "hypothesis": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "under_review", "narrowed", "verified", "refuted", "unresolved", "superseded"]},
    "confidence": {"enum": ["unknown", "low", "medium", "high"]}, "component_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_generation": {"type": "string"}, "component_generation": {"type": "string"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["contract_id", "job_id", "attempt_id", "artifact_path", "artifact_sha256", "accepted_pointer_sha256"],
      "properties": {"contract_id": {"type": "string"}, "job_id": {"type": "string"}, "attempt_id": {"type": "string"}, "artifact_path": {"type": "string"}, "artifact_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "accepted_pointer_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}}},
    "citations": {"type": "array", "minItems": 1, "items": {"$ref": "claim-ledger-citation.schema.json"}},
    "proof_obligations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "statement"], "properties": {"obligation_id": {"type": "string"}, "statement": {"type": "string"}}}},
    "dissent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "causal_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "supersedes_claim_id": {"type": ["string", "null"]}, "from_status": {"type": ["string", "null"]},
    "decision_authority": {"type": ["object", "null"], "additionalProperties": false, "required": ["job_id", "attempt_id", "role_id", "source_generation", "component_generation", "artifact_path", "artifact_sha256", "permission_receipt_path", "permission_receipt_sha256", "reason"],
      "properties": {"job_id": {"type": "string"}, "attempt_id": {"type": "string"}, "role_id": {"type": "string"}, "source_generation": {"type": "string"}, "component_generation": {"type": "string"}, "artifact_path": {"type": "string"}, "artifact_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "permission_receipt_path": {"type": "string"}, "permission_receipt_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "reason": {"type": "string"}}},
    "previous_entry_hash": {"type": ["string", "null"], "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "entry_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
