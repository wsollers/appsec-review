{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-index-derived.schema.json",
  "title": "02-evidence-index-derived result (evidence-index-derived.json)",
  "description": "The post-producer derived index. selection lists every enrichment profile: included producers (admitted accepted publications of this run's source generation) and excluded ones with disposition and reason; each exclusion is also a coverage gap. build_inputs summarizes the accepted 02-native-build build-input corpus (build-dependencies records, generated headers, out-of-checkout headers whose bytes are not retained). text lists every text document offered (generated headers, producer derived-text-manifest documents) with its indexing status. The records themselves are in evidence-index-enrichment.json; the searchable rows are in the SQLite database, whose logical rows hash to content_sha256. Rows are locators, never findings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "status", "source_snapshot_sha256", "index", "selection", "build_inputs", "enrichment", "text", "content_sha256", "sqlite", "limits", "coverage_gaps", "claim_boundary"],
  "$defs": {
    "sha": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
    "count": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"}
  },
  "properties": {
    "schema": {"const": "appsec-review/evidence-index-derived/1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"$ref": "common/formats.schema.json#/$defs/ok_status"},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha"},
    "index": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "accepted_pointer_sha256", "source_snapshot_sha256"],
      "properties": {"attempt_id": {"type": "string"}, "accepted_pointer_sha256": {"$ref": "#/$defs/sha"},
                     "source_snapshot_sha256": {"$ref": "#/$defs/sha"}}
    },
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["job_id", "attempt_id", "pointer_sha256", "artifact_path", "artifact_sha256"],
          "properties": {"job_id": {"type": "string"}, "attempt_id": {"type": "string"},
                         "pointer_sha256": {"$ref": "#/$defs/sha"}, "artifact_path": {"type": "string"},
                         "artifact_sha256": {"$ref": "#/$defs/sha"}}}},
        "excluded": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["job_id", "disposition", "reason"],
          "properties": {"job_id": {"type": "string"},
                         "disposition": {"enum": ["absent", "skipped", "failed", "not-admissible", "other-generation", "not-selectable", "not-indexable"]},
                         "reason": {"type": "string", "minLength": 1}}}}
      }
    },
    "build_inputs": {
      "type": "object", "additionalProperties": false, "required": ["status", "attempt_id", "units"],
      "properties": {
        "status": {"enum": ["indexed", "absent", "skipped", "failed"]},
        "attempt_id": {"type": ["string", "null"]},
        "units": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["unit_id", "build_dependencies", "records", "generated_headers", "generated_headers_omitted_at_build", "out_of_checkout_headers"],
          "properties": {
            "unit_id": {"type": "string"},
            "build_dependencies": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
              "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}}}]},
            "records": {"$ref": "#/$defs/count"}, "generated_headers": {"$ref": "#/$defs/count"},
            "generated_headers_omitted_at_build": {"$ref": "#/$defs/count"},
            "out_of_checkout_headers": {"$ref": "#/$defs/count"}}}}
      }
    },
    "enrichment": {
      "type": "object", "additionalProperties": false, "required": ["artifact", "sha256", "record_count", "producer_count"],
      "properties": {"artifact": {"const": "evidence-index-enrichment.json"}, "sha256": {"$ref": "#/$defs/sha"},
                     "record_count": {"$ref": "#/$defs/count"}, "producer_count": {"$ref": "#/$defs/count"}}
    },
    "text": {
      "type": "object", "additionalProperties": false, "required": ["files", "chunk_count"],
      "properties": {
        "chunk_count": {"$ref": "#/$defs/count"},
        "files": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["doc_id", "kind", "producer_job_id", "producer_attempt_id", "artifact_path", "sha256", "source_path", "source_sha256", "converter", "converter_version", "bytes", "chunks", "status"],
          "properties": {
            "doc_id": {"type": "string", "pattern": "^text_[0-9a-f]{24}\\Z"},
            "kind": {"enum": ["generated-header", "converted-document"]},
            "producer_job_id": {"type": "string"}, "producer_attempt_id": {"type": "string"},
            "artifact_path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}, "source_path": {"type": "string"},
            "source_sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
            "converter": {"type": ["string", "null"]}, "converter_version": {"type": ["string", "null"]},
            "bytes": {"$ref": "#/$defs/count"}, "chunks": {"$ref": "#/$defs/count"},
            "status": {"enum": ["indexed", "over-file-count", "over-file-bytes", "over-total-bytes", "not-utf8", "line-too-long"]}}}}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha"},
    "sqlite": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
      "properties": {"path": {"const": "evidence-index-derived.sqlite"}, "sha256": {"$ref": "#/$defs/sha"}, "bytes": {"$ref": "#/$defs/count"}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["text_max_files", "text_max_file_bytes", "text_max_total_bytes", "text_chunk_lines", "text_max_line_chars", "build_records_max"],
      "properties": {"text_max_files": {"$ref": "#/$defs/count"}, "text_max_file_bytes": {"$ref": "#/$defs/count"},
                     "text_max_total_bytes": {"$ref": "#/$defs/count"}, "text_chunk_lines": {"type": "integer", "minimum": 1},
                     "text_max_line_chars": {"type": "integer", "minimum": 1}, "build_records_max": {"$ref": "#/$defs/count"}}
    },
    "coverage_gaps": {"type": "array", "items": {"type": "string"}},
    "claim_boundary": {"const": "DERIVED_INDEX_NOT_AUTHORITY_OR_RUNTIME_PROOF"}
  }
}
