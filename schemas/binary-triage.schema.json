{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "binary-triage.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "run_id",
        "job_id",
        "attempt_id",
        "status",
        "native_build",
        "upstream",
        "authority",
        "image",
        "tool",
        "records",
        "coverage_gaps"
    ],
    "properties": {
        "schema": {
            "const": "appsec-review/binary-triage/1"
        },
        "run_id": {
            "type": "string"
        },
        "job_id": {
            "const": "02-binary-triage"
        },
        "attempt_id": {
            "type": "string"
        },
        "status": {
            "enum": ["OK", "OK_WITH_GAPS"]
        },
        "native_build": {"$ref": "binary-evidence-native.schema.json"},
        "upstream": {
            "type": "object", "additionalProperties": false
        },
        "authority": {"$ref": "binary-evidence-authority.schema.json"},
        "image": {"$ref": "binary-evidence-image.schema.json"},
        "tool": {"$ref": "binary-evidence-tool.schema.json"},
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "binary_id",
                    "binary_sha256",
                    "build_identity_sha256",
                    "triage_id",
                    "format",
                    "architecture",
                    "hardening",
                    "sections",
                    "imports",
                    "packed",
                    "stripped",
                    "gaps"
                ],
                "properties": {
                    "binary_id": {
                        "type": "string"
                    },
                    "binary_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "build_identity_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "triage_id": {"type":"string","pattern":"^triage_[0-9a-f]{16}$"},
                    "format": {
                        "enum": [
                            "ELF",
                            "PE",
                            "MACHO",
                            "WASM",
                            "UNKNOWN"
                        ]
                    },
                    "architecture": {
                        "type": "string"
                    },
                    "hardening": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "nx",
                            "pie",
                            "relro",
                            "stack_canary"
                        ],
                        "properties": {
                            "nx": {
                                "enum": [
                                    "ENABLED",
                                    "DISABLED",
                                    "UNKNOWN"
                                ]
                            },
                            "pie": {
                                "enum": [
                                    "ENABLED",
                                    "DISABLED",
                                    "UNKNOWN"
                                ]
                            },
                            "relro": {
                                "enum": [
                                    "FULL",
                                    "PARTIAL",
                                    "NONE",
                                    "UNKNOWN"
                                ]
                            },
                            "stack_canary": {
                                "enum": [
                                    "PRESENT",
                                    "ABSENT",
                                    "UNKNOWN"
                                ]
                            }
                        }
                    },
                    "sections": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "imports": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "packed": {
                        "enum": [
                            "YES",
                            "NO",
                            "UNKNOWN"
                        ]
                    },
                    "stripped": {
                        "enum": [
                            "YES",
                            "NO",
                            "UNKNOWN"
                        ]
                    },
                    "gaps": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "coverage_gaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
