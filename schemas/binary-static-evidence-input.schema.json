{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"binary-static-evidence-input.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema","job_id","native_build","image","config","records","gaps"],
  "properties":{
    "schema":{"const":"appsec-review/binary-static-evidence-input/1"},
    "job_id":{"enum":["02-debug-symbol-index","02-binary-triage","02-binary-cfg"]},
    "native_build":{"$ref":"binary-evidence-native.schema.json"},
    "image":{"$ref":"binary-evidence-image.schema.json"},
    "config":{"type":"object","additionalProperties":false,
      "required":["static_only","adapter_id","adapter_version"],"properties":{
        "static_only":{"const":true},"adapter_id":{"type":"string","minLength":1},
        "adapter_version":{"type":"string","minLength":1}}},
    "records":{"type":"array","items":{"type":"object"}},
    "gaps":{"type":"array","items":{"type":"string"},"uniqueItems":true}
  }
}
