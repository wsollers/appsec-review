{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-input-manifest-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt_id", "accepted_pointer_path", "accepted_pointer_sha256", "manifest_path", "manifest_sha256"],
  "properties": {
    "attempt_id": {"type": "string"},
    "accepted_pointer_path": {"type": "string"},
    "accepted_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_path": {"type": "string"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
