{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-snapshot-manifest.schema.json",
  "title": "Immutable Reference Snapshot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "family",
    "edition",
    "upstream",
    "retrieved_at",
    "license",
    "extractor",
    "raw_files",
    "normalized_files",
    "lineage",
    "record_counts",
    "content_digest",
    "validation"
  ],
  "properties": {
    "schema": {"const": "appsec-review/reference-snapshot-manifest/1.0"},
    "snapshot_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{16}$"},
    "family": {"type": "string"},
    "edition": {"type": "string"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "immutable_ref", "resolved_commit"],
      "properties": {
        "url": {"type": "string"},
        "immutable_ref": {"type": "string"},
        "resolved_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tag_object": {"type": ["string", "null"]}
      }
    },
    "retrieved_at": {"type": "string"},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "source_path", "sha256"],
      "properties": {
        "identifier": {"type": "string"},
        "source_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_path"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "source_path": {"type": "string"}
      }
    },
    "raw_files": {"type": "array", "minItems": 1, "items": {"$ref": "reference-snapshot-file.schema.json"}},
    "normalized_files": {"type": "array", "minItems": 1, "items": {"$ref": "reference-snapshot-file.schema.json"}},
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["normalized_path", "raw_paths"],
        "properties": {
          "normalized_path": {"type": "string"},
          "raw_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "record_counts": {"type": "object"},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {"enum": ["PASS"]},
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
