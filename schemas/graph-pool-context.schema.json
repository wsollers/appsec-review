{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-pool-context.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "job_id", "source_generation", "intake_binding", "spec_sha256", "pool_directory", "pool_parent", "prompt_root", "readable_roots", "allowed_models", "invoker_id", "host_flavor", "docker_executable", "container_user", "mount_roots", "registry_ceiling", "rendezvous_parent", "terminal_manifest_sha256"],
  "properties": {
    "schema": {"const": "appsec-review/graph-pool-context/1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"const": "persona-tool-pool-dispatch"},
    "source_generation": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "intake_binding": {"type": "object"},
    "spec_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pool_directory": {"type": "string", "minLength": 1},
    "pool_parent": {"type": "string", "minLength": 1},
    "prompt_root": {"type": "string", "minLength": 1},
    "readable_roots": {"type": "object"},
    "allowed_models": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "invoker_id": {"const": "intake-canonical"},
    "host_flavor": {"enum": ["posix", "windows"]},
    "docker_executable": {"type": "null"},
    "container_user": {"type": "null"},
    "mount_roots": {"type": "object"},
    "registry_ceiling": {"type": "null"},
    "rendezvous_parent": {"type": "string", "minLength": 1},
    "terminal_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
