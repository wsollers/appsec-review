{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-batch-proof-obligation.schema.json",
  "title": "Routed OWASP proof obligation",
  "type": "object",
  "additionalProperties": false,
  "required": ["obligation_id", "text", "evidence_classification", "catalog_minimum_evidence_modes", "primary_evidence_mode", "authorization_boundary", "tooling_profile_id", "validator_role", "linked_tests", "route_id"],
  "properties": {
    "obligation_id": {"type": "string"},
    "text": {"type": "string"},
    "evidence_classification": {"enum": ["unclassified_requires_policy", "classified"]},
    "catalog_minimum_evidence_modes": {"type": "array", "items": {"type": "string"}},
    "primary_evidence_mode": {"enum": ["document_or_process", "static_source", "static_config", "built_artifact", "test_evidence", "dynamic_runtime"]},
    "authorization_boundary": {"enum": ["static_offline", "dynamic_request_only"]},
    "tooling_profile_id": {"type": "string"},
    "validator_role": {"type": "string"},
    "linked_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "source_record_hash", "snapshot_id", "platform", "test_modes"],
        "properties": {
          "test_id": {"type": "string"},
          "source_record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "snapshot_id": {"type": "string"},
          "platform": {"type": "string"},
          "test_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "route_id": {"type": "string"}
  }
}
