{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-purpose-map.schema.json",
  "title": "Component Purpose And Review Routing Map",
  "type": "object",
  "required": [
    "schema", "target", "source_revision", "source_snapshot_sha256",
    "characterization_basis", "code_scope_classification", "analysis_exclusions",
    "functional_components", "parallel_review_groups", "negative_evidence",
    "classification_gaps", "rescope_triggers"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "appsec-review/component-purpose-map/1.0"},
    "target": {"type": "string"},
    "source_revision": {"type": ["string", "null"]},
    "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "characterization_basis": {"const": "static-evidence-and-review-routing"},
    "code_scope_classification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scope_id", "classification", "path_patterns", "disposition", "purpose", "confidence", "evidence_citations"],
        "additionalProperties": false,
        "properties": {
          "scope_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "classification": {"enum": ["first-party", "vendored", "generated", "test-sample", "documentation", "build-tooling", "unknown"]},
          "path_patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "disposition": {"enum": ["review", "exclude", "defer", "unresolved"]},
          "purpose": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence_citations": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-citation.schema.json"}}
        }
      }
    },
    "analysis_exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope_id", "reason", "rescope_trigger_id"],
        "additionalProperties": false,
        "properties": {
          "scope_id": {"type": "string"},
          "reason": {"type": "string"},
          "rescope_trigger_id": {"type": "string"}
        }
      }
    },
    "functional_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component_id", "name", "coarse_group", "component_type", "aliases",
          "search_terms", "representative_locations", "observed_purpose", "confidence",
          "evidence_citations", "trust_boundary_relevance", "data_classes",
          "security_control_relevance", "deployability", "downstream_lanes",
          "parallel_review_group"
        ],
        "additionalProperties": false,
        "properties": {
          "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string"},
          "coarse_group": {"type": "string"},
          "component_type": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "search_terms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "representative_locations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "observed_purpose": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence_citations": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-citation.schema.json"}},
          "trust_boundary_relevance": {"type": "string"},
          "data_classes": {"type": "array", "items": {"type": "string"}},
          "security_control_relevance": {"type": "string"},
          "deployability": {"enum": ["deployable", "linked-runtime", "build-time", "non-runtime", "unknown"]},
          "downstream_lanes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "parallel_review_group": {"type": "string"}
        }
      }
    },
    "parallel_review_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["group_id", "component_ids", "downstream_lanes", "rationale"],
        "additionalProperties": false,
        "properties": {
          "group_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "component_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "downstream_lanes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rationale": {"type": "string"}
        }
      }
    },
    "negative_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "search_terms", "search_scope", "confidence", "evidence_citations"],
        "additionalProperties": false,
        "properties": {
          "category": {"type": "string"},
          "search_terms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "search_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence_citations": {"type": "array", "minItems": 1, "items": {"$ref": "evidence-citation.schema.json"}}
        }
      }
    },
    "classification_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "subject", "reason", "routing_impact", "resolution_action"],
        "additionalProperties": false,
        "properties": {
          "gap_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "subject": {"type": "string"},
          "reason": {"type": "string"},
          "routing_impact": {"type": "string"},
          "resolution_action": {"type": "string"}
        }
      }
    },
    "rescope_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger_id", "condition", "affected_scope_ids", "affected_component_ids", "actions"],
        "additionalProperties": false,
        "properties": {
          "trigger_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "condition": {"type": "string"},
          "affected_scope_ids": {"type": "array", "items": {"type": "string"}},
          "affected_component_ids": {"type": "array", "items": {"type": "string"}},
          "actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
