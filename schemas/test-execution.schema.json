{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "test-execution.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "run_id",
        "source_snapshot_sha256",
        "source_tree_sha256",
        "checkout_identity_sha256",
        "source_revision",
        "native_build",
        "unit_id",
        "variant_sha256",
        "image_id",
        "image_digest",
        "binary_set_sha256",
        "command",
        "permission_fingerprint_sha256",
        "result_format",
        "coverage_format",
        "execution_status",
        "exit_code",
        "artifacts",
        "coverage_gaps"
    ],
    "properties": {
        "schema": {
            "const": "appsec-review/test-execution/1"
        },
        "run_id": {
            "type": "string"
        },
        "source_snapshot_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_tree_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checkout_identity_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_revision": {
            "type": "string"
        },
        "native_build": {
            "$ref": "test-native-build-lineage.schema.json"
        },
        "unit_id": {
            "type": "string"
        },
        "variant_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "image_id": {
            "type": "string"
        },
        "image_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "binary_set_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "command": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "argv",
                "environment",
                "timeout_seconds",
                "network",
                "credentials",
                "mutation"
            ],
            "properties": {
                "argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "environment": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "timeout_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                },
                "network": {
                    "const": "none"
                },
                "credentials": {
                    "type": "array",
                    "maxItems": 0
                },
                "mutation": {
                    "const": "run-owned-copy"
                }
            }
        },
        "permission_fingerprint_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result_format": {
            "enum": [
                "junit-xml",
                "unsupported"
            ]
        },
        "coverage_format": {
            "enum": [
                "lcov",
                "unsupported",
                "none"
            ]
        },
        "execution_status": {
            "enum": [
                "PASS",
                "FAIL",
                "TIMEOUT",
                "CRASH"
            ]
        },
        "exit_code": {
            "type": [
                "integer",
                "null"
            ]
        },
        "artifacts": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "path", "sha256", "size_bytes"],
                "properties": {
                    "kind": {"enum": ["test-results", "coverage"]},
                    "path": {"type": "string", "minLength": 1},
                    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                    "size_bytes": {"type": "integer", "minimum": 0}
                }
            }
        },
        "coverage_gaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
