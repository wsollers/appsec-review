{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-index-enrichment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "source_snapshot_sha256", "build_lineage_sha256", "producer_count", "record_count", "records", "partitions", "components", "coverage_gaps", "limits", "claim_boundary"],
  "properties": {
    "schema": {"const": "appsec-review/evidence-index-enrichment/1.0"},
    "run_id": {"type": "string"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "build_lineage_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "producer_count": {"type": "integer", "minimum": 0},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {"$ref": "evidence-index-derived-record.schema.json"}},
    "partitions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["partition_id", "record_id"], "properties": {"partition_id": {"type": "string"}, "record_id": {"type": "string"}}}},
    "components": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component_id", "record_id"], "properties": {"component_id": {"type": "string"}, "record_id": {"type": "string"}}}},
    "coverage_gaps": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_producers", "max_records", "max_links", "max_search_text", "max_query_results"], "properties": {"max_producers": {"type": "integer", "minimum": 1}, "max_records": {"type": "integer", "minimum": 1}, "max_links": {"type": "integer", "minimum": 1}, "max_search_text": {"type": "integer", "minimum": 1}, "max_query_results": {"type": "integer", "minimum": 1}}},
    "claim_boundary": {"const": "DERIVED_INDEX_NOT_AUTHORITY_OR_RUNTIME_PROOF"}
  }
}
