{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "treesitter-ast.schema.json",
  "title": "Deterministic tree-sitter AST summary of a checkout (appsec-review-process/treesitter_ast.py)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "root", "generator", "source_manifest_sha256", "totals", "files", "gaps", "content_sha256"],
  "properties": {
    "schema": {"const": "appsec-review/treesitter-ast/1"},
    "root": {"type": "string"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tree_sitter", "grammars", "limits"],
      "properties": {
        "name": {"const": "treesitter_ast.py"},
        "tree_sitter": {"type": ["string", "null"]},
        "grammars": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "version"],
            "properties": {
              "language": {"type": "string", "pattern": "^[a-z_]{1,32}\\Z"},
              "version": {"type": "string"}
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_file_bytes", "max_files", "max_rows_per_file"],
          "properties": {
            "max_file_bytes": {"type": "integer"},
            "max_files": {"type": "integer"},
            "max_rows_per_file": {"type": "integer"}
          }
        }
      }
    },
    "source_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
    "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "bytes", "functions", "calls", "imports", "error_nodes", "non_source", "gaps"],
      "properties": {
        "files": {"type": "integer"},
        "bytes": {"type": "integer"},
        "functions": {"type": "integer"},
        "calls": {"type": "integer"},
        "imports": {"type": "integer"},
        "error_nodes": {"type": "integer"},
        "non_source": {"type": "integer", "minimum": 0, "description": "Files skipped as build/doc/config, not program source; not a coverage gap."},
        "gaps": {"type": "integer"}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "language", "sha256", "bytes", "node_kinds", "error_nodes", "functions", "calls", "imports"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$)).+\\Z"},
          "language": {"enum": ["bash", "c", "c_sharp", "cpp", "go", "java", "javascript", "json", "php", "python", "ruby", "rust", "tsx", "typescript"]},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}\\Z"},
          "bytes": {"type": "integer"},
          "error_nodes": {"type": "integer"},
          "node_kinds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "count"],
              "properties": {"kind": {"type": "string"}, "count": {"type": "integer"}}
            }
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "start_line", "end_line"],
              "properties": {
                "name": {"type": ["string", "null"]},
                "kind": {"type": "string"},
                "start_line": {"type": "integer"},
                "end_line": {"type": "integer"}
              }
            }
          },
          "calls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["callee", "line"],
              "properties": {"callee": {"type": ["string", "null"]}, "line": {"type": "integer"}}
            }
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "line"],
              "properties": {"text": {"type": ["string", "null"]}, "line": {"type": "integer"}}
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "detail"],
        "properties": {
          "kind": {"enum": ["grammar-unavailable", "path-outside-root", "symlink-skipped", "not-a-file", "max-files", "file-too-large", "unreadable", "rows-truncated", "no-grammar"]},
          "path": {"type": ["string", "null"]},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
