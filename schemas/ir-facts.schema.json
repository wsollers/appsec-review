{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "ir-facts.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "run_id", "source_revision", "source_snapshot_sha256", "checkout_identity_sha256", "link", "linked_module_sha256", "variant_sha256", "toolchain_sha256", "image_id", "image_digest", "sources", "status", "debug_locations", "facts", "coverage_gaps"],
  "properties": {
    "schema": {"const": "appsec-review/ir-facts/1"}, "run_id": {"type": "string"}, "source_revision": {"type": "string"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "link": {"$ref": "ir-upstream-lineage.schema.json"},
    "checkout_identity_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "linked_module_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "variant_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "toolchain_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "image_id": {"type": "string"}, "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "status": {"enum": ["OK", "OK_WITH_GAPS"]},
    "debug_locations": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["debug_location_id", "source_line", "source_column"], "properties": {
        "debug_location_id": {"type": "string"}, "source_line": {"type": "integer"}, "source_column": {"type": "integer"}}}},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["fact_id", "kind", "ir_line", "function", "module_id", "debug_location_id"],
      "properties": {"fact_id": {"type": "string"}, "kind": {"enum": ["pointer-arithmetic", "memory-read", "memory-write", "memory-intrinsic"]},
        "ir_line": {"type": "integer"}, "function": {"type": ["string", "null"]}, "module_id": {"type": "string"},
        "debug_location_id": {"type": ["string", "null"]}}}},
    "coverage_gaps": {"type": "array", "items": {"type": "object"}}
  }
}
