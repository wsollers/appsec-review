{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intel-manifest.schema.json",
  "title": "Hash-bound evidence assembly manifest",
  "description": "appsec-review/intel-manifest/2.0: content only, so one set of producer publications derives one manifest across launches. 2.0 moved the per-launch C01/C02 terminal generation (1.0 terminal_instances, generation.terminal_manifest_sha256 and each producer's terminal_instance_ids) to the retained audit artifact named by terminal_binding (evidence-assembly-terminal-binding.schema.json), hash-bound by the assembly envelope and outside manifest_sha256 and generation_sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "source_snapshot_sha256", "assembly_status", "generation", "terminal_binding", "producers", "coverage_gaps", "manifest_sha256"],
  "properties": {
    "schema": {"const": "appsec-review/intel-manifest/2.0"},
    "run_id": {"type": "string"},
    "source_snapshot_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
    "assembly_status": {"enum": ["COMPLETE", "INCOMPLETE"]},
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["generation_sha256", "graph_sha256"],
      "properties": {"generation_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"}, "graph_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"}}
    },
    "terminal_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"const": "terminal-binding.json"}}
    },
    "producers": {"type": "array", "items": {"$ref": "intel-manifest-producer.schema.json"}},
    "coverage_gaps": {"type": "array", "items": {"$ref": "intel-manifest-gap.schema.json"}},
    "manifest_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"}
  }
}
