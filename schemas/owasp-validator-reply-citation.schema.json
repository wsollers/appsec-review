{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-validator-reply-citation.schema.json",
  "title": "Reduced evidence or counterevidence citation (judgement only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref",
    "locator",
    "observed_fact",
    "evidence_mode",
    "limitations",
    "affirmative_contrary_evidence"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "description": "An input_id or artifact path exactly as listed in the handoff's accepted inputs (or the output_id of one of your derived outputs)."
    },
    "locator": {
      "type": "string"
    },
    "observed_fact": {
      "type": "string"
    },
    "evidence_mode": {
      "enum": [
        "document_or_process",
        "static_source",
        "static_config",
        "built_artifact",
        "test_evidence",
        "dynamic_runtime",
        "manual_inspection"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affirmative_contrary_evidence": {
      "type": "boolean"
    },
    "source_kind": {
      "enum": [
        "document",
        "scanner",
        "test_evidence"
      ],
      "description": "Optional. Only to NARROW what the input can prove; omit for ordinary canonical evidence."
    },
    "test_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "test_definition",
        "test_result",
        "environment_identity",
        "production_equivalence",
        "production_equivalence_limitations",
        "mocks_used"
      ],
      "properties": {
        "test_definition": {
          "type": "string"
        },
        "test_result": {
          "type": "string"
        },
        "environment_identity": {
          "type": "string"
        },
        "production_equivalence": {
          "enum": [
            "equivalent",
            "not_equivalent",
            "unknown"
          ]
        },
        "production_equivalence_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mocks_used": {
          "type": "boolean"
        }
      },
      "description": "Only with source_kind test_evidence."
    },
    "dereference_ref": {
      "type": "string",
      "description": "Only for a locator-only input: the ref of the canonical input, cited elsewhere in this obligation, that it points to."
    }
  }
}
