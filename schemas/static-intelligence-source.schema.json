{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "static-intelligence-source.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "path",
        "sha256",
        "status",
        "redactions"
    ],
    "properties": {
        "path": {
            "type": "string"
        },
        "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status": {
            "enum": [
                "UNCHANGED",
                "REDACTED",
                "OVERSIZED",
                "WITHHELD",
                "UNCONVERTED"
            ]
        },
        "redactions": {
            "type": "integer"
        }
    }
}
