{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hypothesis-hunt-candidates.schema.json",
  "title": "Hypothesis hunter candidates (derived, strict)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "subject_id",
          "assertion",
          "evidence_sha256",
          "claim_class"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^hunt-[0-9a-f]{24}$"
          },
          "subject_id": {
            "type": "string",
            "pattern": "^(hyp|cov)-[0-9a-f]{24}$"
          },
          "assertion": {
            "type": "string",
            "minLength": 2,
            "description": "Canonical JSON of one hunter-hypothesis.schema.json record (subject hyp-...) or one hunter-catalog-coverage.schema.json record (subject cov-...)."
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "claim_class": {
            "const": "candidate_only"
          }
        }
      }
    }
  }
}
