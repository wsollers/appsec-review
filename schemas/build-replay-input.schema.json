{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "build-replay-input.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "mode", "requirements", "grants", "timeout_seconds"],
  "properties": {
    "schema": {"const": "appsec-review/build-replay-input/1"},
    "mode": {"const": "success"},
    "requirements": {"type": "object", "additionalProperties": false,
      "required": ["02-build-configure", "02-native-build"],
      "properties": {
        "02-build-configure": {"type": "object"},
        "02-native-build": {"type": "object"}
      }},
    "grants": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200}
  }
}
