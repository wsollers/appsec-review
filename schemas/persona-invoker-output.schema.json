{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona-invoker-output.schema.json",
  "title": "Persona invoker output manifest",
  "description": "The invoker-output.json an invoker writes last into the writable output root: identity echo, usage, every output file and every claim with its class and citations. It is untrusted; persona_invocation.py re-derives or bounds every field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_sha256",
    "invoker_id",
    "persona_id",
    "persona_sha256",
    "model",
    "usage",
    "tool_calls",
    "files",
    "claims",
    "verified_invocations",
    "injection_suspected",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/persona-invoker-output/1.0"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}\\Z"
    },
    "invoker_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,95}\\Z"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,95}\\Z"
    },
    "persona_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}\\Z"
    },
    "model": {
      "$ref": "persona-model-identity.schema.json"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_bytes",
        "input_units",
        "output_bytes",
        "output_units",
        "tool_calls"
      ],
      "properties": {
        "input_bytes": {
          "type": "integer"
        },
        "input_units": {
          "type": "integer"
        },
        "output_bytes": {
          "type": "integer"
        },
        "output_units": {
          "type": "integer"
        },
        "tool_calls": {
          "type": "integer"
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "calls"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "pattern": "^act-[0-9a-f]{24}\\Z"
          },
          "calls": {
            "type": "integer"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "persona-invocation-file.schema.json"
      },
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_class",
          "statement",
          "file",
          "citations"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}\\Z"
          },
          "claim_class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}\\Z"
          },
          "statement": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{1,2000}\\Z"
          },
          "file": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9._ /-]{1,512}\\Z"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "root",
                "path",
                "sha256",
                "locator"
              ],
              "properties": {
                "root": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,95}\\Z"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._ /-]{1,512}\\Z"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}\\Z"
                },
                "locator": {
                  "type": "string",
                  "pattern": "^[^\\x00-\\x1f\\x7f]{1,2000}\\Z"
                }
              }
            },
            "minItems": 1
          }
        }
      }
    },
    "verified_invocations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}\\Z"
      }
    },
    "injection_suspected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "path",
          "sha256",
          "locator"
        ],
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}\\Z"
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._ /-]{1,512}\\Z"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "locator": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{1,2000}\\Z"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\x00-\\x1f\\x7f]{1,2000}\\Z"
      }
    }
  }
}
