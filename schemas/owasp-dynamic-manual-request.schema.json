{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "owasp-dynamic-manual-request.schema.json",
  "title": "Accepted T09 dynamic/manual request version", "type": "object", "additionalProperties": false,
  "required": ["schema", "request_id", "version", "run_id", "selection_id", "lineage", "subject", "state", "transition", "static_insufficiency", "test_plan", "authorization_requirements", "criteria", "capture_requirements", "owner", "limitations", "contradictions", "unresolved_conditions", "dissent", "crosswalks", "prior_version", "acknowledgements", "publication"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-dynamic-manual-request/1.0"},
    "request_id": {"type": "string", "pattern": "^dynamic-request-[0-9a-f]{20}$"}, "version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string"}, "selection_id": {"type": "string"},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["applicability_identity", "worklist_identity", "sources"], "properties": {
      "applicability_identity": {"type": "object"}, "worklist_identity": {"type": "object"},
      "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["batch_id", "handoff_id", "handoff", "assessment", "intercom"], "properties": {
        "batch_id": {"type": "string"}, "handoff_id": {"type": "string"},
        "handoff": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "accepted_pointer_path", "accepted_pointer_sha256", "handoff_set_path", "handoff_set_sha256", "member_path", "member_sha256"], "properties": {"attempt_id": {"type": "string"}, "accepted_pointer_path": {"type": "string"}, "accepted_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "handoff_set_path": {"type": "string"}, "handoff_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "member_path": {"type": "string"}, "member_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        "assessment": {"type": ["object", "null"]}, "intercom": {"type": ["object", "null"]}
      }}}
    }},
    "subject": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["batch_id", "handoff_id", "control_id", "component_id", "fragment_id", "proof_obligation_id", "evidence_mode"], "properties": {"batch_id": {"type": "string"}, "handoff_id": {"type": "string"}, "control_id": {"type": "string"}, "component_id": {"type": "string"}, "fragment_id": {"type": "string"}, "proof_obligation_id": {"type": "string"}, "evidence_mode": {"enum": ["dynamic_runtime", "manual_inspection"]}}}},
    "state": {"enum": ["proposed", "authorized", "executed", "ingested", "reassessed", "canceled", "blocked"]},
    "transition": {"type": "object", "additionalProperties": false, "required": ["transition_id", "from_state", "to_state", "authority", "occurred_at", "reason"], "properties": {
      "transition_id": {"type": "string"}, "from_state": {"type": ["string", "null"]}, "to_state": {"type": "string"}, "occurred_at": {"type": "string"}, "reason": {"type": "string", "minLength": 1},
      "authority": {"type": "object", "additionalProperties": false, "required": ["kind", "authority_id", "role", "artifact"], "properties": {"kind": {"enum": ["proposal_author", "baseline_policy", "request_owner", "external_state_artifact"]}, "authority_id": {"type": "string"}, "role": {"type": "string"}, "artifact": {"type": ["object", "null"]}}
    }}},
    "static_insufficiency": {"type": "object", "additionalProperties": false, "required": ["reasons", "supplied_evidence_limitations", "missing_evidence_not_failure", "static_cannot_close_dynamic_or_manual"], "properties": {"reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "supplied_evidence_limitations": {"type": "array", "items": {"type": "string"}}, "missing_evidence_not_failure": {"const": true}, "static_cannot_close_dynamic_or_manual": {"const": true}}},
    "test_plan": {"type": "object", "additionalProperties": false, "required": ["test_type", "target_environment", "prerequisites", "identity_requirements", "data_requirements", "requested_actions"], "properties": {"test_type": {"enum": ["dynamic_runtime", "manual_observation"]}, "target_environment": {"type": "object"}, "prerequisites": {"type": "array", "items": {"type": "string"}}, "identity_requirements": {"type": "array", "items": {"type": "string"}}, "data_requirements": {"type": "array", "items": {"type": "string"}}, "requested_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "authorization_requirements": {"type": "object", "additionalProperties": false, "required": ["required_authority", "least_privilege", "safety_constraints", "target_contact", "target_mutation", "manual_observation", "secrets"], "properties": {"required_authority": {"type": "object"}, "least_privilege": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "safety_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "target_contact": {"type": "boolean"}, "target_mutation": {"type": "boolean"}, "manual_observation": {"type": "boolean"}, "secrets": {"type": "boolean"}}},
    "criteria": {"type": "object", "additionalProperties": false, "required": ["observations", "pass", "fail", "inconclusive"], "properties": {"observations": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "pass": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "fail": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "inconclusive": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "capture_requirements": {"type": "object", "additionalProperties": false, "required": ["artifacts", "redaction", "retention"], "properties": {"artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "redaction": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "retention": {"type": "string"}}},
    "owner": {"type": "object", "additionalProperties": false, "required": ["owner_id", "role", "reassessment_path", "reverification_path"], "properties": {"owner_id": {"type": "string"}, "role": {"type": "string"}, "reassessment_path": {"type": "string"}, "reverification_path": {"type": "string"}}},
    "limitations": {"type": "array", "items": {"type": "string"}}, "contradictions": {"type": "array", "items": {"type": "string"}}, "unresolved_conditions": {"type": "array", "items": {"type": "string"}}, "dissent": {"type": "array", "items": {"type": "object"}}, "crosswalks": {"type": "array", "items": {"type": "object"}},
    "prior_version": {"type": ["object", "null"]},
    "acknowledgements": {"type": "object", "additionalProperties": false, "required": ["request_is_inert", "t09_does_not_authorize", "t09_does_not_execute", "t09_does_not_observe", "target_contacted_by_t09", "target_mutated_by_t09", "manual_observation_performed_by_t09", "secrets_included", "personal_data_minimized", "crosswalks_are_navigation_only", "intercom_is_not_evidence_or_authority", "assessment_unchanged", "no_finding_promotion", "supplied_results_require_reassessment_and_reverification"], "properties": {"request_is_inert": {"const": true}, "t09_does_not_authorize": {"const": true}, "t09_does_not_execute": {"const": true}, "t09_does_not_observe": {"const": true}, "target_contacted_by_t09": {"const": false}, "target_mutated_by_t09": {"const": false}, "manual_observation_performed_by_t09": {"const": false}, "secrets_included": {"const": false}, "personal_data_minimized": {"const": true}, "crosswalks_are_navigation_only": {"const": true}, "intercom_is_not_evidence_or_authority": {"const": true}, "assessment_unchanged": {"const": true}, "no_finding_promotion": {"const": true}, "supplied_results_require_reassessment_and_reverification": {"const": true}}},
    "publication": {"type": "object", "additionalProperties": false, "required": ["version", "candidate_path", "candidate_sha256", "previous_version_hash", "published_at"], "properties": {"version": {"type": "integer", "minimum": 1}, "candidate_path": {"type": "string"}, "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "previous_version_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "published_at": {"type": "string"}}}
  }
}
