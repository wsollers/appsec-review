{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "build-resolution-input.schema.json",
  "title": "Build resolution control",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "build_resolution_attempts", "build_image_reuse", "build_command_timeout_seconds", "image_build_timeout_seconds", "apt_mirror", "permission"],
  "properties": {
    "build_network": {"enum": ["none", "unrestricted"], "description": "Network for the containers that run the target build (D-28, William 2026-10-01): unrestricted is Docker's default bridge so package managers can fetch dependencies; absent or none is offline, as before."},
    "schema": {"const": "appsec-review/build-resolution-input/1"},
    "mode": {"enum": ["success", "exit-nonzero"]},
    "build_resolution_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
    "build_image_reuse": {"enum": ["auto", "rebuild", "require"]},
    "build_command_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "image_build_timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "apt_mirror": {
      "type": "object", "additionalProperties": false,
      "required": ["scheme", "host", "port", "suite", "components"],
      "properties": {
        "scheme": {"const": "http"}, "host": {"const": "archive.ubuntu.com"},
        "port": {"const": 80}, "suite": {"const": "noble"},
        "components": {"const": ["main", "universe"]}
      }
    },
    "permission": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement", "grants"],
      "properties": {
        "requirement": {"$ref": "permission-requirement.schema.json"},
        "grants": {"type": "array", "minItems": 1, "items": {"$ref": "permission-grant.schema.json"}}
      }
    }
  }
}
