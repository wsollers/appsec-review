{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attack-chain-candidates.schema.json",
  "title": "Lane-14 cell candidates (derived, strict)",
  "description": "The invoker document of one attack-chain composer or refuter cell: one candidate per derived chain or refutation outcome (assertion = canonical JSON of the record), or one no-chain record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "subject_id",
          "assertion",
          "evidence_sha256",
          "claim_class"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^(chain|no-chain|refute)-[0-9a-f]{24}$"
          },
          "subject_id": {
            "type": "string",
            "pattern": "^(cluster-[0-9a-f]{16}|chain-[0-9a-f]{24})$"
          },
          "assertion": {
            "type": "string",
            "minLength": 2
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "claim_class": {
            "const": "candidate_only"
          }
        }
      }
    }
  }
}
