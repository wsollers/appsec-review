{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poc-fix-candidates.schema.json",
  "title": "Lane-12b cell candidates (derived, strict)",
  "description": "The invoker document of one poc-and-fix cell: one candidate whose assertion is the canonical JSON of the derived PoC-and-fix record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "subject_id",
          "assertion",
          "evidence_sha256",
          "claim_class"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^pocfix-[0-9a-f]{24}$"
          },
          "subject_id": {
            "type": "string",
            "pattern": "^pocreq-[0-9a-f]{16}$"
          },
          "assertion": {
            "type": "string",
            "minLength": 2
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "claim_class": {
            "const": "candidate_only"
          }
        }
      }
    }
  }
}
