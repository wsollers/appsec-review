{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dependency-reachability-summary.schema.json",
  "title": "Correlated dependency reachability summary (06-cve-reachability outputs/dependency-reachability-summary.json, ADR-0023)",
  "description": "The report and lanes 07 to 12 read this. conflict (engines disagree) and unknown are shown as such; neither is 'not vulnerable'. Every field is derived by the Python correlator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "job_id",
    "attempt_id",
    "source_snapshot_sha256",
    "counts",
    "engines",
    "matches",
    "review",
    "coverage_gaps",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/dependency-reachability-summary/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
    },
    "job_id": {
      "const": "06-cve-reachability"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}\\Z"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reachable",
        "unreachable",
        "conflict",
        "unknown"
      ],
      "properties": {
        "reachable": {
          "type": "integer",
          "minimum": 0
        },
        "unreachable": {
          "type": "integer",
          "minimum": 0
        },
        "conflict": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "engines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "engine",
          "attempt_id",
          "result_sha256",
          "status"
        ],
        "properties": {
          "job_id": {
            "enum": [
              "06-reachability-codeql",
              "06-reachability-ir"
            ]
          },
          "engine": {
            "enum": [
              "codeql",
              "ir"
            ]
          },
          "attempt_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "result_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "status": {
            "enum": [
              "OK",
              "OK_WITH_GAPS",
              "ABSENT"
            ]
          }
        }
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "match_id",
          "component_ref",
          "advisory_id",
          "component",
          "ecosystem",
          "language",
          "verdict",
          "tier",
          "deciding_engines",
          "engines",
          "witness_length",
          "entry",
          "call_site",
          "reason",
          "gaps"
        ],
        "properties": {
          "match_id": {
            "type": "string",
            "pattern": "^VM-[0-9]{6}\\Z"
          },
          "component_ref": {
            "type": "string",
            "pattern": "^SC-[0-9]{6}\\Z"
          },
          "advisory_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{1,15}-[0-9A-Za-z][0-9A-Za-z-]{0,47}\\Z"
          },
          "component": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[^\\x00-\\x1f\\x7f]{0,300}\\Z"
          },
          "ecosystem": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "enum": [
              null,
              "cpp",
              "go",
              "java",
              "csharp",
              "javascript",
              "python",
              "ruby",
              "rust",
              "php"
            ]
          },
          "verdict": {
            "enum": [
              "reachable",
              "unreachable",
              "conflict",
              "unknown"
            ]
          },
          "tier": {
            "enum": [
              null,
              "direct",
              "through-dependency"
            ]
          },
          "deciding_engines": {
            "type": "array",
            "items": {
              "enum": [
                "codeql",
                "ir"
              ]
            }
          },
          "engines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "verdict"
              ],
              "properties": {
                "engine": {
                  "enum": [
                    "codeql",
                    "ir",
                    "lsp",
                    "treesitter"
                  ]
                },
                "verdict": {
                  "enum": [
                    "reachable",
                    "unreachable",
                    "unknown",
                    "hint",
                    "absent"
                  ]
                }
              }
            }
          },
          "witness_length": {
            "type": "integer",
            "minimum": 0
          },
          "entry": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "function",
              "file",
              "line"
            ],
            "properties": {
              "function": {
                "type": "string",
                "pattern": "^[^\\x00-\\x1f\\x7f]{0,200}\\Z"
              },
              "file": {
                "type": "string",
                "pattern": "^[^\\x00-\\x1f\\x7f]{0,1024}\\Z"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "call_site": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "file",
              "line"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^[^\\x00-\\x1f\\x7f]{0,1024}\\Z"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "reason": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{0,1024}\\Z"
          },
          "gaps": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p1_match_ids",
        "conflict_match_ids"
      ],
      "properties": {
        "p1_match_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^VM-[0-9]{6}\\Z"
          }
        },
        "conflict_match_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^VM-[0-9]{6}\\Z"
          }
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\x00-\\x1f\\x7f]{0,512}\\Z"
      }
    },
    "claim_ceiling": {
      "const": "EVIDENCE_LEADS_ONLY"
    }
  }
}
