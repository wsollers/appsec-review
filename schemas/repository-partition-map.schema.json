{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-partition-map.schema.json",
  "title": "Repository Partition Map And Specialist Routing",
  "type": "object",
  "required": [
    "schema",
    "target",
    "source_revision",
    "partitions",
    "coverage"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "appsec-review/repository-partition-map/0.1"
    },
    "target": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "partition_id",
          "name",
          "kinds",
          "include_paths",
          "exclude_paths",
          "primary_persona_id",
          "supporting_persona_ids",
          "routing_rationale",
          "confidence",
          "evidence_citations",
          "relationships",
          "overlap_notes",
          "disposition",
          "disposition_reason",
          "rescope_trigger"
        ],
        "additionalProperties": false,
        "properties": {
          "partition_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "client",
                "server",
                "api",
                "shared-library",
                "iac",
                "cicd",
                "build-release",
                "deployment",
                "operations",
                "test",
                "generated",
                "vendored",
                "documentation",
                "other",
                "unknown"
              ]
            }
          },
          "include_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/repository-path"
            }
          },
          "exclude_paths": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/repository-path"
            }
          },
          "primary_persona_id": {
            "type": "string",
            "enum": [
              "developer-engineer",
              "devops-engineer",
              "sre-engineer"
            ]
          },
          "supporting_persona_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "developer-engineer",
                "devops-engineer",
                "sre-engineer"
              ]
            }
          },
          "routing_rationale": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "evidence-citation.schema.json"
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target_partition_id",
                "kind",
                "basis",
                "evidence_citations"
              ],
              "additionalProperties": false,
              "properties": {
                "target_partition_id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "calls",
                    "implements",
                    "deploys",
                    "builds",
                    "monitors",
                    "shares",
                    "other"
                  ]
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "declared",
                    "inferred"
                  ]
                },
                "evidence_citations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "evidence-citation.schema.json"
                  }
                }
              }
            }
          },
          "overlap_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disposition": {
            "type": "string",
            "enum": [
              "review",
              "deferred",
              "unresolved"
            ]
          },
          "disposition_reason": {
            "type": "string"
          },
          "rescope_trigger": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "deferred"
                }
              }
            },
            "then": {
              "properties": {
                "disposition_reason": {
                  "minLength": 1
                },
                "rescope_trigger": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "inventory_scope",
        "unassigned_paths",
        "uninspected_scope",
        "budget_limitations",
        "category_checks"
      ],
      "additionalProperties": false,
      "properties": {
        "inventory_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repository-path"
          }
        },
        "unassigned_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repository-path"
          }
        },
        "uninspected_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repository-path"
          }
        },
        "budget_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "result",
              "search_scope",
              "evidence_citations"
            ],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "client",
                  "server",
                  "api",
                  "shared-library",
                  "iac",
                  "cicd",
                  "build-release",
                  "deployment",
                  "operations",
                  "test",
                  "generated",
                  "vendored",
                  "documentation"
                ],
                "description": "One of the partition kinds (other/unknown excluded). Every category needs exactly one check."
              },
              "result": {
                "type": "string",
                "enum": [
                  "found",
                  "not-found",
                  "uninspected"
                ]
              },
              "search_scope": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/repository-path"
                }
              },
              "evidence_citations": {
                "type": "array",
                "items": {
                  "$ref": "evidence-citation.schema.json"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "result": {
                      "const": "not-found"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "search_scope": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          },
          "minItems": 13,
          "maxItems": 13,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "client"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "server"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "api"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "shared-library"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "iac"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "cicd"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "build-release"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "deployment"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "operations"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "test"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "generated"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "vendored"
                  }
                },
                "required": [
                  "category"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "category": {
                    "const": "documentation"
                  }
                },
                "required": [
                  "category"
                ]
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "repository-path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!(?:.*/)?\\.\\.?(?:/|$))[^\\x00]+$",
      "description": "A normalized repository-relative POSIX path or glob (src/**, .github/**, docs/x.md): no leading '/', no '.' or '..' segment, no backslash, no trailing '/'. The same rule validate_job_output._repository_relative applies."
    }
  }
}
