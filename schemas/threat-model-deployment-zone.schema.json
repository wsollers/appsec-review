{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threat-model-deployment-zone.schema.json",
  "title": "Threat-model deployment zone",
  "type": "object",
  "required": [
    "zone_id",
    "kind",
    "name",
    "exposure_label",
    "evidence_class",
    "confidence",
    "citations",
    "originating_workcell_id"
  ],
  "additionalProperties": false,
  "properties": {
    "zone_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "public_ingress",
        "private_service",
        "admin_control_plane",
        "build_release",
        "client_device",
        "third_party"
      ]
    },
    "name": {
      "type": "string"
    },
    "exposure_label": {
      "type": "string",
      "enum": [
        "DECLARED_EXPOSURE",
        "OBSERVED_EXPOSURE"
      ],
      "description": "OBSERVED_EXPOSURE is schema-valid so the lane validator can reject it by name; this workbench may only produce DECLARED_EXPOSURE (ADR-0008 Decision 7)."
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "DIRECT_EVIDENCE",
        "STRONG_INFERENCE",
        "WEAK_INFERENCE",
        "FOLLOW_ON_REQUIRED"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "threat-model-citation.schema.json"
      }
    },
    "originating_workcell_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
