{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-dispatch-accounting.schema.json",
  "title": "Immutable dispatch, wait-all and failure accounting of one OWASP validator dispatch attempt (T10)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "accounting_rule",
    "run_id",
    "job_id",
    "attempt_id",
    "input_fingerprint",
    "lane",
    "handoff_publication",
    "worklist",
    "dispatch_config",
    "composition",
    "cell_boundary",
    "claims_boundary",
    "vocabulary",
    "pools",
    "dispatch_outcome",
    "degraded",
    "status",
    "cells",
    "rows",
    "counts",
    "accounting_sha256"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/owasp-dispatch-accounting/1.0"
    },
    "accounting_rule": {
      "const": "appsec-review/owasp-dispatch-accounting-rule/1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}\\Z"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}\\Z"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}\\Z"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}\\Z"
    },
    "lane": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,95}\\Z"
    },
    "handoff_publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id",
        "accepted_pointer_sha256",
        "handoff_set_sha256",
        "handoffs"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}\\Z"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}\\Z"
        },
        "accepted_pointer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}\\Z"
        },
        "handoff_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}\\Z"
        },
        "handoffs": {
          "type": "integer"
        }
      }
    },
    "worklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "rows"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}\\Z"
        },
        "rows": {
          "type": "integer"
        }
      }
    },
    "dispatch_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_id",
        "version",
        "config_digest"
      ],
      "properties": {
        "config_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,95}\\Z"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\Z"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}\\Z"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_sha256",
        "persona_id",
        "job_template_id",
        "model",
        "invoker_id"
      ],
      "properties": {
        "composition_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}\\Z"
        },
        "persona_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,95}\\Z"
        },
        "job_template_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,95}\\Z"
        },
        "model": {
          "$ref": "persona-model-identity.schema.json"
        },
        "invoker_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,95}\\Z"
        }
      }
    },
    "cell_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_claim_classes",
        "prohibited_claim_classes",
        "tool_ids",
        "granted_permission_kinds",
        "network_access",
        "dynamic_execution",
        "manual_observation",
        "target_mutation"
      ],
      "properties": {
        "allowed_claim_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}\\Z"
          }
        },
        "prohibited_claim_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}\\Z"
          }
        },
        "tool_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^act-[0-9a-f]{24}\\Z"
          }
        },
        "granted_permission_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}\\Z"
          }
        },
        "network_access": {
          "const": false
        },
        "dynamic_execution": {
          "const": false
        },
        "manual_observation": {
          "const": false
        },
        "target_mutation": {
          "const": false
        }
      }
    },
    "claims_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_status_issued",
        "results_joined",
        "challenges_resolved",
        "finding_or_severity_issued",
        "compliance_or_remediation_issued",
        "dynamic_or_manual_work_authorized",
        "older_attempt_consulted"
      ],
      "properties": {
        "control_status_issued": {
          "const": false
        },
        "results_joined": {
          "const": false
        },
        "challenges_resolved": {
          "const": false
        },
        "finding_or_severity_issued": {
          "const": false
        },
        "compliance_or_remediation_issued": {
          "const": false
        },
        "dynamic_or_manual_work_authorized": {
          "const": false
        },
        "older_attempt_consulted": {
          "const": false
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failed",
        "canceled",
        "timed_out",
        "skipped",
        "invalid",
        "degraded"
      ],
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_]{1,40}\\Z"
          }
        },
        "canceled": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_]{1,40}\\Z"
          }
        },
        "timed_out": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_]{1,40}\\Z"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_]{1,40}\\Z"
          }
        },
        "invalid": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_]{1,40}\\Z"
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_]{1,40}\\Z"
          }
        }
      }
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "owasp-dispatch-pool.schema.json"
      }
    },
    "dispatch_outcome": {
      "enum": [
        "EMPTY",
        "COMPLETE",
        "DEGRADED",
        "FAILED",
        "CANCELED"
      ]
    },
    "degraded": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "OK",
        "OK_WITH_GAPS"
      ]
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "owasp-dispatch-cell.schema.json"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "owasp-dispatch-row.schema.json"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "dispatched",
        "request_only",
        "valid_result",
        "failed",
        "canceled",
        "timed_out",
        "skipped",
        "invalid",
        "rows",
        "rows_deferred",
        "rows_deferred_with_request_only",
        "rows_not_assessed",
        "rows_request_only",
        "rows_not_validator_assignment",
        "fragments",
        "fragments_deferred",
        "fragments_not_assessed",
        "fragments_request_only"
      ],
      "properties": {
        "cells": {
          "type": "integer"
        },
        "dispatched": {
          "type": "integer"
        },
        "request_only": {
          "type": "integer"
        },
        "valid_result": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "canceled": {
          "type": "integer"
        },
        "timed_out": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "invalid": {
          "type": "integer"
        },
        "rows": {
          "type": "integer"
        },
        "rows_deferred": {
          "type": "integer"
        },
        "rows_deferred_with_request_only": {
          "type": "integer"
        },
        "rows_not_assessed": {
          "type": "integer"
        },
        "rows_request_only": {
          "type": "integer"
        },
        "rows_not_validator_assignment": {
          "type": "integer"
        },
        "fragments": {
          "type": "integer"
        },
        "fragments_deferred": {
          "type": "integer"
        },
        "fragments_not_assessed": {
          "type": "integer"
        },
        "fragments_request_only": {
          "type": "integer"
        }
      }
    },
    "accounting_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}\\Z"
    }
  }
}
