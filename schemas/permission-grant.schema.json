{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "permission-grant.schema.json",
  "title": "Engagement permission grant",
  "description": "An ALLOW or DENY issued by a named human authority, bound to one run and one source snapshot (and optionally one job), with issue and expiry timestamps. Carries credential reference ids only, never credential values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grant_id",
    "effect",
    "authority",
    "issued_at",
    "expires_at",
    "binding",
    "justification",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/permission-grant/1.0"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "effect": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^\\S"
        },
        "role": {
          "type": "string",
          "pattern": "^\\S"
        }
      }
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "source_snapshot_sha256",
        "job_id"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "source_snapshot_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "job_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        }
      }
    },
    "justification": {
      "type": "string",
      "pattern": "^\\S"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "permission-capability-entry.schema.json"
      }
    }
  }
}
