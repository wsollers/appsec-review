{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "debug-symbol-index.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "run_id",
        "job_id",
        "attempt_id",
        "status",
        "native_build",
        "upstream",
        "authority",
        "image",
        "tool",
        "records",
        "coverage_gaps"
    ],
    "properties": {
        "schema": {
            "const": "appsec-review/debug-symbol-index/1"
        },
        "run_id": {
            "type": "string"
        },
        "job_id": {
            "const": "02-debug-symbol-index"
        },
        "attempt_id": {
            "type": "string"
        },
        "status": {
            "enum": ["OK", "OK_WITH_GAPS", "SKIPPED"]
        },
        "native_build": {"$ref": "binary-evidence-native.schema.json"},
        "upstream": {
            "type": "object", "additionalProperties": false
        },
        "authority": {"$ref": "binary-evidence-authority.schema.json"},
        "image": {"$ref": "binary-evidence-image.schema.json"},
        "tool": {"$ref": "binary-evidence-tool.schema.json"},
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "binary_id",
                    "binary_sha256",
                    "build_identity_sha256",
                    "symbol_status",
                    "symbol_identity",
                    "symbols",
                    "gaps"
                ],
                "properties": {
                    "binary_id": {
                        "type": "string"
                    },
                    "binary_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "build_identity_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "symbol_status": {
                        "enum": [
                            "PRESENT",
                            "STRIPPED",
                            "PARTIAL",
                            "MISSING",
                            "MISMATCH"
                        ]
                    },
                    "symbol_identity": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "symbols": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "address",
                                "size",
                                "name",
                                "kind",
                                "source_path",
                                "line"
                                ,"symbol_id"
                            ],
                            "properties": {
                                "address": {
                                    "type": "string"
                                },
                                "size": {
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "name": {
                                    "type": "string"
                                },
                                "kind": {
                                    "type": "string"
                                },
                                "source_path": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                            "line": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ],
                                    "minimum": 1
                                },
                                "symbol_id": {"type":"string","pattern":"^sym_[0-9a-f]{16}$"}
                            }
                        }
                    },
                    "gaps": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "coverage_gaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "$defs": {
        "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "gaps": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "uniqueItems": true
        },
        "native": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "job_id",
                "attempt_id",
                "result_sha256",
                "envelope_sha256",
                "source_revision"
            ],
            "properties": {
                "job_id": {
                    "const": "02-native-build"
                },
                "attempt_id": {
                    "type": "string"
                },
                "result_sha256": {
                    "$ref": "#/$defs/hash"
                },
                "envelope_sha256": {
                    "$ref": "#/$defs/hash"
                },
                "source_revision": {
                    "type": "string"
                }
            }
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "image_id",
                "image_digest",
                "status"
            ],
            "properties": {
                "image_id": {
                    "type": "string"
                },
                "image_digest": {
                    "type": "null"
                },
                "status": {
                    "const": "M02_UNRESOLVED"
                }
            }
        },
        "tool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "adapter_id",
                "adapter_version",
                "config_sha256",
                "raw_evidence_sha256"
            ],
            "properties": {
                "adapter_id": {
                    "type": "string"
                },
                "adapter_version": {
                    "type": "string"
                },
                "config_sha256": {
                    "$ref": "#/$defs/hash"
                },
                "raw_evidence_sha256": {
                    "$ref": "#/$defs/hash"
                }
            }
        }
    }
}
