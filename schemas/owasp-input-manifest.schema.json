{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-input-manifest.schema.json",
  "title": "Accepted OWASP workbench input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "selection_id", "selection", "input_fingerprint", "admitted_at", "permissions",
    "reference_snapshots", "entries", "nvd", "gaps", "claim_limits"
  ],
  "properties": {
    "schema": {"const": "appsec-review/owasp-input-manifest/1.0"},
    "run_id": {"type": "string"},
    "selection_id": {"type": "string"},
    "selection": {"$ref": "standard-selection.schema.json"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admitted_at": {"type": "string"},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static_inspection", "dynamic_execution", "manual_observation", "network_access", "target_mutation"],
      "properties": {
        "static_inspection": {"const": true},
        "dynamic_execution": {"const": false},
        "manual_observation": {"const": false},
        "network_access": {"const": false},
        "target_mutation": {"const": false}
      }
    },
    "reference_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "edition", "profile_or_level", "snapshot_id", "manifest_path", "manifest_sha256", "manifest"],
        "properties": {
          "family": {"type": "string"},
          "edition": {"type": "string"},
          "profile_or_level": {"type": ["string", "null"]},
          "snapshot_id": {"type": "string"},
          "manifest_path": {"type": "string"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "manifest": {"$ref": "reference-snapshot-manifest.schema.json"}
        }
      }
    },
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "nvd": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["snapshot_id", "manifest_path", "manifest_sha256", "manifest", "feed_schema", "captured_at", "cursor", "age_seconds", "freshness_status", "limitations"],
      "properties": {
        "snapshot_id": {"type": "string"},
        "manifest_path": {"type": "string"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest": {"$ref": "nvd-snapshot-manifest.schema.json"},
        "feed_schema": {"const": "NVD_CVE/2.0"},
        "captured_at": {"type": "string"},
        "cursor": {"type": "string"},
        "age_seconds": {"type": "number"},
        "freshness_status": {"enum": ["within_advisory_target", "stale_accepted"]},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "gaps": {"type": "array", "items": {"type": "object"}},
    "claim_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
