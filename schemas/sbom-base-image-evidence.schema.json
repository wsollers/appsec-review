{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sbom-base-image-evidence.schema.json",
  "title": "Base-image evidence of one SBOM component (P43)",
  "description": "P43: the base images whose package database lists this component, one entry per inventory record, sorted by reference_id. Null on every component that is not image-observed.",
  "type": [
    "object",
    "null"
  ],
  "additionalProperties": false,
  "required": [
    "images"
  ],
  "properties": {
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "repository",
          "tag",
          "digest",
          "manifest_digest",
          "platform",
          "mutable",
          "dockerfile",
          "layer_digest",
          "operating_system",
          "eol_status",
          "support_end"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "pattern": "^BI-[0-9]{6}\\Z"
          },
          "repository": {
            "type": "string",
            "pattern": "^(?!.*[0-9A-Fa-f]{32})[a-z0-9]([a-z0-9._-]{0,126}[a-z0-9])?(:[0-9]{1,5})?(/[a-z0-9]([a-z0-9._-]{0,126}[a-z0-9])?){0,15}\\Z"
          },
          "tag": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?!.*[0-9A-Fa-f]{32})[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}\\Z"
          },
          "digest": {
            "description": "As declared in the FROM reference; null for a tag-only (mutable) reference.",
            "anyOf": [
              {
                "$ref": "common/formats.schema.json#/$defs/sha256_ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "manifest_digest": {
            "description": "The platform image manifest whose layers were inventoried.",
            "$ref": "common/formats.schema.json#/$defs/sha256_ref"
          },
          "platform": {
            "type": "string",
            "pattern": "^[a-z0-9]{1,16}/[a-z0-9]{1,16}(/[a-z0-9]{1,16})?\\Z"
          },
          "mutable": {
            "type": "boolean"
          },
          "dockerfile": {
            "description": "Where the FROM instruction is; path null when the inventory withheld it.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "start_line"
            ],
            "properties": {
              "path": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(?!.*[0-9A-Fa-f]{32})[A-Za-z0-9._+@%~,-][A-Za-z0-9._+@%~,/-]{0,1023}\\Z"
              },
              "start_line": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "layer_digest": {
            "description": "The layer the package database entry came from.",
            "$ref": "common/formats.schema.json#/$defs/sha256_ref"
          },
          "operating_system": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(?!.*[0-9A-Fa-f]{32})[a-z0-9][a-z0-9._-]{0,63}\\Z"
              },
              "version_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(?!.*[0-9A-Fa-f]{32})[A-Za-z0-9][A-Za-z0-9._~-]{0,63}\\Z"
              }
            }
          },
          "eol_status": {
            "type": "string",
            "enum": [
              "end-of-life",
              "supported",
              "not-listed"
            ]
          },
          "support_end": {
            "description": "From the pinned EOL table (data/base-image-eol.json); null when not-listed.",
            "anyOf": [
              {
                "$ref": "common/formats.schema.json#/$defs/utc_date"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
