{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poc-fix.schema.json",
  "title": "12b-poc-and-fix result",
  "description": "Unvalidated static PoCs and proposed fixes for verified, Critical, REACHABLE findings (brief F). Nothing here was executed or applied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "job_id",
    "source_snapshot_sha256",
    "scoring",
    "ledger_head_sha256",
    "enrichment_inputs",
    "eligibility",
    "requests",
    "records",
    "gaps",
    "skip_reason",
    "pool",
    "claim_limits"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/poc-fix/1.0"
    },
    "run_id": {
      "type": "string"
    },
    "job_id": {
      "const": "12b-poc-and-fix"
    },
    "source_snapshot_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "scoring": {
      "type": "object"
    },
    "ledger_head_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "enrichment_inputs": {
      "type": "object"
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "considered",
        "eligible",
        "selected",
        "excluded"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "considered": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "reason",
              "detail"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "reason": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "detail": {
                "type": "string",
                "maxLength": 600
              }
            }
          }
        }
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "claim_id",
          "workspace_sha256"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^pocreq-[0-9a-f]{16}$"
          },
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "workspace_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "poc-fix-record.schema.json"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "id",
          "reason",
          "detail"
        ],
        "properties": {
          "scope": {
            "enum": [
              "finding",
              "request",
              "job"
            ]
          },
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "detail": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    },
    "skip_reason": {
      "enum": [
        null,
        "not-applicable-no-eligible-findings"
      ]
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instances",
        "expected_worker_ids",
        "missing_worker_ids",
        "conflict_candidate_ids"
      ],
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 0
        },
        "expected_worker_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_worker_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflict_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claim_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "validated",
        "target_modified",
        "fixed_claimed",
        "finding_created",
        "severity_assigned"
      ],
      "properties": {
        "executed": {
          "const": false
        },
        "validated": {
          "const": false
        },
        "target_modified": {
          "const": false
        },
        "fixed_claimed": {
          "const": false
        },
        "finding_created": {
          "const": false
        },
        "severity_assigned": {
          "const": false
        }
      }
    }
  }
}
