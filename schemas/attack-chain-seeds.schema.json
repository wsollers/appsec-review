{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attack-chain-seeds.schema.json",
  "description": "Lane-14 seeding result (ADR-0016 decisions 2, 5, 8): excluded claims, one workspace per selected cluster, cuts and input gaps as gaps, and coverage counts. skip_reason is set when no cluster has an entry seed and a P1 or verified claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "verification",
    "bounds",
    "skip_reason",
    "excluded",
    "clusters",
    "gaps",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/attack-chain-seeds/1.0"
    },
    "run_id": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_head_id",
        "ledger_head_sha256"
      ],
      "properties": {
        "ledger_head_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ledger_head_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_clusters_max",
        "chain_cluster_claims_max",
        "chain_links_max",
        "chains_per_cluster_max",
        "chains_refuted_max",
        "chain_refutation_batch",
        "chains_reported_max"
      ],
      "properties": {
        "chain_clusters_max": {
          "type": "integer"
        },
        "chain_cluster_claims_max": {
          "type": "integer"
        },
        "chain_links_max": {
          "type": "integer"
        },
        "chains_per_cluster_max": {
          "type": "integer"
        },
        "chains_refuted_max": {
          "type": "integer"
        },
        "chain_refutation_batch": {
          "type": "integer"
        },
        "chains_reported_max": {
          "type": "integer"
        }
      }
    },
    "skip_reason": {
      "enum": [
        null,
        "not-applicable-no-chain-seeds"
      ]
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "reason"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "refuted",
              "superseded"
            ]
          }
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "$ref": "attack-chain-workspace.schema.json"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "id",
          "reason",
          "detail"
        ],
        "properties": {
          "scope": {
            "enum": [
              "input",
              "cluster",
              "chain"
            ]
          },
          "id": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "no-native-facts",
              "input-missing",
              "cluster-cap",
              "cluster-claims-cap",
              "cluster-facts-cap",
              "composer-failed",
              "composer-no-chain",
              "merge-conflict",
              "refutation-cap",
              "refuter-failed",
              "refutation-skipped-budget",
              "synthetic-edge"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_candidates",
        "excluded_claims",
        "entry_facts",
        "entry_claims",
        "clusters_seen",
        "clusters_eligible",
        "clusters_cut",
        "clusters_selected",
        "native_facts"
      ],
      "properties": {
        "link_candidates": {
          "type": "integer"
        },
        "excluded_claims": {
          "type": "integer"
        },
        "entry_facts": {
          "type": "integer"
        },
        "entry_claims": {
          "type": "integer"
        },
        "clusters_seen": {
          "type": "integer"
        },
        "clusters_eligible": {
          "type": "integer"
        },
        "clusters_cut": {
          "type": "integer"
        },
        "clusters_selected": {
          "type": "integer"
        },
        "native_facts": {
          "type": "boolean"
        }
      }
    }
  }
}
