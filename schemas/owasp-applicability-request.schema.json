{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-applicability-request.schema.json",
  "title": "OWASP applicability model request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "input_manifest", "assigned_reviewer", "components", "rules", "overrides"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-applicability-request/1.0"},
    "run_id": {"type": "string"},
    "input_manifest": {"$ref": "owasp-input-manifest-binding.schema.json"},
    "component_map": {"$ref": "owasp-component-map-binding.schema.json"},
    "universe": {"$ref": "#/$defs/universe_binding"},
    "assigned_reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "role"],
      "properties": {"reviewer_id": {"type": "string"}, "role": {"const": "owasp-applicability-reviewer"}}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "name", "classification_hash", "input_ids", "scope_status", "scope_authority"],
        "properties": {
          "component_id": {"type": "string"},
          "name": {"type": "string"},
          "classification_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "input_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_input_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "scope_status": {"enum": ["in_scope", "out_of_scope"]},
          "scope_authority": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["actor", "rationale", "decided_at"],
            "properties": {
              "actor": {"type": "string"},
              "rationale": {"type": "string"},
              "decided_at": {"type": "string"}
            }
          },
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "trust_role": {"type": "string"},
          "evidence_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "classification_state": {"enum": ["known", "partial", "unknown"]},
          "component_type": {"type": "string"},
          "coarse_group": {"type": "string"},
          "deployability": {"type": "string"},
          "control_scope": {
            "description": "ADR-0034: a synthetic asvs-V<n> chapter target receives only the controls of the listed chapters/domains.",
            "type": "object",
            "additionalProperties": false,
            "required": ["domain_ids"],
            "properties": {"domain_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "component_id", "selector", "decision"],
        "properties": {
          "rule_id": {"type": "string"},
          "component_id": {"type": "string"},
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "required": ["standard_family", "control_ids", "domain_ids", "all_controls"],
            "properties": {
              "standard_family": {"type": "string"},
              "control_ids": {"type": "array", "items": {"type": "string"}},
              "domain_ids": {"type": "array", "items": {"type": "string"}},
              "all_controls": {"type": "boolean"}
            }
          },
          "decision": {"$ref": "owasp-applicability-decision.schema.json"}
        }
      }
    },
    "overrides": {"type": "array", "items": {"$ref": "owasp-applicability-override.schema.json"}}
  },
  "$defs": {
    "universe_binding": {
      "description": "The newest accepted, within-budget 04-owasp-universe publication the request projects (ADR-0034).",
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "attempt_id", "accepted_pointer_path", "accepted_pointer_sha256", "artifact_path",
                   "artifact_sha256", "source_snapshot_sha256", "planned_validator_calls"],
      "properties": {
        "job_id": {"const": "04-owasp-universe"},
        "attempt_id": {"$ref": "common/formats.schema.json#/$defs/attempt_id"},
        "accepted_pointer_path": {"const": "jobs/04-owasp-universe/whole/accepted.json"},
        "accepted_pointer_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_hex"},
        "artifact_path": {"type": "string", "pattern": "^jobs/04-owasp-universe/whole/attempts/[^/]+/outputs/owasp-universe\\.json\\Z"},
        "artifact_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_hex"},
        "source_snapshot_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
        "planned_validator_calls": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"}
      }
    }
  }
}
