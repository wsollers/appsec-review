{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-build.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "source_revision",
    "upstream",
    "status",
    "units",
    "coverage_gaps"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/native-build/1"
    },
    "run_id": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "status": {
      "enum": [
        "OK",
        "OK_WITH_GAPS"
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution",
        "configured"
      ],
      "properties": {
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job",
            "attempt_id",
            "lock_sha256"
          ],
          "properties": {
            "job": {
              "const": "02-build-resolution"
            },
            "attempt_id": {
              "type": "string"
            },
            "lock_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "configured": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job",
            "attempt_id",
            "result_sha256",
            "envelope_sha256"
          ],
          "properties": {
            "job": {
              "const": "02-build-configure"
            },
            "attempt_id": {
              "type": "string"
            },
            "result_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "envelope_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "status",
          "image_id",
          "image_digest",
          "commands",
          "compile_database",
          "binaries"
        ],
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "status": {
            "const": "OK"
          },
          "image_id": {
            "type": "string",
            "pattern": "^image_build_[0-9a-f]{12}$"
          },
          "image_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "compile_database": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "entries"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "entries": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "binaries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_path",
                "artifact_path",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "source_path": {
                  "type": "string"
                },
                "artifact_path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "generated_headers": {
            "description": "P35: configure-generated headers present in the build copy but absent from the checkout, published under root and hash-bound; omitted counts headers beyond the count/size bound.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "headers",
              "omitted"
            ],
            "properties": {
              "root": {
                "type": "string"
              },
              "headers": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "size_bytes"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "$ref": "common/formats.schema.json#/$defs/sha256_ref"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "omitted": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "build_dependencies": {
            "description": "P36: the unit's build-dependencies.json (schemas/build-dependencies.schema.json), captured in the build image after the successful replay and bound by sha256; path is relative to the attempt.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^outputs/[A-Za-z0-9._-]+/build-dependencies\\.json\\Z"
              },
              "sha256": {
                "$ref": "common/formats.schema.json#/$defs/sha256_ref"
              }
            }
          }
        }
      }
    },
    "coverage_gaps": {
      "description": "Run-level gaps; only a lock with no unit produces one (no-resolved-build-units). Per-unit capture gaps live in each build-dependencies.json.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
