{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-participation.schema.json",
  "title": "Accepted 04-owasp-participation result: validated per-chapter classification of every candidate (ADR-0034)",
  "description": "Python plans one cell per chapter with candidates (split by max_candidates_per_cell), checks the planned call count against the participation budget before any call, validates each owasp-participation-cell reply and accounts for every candidate exactly once: a validated record or an unclassified entry (a gap). Model output is classification only; nothing here selects controls or work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "job_id", "source_snapshot_sha256", "status", "candidate_search", "code_index", "config",
               "budget", "cells", "records", "unclassified", "rejected_records", "gaps"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-participation/1.0"},
    "run_id": {"$ref": "common/formats.schema.json#/$defs/run_id"},
    "job_id": {"const": "04-owasp-participation"},
    "source_snapshot_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
    "status": {"$ref": "common/formats.schema.json#/$defs/ok_status"},
    "candidate_search": {"$ref": "owasp-universe.schema.json#/$defs/binding"},
    "code_index": {"$ref": "owasp-universe.schema.json#/$defs/binding"},
    "config": {"$ref": "owasp-universe.schema.json#/$defs/config_ref"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_candidates_per_cell", "max_participation_calls", "planned_calls", "within_budget"],
      "properties": {
        "max_candidates_per_cell": {"type": "integer", "minimum": 1},
        "max_participation_calls": {"type": "integer", "minimum": 1},
        "planned_calls": {"description": "sum over chapters of ceil(candidate_count / max_candidates_per_cell); a published result always has within_budget true.", "$ref": "common/formats.schema.json#/$defs/nonneg_int"},
        "within_budget": {"const": true}
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cell_id", "chapter_id", "candidate_ids", "outcome", "reply_sha256"],
        "properties": {
          "cell_id": {"type": "string", "pattern": "^asvs-V(?:[1-9]|1[0-7])-[0-9]{2}\\Z"},
          "chapter_id": {"$ref": "owasp-category-rules.schema.json#/$defs/chapter_id"},
          "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "owasp-candidate-search.schema.json#/$defs/candidate_id"}},
          "outcome": {"enum": ["accepted", "invalid_reply", "failed"]},
          "reply_sha256": {"oneOf": [{"type": "null"}, {"$ref": "common/formats.schema.json#/$defs/sha256_hex"}]}
        }
      }
    },
    "records": {
      "description": "Validated records: every citation resolved in the snapshot. candidate_id null marks a model-found participating function (Python resolved its span in the code index).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cell_id", "chapter_id", "candidate_id", "symbol", "file", "file_sha256", "start_line", "end_line", "role", "citations", "rationale"],
        "properties": {
          "cell_id": {"type": "string", "pattern": "^asvs-V(?:[1-9]|1[0-7])-[0-9]{2}\\Z"},
          "chapter_id": {"$ref": "owasp-category-rules.schema.json#/$defs/chapter_id"},
          "candidate_id": {"oneOf": [{"type": "null"}, {"$ref": "owasp-candidate-search.schema.json#/$defs/candidate_id"}]},
          "symbol": {"type": "string", "minLength": 1, "maxLength": 1000},
          "file": {"$ref": "owasp-candidate-search.schema.json#/$defs/path"},
          "file_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref_or_hex"},
          "start_line": {"$ref": "owasp-candidate-search.schema.json#/$defs/line"},
          "end_line": {"$ref": "owasp-candidate-search.schema.json#/$defs/line"},
          "role": {"enum": ["implements", "enforces", "consumes", "not_participating"]},
          "citations": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "line", "file_sha256"],
              "properties": {
                "file": {"$ref": "owasp-candidate-search.schema.json#/$defs/path"},
                "line": {"$ref": "owasp-candidate-search.schema.json#/$defs/line"},
                "file_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref_or_hex"}
              }
            }
          },
          "rationale": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    },
    "unclassified": {
      "description": "Candidates without exactly one validated record. Each is a gap for its chapter, never a not_participating.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "chapter_id", "cell_id", "reason"],
        "properties": {
          "candidate_id": {"$ref": "owasp-candidate-search.schema.json#/$defs/candidate_id"},
          "chapter_id": {"$ref": "owasp-category-rules.schema.json#/$defs/chapter_id"},
          "cell_id": {"type": "string", "pattern": "^asvs-V(?:[1-9]|1[0-7])-[0-9]{2}\\Z"},
          "reason": {"enum": ["missing_record", "duplicate_record", "citation_unresolved", "span_mismatch", "cell_failed", "invalid_reply"]}
        }
      }
    },
    "rejected_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cell_id", "record_index", "reason"],
        "properties": {
          "cell_id": {"type": "string", "pattern": "^asvs-V(?:[1-9]|1[0-7])-[0-9]{2}\\Z"},
          "record_index": {"$ref": "common/formats.schema.json#/$defs/nonneg_int"},
          "reason": {"enum": ["unknown_candidate", "duplicate_record", "citation_unresolved", "span_mismatch", "symbol_not_indexed"]}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "kind", "chapter_ids", "statement"],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^gap-[0-9a-f]{20}\\Z"},
          "kind": {"enum": ["unclassified_candidates", "cell_failed", "invalid_reply"]},
          "chapter_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "owasp-category-rules.schema.json#/$defs/chapter_id"}},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
