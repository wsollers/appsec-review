{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-assembly-supply.schema.json",
  "title": "Supplied evidence-assembly generation bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "source_snapshot_sha256", "producers"],
  "properties": {
    "schema": {"const": "appsec-review/evidence-assembly-supply/1.0"},
    "run_id": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "producers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "source_snapshot_sha256", "producer_source_snapshot_sha256", "build_lineage_sha256", "permissions", "terminal_instance_ids"],
        "properties": {
          "job_id": {"type": "string", "pattern": "^02-[0-9a-z-]+$"},
          "source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "producer_source_snapshot_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "build_lineage_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "terminal_instance_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}
        }
      }
    }
  }
}
