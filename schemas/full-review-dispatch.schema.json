{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-review-dispatch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "job_id", "attempt_id", "source_generation", "assembly_attempt_id", "assembly_sha256", "results", "skipped"],
  "properties": {
    "schema": {"const": "appsec-review/full-review-dispatch/1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"const": "02-full-review-input-dispatch"},
    "attempt_id": {"type": "string", "minLength": 1},
    "source_generation": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "assembly_attempt_id": {"type": "string", "minLength": 1},
    "assembly_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["job_id", "adapter", "status", "request_sha256", "result_path", "result_sha256"],
        "properties": {
          "job_id": {"type": "string", "minLength": 1},
          "adapter": {"enum": ["bounded", "vendor", "dependency"]},
          "status": {"const": "CURRENT"},
          "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "result_path": {"type": "string", "pattern": "^results/[0-9A-Za-z._-]+\\.json$"},
          "result_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["job_id", "status", "reason"],
        "properties": {
          "job_id": {"type": "string", "minLength": 1},
          "status": {"const": "SKIPPED_NA"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
