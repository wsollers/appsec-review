{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pool-specification.schema.json",
  "title": "Pool specification (C01)",
  "description": "appsec-review/pool-specification/1.0: one pool job as a recorded configuration. Closed, every property required. wait_all is required and may only be true: a pool that does not wait for every expected instance is not expressible in 1.0. A resource pool is never named per worker; it is derived by resource_pools.derive_pool and only bounded here by resource_pool_policy.allowed_pools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pool_id",
    "lane",
    "run_id",
    "job_id",
    "attempt_id",
    "budget_class",
    "pool_budget",
    "resource_pool_policy",
    "wait_all",
    "rendezvous_timeout_seconds",
    "empty_pool_reason",
    "worker_groups"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/pool-specification/1.0"
    },
    "pool_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}\\Z"
    },
    "lane": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}\\Z"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}\\Z"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}\\Z"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}\\Z"
    },
    "budget_class": {
      "type": "string",
      "enum": [
        "probe",
        "standard",
        "deep"
      ]
    },
    "pool_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_instances",
        "max_persona_input_units",
        "max_persona_output_units",
        "max_total_timeout_seconds"
      ],
      "properties": {
        "max_instances": {
          "type": "integer"
        },
        "max_persona_input_units": {
          "type": "integer"
        },
        "max_persona_output_units": {
          "type": "integer"
        },
        "max_total_timeout_seconds": {
          "type": "integer"
        }
      }
    },
    "resource_pool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_pools"
      ],
      "properties": {
        "allowed_pools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{1,31}\\Z"
          }
        }
      }
    },
    "wait_all": {
      "const": true
    },
    "rendezvous_timeout_seconds": {
      "type": "integer"
    },
    "empty_pool_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "no_applicable_work",
        "scope_excluded",
        "upstream_produced_no_work",
        null
      ]
    },
    "worker_groups": {
      "type": "array",
      "items": {
        "$ref": "pool-worker-group.schema.json"
      }
    }
  }
}
