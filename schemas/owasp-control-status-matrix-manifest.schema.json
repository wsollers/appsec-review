{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-control-status-matrix-manifest.schema.json",
  "title": "Manifest for a deterministically partitioned OWASP control status matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "selection_id", "logical_matrix_schema", "logical_matrix_sha256", "rows_sha256", "row_count", "matrix_header", "pages"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-control-status-matrix-manifest/1.0"},
    "run_id": {"type": "string"},
    "selection_id": {"type": "string"},
    "logical_matrix_schema": {"const": "appsec-review/owasp-control-status-matrix/1.0"},
    "logical_matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_count": {"type": "integer", "minimum": 1},
    "matrix_header": {"type": "object"},
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["page_index", "path", "sha256", "byte_size", "first_row_index", "last_row_index", "row_count"],
        "properties": {
          "page_index": {"type": "integer", "minimum": 0},
          "path": {"type": "string", "pattern": "^owasp-control-status-matrix-pages/page-[0-9]{4}\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_size": {"type": "integer", "minimum": 1, "maximum": 7340032},
          "first_row_index": {"type": "integer", "minimum": 0},
          "last_row_index": {"type": "integer", "minimum": 0},
          "row_count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
