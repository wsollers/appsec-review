{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-reachability.schema.json",
  "title": "Reachability engine table shared by 06-reachability-codeql and 06-reachability-ir (ADR-0023)",
  "description": "One row per accepted SCA match. Derived deterministically from hash-bound evidence; no model text. unknown is never 'not vulnerable'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "job_id",
    "attempt_id",
    "engine",
    "source_snapshot_sha256",
    "sca_binding",
    "status",
    "languages",
    "rows",
    "counts",
    "coverage_gaps",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/engine-reachability/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
    },
    "job_id": {
      "enum": [
        "06-reachability-codeql",
        "06-reachability-ir"
      ]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
    },
    "engine": {
      "enum": [
        "codeql",
        "ir"
      ]
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}\\Z"
    },
    "sca_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id",
        "sha256"
      ],
      "properties": {
        "job_id": {
          "const": "02-sca-vulnerability-match"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}\\Z"
        }
      }
    },
    "status": {
      "enum": [
        "OK",
        "OK_WITH_GAPS"
      ]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "state",
          "database_ids",
          "gaps"
        ],
        "properties": {
          "language": {
            "enum": [
              "cpp",
              "go",
              "java",
              "csharp",
              "javascript",
              "python",
              "ruby",
              "rust",
              "php"
            ]
          },
          "state": {
            "enum": [
              "ran",
              "no-matches",
              "no-database",
              "no-pack",
              "no-engine",
              "gap"
            ]
          },
          "database_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^codeqldb_[0-9a-f]{16}\\Z"
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^\\x00-\\x1f\\x7f]{0,512}\\Z"
            }
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "engine-reachability-row.schema.json"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reachable",
        "unreachable",
        "unknown"
      ],
      "properties": {
        "reachable": {
          "type": "integer",
          "minimum": 0
        },
        "unreachable": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\x00-\\x1f\\x7f]{0,512}\\Z"
      }
    },
    "claim_ceiling": {
      "const": "EVIDENCE_LEADS_ONLY"
    }
  }
}
