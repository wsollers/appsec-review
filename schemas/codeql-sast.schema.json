{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codeql-sast.schema.json",
  "title": "Normalized CodeQL security-suite evidence leads (02-codeql-sast)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "job_id",
    "attempt_id",
    "source_snapshot_sha256",
    "status",
    "tools",
    "leads",
    "coverage_gaps"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/codeql-sast/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
    },
    "job_id": {
      "const": "02-codeql-sast"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,95}\\Z"
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}\\Z"
    },
    "status": {
      "enum": [
        "OK",
        "OK_WITH_GAPS"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "tool",
          "version",
          "language",
          "build_mode",
          "query_suite",
          "image_id",
          "image_digest",
          "tool_metadata_sha256",
          "lane_script_sha256",
          "records",
          "dropped_records"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "pattern": "^codeql-[a-z]+\\Z"
          },
          "tool": {
            "const": "codeql"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9][0-9A-Za-z.+_-]{0,31}\\Z"
          },
          "language": {
            "enum": [
              "cpp",
              "csharp",
              "java",
              "javascript",
              "python",
              "ruby"
            ]
          },
          "build_mode": {
            "const": "none"
          },
          "query_suite": {
            "type": "string",
            "pattern": "^codeql/[a-z]+-queries:codeql-suites/[a-z]+-security-extended\\.qls\\Z"
          },
          "image_id": {
            "const": "audit-codeql"
          },
          "image_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "tool_metadata_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "lane_script_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "dropped_records": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "leads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lead_id",
          "tool_id",
          "rule_id",
          "path",
          "start_line",
          "end_line",
          "source_sha256",
          "language",
          "category"
        ],
        "properties": {
          "lead_id": {
            "type": "string",
            "pattern": "^lead_[0-9a-f]{16}\\Z"
          },
          "tool_id": {
            "type": "string",
            "pattern": "^codeql-[a-z]+\\Z"
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[^\\r\\n]{1,256}\\Z"
          },
          "rule_name": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]{1,256}\\Z"
          },
          "cwe": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CWE-[1-9][0-9]{0,5}\\Z"
            }
          },
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\][^\\r\\n]{0,1023}\\Z"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}\\Z"
          },
          "language": {
            "enum": [
              "cpp",
              "csharp",
              "java",
              "javascript",
              "python",
              "ruby"
            ]
          },
          "category": {
            "const": "codeql-security-query"
          }
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
