{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attack-chain-record.schema.json",
  "description": "One derived attack chain (ADR-0016 decisions 3, 4, 7). Link states, edge bases, ids, causal_claim_ids, the state and the weakest link are computed by Python. A chain is prioritisation context: it never creates a finding or assigns severity, and its ceiling is supported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain_id",
    "cluster_id",
    "objective",
    "impact_kind",
    "narrative",
    "links",
    "edges",
    "causal_claim_ids",
    "fact_refs",
    "weakest",
    "refutation",
    "state",
    "composer",
    "claim_limits"
  ],
  "properties": {
    "chain_id": {
      "type": "string",
      "pattern": "^chain-[0-9a-f]{24}$"
    },
    "cluster_id": {
      "type": "string",
      "pattern": "^cluster-[0-9a-f]{16}$"
    },
    "objective": {
      "type": "string"
    },
    "impact_kind": {
      "enum": [
        "code_execution",
        "data_disclosure",
        "data_tampering",
        "denial_of_service",
        "credential_theft",
        "exfiltration"
      ]
    },
    "narrative": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "stage",
          "claim_id",
          "fact_ref",
          "link_state",
          "prerequisites",
          "citations"
        ],
        "properties": {
          "index": {
            "type": "integer"
          },
          "stage": {
            "enum": [
              "entry",
              "execution",
              "privilege_gain",
              "persistence",
              "lateral_movement",
              "impact"
            ]
          },
          "claim_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "fact_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "link_state": {
            "enum": [
              "verified",
              "narrowed",
              "open",
              "refuted"
            ]
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "requires_link_indexes"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "requires_link_indexes": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "claim-citation",
                    "fact"
                  ]
                }
              }
            }
          },
          "attack_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "basis",
          "fact_ref",
          "fact_refs",
          "adjacency_edge_id",
          "downgraded_from",
          "rationale"
        ],
        "properties": {
          "from": {
            "type": "integer"
          },
          "to": {
            "type": "integer"
          },
          "basis": {
            "enum": [
              "code_fact",
              "model_flow",
              "synthetic"
            ]
          },
          "fact_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "fact_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adjacency_edge_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "downgraded_from": {
            "enum": [
              null,
              "code_fact",
              "model_flow"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "causal_claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "fact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weakest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index",
        "reason"
      ],
      "properties": {
        "kind": {
          "enum": [
            "link",
            "edge"
          ]
        },
        "index": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "refutation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "disposition",
        "target",
        "mechanism",
        "refuter",
        "citations"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "broken",
            "narrowed",
            "holds",
            "cannot_assess",
            "not_run"
          ]
        },
        "target": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ],
          "properties": {
            "kind": {
              "enum": [
                "link",
                "edge"
              ]
            },
            "index": {
              "type": "integer"
            }
          }
        },
        "mechanism": {
          "type": [
            "string",
            "null"
          ]
        },
        "refuter": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "job_id",
            "attempt_id",
            "persona_id",
            "request_sha256"
          ],
          "properties": {
            "job_id": {
              "type": "string"
            },
            "attempt_id": {
              "type": "string"
            },
            "persona_id": {
              "type": "string"
            },
            "request_sha256": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "state": {
      "enum": [
        "supported",
        "plausible",
        "hypothesis",
        "refuted"
      ]
    },
    "composer": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id",
        "persona_id",
        "request_sha256"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "persona_id": {
          "type": "string"
        },
        "request_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_created",
        "severity_assigned"
      ],
      "properties": {
        "finding_created": {
          "const": false
        },
        "severity_assigned": {
          "const": false
        }
      }
    },
    "mitre_reference": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "reference_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attack_versions": {
          "type": "object"
        },
        "capec_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
