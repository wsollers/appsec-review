{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "operations-doc-intelligence.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "run_id",
        "job_id",
        "attempt_id",
        "status",
        "source",
        "sources",
        "records",
        "coverage_gaps",
        "static_only"
    ],
    "properties": {
        "schema": {
            "const": "appsec-review/operations-doc-intelligence/1"
        },
        "run_id": {
            "type": "string"
        },
        "job_id": {
            "const": "02-operations-doc-ingest"
        },
        "attempt_id": {
            "type": "string"
        },
        "status": {
            "$ref": "common/formats.schema.json#/$defs/publishable_status"
        },
        "applicability": {
            "enum": [
                "APPLICABLE",
                "SKIPPED_NA_NO_APPLICABLE_INPUTS"
            ]
        },
        "inventory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "files_examined",
                "non_file_entries",
                "candidates"
            ],
            "properties": {
                "files_examined": {"type": "integer", "minimum": 0},
                "non_file_entries": {"type": "integer", "minimum": 0},
                "candidates": {"type": "integer", "minimum": 0}
            }
        },
        "source": {"$ref":"static-intelligence-binding.schema.json"},
        "sources": {
            "type": "array",
            "items": {
                "$ref": "static-intelligence-source.schema.json"
            }
        },
        "records": {
            "type": "array",
            "items": {
                "$ref": "static-intelligence-record.schema.json"
            }
        },
        "coverage_gaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "static_only": {
            "const": true
        }
    },
    "allOf": [
        {
            "if": {"properties": {"status": {"const": "SKIPPED"}}, "required": ["status"]},
            "then": {
                "required": ["applicability", "inventory"],
                "properties": {
                    "applicability": {"const": "SKIPPED_NA_NO_APPLICABLE_INPUTS"},
                    "inventory": {"properties": {"non_file_entries": {"const": 0}, "candidates": {"const": 0}}},
                    "records": {"maxItems": 0},
                    "coverage_gaps": {"maxItems": 0}
                }
            }
        }
    ]
}
