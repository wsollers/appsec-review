{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "doc-intelligence.schema.json",
    "description": "02-doc-intelligence-ingest (gap 7): the document universe Python chose (documents, skipped with reasons), locator records with citations, and the converted-text manifest binding. Records are documented static intent, never findings.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "run_id",
        "job_id",
        "attempt_id",
        "status",
        "applicability",
        "inventory",
        "source",
        "sources",
        "documents",
        "skipped",
        "records",
        "converted_text",
        "coverage_gaps",
        "static_only"
    ],
    "properties": {
        "schema": {
            "const": "appsec-review/doc-intelligence/2"
        },
        "run_id": {
            "type": "string"
        },
        "job_id": {
            "const": "02-doc-intelligence-ingest"
        },
        "attempt_id": {
            "type": "string"
        },
        "status": {
            "$ref": "common/formats.schema.json#/$defs/publishable_status"
        },
        "applicability": {
            "enum": [
                "APPLICABLE",
                "SKIPPED_NA_NO_APPLICABLE_INPUTS"
            ]
        },
        "inventory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "files_examined",
                "non_file_entries",
                "candidates"
            ],
            "properties": {
                "files_examined": {"type": "integer", "minimum": 0},
                "non_file_entries": {"type": "integer", "minimum": 0},
                "candidates": {"type": "integer", "minimum": 0}
            }
        },
        "source": {"$ref": "static-intelligence-binding.schema.json"},
        "sources": {
            "type": "array",
            "items": {
                "$ref": "static-intelligence-source.schema.json"
            }
        },
        "documents": {
            "description": "Every included document with its deterministic class and format; outcome gap carries the gap kind.",
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "doc_class", "format", "source_sha256", "outcome", "reason"],
                "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "doc_class": {"$ref": "#/$defs/doc_class"},
                    "format": {"$ref": "#/$defs/format"},
                    "source_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
                    "outcome": {"enum": ["indexed", "gap"]},
                    "reason": {"type": ["string", "null"]}
                }
            }
        },
        "skipped": {
            "description": "Every candidate document the intake rules did not take, with the reason.",
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "reason"],
                "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "reason": {
                        "type": "string",
                        "pattern": "^(?:outside-document-scope|unsafe-path|excluded-path:[a-z-]+|unsupported-format:\\.[a-z0-9]+)\\Z"
                    }
                }
            }
        },
        "records": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/doc_record"
            }
        },
        "converted_text": {
            "description": "Binding to doc-text-manifest.json (doc-text-manifest.schema.json): one UTF-8 text artifact per converted document.",
            "type": "object",
            "additionalProperties": false,
            "required": ["manifest", "sha256", "documents"],
            "properties": {
                "manifest": {"const": "doc-text-manifest.json"},
                "sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
                "documents": {"type": "integer", "minimum": 0}
            }
        },
        "coverage_gaps": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "static_only": {
            "const": true
        }
    },
    "allOf": [
        {
            "if": {"properties": {"status": {"const": "SKIPPED"}}, "required": ["status"]},
            "then": {
                "properties": {
                    "applicability": {"const": "SKIPPED_NA_NO_APPLICABLE_INPUTS"},
                    "inventory": {"properties": {"non_file_entries": {"const": 0}, "candidates": {"const": 0}}},
                    "records": {"maxItems": 0},
                    "documents": {"maxItems": 0},
                    "coverage_gaps": {"maxItems": 0}
                }
            }
        }
    ],
    "$defs": {
        "doc_class": {
            "enum": ["readme", "security_policy", "changelog", "design", "api", "manual", "other"]
        },
        "format": {
            "enum": ["text", "markdown", "rst", "adoc", "html", "roff", "pdf", "docx"]
        },
        "topic": {
            "enum": ["auth", "crypto", "tls", "secrets", "reporting_policy"]
        },
        "doc_record": {
            "description": "static-intelligence-record plus the document class, format, security topics and a citation (path:line, path#page=N or path#text-line=N).",
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "kind", "path", "source_sha256", "locator", "summary", "semantics",
                         "citation", "doc_class", "format"],
            "properties": {
                "record_id": {"type": "string", "pattern": "^intel_[0-9a-f]{16}\\Z"},
                "kind": {"enum": ["document", "document-heading", "security-section", "document-statement"]},
                "path": {"type": "string", "minLength": 1},
                "source_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
                "locator": {
                    "type": "string",
                    "pattern": "^(?:file|line:[1-9][0-9]*(?::text-line:[1-9][0-9]*)?|page:[1-9][0-9]*:line:[1-9][0-9]*|text-line:[1-9][0-9]*)\\Z"
                },
                "summary": {"type": "string"},
                "semantics": {"const": "DOCUMENTED_STATIC_INTENT"},
                "citation": {"type": "string", "pattern": "^.+(?::[1-9][0-9]*|#page=[1-9][0-9]*|#text-line=[1-9][0-9]*)\\Z"},
                "doc_class": {"$ref": "#/$defs/doc_class"},
                "format": {"$ref": "#/$defs/format"},
                "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/topic"}},
                "heading_level": {"type": "integer", "minimum": 1, "maximum": 6}
            }
        }
    }
}
