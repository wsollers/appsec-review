{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pinned-container-request.schema.json",
  "title": "Pinned-container adapter request",
  "description": "Everything a caller may say to the pinned-container argv adapter. There is deliberately no property for a docker option, a tag, a capability, a device, a writable target mount, a user, a working directory or a host environment name. Bounds, path identity, the image registry and the permission gate are container_execution.py responsibilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "job_id",
    "attempt_id",
    "image",
    "argv",
    "environment",
    "target_mounts",
    "scratch_path",
    "log_path",
    "network",
    "permission",
    "limits"
  ],
  "properties": {
    "schema": {
      "const": "appsec-review/pinned-container-request/1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}\\Z"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}\\Z"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}\\Z"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_id",
        "digest"
      ],
      "properties": {
        "image_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}\\Z"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}\\Z"
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "LANG",
              "LC_ALL",
              "NO_COLOR",
              "SOURCE_DATE_EPOCH",
              "TZ",
              "XDG_CACHE_HOME"
            ]
          },
          "value": {
            "type": "string",
            "pattern": "^[ -~]{0,256}\\Z"
          }
        }
      }
    },
    "target_mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host_path",
          "container_path"
        ],
        "properties": {
          "host_path": {
            "type": "string"
          },
          "container_path": {
            "type": "string",
            "pattern": "^/(workspace|inputs/[a-z0-9][a-z0-9_-]{0,39})\\Z"
          }
        }
      }
    },
    "scratch_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,7}\\Z"
    },
    "log_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,7}\\Z"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "destinations"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "granted-fixed-destinations"
          ]
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scheme",
              "host",
              "port"
            ],
            "properties": {
              "scheme": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9+.-]{0,15}\\Z"
              },
              "host": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?\\Z"
              },
              "port": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "grants",
        "decision"
      ],
      "properties": {
        "requirement": {
          "$ref": "permission-requirement.schema.json"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "permission-grant.schema.json"
          }
        },
        "decision": {
          "$ref": "permission-decision.schema.json"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "memory_bytes",
        "cpu_millis",
        "pids",
        "tmpfs_bytes",
        "stdout_limit_bytes",
        "stderr_limit_bytes"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer"
        },
        "memory_bytes": {
          "type": "integer"
        },
        "cpu_millis": {
          "type": "integer"
        },
        "pids": {
          "type": "integer"
        },
        "tmpfs_bytes": {
          "type": "integer"
        },
        "stdout_limit_bytes": {
          "type": "integer"
        },
        "stderr_limit_bytes": {
          "type": "integer"
        }
      }
    }
  }
}
