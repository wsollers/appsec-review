{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owasp-participants-bundle.schema.json",
  "title": "asvs-participants-V<n>: hash-bound source excerpts of one participating ASVS chapter (ADR-0034)",
  "description": "Written by 04-owasp-universe as outputs/asvs-participants-V<n>.json and admitted by the OWASP lane-in as source_excerpt_bundle / canonical_evidence. Each excerpt is the exact snapshot text of lines start_line..end_line of a participating function; text_sha256 is sha256 of the UTF-8 text; the lane-in re-reads the snapshot and rejects any mismatch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "input_id", "chapter_id", "source_snapshot_sha256", "excerpts", "truncated"],
  "properties": {
    "schema": {"const": "appsec-review/owasp-participants-bundle/1.0"},
    "run_id": {"$ref": "common/formats.schema.json#/$defs/run_id"},
    "input_id": {"type": "string", "pattern": "^asvs-participants-V(?:[1-9]|1[0-7])\\Z"},
    "chapter_id": {"$ref": "owasp-category-rules.schema.json#/$defs/chapter_id"},
    "source_snapshot_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref"},
    "excerpts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "file", "file_sha256", "start_line", "end_line", "roles", "text", "text_sha256"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1, "maxLength": 1000},
          "file": {"$ref": "owasp-candidate-search.schema.json#/$defs/path"},
          "file_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_ref_or_hex"},
          "start_line": {"$ref": "owasp-candidate-search.schema.json#/$defs/line"},
          "end_line": {"$ref": "owasp-candidate-search.schema.json#/$defs/line"},
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["implements", "enforces", "consumes"]}},
          "text": {"type": "string"},
          "text_sha256": {"$ref": "common/formats.schema.json#/$defs/sha256_hex"}
        }
      }
    },
    "truncated": {
      "description": "Excerpts cut at max_excerpt_lines or dropped at max_bundle_bytes; the universe records a bundle_truncated gap for each.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "file", "reason"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1, "maxLength": 1000},
          "file": {"$ref": "owasp-candidate-search.schema.json#/$defs/path"},
          "reason": {"enum": ["max_excerpt_lines", "max_bundle_bytes"]}
        }
      }
    }
  }
}
