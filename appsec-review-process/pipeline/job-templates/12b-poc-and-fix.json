{
  "schema": "appsec-review/job-template/0.1",
  "process": "12b-poc-and-fix",
  "budget_default": "standard",
  "model": {
    "model": "deterministic-python",
    "effort": "none"
  },
  "permissions": [
    "read-run-data",
    "write-run-data"
  ],
  "prompt_sections": [
    "governing_rules",
    "persona",
    "role",
    "domain",
    "tooling_profile",
    "output_contract"
  ],
  "implemented": true,
  "retry": {
    "max_attempts": 1,
    "transient_reasons": [],
    "side_effect_free": true
  },
  "coordinator": "intake-coordinator",
  "job_template_id": "12b-poc-and-fix",
  "display_name": "Light PoC and Proposed Fix",
  "composition": {
    "persona_id": "poc-fix-author",
    "role_id": "poc-fix-coordinator",
    "domain_id": "poc-and-fix",
    "tooling_profile_id": "claim-review-static",
    "output_contract_id": "12b-poc-and-fix"
  },
  "inputs": {
    "required": [
      "accepted 12-scoring-prioritization result"
    ],
    "optional": [
      "accepted 02-code-property-graph and 02-ir-facts (reachability)",
      "inputs/reachability-entry-points.json",
      "projected source checkout (hashes, snippets)"
    ]
  },
  "outputs": {
    "directory": "outputs/12b-poc-and-fix",
    "files": [
      "poc-fix.json",
      "poc-fix.md",
      "poc-fix-pool-merge.json",
      "permission.json",
      "lineage.json",
      "pool-receipt.json",
      "status.json"
    ]
  },
  "applicability": "every full review after 12; SKIPPED not-applicable-no-eligible-findings when no finding is verified, scored CRITICAL and REACHABLE",
  "timeout_seconds": 7200,
  "tunables": {
    "poc_findings_max": {
      "value": 12,
      "unit": "count",
      "kind": "resource",
      "description": "Eligible findings (verified, CRITICAL, REACHABLE) that get a poc-and-fix cell, highest 12 score first; the rest are recorded as a gap.",
      "scale": "Each cell is one claude -p call capped at budget_max_usd_per_call[standard]."
    },
    "poc_citation_window_lines": {
      "value": 20,
      "unit": "lines",
      "kind": "window",
      "description": "Lines either side of each finding location and witness call site that a PoC or fix may cite.",
      "scale": ""
    },
    "max_parallel": {
      "value": 2,
      "unit": "count",
      "kind": "resource",
      "description": "poc-and-fix cells dispatched concurrently (the persona_llm pool bounds it too).",
      "scale": ""
    },
    "rendezvous_timeout_seconds": {
      "value": 3600,
      "unit": "seconds",
      "kind": "resource",
      "description": "Wall-clock wait for every cell of the lane-12b pool.",
      "scale": ""
    }
  }
}
