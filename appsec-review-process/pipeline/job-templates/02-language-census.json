{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "02-language-census",
  "display_name": "Language census (file classes and program languages)",
  "process": "02-evidence-pregather",
  "budget_default": "standard",
  "composition": {
    "persona_id": "evidence-custodian",
    "role_id": "evidence-indexer",
    "domain_id": "intake-state",
    "tooling_profile_id": "local-evidence-retrieval",
    "output_contract_id": "language-census"
  },
  "inputs": {
    "required": [
      "accepted 00-intake staged source snapshot (inputs/artifact-manifest.json target.repo_path)",
      "data/owasp-asvs/category-rules-v1.json vendored and generated exclusion globs",
      "tooling/buildenv-catalog.json language servers"
    ],
    "optional": []
  },
  "outputs": {
    "directory": "data/jobs/02-language-census/attempts/<attempt_id>",
    "files": [
      "language-census.json",
      "language-census-summary.md",
      "status.json",
      "permission.json",
      "lineage.json"
    ]
  },
  "prompt_sections": [
    "governing_rules",
    "scope",
    "validation",
    "output_contract"
  ],
  "implemented": true,
  "timeout_seconds": 1800,
  "execution": {
    "worker": "language_census.py",
    "arguments": [
      "{run_id}"
    ]
  },
  "retry": {
    "max_attempts": 1,
    "transient_reasons": [],
    "side_effect_free": true
  },
  "applicability": "every run with an accepted 00-intake; deterministic Python over the staged snapshot, no model and no container",
  "permissions": [
    "read-source",
    "write-run-data"
  ],
  "coordinator": "intake-coordinator",
  "tunables": {
    "max_rows": {
      "value": 200000,
      "unit": "count",
      "kind": "safety",
      "description": "Most per-file census rows listed; class and language counts still cover every file and the unlisted rows are a gap.",
      "scale": "Grows with snapshot file count (00-intake bounds its inventory at 100000 files)."
    }
  }
}
