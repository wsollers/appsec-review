{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "02-code-index",
  "display_name": "Structural code index (SQLite)",
  "process": "02-evidence-pregather",
  "budget_default": "standard",
  "composition": {
    "persona_id": "evidence-custodian",
    "role_id": "source-sast-curator",
    "domain_id": "repo-project-discovery",
    "tooling_profile_id": "pinned-source-sast",
    "output_contract_id": "code-index"
  },
  "inputs": {
    "required": [
      "accepted code property graph records file"
    ],
    "optional": [
      "accepted tree-sitter AST summary",
      "accepted binary triage export tables",
      "accepted IR facts",
      "accepted debug-symbol index records"
    ]
  },
  "outputs": {
    "directory": "data/jobs/02-code-index/attempts/<attempt_id>",
    "files": [
      "code-index.json",
      "code-index.sqlite",
      "code-index-summary.md",
      "status.json",
      "permission.json",
      "lineage.json"
    ]
  },
  "prompt_sections": [
    "governing_rules",
    "scope",
    "validation",
    "output_contract"
  ],
  "implemented": true,
  "timeout_seconds": 3600,
  "execution": {
    "worker": "code_index_job.py",
    "arguments": [
      "{run_id}"
    ]
  },
  "retry": {
    "max_attempts": 1,
    "transient_reasons": [],
    "side_effect_free": true
  },
  "applicability": "every run with an accepted code property graph",
  "permissions": [
    "read-run-data",
    "write-run-data"
  ],
  "coordinator": "intake-coordinator"
}
