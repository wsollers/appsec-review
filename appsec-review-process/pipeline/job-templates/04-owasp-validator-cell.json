{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "04-owasp-validator-cell",
  "display_name": "OWASP Control Validator Cell",
  "process": "04-asvs-masvs",
  "budget_default": "standard",
  "composition": {
    "persona_id": "owasp-validator",
    "role_id": "standards-control-validator",
    "domain_id": "owasp-application-controls",
    "tooling_profile_id": "owasp-control-validator",
    "output_contract_id": "owasp-control-assessment-candidate"
  },
  "inputs": {
    "required": [
      "exact T06 validator handoff",
      "exact accepted T06 publication",
      "pinned evidence named by the handoff"
    ],
    "optional": []
  },
  "outputs": {
    "directory": "run-owned persona cell output",
    "files": [
      "control-assessment-result.json"
    ]
  },
  "prompt_sections": [
    "governing_rules",
    "persona",
    "role",
    "domain",
    "tooling_profile",
    "validator_handoff",
    "evidence",
    "output_contract"
  ],
  "tunables": {
    "max_parallel": {
      "value": 4,
      "unit": "count",
      "kind": "resource",
      "description": "Validator cells T10 dispatches concurrently (ADR-0034); dagster_workflow caps it at the shared pool_persona_llm_slots.",
      "scale": "A full ASVS universe plans at most 17 cells (max_validator_calls 20); each cell is one claude -p call."
    }
  }
}
