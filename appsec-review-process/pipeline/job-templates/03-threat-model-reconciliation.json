{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "03-threat-model-reconciliation",
  "display_name": "Threat Model Evidence Reconciliation",
  "process": "03-threat-model-dfd-stride",
  "budget_default": "standard",
  "model": {"model": "deterministic-python", "effort": "none"},
  "composition": {"persona_id": "developer-engineer", "role_id": "threat-model-reconciler", "domain_id": "threat-model-reconciliation", "tooling_profile_id": "threat-model-reconciliation", "output_contract_id": "threat-model-reconciliation"},
  "inputs": {"required": ["accepted reproducible L6A model", "current accepted F03 component map and F02 evidence generation"], "optional": ["bounded reviewer/model reconciliation input control"]},
  "outputs": {"directory": "data/jobs/03-threat-model-reconciliation/attempts/<attempt_id>", "files": ["threat-model-reconciliation.json", "threat-model-reconciliation-summary.md", "permission.json", "lineage.json", "status.json"]},
  "permissions": ["read-source", "read-run-data", "write-run-data"],
  "prompt_sections": ["governing_rules", "persona", "role", "domain", "tooling_profile", "task", "output_contract"],
  "implemented": true,
  "timeout_seconds": 300,
  "execution": {"worker": "threat_model_reconciliation.py", "arguments": ["{run_id}"]},
  "retry": {"max_attempts": 1, "transient_reasons": [], "side_effect_free": true},
  "applicability": "runs with an accepted L6A model and current accepted component map",
  "coordinator": "intake-coordinator"
}
