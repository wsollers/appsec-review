{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "04-owasp-component-routing",
  "display_name": "OWASP Component Applicability Routing",
  "process": "04-asvs-masvs",
  "budget_default": "probe",
  "composition": {
    "persona_id": "owasp-validator",
    "role_id": "standards-control-validator",
    "domain_id": "owasp-application-controls",
    "tooling_profile_id": "owasp-worklist-builder",
    "output_contract_id": "owasp-applicability-request"
  },
  "inputs": {
    "required": ["newest accepted 01-component-characterization", "newest accepted 04-owasp-intel-lane-in with approved selection and exact component-map admission"],
    "optional": []
  },
  "outputs": {
    "directory": "data/jobs/04-owasp-component-routing/attempts/<attempt_id>",
    "files": ["owasp-applicability-request.json", "owasp-component-routing.json", "status.json"]
  },
  "prompt_sections": ["governing_rules", "scope", "validation", "output_contract"],
  "implemented": true,
  "execution": {"worker": "owasp_component_routing.py", "arguments": ["--run-id", "{run_id}"]},
  "permissions": ["read-run-data", "write-run-data"],
  "applicability": "accepted component characterization and approved OWASP selection",
  "timeout_seconds": 900,
  "retry": {"max_attempts": 1, "transient_reasons": [], "side_effect_free": true},
  "coordinator": "intake-coordinator"
}
