{
    "schema": "appsec-review/job-template/0.1",
    "job_template_id": "02-test-coverage-ingest",
    "display_name": "Test Coverage Ingest",
    "process": "02-evidence-pregather",
    "budget_default": "probe",
    "composition": {
        "persona_id": "test-coverage-indexer",
        "role_id": "test-evidence-producer",
        "domain_id": "qa-test-artifacts",
        "tooling_profile_id": "bounded-test-evidence",
        "output_contract_id": "test-coverage-intelligence"
    },
    "inputs": {
        "required": [
            "accepted test execution"
        ],
        "optional": []
    },
    "outputs": {
        "directory": "data/jobs/02-test-coverage-ingest/attempts/<attempt_id>",
        "files": [
            "test-coverage.json",
            "test-coverage-intelligence-summary.md",
            "status.json",
            "permission.json",
            "lineage.json"
        ]
    },
    "prompt_sections": [
        "governing_rules",
        "scope",
        "validation",
        "output_contract"
    ],
    "implemented": true,
    "timeout_seconds": 300,
    "execution": {
        "worker": "test_coverage_ingest.py",
        "arguments": [
            "{run_id}"
        ]
    },
    "retry": {
        "max_attempts": 1,
        "transient_reasons": [],
        "side_effect_free": true
    },
    "applicability": "accepted executions with supported, partial, missing or explicitly unsupported coverage",
    "permissions": [
        "read-run-data",
        "write-run-data"
    ],
    "coordinator": "intake-coordinator"
}
