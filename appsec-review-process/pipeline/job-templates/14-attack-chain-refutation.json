{
  "schema": "appsec-review/job-template/0.1",
  "process": "14-attack-chain",
  "budget_default": "standard",
  "model": {
    "model": "deterministic-python",
    "effort": "none"
  },
  "permissions": [
    "read-run-data",
    "write-run-data"
  ],
  "prompt_sections": [
    "governing_rules",
    "persona",
    "role",
    "domain",
    "tooling_profile",
    "output_contract"
  ],
  "implemented": true,
  "retry": {
    "max_attempts": 1,
    "transient_reasons": [],
    "side_effect_free": true
  },
  "coordinator": "intake-coordinator",
  "job_template_id": "14-attack-chain-refutation",
  "display_name": "Attack-chain Refutation and Ledger",
  "composition": {
    "persona_id": "attack-chain-refuter",
    "role_id": "attack-chain-coordinator",
    "domain_id": "attack-chain-lifecycle",
    "tooling_profile_id": "claim-review-static",
    "output_contract_id": "14-attack-chain-refutation"
  },
  "inputs": {
    "required": [
      "accepted 14-attack-chain-composition result and seeds"
    ],
    "optional": [
      "supporting-evidence menu"
    ]
  },
  "outputs": {
    "directory": "outputs/14-attack-chain-refutation",
    "files": [
      "attack-chain-ledger.json",
      "attack-chain-ledger.md",
      "refutation-pool-merge.json",
      "permission.json",
      "lineage.json",
      "pool-receipt.json",
      "status.json"
    ]
  },
  "applicability": "every full review after 14-attack-chain-composition; SKIPPED not-applicable-no-chain-seeds when composition skipped",
  "timeout_seconds": 7200,
  "tunables": {
    "max_parallel": {
      "value": 2,
      "unit": "count",
      "kind": "resource",
      "description": "Refuter cells dispatched concurrently (the persona_llm pool bounds it too).",
      "scale": ""
    },
    "rendezvous_timeout_seconds": {
      "value": 5400,
      "unit": "seconds",
      "kind": "resource",
      "description": "Wall-clock wait for every refuter cell.",
      "scale": ""
    }
  }
}
