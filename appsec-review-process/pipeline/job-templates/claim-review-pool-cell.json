{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "claim-review-pool-cell",
  "display_name": "Stage-scoped Claim Reviewer Cell",
  "process": "claim-review-pool",
  "budget_default": "standard",
  "model": {
    "model": "claude-sonnet-5",
    "effort": "high"
  },
  "composition": {
    "persona_id": "claim-reviewer",
    "role_id": "claim-reviewer",
    "domain_id": "claim-review-lifecycle",
    "tooling_profile_id": "claim-review-static",
    "output_contract_id": "claim-review-pool-candidates"
  },
  "inputs": {
    "required": [
      "newest accepted upstream claim artifact",
      "runtime-supplied stage and invocation identity"
    ],
    "optional": [
      "supporting-evidence menu of accepted non-finding evidence and the files it pins"
    ]
  },
  "outputs": {
    "directory": "private persona instance output",
    "files": [
      "candidates.json"
    ]
  },
  "permissions": [
    "read-run-data"
  ],
  "prompt_sections": [
    "governing_rules",
    "persona",
    "role",
    "domain",
    "tooling_profile",
    "task",
    "output_contract"
  ],
  "task_prompt": "appsec-review-process/claim-review-pool-task.md",
  "implemented": true,
  "applicability": "one persona cell per claim shard (claim_review_pool_instances, default 3) when the newest accepted stage input contains claims; zero instances otherwise",
  "timeout_seconds": 1800,
  "retry": {
    "max_attempts": 1,
    "transient_reasons": [],
    "side_effect_free": true
  },
  "coordinator": "intake-coordinator",
  "persona_variants": [
    "api-contract-abuser",
    "auth-session-specialist",
    "authenticated-low-priv-user",
    "business-logic-abuse-reviewer",
    "cloud-initial-access-operator",
    "container-source-auditor",
    "control-owner",
    "data-storage-records-reviewer",
    "defensive-skeptic",
    "dependency-reachability-skeptic",
    "evidence-only-verifier",
    "insider-developer",
    "kubernetes-workload-hardening-reviewer",
    "llm-agent-abuse-reviewer",
    "malicious-tenant",
    "mobile-platform-attacker",
    "native-exploitability-engineer",
    "observability-forensics-reviewer",
    "opportunistic-public-web-attacker",
    "privacy-abuse-reviewer",
    "product-owner",
    "protocol-rfc-lawyer",
    "release-integrity-reviewer",
    "remediation-planner",
    "residual-risk-owner",
    "reverse-engineer",
    "scoring-prioritization-reviewer",
    "standards-mapping-auditor",
    "supply-chain-attacker"
  ],
  "stage_personas": {
    "07-red-team-adversarial": [
      "opportunistic-public-web-attacker",
      "api-contract-abuser",
      "authenticated-low-priv-user",
      "malicious-tenant",
      "business-logic-abuse-reviewer",
      "privacy-abuse-reviewer",
      "cloud-initial-access-operator",
      "supply-chain-attacker",
      "insider-developer",
      "native-exploitability-engineer",
      "reverse-engineer",
      "llm-agent-abuse-reviewer",
      "mobile-platform-attacker"
    ],
    "08-blue-team-refutation": [
      "defensive-skeptic",
      "control-owner",
      "dependency-reachability-skeptic",
      "observability-forensics-reviewer",
      "release-integrity-reviewer",
      "auth-session-specialist",
      "container-source-auditor",
      "kubernetes-workload-hardening-reviewer",
      "data-storage-records-reviewer"
    ],
    "09-independent-verification": [
      "evidence-only-verifier",
      "standards-mapping-auditor",
      "protocol-rfc-lawyer",
      "claim-reviewer"
    ],
    "12-scoring-prioritization": [
      "scoring-prioritization-reviewer",
      "residual-risk-owner",
      "remediation-planner",
      "product-owner"
    ]
  },
  "knowledge_packs": {
    "opportunistic-public-web-attacker": [
      "injection"
    ],
    "api-contract-abuser": [
      "injection"
    ],
    "cloud-initial-access-operator": [
      "cloud-exposure"
    ],
    "supply-chain-attacker": [
      "supply-chain"
    ],
    "insider-developer": [
      "supply-chain"
    ]
  },
  "role_variants": [
    "red-team-adversary",
    "blue-team-refuter",
    "independent-verifier",
    "scorer"
  ],
  "stage_roles": {
    "07-red-team-adversarial": "red-team-adversary",
    "08-blue-team-refutation": "blue-team-refuter",
    "09-independent-verification": "independent-verifier",
    "12-scoring-prioritization": "scorer"
  },
  "tunables": {
    "claim_review_pool_instances": {
      "value": 3,
      "unit": "count",
      "kind": "resource",
      "description": "Reviewer instances per claim-review stage (07/08/09/12); each gets its own shard of the claims (shard only: one review per claim per stage) and its own persona.",
      "scale": "Raise for large ledgers; the shard input limit below raises it automatically when a shard would not fit."
    },
    "claim_review_pool_max_parallel": {
      "value": 3,
      "unit": "count",
      "kind": "resource",
      "description": "Reviewer instances of one stage that may call the model at once (also bounded by the Dagster persona_llm pool).",
      "scale": ""
    },
    "claim_review_shard_input_units_max": {
      "value": 200000,
      "unit": "count",
      "kind": "safety",
      "description": "Largest estimated input tokens (claim JSON bytes / 4) of one reviewer shard; more instances are planned, up to pool_instances_max, until every shard fits.",
      "scale": "Leaves room in the standard 800k-unit persona budget for the prompt, menu and evidence reads."
    }
  }
}
