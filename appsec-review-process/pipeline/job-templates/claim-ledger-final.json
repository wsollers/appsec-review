{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "claim-ledger-final",
  "display_name": "Final Claim-Decision Ledger (L01 plus lifecycle decisions)",
  "process": "10-synthesis-report",
  "budget_default": "probe",
  "model": {"model": "deterministic-python", "effort": "none"},
  "composition": {"persona_id": "developer-engineer", "role_id": "claim-ledger-custodian", "domain_id": "claim-ledger-lifecycle", "tooling_profile_id": "hash-linked-claim-ledger", "output_contract_id": "claim-ledger-final"},
  "implemented": true,
  "permissions": ["read-run-data", "write-run-data"],
  "inputs": {"required": ["accepted claim-ledger-routing L01 ledger", "accepted 07-red-team-adversarial, 08-blue-team-refutation and 09-independent-verification results reviewing its head", "accepted 12-scoring-prioritization result reviewing the same head"], "optional": []},
  "outputs": {"directory": "data/jobs/claim-ledger-final/attempts/<attempt_id>", "files": ["claim-decision-ledger.json", "claim-ledger-final-summary.md", "permission.json", "lineage.json", "status.json", "result.json"]},
  "prompt_sections": ["governing_rules", "source_lineage", "output_contract"],
  "execution": {"worker": "claim_ledger_final.py", "arguments": ["--run-id", "{run_id}"]},
  "applicability": "every run whose L01 ledger admitted claims, after 12-scoring-prioritization and before 10-synthesis-report",
  "timeout_seconds": 3600,
  "retry": {"max_attempts": 1, "transient_reasons": [], "side_effect_free": true},
  "coordinator": "intake-coordinator"
}
