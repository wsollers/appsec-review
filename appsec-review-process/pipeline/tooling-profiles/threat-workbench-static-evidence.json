{
  "schema": "appsec-review/tooling-profile/0.1",
  "tooling_profile_id": "threat-workbench-static-evidence",
  "display_name": "Static Threat Workbench Cell",
  "mode": "static-only",
  "required_inputs": [
    "cell brief",
    "base DFD",
    "accepted component map"
  ],
  "optional_inputs": [
    "supporting-evidence menu and pinned files",
    "target source at the bound snapshot",
    "wave-1 model overlays"
  ],
  "allowed_actions": [
    "read pinned inputs and look them up by exact path",
    "search the run evidence index",
    "write the cell reply"
  ],
  "disallowed_actions": [
    "execute target code",
    "access network other than the configured model invocation",
    "mutate target content",
    "invent evidence"
  ],
  "claim_limits": {
    "allowed": [
      "candidate_only"
    ],
    "forbidden": [
      "finding",
      "verified_security_finding",
      "severity",
      "runtime_state",
      "compliance_verdict",
      "remediation_status",
      "malicious_intent"
    ]
  }
}
