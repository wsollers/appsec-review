{
  "schema": "appsec-review/tooling-profile/0.1",
  "tooling_profile_id": "component-evidence-router",
  "display_name": "Static Component Evidence Router",
  "mode": "static-only",
  "required_inputs": ["target repository mounted read-only", "accepted COMPLETE intel-manifest.json", "manifest-declared assembly-relative artifacts with matching envelope and content hashes"],
  "optional_inputs": ["symbol index", "semantic index", "repository partition map", "build and scanner summaries"],
  "allowed_actions": ["search source and manifests", "inspect only manifest-declared accepted static evidence", "classify repository-relative scope", "infer component purpose, ownership and relationships with citations", "build a deterministic component tag cloud", "prepare downstream review routing", "record unknowns, negative evidence and bounded rescope triggers"],
  "disallowed_actions": ["execute target code", "modify the target", "access the network", "publish findings", "assign severity", "assert runtime state", "declare compliance"],
  "claim_limits": {
    "allowed": ["static_scope_classification", "statically_inferred_component_purpose", "evidence_backed_ownership", "component_relationship", "component_tag", "review_routing", "unknown", "coverage_gap", "rescope_trigger"],
    "forbidden": ["finding", "verified_security_finding", "severity", "runtime_state", "compliance_verdict", "remediation_status"]
  }
}
