{
    "schema": "appsec-review/output-contract/0.1",
    "contract_id": "test-result-intelligence",
    "display_name": "Normalized Test Results",
    "required_files": [
        "test-results.json",
        "test-result-intelligence-summary.md",
        "status.json",
        "permission.json",
        "lineage.json"
    ],
    "required_status_fields": [
        "process",
        "status",
        "records",
        "qualification"
    ],
    "result_schema": {
        "artifact": "test-results.json",
        "schema_file": "test-results.schema.json"
    },
    "claim_class": {
        "claim_class_id": "test_evidence",
        "allowed_assertions": [
            "test-outcome",
            "coverage-gap"
        ],
        "forbidden_promotions": [
            "finding",
            "severity",
            "runtime-state"
        ]
    },
    "validation_rules": [
        "consume only accepted hash-bound execution artifacts",
        "normalize unique deterministic pass, fail and skip outcomes",
        "unsupported or empty formats are explicit gaps",
        "passing results are evidence and not a clean claim"
    ]
}
