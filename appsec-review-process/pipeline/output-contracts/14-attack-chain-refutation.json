{
  "schema": "appsec-review/output-contract/0.1",
  "contract_id": "14-attack-chain-refutation",
  "display_name": "Attack-chain Ledger",
  "required_files": [
    "attack-chain-ledger.json",
    "attack-chain-ledger.md",
    "refutation-pool-merge.json",
    "permission.json",
    "lineage.json",
    "pool-receipt.json",
    "status.json"
  ],
  "required_status_fields": [
    "process",
    "status",
    "chains",
    "refuted",
    "gaps",
    "claim_limit"
  ],
  "result_schema": {
    "artifact": "attack-chain-ledger.json",
    "schema_file": "attack-chain-ledger.schema.json"
  },
  "claim_class": {
    "claim_class_id": "candidate_hypothesis",
    "allowed_assertions": [
      "attack-chain",
      "attack-chain-refutation",
      "coverage-gap"
    ],
    "forbidden_promotions": [
      "finding",
      "severity",
      "runtime-state"
    ]
  },
  "validation_rules": [
    "hash-linked events bound to the claim-ledger head and the 09 accepted pointer",
    "every causal_claim_ids entry resolves to a link candidate",
    "a chain is never more than supported and never stronger than its weakest link",
    "refuted chains are counted with their reason, not published"
  ]
}
