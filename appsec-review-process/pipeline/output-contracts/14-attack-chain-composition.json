{
  "schema": "appsec-review/output-contract/0.1",
  "contract_id": "14-attack-chain-composition",
  "display_name": "Composed Attack Chains (before refutation)",
  "required_files": [
    "attack-chain-composition.json",
    "attack-chain-seeds.json",
    "attack-chain-composition.md",
    "chain-pool-merge.json",
    "permission.json",
    "lineage.json",
    "pool-receipt.json",
    "status.json"
  ],
  "required_status_fields": [
    "process",
    "status",
    "chains",
    "gaps",
    "claim_limit"
  ],
  "result_schema": {
    "artifact": "attack-chain-composition.json",
    "schema_file": "attack-chain-composition.schema.json"
  },
  "claim_class": {
    "claim_class_id": "candidate_hypothesis",
    "allowed_assertions": [
      "attack-chain-candidate",
      "coverage-gap"
    ],
    "forbidden_promotions": [
      "finding",
      "severity",
      "runtime-state"
    ]
  },
  "validation_rules": [
    "every link cites a link-candidate claim of the accepted 09 result or a recorded fact",
    "edge bases, ids, link states and chain states are derived by Python",
    "failed or no-chain composer cells, cuts and synthetic edges are gaps",
    "candidate-only: no finding, severity or runtime claim"
  ]
}
