{
  "schema": "appsec-review/output-contract/0.1",
  "contract_id": "component-map",
  "display_name": "Component Purpose And Review Routing Map",
  "required_files": [
    "component-purpose-map.json",
    "component-purpose-map.md",
    "status.json"
  ],
  "required_status_fields": [
    "process",
    "status",
    "budget",
    "persona_id",
    "role_id",
    "domain_id",
    "tooling_profile_id",
    "artifacts_read",
    "classification_gaps"
  ],
  "result_schema": {
    "artifact": "component-purpose-map.json",
    "schema_file": "component-purpose-map.schema.json"
  },
  "citable_roots": [
    "target-repository",
    "upstream-artifacts"
  ],
  "claim_class": {
    "claim_class_id": "component_characterization",
    "allowed_assertions": [
      "static-scope-classification",
      "statically-inferred-component-purpose",
      "evidence-backed-ownership",
      "component-relationship",
      "component-tag",
      "review-routing",
      "unknown",
      "coverage-gap",
      "rescope-trigger"
    ],
    "forbidden_promotions": [
      "finding",
      "severity",
      "runtime-state"
    ]
  },
  "validation_rules": [
    "the orchestrator overwrites target, source_revision, source_snapshot_sha256, evidence_manifest_lineage and every citation content_hash with the pinned values before validation",
    "the orchestrator reruns the full semantic validation inside the repair loop: a rejected answer comes back with the list of errors to fix",
    "the latest failed attempt blocks reuse of an older accepted map"
  ]
}
