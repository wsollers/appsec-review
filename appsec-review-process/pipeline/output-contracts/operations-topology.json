{
  "schema": "appsec-review/output-contract/0.1",
  "contract_id": "operations-topology",
  "display_name": "Operations Topology",
  "required_files": [
    "service-inventory.json",
    "operations-topology-summary.md",
    "status.json"
  ],
  "required_status_fields": [
    "process",
    "status",
    "budget",
    "persona_id",
    "role_id",
    "domain_id",
    "tooling_profile_id",
    "artifacts_read"
  ],
  "result_schema": {
    "artifact": "service-inventory.json",
    "schema_file": "operations-topology.schema.json"
  },
  "claim_class": {
    "claim_class_id": "supplied_operations_topology",
    "allowed_assertions": [
      "declared-operations-topology",
      "statically-inferred-service-dependency",
      "coverage-gap"
    ],
    "forbidden_promotions": [
      "finding",
      "severity",
      "runtime-state"
    ]
  },
  "validation_rules": [
    "the orchestrator overwrites target, source_revision and every citation content_hash with the pinned values",
    "the orchestrator runs the acceptance checks (unique service ids, resolvable dependency targets and follow-up services, citation freshness, deferred-partition gaps) inside the repair loop: a rejected answer comes back with the errors to fix"
  ]
}
