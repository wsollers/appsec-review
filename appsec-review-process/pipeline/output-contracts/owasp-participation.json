{
  "schema": "appsec-review/output-contract/0.1",
  "contract_id": "owasp-participation",
  "display_name": "Validated ASVS Chapter Participation",
  "required_files": [
    "owasp-participation.json",
    "owasp-participation.md",
    "permission.json",
    "lineage.json",
    "pool-receipt.json",
    "status.json"
  ],
  "required_status_fields": [
    "process",
    "status",
    "planned_calls",
    "records",
    "unclassified",
    "gaps"
  ],
  "result_schema": {
    "artifact": "owasp-participation.json",
    "schema_file": "owasp-participation.schema.json"
  },
  "claim_class": {
    "claim_class_id": "candidate_only",
    "allowed_assertions": [
      "participation-classification",
      "coverage-gap"
    ],
    "forbidden_promotions": [
      "finding",
      "severity",
      "runtime-state"
    ]
  },
  "validation_rules": [
    "planned calls are computed and checked against max_participation_calls before the first model call; over budget is BLOCKED",
    "every candidate is accounted for exactly once: a validated record or an unclassified gap",
    "citations resolve to the pinned source snapshot; path escapes and symlinks are rejected records",
    "classification only: 04-owasp-universe decides every target"
  ]
}
