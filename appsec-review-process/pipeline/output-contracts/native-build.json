{
  "schema": "appsec-review/output-contract/0.1",
  "contract_id": "native-build",
  "display_name": "Native Build",
  "required_files": ["native-build.json", "b13-receipts.json", "native-build-summary.md", "status.json"],
  "required_status_fields": ["process", "status", "source_revision", "units", "permissions", "network"],
  "result_schema": {"artifact": "native-build.json", "schema_file": "native-build.schema.json"},
  "claim_class": {"claim_class_id": "build_replay", "allowed_assertions": ["native-build-succeeded", "compile-database-produced", "binary-produced"],
    "forbidden_promotions": ["finding", "severity", "runtime-state"]},
  "validation_rules": ["bind the accepted stage-13 lock and configured build", "replay only locked configure/build argv", "require non-empty fixed-clang compile database", "hash published binaries without running them", "publish configure-generated headers absent from the checkout as bounded hash-bound artifacts and count any omitted", "re-verify caller-held B13 result hash"]
}
