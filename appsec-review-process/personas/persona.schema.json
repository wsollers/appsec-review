{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona.schema.json",
  "title": "Composable Review Persona",
  "description": "One persona folder's persona.json (personas/personas/<persona_id>/). Every key is present, in this order; a field that does not apply holds an explicit empty value (best_used_in_lanes [] when the persona names no lanes, knowledge_packs [] when it lists no knowledge pack (ADR-0034; only attacker and domain-specialist personas may list any), provenance {} for a hand-authored record, else the four catalog_personas.py keys). tests/test_persona_folder_uniform.py enforces the order and the provenance shape.",
  "type": "object",
  "required": [
    "schema",
    "persona_id",
    "display_name",
    "category",
    "primary_failure_mode_caught",
    "best_used_in_lanes",
    "assumptions",
    "required_inputs",
    "outputs",
    "must_not",
    "knowledge_packs",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "appsec-review/persona/0.1"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "display_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "attacker",
        "defender",
        "verifier",
        "domain-specialist",
        "evidence-ingestion",
        "stakeholder-output",
        "synthesis",
        "standards-validator"
      ]
    },
    "primary_failure_mode_caught": {
      "type": "string"
    },
    "best_used_in_lanes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "object"
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_not": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_packs": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*\\Z"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "reviewed": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
