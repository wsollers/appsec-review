{
  "schema": "appsec-review/domain/0.1",
  "domain_id": "functional-design-docs",
  "display_name": "Functional And Design Documents",
  "surfaces": [
    "PRDs",
    "functional specs",
    "architecture docs",
    "ADRs",
    "runbooks",
    "network diagrams"
  ],
  "common_failure_modes": [
    "roles and data classes missing from threat model",
