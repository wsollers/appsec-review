{
  "schema": "appsec-review/tooling-profile/0.1",
  "tooling_profile_id": "claim-review-static",
  "display_name": "Static Accepted-claim Review",
  "mode": "evidence-only",
  "required_inputs": ["newest accepted upstream claim artifact"],
  "optional_inputs": [],
  "allowed_actions": ["read the pinned upstream artifact", "emit closed candidate decisions"],
  "disallowed_actions": ["execute target content", "network access other than the configured model invocation", "mutate target content", "invent evidence"],
  "claim_limits": {"allowed": ["candidate_only", "refutation", "verification_observation"], "forbidden": ["finding", "severity", "runtime_state", "compliance_verdict"]}
}
