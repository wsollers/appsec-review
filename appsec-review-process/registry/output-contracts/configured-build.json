{
  "schema": "appsec-review/output-contract/0.1",
  "contract_id": "configured-build",
  "display_name": "Configured Build",
  "required_files": ["configured-build.json", "b13-receipts.json", "configured-build-summary.md", "status.json"],
  "required_status_fields": ["process", "status", "source_revision", "units", "permissions", "network"],
  "result_schema": {"artifact": "configured-build.json", "schema_file": "configured-build.schema.json"},
  "claim_class": {"claim_class_id": "build_replay", "allowed_assertions": ["configure-succeeded"],
    "forbidden_promotions": ["finding", "severity", "runtime-state"]},
  "validation_rules": ["bind the accepted stage-13 lock", "replay only locked configure argv", "B13 network none and read-only target", "re-verify caller-held B13 result hash"]
}
