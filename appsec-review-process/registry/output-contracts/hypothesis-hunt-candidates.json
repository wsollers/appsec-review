{
  "schema": "appsec-review/output-contract/0.1",
  "contract_id": "hypothesis-hunt-candidates",
  "display_name": "Hunter Candidate Hypotheses (one pool instance)",
  "required_files": [
    "candidates.json"
  ],
  "required_status_fields": [],
  "result_schema": {
    "artifact": "candidates.json",
    "schema_file": "hypothesis-hunt-candidates.schema.json"
  },
  "claim_class": {
    "claim_class_id": "candidate_only",
    "allowed_assertions": [
      "candidate-hypothesis"
    ],
    "forbidden_promotions": [
      "finding",
      "severity",
      "runtime-state"
    ]
  },
  "validation_rules": [
    "the persona reply validates hypothesis-hunt-persona.schema.json",
    "ids, hashes and hunter identity are derived, never model-written",
    "locations resolve against pinned bytes or are recorded as dropped"
  ]
}
