{
    "schema": "appsec-review/output-contract/0.1",
    "contract_id": "ir-link",
    "display_name": "Deterministic Linked LLVM Module",
    "required_files": [
        "ir-link.json",
        "b13-receipts.json",
        "permission.json",
        "lineage.json"
    ],
    "required_status_fields": [
        "process",
        "status",
        "modules",
        "coverage_gaps",
        "qualification"
    ],
    "result_schema": {
        "artifact": "ir-link.json",
        "schema_file": "ir-link.schema.json"
    },
    "claim_class": {
        "claim_class_id": "ir_static_evidence",
        "allowed_assertions": [
            "linked-module",
            "coverage-gap"
        ],
        "forbidden_promotions": [
            "finding",
            "severity",
            "runtime-state"
        ]
    },
    "validation_rules": [
        "consume only accepted hash-bound capture modules",
        "reject zero, missing or malformed modules",
        "bind ordered input module set and exact variant",
        "preserve capture coverage gaps"
    ]
}
