{
    "schema": "appsec-review/output-contract/0.1",
    "contract_id": "ir-facts",
    "display_name": "LLVM Pointer And Memory Facts",
    "required_files": [
        "ir-facts.json",
        "b13-receipts.json",
        "permission.json",
        "lineage.json"
    ],
    "required_status_fields": [
        "process",
        "status",
        "facts",
        "coverage_gaps",
        "qualification"
    ],
    "result_schema": {
        "artifact": "ir-facts.json",
        "schema_file": "ir-facts.schema.json"
    },
    "claim_class": {
        "claim_class_id": "ir_static_evidence",
        "allowed_assertions": [
            "debug-location",
            "pointer-memory-fact",
            "coverage-gap"
        ],
        "forbidden_promotions": [
            "finding",
            "severity",
            "runtime-state"
        ]
    },
    "validation_rules": [
        "consume only the accepted hash-bound linked module",
        "emit deterministic pointer arithmetic and memory-operation records",
        "join debug locations and facts to exact source path, hash, function and captured module identity or emit an ambiguity gap",
        "facts are evidence and never vulnerability verdicts"
    ]
}
