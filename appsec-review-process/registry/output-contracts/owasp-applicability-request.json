{
  "schema": "appsec-review/output-contract/0.1",
  "contract_id": "owasp-applicability-request",
  "display_name": "OWASP Component Applicability Request Assembly",
  "required_files": ["owasp-applicability-request.json", "owasp-component-routing.json", "status.json"],
  "required_status_fields": ["process", "status", "components", "selected_controls", "expected_targets"],
  "result_schema": {"artifact": "owasp-applicability-request.json", "schema_file": "owasp-applicability-request.schema.json"},
  "claim_class": {
    "claim_class_id": "control_routing",
    "allowed_assertions": ["component-classification", "applicability", "coverage-gap", "rescope-trigger"],
    "forbidden_promotions": ["finding", "severity", "runtime-state"]
  },
  "validation_rules": [
    "newest accepted component map and T03 input manifest are hash and pointer bound",
    "every functional component is projected exactly once",
    "selected-control by component target count is explicit",
    "unknown or unmatched classification remains cannot_determine",
    "technical not_applicable is never inferred"
  ]
}
