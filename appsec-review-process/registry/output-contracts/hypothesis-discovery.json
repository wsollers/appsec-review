{
  "schema": "appsec-review/output-contract/0.1",
  "contract_id": "hypothesis-discovery",
  "display_name": "Code-reading Vulnerability Hypotheses",
  "required_files": [
    "hypothesis-discovery.json",
    "hypothesis-discovery.md",
    "hunt-pool-merge.json",
    "permission.json",
    "lineage.json",
    "pool-receipt.json",
    "status.json"
  ],
  "required_status_fields": [
    "process",
    "status",
    "hypotheses",
    "gaps",
    "claim_limit"
  ],
  "result_schema": {
    "artifact": "hypothesis-discovery.json",
    "schema_file": "hypothesis-discovery.schema.json"
  },
  "claim_class": {
    "claim_class_id": "candidate_hypothesis",
    "allowed_assertions": [
      "candidate-hypothesis",
      "coverage-gap"
    ],
    "forbidden_promotions": [
      "finding",
      "severity",
      "runtime-state"
    ]
  },
  "validation_rules": [
    "every hypothesis resolves to a checkout file and line range with its sha256",
    "unresolvable hypotheses are gaps, never repaired",
    "deduplicated across hunters; tool-lead overlap recorded",
    "candidate-only: no finding, severity or runtime claim"
  ]
}
