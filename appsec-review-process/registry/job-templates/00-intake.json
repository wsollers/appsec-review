{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "00-intake",
  "display_name": "00-intake",
  "process": "00-intake-recovery",
  "budget_default": "probe",
  "composition": {
    "persona_id": "intake-coordinator",
    "role_id": "intake-coordinator",
    "domain_id": "intake-state",
    "tooling_profile_id": "read-only-intake",
    "output_contract_id": "intake"
  },
  "inputs": {
    "required": [
      "target path",
      "source identity",
      "scope",
      "permissions"
    ],
    "optional": [
      "hashed imports"
    ]
  },
  "outputs": {
    "directory": "data/jobs/00-intake/whole/attempts/<attempt_id>",
    "files": [
      "outputs/intake.json",
      "outputs/build-discovery.md",
      "status.json"
    ]
  },
  "prompt_sections": [
    "governing_rules",
    "scope",
    "validation",
    "output_contract"
  ],
  "implemented": true,
  "timeout_seconds": 120,
  "execution": {
    "worker": "intake.py",
    "arguments": ["{attempt_root}"]
  },
  "retry": {
    "max_attempts": 1,
    "transient_reasons": [],
    "side_effect_free": true
  },
  "applicability": "all engagements",
  "permissions": [
    "read-source"
  ],
  "coordinator": "intake-coordinator",
  "tunables": {
    "source_fingerprint_max_bytes": {
      "value": 4294967296,
      "unit": "bytes",
      "kind": "safety",
      "description": "Largest total checkout intake will fingerprint; more stops intake.",
      "scale": "Grows with target size; see docs/scale-audit-unreal-engine.md A: an engine checkout with dependencies is ~50 GB; scope out binary content."
    }
  }
}
