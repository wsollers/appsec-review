{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "02-binary-intelligence-ingest",
  "display_name": "Binary Intelligence Ingest",
  "process": "02-evidence-pregather",
  "budget_default": "standard",
  "implemented": true,
  "timeout_seconds": 1800,
  "execution": {"worker":"binary_intelligence_ingest.py","arguments":["{run_id}"]},
  "retry": {"max_attempts":1,"transient_reasons":[],"side_effect_free":true},
  "applicability": "accepted binary-triage and binary-cfg publications; SKIPPED only when the accepted build contains zero binaries",
  "permissions": ["read-run-data", "write-run-data"],
  "composition": {
    "persona_id": "reverse-engineer",
    "role_id": "binary-intelligence-extractor",
    "domain_id": "binary-artifact-analysis",
    "tooling_profile_id": "binary-intel-static-analysis",
    "output_contract_id": "binary-intelligence"
  },
  "inputs": {
    "required": [
      "accepted native-build binary lineage",
      "accepted binary-triage result",
      "accepted binary-cfg result"
    ],
    "optional": [
      "source component map",
      "deterministically derived normalized binary leads"
    ]
  },
  "outputs": {
    "directory": "runs/<run_id>/data/jobs/02-binary-intelligence-ingest",
    "files": [
      "binary-intelligence.json",
      "status.json",
      "permission.json",
      "lineage.json",
      "applicability-receipt.json"
    ]
  },
  "prompt_sections": [
    "governing_rules",
    "persona",
    "role",
    "domain",
    "tooling_profile",
    "buildenv_catalog",
    "task",
    "output_contract"
  ],
  "coordinator": "intake-coordinator"
}
