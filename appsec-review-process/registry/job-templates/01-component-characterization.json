{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "01-component-characterization",
  "display_name": "Component Purpose And Review Routing",
  "process": "01-component-characterization",
  "budget_default": "standard",
  "model": {"model": "claude-sonnet-5", "effort": "medium", "_note": "Component inference and evidence-backed routing require semantic judgment; all output remains static evidence, not findings."},
  "composition": {
    "persona_id": "developer-engineer",
