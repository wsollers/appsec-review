{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "02-evidence-assembly",
  "display_name": "Evidence Assembly",
  "process": "02-evidence-pregather",
  "budget_default": "probe",
  "composition": {
    "persona_id": "evidence-custodian",
    "role_id": "evidence-assembler",
    "domain_id": "evidence-assembly",
    "tooling_profile_id": "hash-bound-evidence-assembly",
    "output_contract_id": "pregather"
  },
  "inputs": {"required": ["assembly-supply.json", "terminal-instances.json", "all graph-required producer accepted pointers and envelopes"], "optional": []},
  "outputs": {"directory": "data/jobs/02-evidence-assembly/attempts/<attempt_id>", "files": ["intel-manifest.json", "status.json", "evidence/<producer>/<attempt>/<artifact>"]},
  "prompt_sections": ["governing_rules", "scope", "validation", "output_contract"],
  "implemented": false,
  "timeout_seconds": 300,
  "retry": {"max_attempts": 1, "transient_reasons": [], "side_effect_free": true},
  "applicability": "all engagements after every required evidence producer is terminal",
  "permissions": ["read-run-data", "write-run-data"],
  "coordinator": "intake-coordinator"
}
