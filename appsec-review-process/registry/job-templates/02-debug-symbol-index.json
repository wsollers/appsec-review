{
    "schema": "appsec-review/job-template/0.1",
    "job_template_id": "02-debug-symbol-index",
    "display_name": "Debug Symbol Index",
    "process": "02-evidence-pregather",
    "budget_default": "standard",
    "implemented": true,
    "timeout_seconds": 3600,
    "execution": {"worker":"debug_symbol_index.py","arguments":["{run_id}"]},
    "retry": {"max_attempts":1,"transient_reasons":[],"side_effect_free":true},
    "applicability": "accepted native-build publications; SKIPPED only when the accepted build contains zero binaries",
    "permissions": ["read-run-data", "write-run-data"],
    "composition": {
        "persona_id": "reverse-engineer",
        "role_id": "binary-intelligence-extractor",
        "domain_id": "binary-artifact-analysis",
        "tooling_profile_id": "binary-intel-static-analysis",
        "output_contract_id": "debug-symbol-index"
    },
    "inputs": {
        "required": [
            "accepted native-build binary lineage",
            "registered audit-binary-analysis image"
        ],
        "optional": []
    },
    "outputs": {
        "directory": "runs/<run_id>/data/jobs/02-debug-symbol-index",
        "files": [
            "debug-symbol-index.json",
            "status.json",
            "permission.json",
            "lineage.json",
            "binary-static-raw.json",
            "binary-b13-receipts.json"
        ]
    },
    "prompt_sections": [
        "governing_rules",
        "persona",
        "role",
        "domain",
        "tooling_profile",
        "task",
        "output_contract"
    ],
    "coordinator": "intake-coordinator"
}
