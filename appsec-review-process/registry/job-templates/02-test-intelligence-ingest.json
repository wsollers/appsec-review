{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "02-test-intelligence-ingest",
  "display_name": "Test Intelligence Ingestion",
  "process": "02-evidence-pregather",
  "budget_default": "standard",
  "composition": {
    "persona_id": "test-coverage-indexer",
    "role_id": "test-intelligence-extractor",
    "domain_id": "qa-test-artifacts",
    "tooling_profile_id": "static-test-doc-parser",
    "output_contract_id": "intelligence-extract"
  },
  "inputs": {
    "required": [
      "tests path",
      "test type or auto"
    ],
    "optional": [
      "coverage report",
      "component map",
      "route inventory",
      "CI test metadata"
    ]
  },
  "outputs": {
    "directory": "scratch/<project>-engagement/qa-intel",
    "files": [
      "summary.md",
      "facts.json",
      "search-records.jsonl",
      "status.json",
      "test-inventory.json",
      "test-intelligence-summary.md",
      "security-test-coverage.json",
      "test-to-component-map.json",
      "test-to-route-map.json",
      "test-to-control-map.json",
      "untested-security-surfaces.json",
      "unit-test-facts.json",
      "integration-test-flows.json",
      "acceptance-flow-inventory.json",
      "smoke-release-gates.json",
      "load-abuse-capacity-notes.json"
    ]
  },
  "prompt_sections": [
    "governing_rules",
    "persona",
    "role",
    "domain",
    "tooling_profile",
    "source_lineage",
    "redaction",
    "task",
    "output_contract"
  ]
}
