{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "02-full-review-input-assembly",
  "display_name": "Full Review Input Assembly",
  "process": "02-full-review-input-assembly",
  "budget_default": "probe",
  "composition": {
    "persona_id": "intake-coordinator",
    "role_id": "evidence-assembler",
    "domain_id": "evidence-assembly",
    "tooling_profile_id": "local-evidence-retrieval",
    "output_contract_id": "full-review-input-assembly"
  },
  "inputs": {"required": ["run artifact manifest", "current accepted producer pointers", "closed launch plan"], "optional": []},
  "outputs": {"directory": "data/jobs/02-full-review-input-assembly/attempts/<attempt_id>", "files": ["full-review-input-assembly.json", "requests/*.json", "status.json"]},
  "prompt_sections": ["governing_rules", "source_lineage", "task", "output_contract"],
  "implemented": true,
  "execution": {"worker": "full_review_input_assembly.py", "arguments": ["--plan", "{plan}", "--run-root", "{run_root}", "--output-root", "{output_root}", "--attempt-id", "{attempt_id}", "--started-at", "{started_at}", "--finished-at", "{finished_at}"]},
  "permissions": ["read-run-data", "write-run-data"],
  "applicability": "full review runs launching standalone analysis families",
  "timeout_seconds": 120,
  "retry": {"max_attempts": 1, "transient_reasons": [], "side_effect_free": true},
  "coordinator": "intake-coordinator"
}
