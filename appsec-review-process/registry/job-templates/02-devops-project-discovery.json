{
  "schema": "appsec-review/job-template/0.1",
  "job_template_id": "02-devops-project-discovery",
  "display_name": "DevOps Project And Pipeline Discovery",
  "process": "02-evidence-pregather",
  "budget_default": "standard",
  "model": {
    "model": "claude-sonnet-5",
    "effort": "medium",
    "_note": "Pinned explicitly 2026-09-25 (D03 construction, mirrors 02-dev-project-discovery's own pin), not left to model-config.json's process-wide default. Deciding which pipeline, container, IaC and deployment units a repository declares, and which safe commands would inspect them, is a reasoning-heavy judgment call over an unknown target, not classification."
  },
  "composition": {
    "persona_id": "devops-engineer",
    "role_id": "repo-project-discoverer",
    "domain_id": "repo-project-discovery",
    "tooling_profile_id": "static-repo-project-inspector",
    "output_contract_id": "project-discovery"
  },
  "inputs": {
    "required": [
      "target repository path",
      "CI/CD and deployment artifact inventory"
    ],
    "optional": [
      "Dockerfiles",
      "IaC",
      "environment templates",
      "build logs",
      "project-intel/repository-partitions/repository-partition-map.json; consume partitions routed to this persona, including supporting review assignments"
    ]
  },
  "outputs": {
    "directory": "scratch/<project>-engagement/project-intel",
    "files": [
      "project-inventory.json",
      "project-discovery-summary.md",
      "status.json"
    ]
  },
  "prompt_sections": [
    "governing_rules",
    "persona",
    "role",
    "domain",
    "tooling_profile",
    "buildenv_catalog",
    "task",
    "output_contract"
  ],
  "task_prompt": "appsec-review-process/02-evidence-pregather/devops-project-discovery.md"
}
