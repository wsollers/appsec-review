    "outputs": {
        "directory": "runs/<run_id>/data/jobs/02-binary-triage",
        "files": [
            "binary-triage-manifest.json",
            "status.json",
            "permission.json",
            "lineage.json"
        ]
    },
    "prompt_sections": [
        "governing_rules",
        "persona",
        "role",
        "domain",
        "tooling_profile",
        "task",
        "output_contract"
