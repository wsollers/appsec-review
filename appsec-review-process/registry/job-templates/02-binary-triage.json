{
    "schema": "appsec-review/job-template/0.1",
    "job_template_id": "02-binary-triage",
    "display_name": "Static Binary Triage",
    "process": "02-evidence-pregather",
    "budget_default": "standard",
    "implemented": false,
    "permissions": ["read-run-data", "write-run-data"],
    "composition": {
        "persona_id": "reverse-engineer",
        "role_id": "binary-intelligence-extractor",
        "domain_id": "binary-artifact-analysis",
