# evidence and run outputs never enter the repo
/evidence/
/scratch/
# Mutable NVD feed state is published locally and never committed. The feed
# contract and operator README remain tracked under data/feeds/nvd/.
/data/feeds/nvd/blobs/
/data/feeds/nvd/downloads/
/data/feeds/nvd/staging/
/data/feeds/nvd/snapshots/
/data/feeds/nvd/locks/
/data/feeds/nvd/current.json
/data/feeds/nvd/state.json
/data/feeds/nvd/events.jsonl
# Base-image cache (P41; base_image_cache.py fetch on the host): content-addressed blobs + pointer.
/data/feeds/base-images/
# cve-bin-tool's database, derived from the NVD snapshot (cve_bin_tool_db.py; ~530 MB for the full NVD).
/data/feeds/cve-bin-tool/
# Preseeded embedding models (semantic_recall_index.py fetch-model; pins under data/embedding-models/).
/data/feeds/embedding-models/
# Pre-run Ghidra decompilation publications of third-party binaries (appsec-review binary-decompile).
/data/binary-decompilation/
# Target acquisition manifests, review exports, and change diffs (appsec-review acquire-target).
/data/target-acquisitions/
# Tool-output cache and per-item memo (brief N): pointers into run trees, never committed.
/data/caches/
*.jsonl
!schemas/**/*.jsonl
# licensed inputs (MSVC headers/libs) are mounted, never committed
/msvc/
/xwin-cache/
# python
__pycache__/
*.pyc
.venv/
*.egg-info/
# Pytest owns this disposable tree. Focused or concurrent sessions use named
# descendants; tests/conftest.py rejects scratch paths anywhere else.
/test/tmp/
# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
# CodeQL bundle: downloaded on the host, COPY'd into audit-codeql
images/audit-codeql/codeql-bundle-linux64.tar.zst
images/audit-buildenv-java/jdtls.tar.gz
# per-target scratch outputs (databases, bitcode, logs) — never committed
/scratch*/
/fixtures/targets/

# image build inputs fetched by images/image_build.py
/images/scancode-toolkit/src/
/images/.build-state/
/images/tool-*/downloads/
# B16 host-local records are regenerated from image build state at code-location start.
/appsec-review-process/pipeline/container-images/*.json
!/appsec-review-process/pipeline/container-images/fixture-harmless.json
# Stage-13 rendered images are host-local immutable state, never source artifacts.
/appsec-review-process/data/build-images/
# Offline Grype/OSV snapshot registry: host-local immutable data, synced by
# dependency_snapshot_sync.py and never committed.
/appsec-review-process/offline/

# Agent worktrees are disposable checkouts of branches, never repository source.
/.claude/worktrees/
# Local Claude handoffs, diffs, and generated diagrams are not repository source.
/Claude outputs/
# Mutable OSV feed state (see docs/osv-feed.md); never committed.
/data/feeds/osv/
# Mutable Grype feed state; immutable manifests and blobs are run inputs, not source.
/data/feeds/grype/
# Mutable MITRE ATT&CK/CAPEC feed state (see docs/mitre-feed.md); never committed.
/data/feeds/mitre/
# Mutable KEV and EPSS snapshots are local reference data, never repository source.
/data/feeds/kev/
/data/feeds/epss/
# Mutable OpenSSF Scorecard cache (blobs, entries, locks); never committed.
/data/feeds/openssf-scorecard/

# Host-local seeds and keys (dependency DB seeds, demo HMAC key): never source.
.artifacts/

# Local archive of the pre-refactor repository. Git history and the
# pre-simplification tag are the durable recovery points.
/old/

# Dagster's generated local secret; the tracked example documents its shape.
/deploy/dagster/.env
# Module envelope signed on the host by lifecycle.py build and copied into the image; per build.
/deploy/dagster/signing/python-modules.json# Stepwise acceptance seed bytes (content-addressed blobs); the manifests are committed under
# test/acceptance/<tag>/seeds/.
/data/acceptance-seeds/
