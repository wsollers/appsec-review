{
  "schema": "appsec-review/tool-image/1",
  "image_id": "tool-phpcs",
  "tool": "phpcs",
  "version": "4.0.4",
  "purpose": "PHP coding-standard and security sniffs (PHP_CodeSniffer).",
  "feeds": [
    "02-source-sast"
  ],
  "executable": "/opt/tool/bin/phpcs",
  "version_argv": [
    "/opt/tool/bin/phpcs",
    "--version"
  ],
  "version_expect": "{version}",
  "assets": [
    {
      "name": "phpcs",
      "url": "https://github.com/PHPCSStandards/PHP_CodeSniffer/releases/download/{version}/phpcs.phar",
      "dest": "downloads/phpcs.phar",
      "verify": {
        "kind": "pgp",
        "signature_url": "https://github.com/PHPCSStandards/PHP_CodeSniffer/releases/download/{version}/phpcs.phar.asc",
        "fingerprint": "5CB4F778BF9BC4FB67AE511D96E91A992CF22FF4"
      }
    }
  ],
  "smoke": [
    {
      "name": "php-fixture",
      "argv": [
        "/opt/tool/bin/phpcs",
        "--report=json",
        "--report-file=/scratch/phpcs.json",
        "/workspace"
      ],
      "exit_codes": [
        0,
        1,
        2
      ],
      "workspace": "images/test/php",
      "expect_files": [
        "phpcs.json"
      ]
    }
  ]
}
