{
  "schema": "appsec-review/tool-image/1",
  "image_id": "tool-hadolint",
  "tool": "hadolint",
  "version": "2.15.1",
  "purpose": "Dockerfile lint (hadolint).",
  "feeds": [
    "02-container-image-inventory"
  ],
  "executable": "/opt/tool/bin/hadolint",
  "version_argv": [
    "/opt/tool/bin/hadolint",
    "--version"
  ],
  "version_expect": "{version}",
  "assets": [
    {
      "name": "hadolint",
      "url": "https://github.com/hadolint/hadolint/releases/download/v{version}/hadolint-linux-x86_64",
      "dest": "downloads/hadolint",
      "verify": {
        "kind": "vendor-checksums",
        "checksums_url": "https://github.com/hadolint/hadolint/releases/download/v{version}/checksums.sha256",
        "entry": "hadolint-linux-x86_64"
      }
    }
  ],
  "smoke": [
    {
      "name": "lint-dockerfile",
      "argv": [
        "/opt/tool/bin/hadolint",
        "--no-fail",
        "--format",
        "json",
        "/workspace/Dockerfile"
      ],
      "exit_codes": [
        0
      ],
      "workspace": "target",
      "stdout_contains": "DL3008"
    }
  ]
}
