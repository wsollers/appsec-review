{
  "schema": "appsec-review/tool-image/1",
  "image_id": "tool-gitleaks",
  "tool": "gitleaks",
  "version": "8.30.1",
  "purpose": "secret scanning over the source tree (gitleaks).",
  "feeds": [
    "02-secrets-inventory"
  ],
  "executable": "/opt/tool/bin/gitleaks",
  "version_argv": [
    "/opt/tool/bin/gitleaks",
    "version"
  ],
  "version_expect": "{version}",
  "assets": [
    {
      "name": "gitleaks",
      "url": "https://github.com/gitleaks/gitleaks/releases/download/v{version}/gitleaks_{version}_linux_x64.tar.gz",
      "dest": "downloads/gitleaks.tar.gz",
      "verify": {
        "kind": "vendor-checksums",
        "checksums_url": "https://github.com/gitleaks/gitleaks/releases/download/v{version}/gitleaks_{version}_checksums.txt",
        "entry": "gitleaks_{version}_linux_x64.tar.gz"
      }
    }
  ],
  "smoke": [
    {
      "name": "dir-scan",
      "argv": [
        "/opt/tool/bin/gitleaks",
        "dir",
        "/workspace",
        "--redact",
        "--no-banner",
        "--report-format",
        "json",
        "--report-path",
        "/scratch/gitleaks.json",
        "--exit-code",
        "0"
      ],
      "exit_codes": [
        0
      ],
      "workspace": "target",
      "expect_files": [
        "gitleaks.json"
      ],
      "file_contains": {
        "gitleaks.json": "["
      }
    }
  ]
}
