{
  "schema": "appsec-review/tool-image/1",
  "image_id": "tool-sbomasm",
  "tool": "sbomasm",
  "version": "2.1.1",
  "purpose": "Offline semantic assembly, editing, augmentation and removal for SPDX and CycloneDX SBOMs (sbomasm).",
  "feeds": [
    "02-sbom-inventory"
  ],
  "executable": "/opt/tool/bin/sbomasm",
  "version_argv": [
    "/opt/tool/bin/sbomasm",
    "version"
  ],
  "version_expect": "{version}",
  "assets": [
    {
      "name": "sbomasm",
      "url": "https://github.com/interlynk-io/sbomasm/releases/download/v{version}/sbomasm_{version}_Linux_x86_64.tar.gz",
      "dest": "downloads/sbomasm.tar.gz",
      "verify": {
        "kind": "vendor-checksums",
        "checksums_url": "https://github.com/interlynk-io/sbomasm/releases/download/v{version}/checksums.txt",
        "entry": "sbomasm_{version}_Linux_x86_64.tar.gz"
      }
    }
  ],
  "smoke": [
    {
      "name": "version",
      "argv": [
        "/opt/tool/bin/sbomasm",
        "version"
      ],
      "exit_codes": [
        0
      ],
      "workspace": "none",
      "stdout_contains": "2.1.1"
    },
    {
      "name": "edit-spdx-document",
      "argv": [
        "/opt/tool/bin/sbomasm",
        "edit",
        "--subject",
        "document",
        "--supplier",
        "Example Corp (security@example.invalid)",
        "--output",
        "/scratch/edited.spdx.json",
        "/config/sample.spdx.json"
      ],
      "exit_codes": [
        0
      ],
      "workspace": "none",
      "config": "smoke-config",
      "expect_files": [
        "edited.spdx.json"
      ],
      "file_contains": {
        "edited.spdx.json": "Example Corp (security@example.invalid)"
      }
    },
    {
      "name": "assemble-cyclonedx",
      "argv": [
        "/opt/tool/bin/sbomasm",
        "assemble",
        "--flatMerge",
        "--name",
        "assembled-smoke",
        "--version",
        "1.0.0",
        "--type",
        "application",
        "--output",
        "/scratch/assembled.cdx.json",
        "/config/base.cdx.json",
        "/config/extension.cdx.json"
      ],
      "exit_codes": [
        0
      ],
      "workspace": "none",
      "config": "smoke-config",
      "expect_files": [
        "assembled.cdx.json"
      ],
      "file_contains": {
        "assembled.cdx.json": "assembled-smoke"
      }
    }
  ],
  "notes": "The B13 profile permits offline assemble, edit and rm operations only. ClearlyDefined enrichment, Dependency-Track integration, and SecureSBOM signing/verification require network access and are outside this image's registered execution profile. A v2.1.1 probe found that component rm deletes the component but leaves a dangling dependsOn reference; component removal must not be accepted without a referential-integrity validator. New-root assembly also emits a current timestamp and random serial number. A transformation worker/output contract is separate full-protocol work."
}
