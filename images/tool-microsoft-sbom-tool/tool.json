{
  "schema": "appsec-review/tool-image/1",
  "image_id": "tool-microsoft-sbom-tool",
  "tool": "microsoft-sbom-tool",
  "version": "4.1.5",
  "purpose": "SPDX 2.2/3.0 SBOM generation and validation, SPDX 2.2 redaction, and config-driven SBOM aggregation (Microsoft SBOM Tool).",
  "feeds": [
    "02-sbom-inventory"
  ],
  "executable": "/opt/tool/bin/sbom-tool",
  "version_argv": [
    "/opt/tool/bin/sbom-tool",
    "--version"
  ],
  "version_expect": "{version}",
  "assets": [
    {
      "name": "sbom-tool",
      "url": "https://github.com/microsoft/sbom-tool/releases/download/v{version}/sbom-tool-linux-x64",
      "dest": "downloads/sbom-tool",
      "verify": {
        "kind": "vendor-spdx",
        "manifest_url": "https://github.com/microsoft/sbom-tool/releases/download/v{version}/linux-x64-manifest.spdx.json",
        "entry": "./GitHub/sbom-tool-linux-x64"
      }
    }
  ],
  "smoke": [
    {
      "name": "version",
      "argv": [
        "/opt/tool/bin/sbom-tool",
        "--version"
      ],
      "exit_codes": [
        0
      ],
      "workspace": "none",
      "stdout_contains": "4.1.5"
    },
    {
      "name": "redact-spdx-2.2",
      "argv": [
        "/opt/tool/bin/sbom-tool",
        "redact",
        "-sp",
        "/config/sample.spdx.json",
        "-o",
        "/scratch"
      ],
      "exit_codes": [
        0
      ],
      "workspace": "none",
      "config": "smoke-config",
      "expect_files": [
        "sample.spdx.json"
      ]
    }
  ],
  "notes": "This is microsoft/sbom-tool, not the unrelated sbom-tool/sbom-tools project. Network-dependent license enrichment and Docker-daemon scanning are outside the offline B13 execution profile. The image is registered now; a transformation worker/output contract is separate full-protocol work."
}
