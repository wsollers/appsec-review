{
  "schema": "appsec-review/tool-image/1",
  "image_id": "tool-zizmor",
  "tool": "zizmor",
  "version": "1.30.1",
  "purpose": "GitHub Actions workflow and action security analysis (zizmor), offline audits only.",
  "feeds": [
    "02-iac-config-scan"
  ],
  "executable": "/opt/tool/bin/zizmor",
  "version_argv": [
    "/opt/tool/bin/zizmor",
    "--version"
  ],
  "version_expect": "{version}",
  "pip_lock": "requirements.txt",
  "pip_package": "zizmor",
  "assets": [],
  "smoke": [
    {
      "name": "workflow-scan",
      "argv": [
        "/opt/tool/bin/zizmor",
        "--offline",
        "--no-exit-codes",
        "--format",
        "sarif",
        "/workspace"
      ],
      "exit_codes": [
        0
      ],
      "workspace": "target",
      "stdout_contains": "\"version\""
    }
  ]
}
