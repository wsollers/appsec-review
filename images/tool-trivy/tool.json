{
  "schema": "appsec-review/tool-image/1",
  "image_id": "tool-trivy",
  "tool": "trivy",
  "version": "0.74.0",
  "purpose": "IaC and Dockerfile misconfiguration scanning with the checks embedded in the binary (trivy config).",
  "feeds": [
    "02-iac-config-scan"
  ],
  "executable": "/opt/tool/bin/trivy",
  "version_argv": [
    "/opt/tool/bin/trivy",
    "--version"
  ],
  "version_expect": "{version}",
  "assets": [
    {
      "name": "trivy",
      "url": "https://github.com/aquasecurity/trivy/releases/download/v{version}/trivy_{version}_Linux-64bit.tar.gz",
      "dest": "downloads/trivy.tar.gz",
      "verify": {
        "kind": "sigstore-checksums",
        "checksums_url": "https://github.com/aquasecurity/trivy/releases/download/v{version}/trivy_{version}_checksums.txt",
        "entry": "trivy_{version}_Linux-64bit.tar.gz",
        "bundle_url": "https://github.com/aquasecurity/trivy/releases/download/v{version}/trivy_{version}_checksums.txt.sigstore.json",
        "certificate_identity_regexp": "^https://github\\.com/aquasecurity/trivy/",
        "certificate_oidc_issuer": "https://token.actions.githubusercontent.com"
      }
    }
  ],
  "smoke": [
    {
      "name": "config-scan",
      "argv": [
        "/opt/tool/bin/trivy",
        "config",
        "--skip-check-update",
        "--cache-dir",
        "/tmp/trivy",
        "--format",
        "json",
        "--output",
        "/scratch/trivy-config.json",
        "/workspace"
      ],
      "exit_codes": [
        0
      ],
      "workspace": "target",
      "expect_files": [
        "trivy-config.json"
      ],
      "file_contains": {
        "trivy-config.json": "Misconfigurations"
      }
    }
  ],
  "notes": "Trivy releases v0.69.4 (all) and v0.69.5/v0.69.6 (Docker Hub) were malicious (GHSA-69fq-xp46-6x23, 2026-03-19). Never pin those. The sigstore check proves the release workflow signed the checksums; it does not by itself prove a release is clean, which is why the version is a deliberate pin."
}
