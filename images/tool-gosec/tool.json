{
  "schema": "appsec-review/tool-image/1",
  "image_id": "tool-gosec",
  "tool": "gosec",
  "version": "2.29.0",
  "purpose": "Go source SAST (gosec).",
  "feeds": [
    "02-source-sast"
  ],
  "executable": "/opt/tool/bin/gosec",
  "version_argv": [
    "/opt/tool/bin/gosec",
    "-version"
  ],
  "version_expect": "{version}",
  "bundles": [
    "go 1.27.1 toolchain (gosec loads packages with the go command)"
  ],
  "assets": [
    {
      "name": "gosec",
      "url": "https://github.com/securego/gosec/releases/download/v{version}/gosec_{version}_linux_amd64.tar.gz",
      "dest": "downloads/gosec.tar.gz",
      "verify": {
        "kind": "sigstore-key-checksums",
        "checksums_url": "https://github.com/securego/gosec/releases/download/v{version}/gosec_{version}_checksums.txt",
        "entry": "gosec_{version}_linux_amd64.tar.gz",
        "bundle_url": "https://github.com/securego/gosec/releases/download/v{version}/gosec_{version}_checksums.txt.sigstore.json",
        "public_key": "cosign.pub",
        "public_key_sha256": "4f9553257dbbb9f07c830da7773e49ae7150962f6d6d187d6243f95002d497fb"
      }
    },
    {
      "name": "go",
      "url": "https://dl.google.com/go/go1.27.1.linux-amd64.tar.gz",
      "dest": "downloads/go.tar.gz",
      "verify": {
        "kind": "vendor-sha256-file",
        "sha256_url": "https://dl.google.com/go/go1.27.1.linux-amd64.tar.gz.sha256"
      }
    }
  ],
  "smoke": [
    {
      "name": "go-fixture",
      "argv": [
        "/opt/tool/bin/gosec",
        "-fmt",
        "json",
        "-out",
        "/scratch/gosec.json",
        "-no-fail",
        "/workspace/..."
      ],
      "exit_codes": [
        0
      ],
      "workspace": "images/test/go",
      "expect_files": [
        "gosec.json"
      ]
    }
  ]
}
