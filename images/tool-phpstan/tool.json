{
  "schema": "appsec-review/tool-image/1",
  "image_id": "tool-phpstan",
  "tool": "phpstan",
  "version": "2.2.16",
  "purpose": "PHP static analysis (PHPStan).",
  "feeds": [
    "02-source-sast"
  ],
  "executable": "/opt/tool/bin/phpstan",
  "version_argv": [
    "/opt/tool/bin/phpstan",
    "--version"
  ],
  "version_expect": "{version}",
  "assets": [
    {
      "name": "phpstan",
      "url": "https://github.com/phpstan/phpstan/releases/download/{version}/phpstan.phar",
      "dest": "downloads/phpstan.phar",
      "verify": {
        "kind": "pgp",
        "signature_url": "https://github.com/phpstan/phpstan/releases/download/{version}/phpstan.phar.asc",
        "fingerprint": "CA7C2C7A30C8E8E1274A847651C67305FFC2E5C0"
      }
    }
  ],
  "smoke": [
    {
      "name": "php-fixture",
      "argv": [
        "/opt/tool/bin/phpstan",
        "analyse",
        "--no-progress",
        "--no-interaction",
        "--level",
        "5",
        "--error-format",
        "json",
        "--memory-limit",
        "1G",
        "/workspace"
      ],
      "exit_codes": [
        0,
        1
      ],
      "workspace": "images/test/php",
      "stdout_contains": "\"totals\""
    }
  ]
}
