{
  "schema": "appsec-review/tool-image/1",
  "image_id": "tool-spotbugs",
  "tool": "spotbugs",
  "version": "4.10.4",
  "purpose": "JVM bytecode SAST (SpotBugs + Find Security Bugs).",
  "feeds": [
    "02-source-sast"
  ],
  "executable": "/opt/spotbugs/bin/spotbugs",
  "version_argv": [
    "/opt/spotbugs/bin/spotbugs",
    "-version"
  ],
  "version_expect": "{version}",
  "bundles": [
    "Find Security Bugs 1.14.0 plugin jar (loaded from /opt/spotbugs/plugin)",
    "Temurin 21 JRE (base image)"
  ],
  "assets": [
    {
      "name": "spotbugs",
      "url": "https://github.com/spotbugs/spotbugs/releases/download/{version}/spotbugs-{version}.tgz",
      "dest": "downloads/spotbugs.tgz",
      "verify": {
        "kind": "pgp",
        "signature_url": "https://github.com/spotbugs/spotbugs/releases/download/{version}/spotbugs-{version}.tgz.asc",
        "fingerprint": "D878D4A823EAE731B729D1A8D2151178A123C97F"
      }
    },
    {
      "name": "findsecbugs-plugin",
      "url": "https://repo1.maven.org/maven2/com/h3xstream/findsecbugs/findsecbugs-plugin/1.14.0/findsecbugs-plugin-1.14.0.jar",
      "dest": "downloads/findsecbugs-plugin.jar",
      "verify": {
        "kind": "pgp",
        "signature_url": "https://repo1.maven.org/maven2/com/h3xstream/findsecbugs/findsecbugs-plugin/1.14.0/findsecbugs-plugin-1.14.0.jar.asc",
        "fingerprint": "CFC10B69382CBCF5387E51484ECE492B63E38ACF"
      }
    }
  ],
  "smoke": [
    {
      "name": "analyze-own-jar",
      "argv": [
        "/opt/spotbugs/bin/spotbugs",
        "-textui",
        "-effort:min",
        "-xml:withMessages",
        "-output",
        "/scratch/spotbugs.xml",
        "/opt/spotbugs/plugin/findsecbugs-plugin.jar"
      ],
      "exit_codes": [
        0
      ],
      "workspace": "none",
      "expect_files": [
        "spotbugs.xml"
      ]
    }
  ],
  "notes": "The smoke run analyzes the plugin jar itself: SpotBugs needs bytecode, and the image carries no compiler."
}
