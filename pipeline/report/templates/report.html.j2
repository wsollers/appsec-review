<title>AppSec Review Report</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap">
<style>
:root{
  --bg:#F7F8FA; --paper:#FFFFFF; --panel:#EEF2F6; --ink:#16202B; --muted:#5B6878; --rule:#D5DBE3;
  --accent:#2F5D8A; --accent-soft:#DCE6F1;
  --sev-Critical:#A8201A; --sev-High:#C8561B; --sev-Medium:#9A7810; --sev-Low:#3F7F48; --sev-None:#6B7785;
  --sev-Refuted:#8C96A3; --sev-Indeterminate:#6A4C93;
  --st-OK:#3F7F48; --st-OK_WITH_GAPS:#9A7810; --st-BLOCKED:#A8201A; --st-FAILED:#A8201A; --st-NOT_BUILT:#6A4C93; --st-SKIPPED_NA:#7D8794;
  --chip-ink:#FFFFFF;
  --code-bg:#F6F8FA; --flaw-bg:#FDE2E1; --flaw-rule:#C8352B;
  --f-head:"IBM Plex Sans Condensed","Arial Narrow",system-ui,sans-serif;
  --f-body:"Source Serif 4",Charter,"Bitstream Charter",Georgia,serif;
  --f-mono:"IBM Plex Mono",ui-monospace,"Cascadia Mono",Menlo,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --bg:#0E1318; --paper:#141B22; --panel:#1B242E; --ink:#E3E8EE; --muted:#93A0AF; --rule:#2A3541;
    --accent:#86AEDA; --accent-soft:#1F3247;
    --sev-Critical:#E0544B; --sev-High:#E47C3F; --sev-Medium:#D1AE3C; --sev-Low:#6DB277; --sev-None:#8C97A4;
    --sev-Refuted:#6F7A87; --sev-Indeterminate:#A386CC;
    --st-OK:#6DB277; --st-OK_WITH_GAPS:#D1AE3C; --st-BLOCKED:#E0544B; --st-FAILED:#E0544B; --st-NOT_BUILT:#A386CC; --st-SKIPPED_NA:#8C97A4;
    --chip-ink:#0E1318;
    --code-bg:#10161C; --flaw-bg:#4A1F1D; --flaw-rule:#E0544B;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#0E1318; --paper:#141B22; --panel:#1B242E; --ink:#E3E8EE; --muted:#93A0AF; --rule:#2A3541;
  --accent:#86AEDA; --accent-soft:#1F3247;
  --sev-Critical:#E0544B; --sev-High:#E47C3F; --sev-Medium:#D1AE3C; --sev-Low:#6DB277; --sev-None:#8C97A4;
  --sev-Refuted:#6F7A87; --sev-Indeterminate:#A386CC;
  --st-OK:#6DB277; --st-OK_WITH_GAPS:#D1AE3C; --st-BLOCKED:#E0544B; --st-FAILED:#E0544B; --st-NOT_BUILT:#A386CC; --st-SKIPPED_NA:#8C97A4;
  --chip-ink:#0E1318;
  --code-bg:#10161C; --flaw-bg:#4A1F1D; --flaw-rule:#E0544B;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font:16px/1.6 var(--f-body);margin:0;padding-inline:16px;padding-block:24px 64px}
.doc{max-width:880px;margin:0 auto;background:var(--paper);border:1px solid var(--rule);padding:clamp(20px,5vw,56px)}
h1,h2,h3,.eyebrow,.chip,.st,nav{font-family:var(--f-head)}
h1{font-size:clamp(28px,5vw,40px);line-height:1.1;margin:.2em 0 .15em;font-weight:700;text-wrap:balance}
h2{font-size:24px;margin:2.2em 0 .6em;padding-bottom:.3em;border-bottom:1px solid var(--rule);display:flex;gap:.6em;align-items:baseline;text-wrap:balance}
h2 .n{color:var(--accent)}
h3{font-size:18px;margin:1.6em 0 .3em;display:flex;gap:.5em;align-items:baseline}
h3 .n{color:var(--accent)}
p{margin:.6em 0;max-width:68ch}
.muted{color:var(--muted)}
.mono,code{font-family:var(--f-mono);font-size:.86em;overflow-wrap:anywhere}
.eyebrow{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
a:focus-visible,summary:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

nav.toc{display:flex;flex-wrap:wrap;gap:4px 16px;font-size:13px;font-weight:500;margin:0 auto 12px;max-width:880px}
nav.toc a{color:var(--muted)}

.sample{font-size:14px;color:var(--sev-Medium);margin-top:10px}
.cover{background:var(--panel);margin:calc(-1*clamp(20px,5vw,56px)) calc(-1*clamp(20px,5vw,56px)) 0;padding:clamp(20px,5vw,56px) clamp(20px,5vw,56px) 28px}
.cover .target{font-family:var(--f-head);font-size:19px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px 24px;margin-top:22px}
.kpi .v{font-family:var(--f-head);font-size:28px;font-weight:700;line-height:1.2;font-variant-numeric:tabular-nums}
.kpi .s{font-size:12.5px;color:var(--muted)}

.chip{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:2px 7px;color:var(--chip-ink);background:var(--sev-None);line-height:1.5;white-space:nowrap}
.kpi .chip{font-size:16px;padding:3px 10px}
{% for s in ['Critical','High','Medium','Low','None','Refuted','Indeterminate'] %}.chip.s-{{s}}{background:var(--sev-{{s}})}
{% endfor %}
.st{font-size:11.5px;font-weight:700;letter-spacing:.04em;white-space:nowrap}
{% for s in ['OK','OK_WITH_GAPS','BLOCKED','FAILED','NOT_BUILT','SKIPPED_NA'] %}.st.t-{{s}}{color:var(--st-{{s}})}
{% endfor %}

.tbl{overflow-x:auto;margin:.8em 0}
table{border-collapse:collapse;width:100%;font-size:14.5px}
th{font:600 11px/1.3 var(--f-head);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);text-align:left;padding:8px 10px 6px;border-bottom:1px solid var(--ink)}
td{padding:7px 10px;border-bottom:1px solid var(--rule);vertical-align:top}
tbody tr:last-child td{border-bottom:1px solid var(--ink)}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
td .gap{color:var(--sev-High)} td .receipt{color:var(--muted)}
td .detail{display:flex;flex-direction:column;gap:2px;font-size:13.5px}

.sevstrip{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin:1.2em 0}
.sevstrip div{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:8px 10px;background:var(--panel)}
.sevstrip b{font:700 26px/1 var(--f-head);font-variant-numeric:tabular-nums}

.bars{display:grid;grid-template-columns:minmax(120px,auto) 32px 1fr 44px;gap:8px 12px;align-items:center;font-size:14px;margin:1em 0}
.bars .h{font:600 11px var(--f-head);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.bars .track{height:10px;background:var(--panel);position:relative}
.bars .fill{position:absolute;inset:0 auto 0 0;background:var(--accent)}
.bars .fill.low{background:var(--sev-High)}
.bars .num{text-align:right;font-variant-numeric:tabular-nums;font-family:var(--f-head);font-weight:600}
.bars .w{color:var(--muted);text-align:center;font-variant-numeric:tabular-nums}
.bars .thr{position:absolute;top:-3px;bottom:-3px;width:1px;background:var(--ink);opacity:.5}

.math{overflow-x:auto;overflow-y:hidden;padding:4px 0;margin:.6em 0}

details.fam{margin:1em 0}
details.fam>summary{cursor:pointer;list-style:none;display:flex;flex-wrap:wrap;gap:4px 12px;align-items:baseline}
details.fam>summary::-webkit-details-marker{display:none}
details.fam>summary h3{margin:0}
details.fam>summary::before{content:"▸";color:var(--muted);font-size:12px}
details.fam[open]>summary::before{content:"▾"}

.finding{border:1px solid var(--rule);border-left:4px solid var(--sev-None);padding:16px 18px;margin:18px 0;background:var(--paper)}
{% for s in ['Critical','High','Medium','Low','None','Refuted'] %}.finding.s-{{s}}{border-left-color:var(--sev-{{s}})}
{% endfor %}
.finding .top{display:flex;justify-content:space-between;align-items:center;gap:12px}
.finding h3{margin:.25em 0 .6em;font-size:20px}
.meta{display:grid;grid-template-columns:130px 1fr;gap:4px 14px;font-size:14.5px}
.meta .eyebrow{padding-top:3px}
@media (max-width:560px){.meta{grid-template-columns:1fr}.meta .eyebrow{padding-top:8px}}
.trail{display:flex;flex-wrap:wrap;gap:6px 8px;align-items:center;font-size:14px;margin:.3em 0 .8em}
.trail .lane{font:700 11px var(--f-head);background:var(--panel);padding:2px 6px;margin-right:4px}
.trail .arrow{color:var(--muted)}
.evlist{list-style:none;padding:0;margin:.3em 0 .8em;font-size:13.5px;display:flex;flex-direction:column;gap:3px}
.finding .block{margin-top:10px}
figure.snippet{margin:12px 0 4px;border:1px solid var(--rule)}
figure.snippet figcaption{display:flex;justify-content:space-between;gap:12px;font:12.5px var(--f-mono);color:var(--muted);background:var(--panel);padding:4px 10px}
pre.code{margin:0;background:var(--code-bg);font:13px/1.55 var(--f-mono);overflow-x:auto;padding:4px 0}
pre.code .l{display:block;padding-right:12px;min-width:max-content}
pre.code .n{display:inline-block;width:3.2em;padding-right:1em;text-align:right;color:var(--muted);user-select:none;font-variant-numeric:tabular-nums}
pre.code .l.flaw{background:var(--flaw-bg);box-shadow:inset 3px 0 0 var(--flaw-rule)}
pre.code .l.flaw .n{color:var(--flaw-rule);font-weight:600}
.snipnote{font-size:13.5px;color:var(--muted);margin:2px 0 10px}


ul.gaps{padding-left:1.1em} ul.gaps li{margin:.35em 0}
tr:target td{background:var(--accent-soft)}

.weights{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}
.weights table{font-size:14px}

details.src{margin-top:2.5em;border-top:1px solid var(--rule);padding-top:1em}
details.src summary{cursor:pointer;font-family:var(--f-head);font-weight:600}
.srcbar{display:flex;gap:10px;align-items:center;margin:.6em 0}
button{font:600 13px var(--f-head);background:var(--ink);color:var(--paper);border:0;padding:6px 12px;cursor:pointer}
pre.tex{background:var(--panel);padding:14px;overflow:auto;max-height:520px;font:12.5px/1.5 var(--f-mono);white-space:pre}
.katex{font-size:1.05em}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
<style>{{ katex_css|safe }}</style>

<nav class="toc" aria-label="Sections">
  <a href="#summary">1 Summary</a><a href="#coverage">2 Coverage</a><a href="#findings">3 Findings</a><a href="#chains">3A Attack chains</a>
  <a href="#gaps">4 Gaps</a><a href="#method">5 Scoring</a><a href="#evidence">A Evidence</a><a href="#provenance">B Provenance</a><a href="#latex">LaTeX source</a>
</nav>

<main class="doc">
  <header class="cover">
    <div class="eyebrow">{{ report.engagement }}</div>
    <h1>{{ report.title }}</h1>
    <div class="target">{{ report.target }} <span class="muted">@ <span class="mono">{{ report.target_commit }}</span></span></div>
    <div class="kpis">
      <div class="kpi"><div class="eyebrow">Overall rating</div><div class="v"><span class="chip s-{{ model.rating }}">{{ model.rating }}</span></div><div class="s">top priority {{ '%.1f'|format(model.top_priority) }}</div></div>
      <div class="kpi"><div class="eyebrow">Process assurance</div><div class="v">{{ (model.assurance_pct|string + '%') if model.assurance_pct is not none else 'Not asserted' }}</div><div class="s">{{ model.n_ok }} of {{ model.n_processes }} retained process records OK, {{ model.gaps|length }} gaps</div></div>
      <div class="kpi"><div class="eyebrow">Native tier</div><div class="v">{{ report.native_tier }}</div><div class="s">ADR-0001 gate</div></div>
      <div class="kpi"><div class="eyebrow">Report date</div><div class="v" style="font-size:20px">{{ report.report_date }}</div><div class="s">SAT {{ report.sat_id }}</div></div>
    </div>
    {% if report.sample %}<p class="sample">{% if finding_scoring == 'authoritative_retained_publication' %}<b>DEMO data.</b> Retained fixture lifecycle; not a production target assessment.{% else %}<b>Sample data.</b> Values are illustrative, shaped like a hello-autotools SAT run.{% endif %}</p>{% endif %}
  </header>

  <section id="summary">
    <h2><span class="n">1</span>Executive summary</h2>
    {% if finding_scoring == 'authoritative_retained_publication' %}<p>The retained report contains {{ model.n_processes }} process records across {{ model.families|length }} families. {{ model.n_ok }} are accepted or completed records and {{ model.gaps|length }} record gaps remain. Overall rating is <b>{{ model.rating }}</b>, preserving the authoritative lifecycle severity and score; process assurance is <b>{{ (model.assurance_pct|string + '%') if model.assurance_pct is not none else 'not asserted' }}</b>.</p>{% else %}<p>The review ran {{ model.n_processes }} processes across {{ model.families|length }} families. {{ model.n_ok }} completed cleanly, {{ model.n_na }} were skipped as not applicable with a probe receipt, and {{ model.gaps|length }} left coverage gaps. Overall rating is <b>{{ model.rating }}</b>, driven by the highest verified priority score of {{ '%.1f'|format(model.top_priority) }}. Process assurance is <b>{{ model.assurance_pct }}%</b>; a process that did not run is reported as a gap, never as a clean result.</p>{% endif %}
    <div class="sevstrip">
      {% for k in ['Critical','High','Medium','Low','Refuted'] %}<div><span class="chip s-{{k}}">{{k}}</span><b>{{ model.counts[k] }}</b></div>{% endfor %}
    </div>
    <div class="tbl"><table>
      <thead><tr><th>ID</th><th>Finding</th><th class="num">CVSS 4.0</th><th class="num">Priority</th><th>Severity</th></tr></thead>
      <tbody>
      {% for f in findings %}
        <tr><td><a class="mono" href="#{{ f.id }}">{{ f.id }}</a></td><td>{{ f.title }}</td>
          <td class="num">{{ '%.1f'|format(f.cvss_score) if f.cvss_score is not none else '–' }}</td>
          <td class="num"><b>{{ f.priority_label if f.get('priority_label') else ('%.1f'|format(f.priority) if f.priority is not none else '–') }}</b></td>
          <td><span class="chip s-{{ f.severity }}">{{ f.severity }}</span></td></tr>
      {% endfor %}
      </tbody></table></div>
  </section>

  <section id="coverage">
    <h2><span class="n">2</span>Scope and process coverage</h2>
    {% if process_assurance == 'not_asserted' %}<p>These are retained accepted-output and completion-control records. No process-assurance score is asserted.</p>{% else %}<p>Every process in the flow appears here, including designed lanes that are not built yet. Credit per process: <span class="st t-OK">OK</span> = 1, <span class="st t-OK_WITH_GAPS">OK_WITH_GAPS</span> = measured coverage, <span class="st t-BLOCKED">BLOCKED</span> / <span class="st t-FAILED">FAILED</span> / <span class="st t-NOT_BUILT">NOT_BUILT</span> = 0, <span class="st t-SKIPPED_NA">SKIPPED_NA</span> excluded from the denominator.</p>{% endif %}
    <div class="math">\[ {{ model.assurance_tex }} \]</div>

    <div class="bars" role="table" aria-label="Assurance by family">
      <span class="h">Family</span><span class="h" style="text-align:center">\(w_k\)</span><span class="h">\(A_k\) &nbsp;<span style="text-transform:none;letter-spacing:0">(line = {{ scoring.assurance_floor_for_clean }} floor)</span></span><span class="h" style="text-align:right">\(A_k\)</span>
      {% for fam in model.families %}
      <span>{{ fam.name }}</span><span class="w">{{ fam.weight }}</span>
      <span class="track"><span class="fill{{ ' low' if (fam.assurance or 0) < scoring.assurance_floor_for_clean }}" style="width:{{ ((fam.assurance or 0)*100)|round(1) }}%"></span><span class="thr" style="left:{{ scoring.assurance_floor_for_clean*100 }}%"></span></span>
      <span class="num">{{ '%.2f'|format(fam.assurance) if fam.assurance is not none else '–' }}</span>
      {% endfor %}
    </div>

    {% for fam in model.families %}
    <details class="fam" open>
      <summary><h3><span class="n">2.{{ loop.index }}</span>{{ fam.name }}</h3><span class="muted" style="font-size:14px">{{ fam.note }}</span></summary>
      <div class="tbl"><table>
        <thead><tr><th>Process</th><th>Status</th><th class="num">\(c_i\)</th><th>Tools / gap / receipt</th></tr></thead>
        <tbody>
        {% for p in fam.procs %}
          <tr><td class="mono">{{ p.id }}</td><td><span class="st t-{{ p.status }}">{{ p.status }}</span></td>
            <td class="num">{{ '%.2f'|format(p.credit) if p.credit is not none else '–' }}</td>
            <td><div class="detail">{% for k, txt in p.detail %}{% if k == 'evidence' %}<span>{% for e in p.evidence %}<a class="mono" href="#{{ e }}">{{ e }}</a>{{ ', ' if not loop.last }}{% endfor %}</span>{% else %}<span class="{{ k }}">{{ txt }}</span>{% endif %}{% endfor %}</div></td></tr>
        {% endfor %}
        </tbody></table></div>
    </details>
    {% endfor %}
  </section>

  <section id="findings">
    <h2><span class="n">3</span>Findings</h2>
    <p>Findings reach this section only after refutation (lane 08) and, for High or Critical, independent verification (lane 09). Refuted hypotheses stay on the record with priority zero.</p>
    {% for f in findings %}
    <article class="finding s-{{ f.severity }}" id="{{ f.id }}">
      <div class="top"><span class="mono">{{ f.id }}</span><span class="chip s-{{ f.severity }}">{{ f.severity }}</span></div>
      <h3>{{ f.title }}</h3>
      <div class="meta">
        <span class="eyebrow">Location</span><span class="mono">{{ f.location }}</span>
        <span class="eyebrow">Component</span><span>{{ f.component }} <span class="muted">{{ f.cwe }}</span></span>
        <span class="eyebrow">CVSS 4.0</span><span>{% if f.cvss %}<span class="mono">{{ f.cvss }}</span> <b>{{ '%.1f'|format(f.cvss_score) }}</b> {{ f.cvss_band }}{% else %}not scored{% endif %}</span>
        <span class="eyebrow">Evidence / status</span><span>{{ f.evidence_strength }} · {{ f.verification }} · {{ f.reachability }}</span>
        {% if f.exploit_signal is defined %}<span class="eyebrow">EPSS / KEV</span><span>{{ f.exploit_signal }}</span>{% endif %}
      </div>
      <div class="math">\[ {{ f.priority_tex }} \]</div>
      <p>{{ f.summary }}</p>
      {% for sn in f.snippets %}
      <figure class="snippet">
        <figcaption><span>{{ sn.path }}</span><span>lines {{ sn.start }}–{{ sn.end }}</span></figcaption>
        <pre class="code">{% for ln in sn.lines %}<span class="l{{ ' flaw' if ln.flaw }}"><span class="n">{{ ln.n }}</span>{{ ln.text }}</span>{% endfor %}</pre>
      </figure>
      {% if sn.note %}<p class="snipnote">{{ sn.note }}</p>{% endif %}
      {% endfor %}
      <div class="block"><div class="eyebrow">Lane trail</div>
        <div class="trail">{% for lane, note in f.trail %}<span><span class="lane">{{ lane }}</span>{{ note }}</span>{% if not loop.last %}<span class="arrow" aria-hidden="true">→</span>{% endif %}{% endfor %}</div></div>
      <div class="block"><div class="eyebrow">Evidence</div>
        <ul class="evlist">{% for eid in f.evidence %}{% set e = evidence_by_id[eid] %}<li><a class="mono" href="#{{ eid }}">{{ eid }}</a> {{ e.producer }}: <span class="mono">{{ e.artifact }}</span></li>{% endfor %}</ul></div>
      <div class="block"><div class="eyebrow">Remediation</div><p>{{ f.remediation }}</p></div>
      {% if f.poc_fix is defined and f.poc_fix %}{% set pf = f.poc_fix %}
      <div class="block pocfix"><div class="eyebrow">Light PoC and proposed fix · {{ pf.label }}</div>
        <p class="muted">{{ pf.label_text }}</p>
        {% if pf.poc.lines %}
        <figure class="snippet">
          <figcaption><span>PoC ({{ pf.poc.kind }}, {{ pf.poc.language }}); expected effect: {{ pf.poc.expected_effect }}</span><span>UNVALIDATED static text</span></figcaption>
          <pre class="code">{% for ln in pf.poc.lines %}<span class="l"><span class="n">{{ loop.index }}</span>{{ ln }}</span>{% endfor %}</pre>
        </figure>
        {% endif %}
        {% if pf.poc.note %}<p>{{ pf.poc.note }}</p>{% endif %}
        {% if pf.poc.trigger_condition %}<p><b>Trigger condition.</b> {{ pf.poc.trigger_condition }}</p>{% endif %}
        <p><b>How it happens (source to sink).</b> {{ pf.explanation }}</p>
        <ul class="evlist">{% for c in pf.cited_lines %}<li class="mono">{{ c.display }}</li>{% endfor %}</ul>
        {% if pf.fix.lines %}
        <figure class="snippet">
          <figcaption><span>Proposed fix: {{ pf.fix.files|join(', ') }}</span><span>PATCH_PROPOSED_UNVALIDATED</span></figcaption>
          <pre class="code">{% for ln in pf.fix.lines %}<span class="l"><span class="n">{{ loop.index }}</span>{{ ln }}</span>{% endfor %}</pre>
        </figure>
        {% endif %}
        {% if pf.fix.rationale %}<p>{{ pf.fix.rationale }}</p>{% endif %}
        {% if pf.fix.note %}<p>{{ pf.fix.note }}</p>{% endif %}
      </div>
      {% elif f.poc_fix_note is defined %}
      <div class="block"><div class="eyebrow">Light PoC and proposed fix</div><p>{{ f.poc_fix_note }}</p></div>
      {% endif %}
    </article>
    {% endfor %}
  </section>

  <section id="chains">
    <h2><span class="n">3A</span>Attack chains</h2>
    {% set ac = attack_chains if attack_chains is defined else {'status': 'ABSENT', 'reason': 'not built', 'chains': [], 'appendix': [], 'refuted_count': 0, 'note': ''} %}
    <p>{{ ac.note }}</p>
    {% if ac.status != 'PUBLISHED' %}<p><b>No chain composed.</b> {{ ac.status }}: {{ ac.reason }}</p>{% elif not ac.chains and not ac.appendix %}<p><b>No chain reported.</b> {{ ac.reason }}</p>{% endif %}
    {% if ac.refuted_count %}<p class="muted">{{ ac.refuted_count }} composed chain(s) were broken by the refuter; they are counted, not listed.</p>{% endif %}
    {% for c in ac.chains %}
    <article class="finding" id="{{ c.chain_id }}">
      <div class="top"><span class="mono">#{{ c.rank }} {{ c.chain_id }}</span><span class="chip">{{ c.state }}</span></div>
      <h3>{{ c.objective }}</h3>
      <div class="meta">
        <span class="eyebrow">Impact</span><span>{{ c.impact_kind }}</span>
        <span class="eyebrow">Weakest link</span><span>{{ c.weakest.reason }}</span>
        <span class="eyebrow">Refutation</span><span>{{ c.refutation.disposition }}{% if c.refutation.mechanism %}: {{ c.refutation.mechanism }}{% endif %} ({{ c.refutation.citations }} citation(s))</span>
        {% if c.boundaries_crossed %}<span class="eyebrow">Boundaries</span><span>{{ c.boundaries_crossed|join(', ') }}</span>{% endif %}
      </div>
      <div class="block"><div class="eyebrow">Stages</div>
        <div class="trail">{% for l in c.links %}<span><span class="lane">{{ l.stage }}</span>{{ l.label }} <span class="muted">({{ l.link_state }}{% if l.severity %}, {{ l.severity }}{% endif %})</span></span>{% if not loop.last %}{% set e = c.edges[loop.index0] %}<span class="arrow" aria-hidden="true">→</span><span class="muted">{{ e.basis }}{% if e.downgraded_from %} (claimed {{ e.downgraded_from }}){% endif %}</span><span class="arrow" aria-hidden="true">→</span>{% endif %}{% endfor %}</div></div>
      <p>{{ c.narrative }}</p>
    </article>
    {% endfor %}
    {% if ac.appendix %}
    <div class="tbl"><table>
      <thead><tr><th>Rank</th><th>Chain</th><th>State</th><th>Impact</th><th>Objective</th></tr></thead>
      <tbody>{% for c in ac.appendix %}<tr><td class="num">{{ c.rank }}</td><td class="mono">{{ c.chain_id }}</td><td>{{ c.state }}</td><td>{{ c.impact_kind }}</td><td>{{ c.objective }}</td></tr>{% endfor %}</tbody>
    </table></div>
    {% endif %}
  </section>

  <section id="gaps">
    <h2><span class="n">4</span>Coverage gaps</h2>
    <p>Each item below is an area the review did not fully examine. None of them may be read as “no issues”.</p>
    <ul class="gaps">
      {% for p in model.gaps %}<li><span class="mono">{{ p.id }}</span> <span class="st t-{{ p.status }}">{{ p.status }}</span>{% if p.get('gap') %} — {{ p.gap }}{% endif %}</li>{% endfor %}
    </ul>
  </section>

  <section id="method">
    <h2><span class="n">5</span>Scoring method</h2>
    {% if finding_scoring == 'authoritative_retained_publication' %}
    <p>Finding severity, lifecycle score, and priority are copied verbatim from the retained verified finding. No CVSS vector, presentation priority, process-assurance score, or coverage-derived rating is calculated. The overall rating preserves the most severe non-refuted authoritative finding severity.</p>
    {% else %}
    <h3><span class="n">5.1</span>Finding priority</h3>
    <p>Lane 12 computes the CVSS 4.0 score \(S_f\) from the vector. Priority adjusts it by how strong the evidence is, whether it survived verification, whether the code is reachable, and exploitation signals:</p>
    <div class="math">\[ P_f = \min\!\big(10,\; S_f \cdot e_f \cdot v_f \cdot r_f \cdot t_f\big), \qquad t_f = 1 + \beta_{\mathrm{KEV}}\,\mathbf{1}[\mathrm{KEV}] + \beta_{\mathrm{EPSS}}\,\mathrm{EPSS}_f \]</div>
    <div class="weights">
      {% for label, sym, d in [('Evidence','e',scoring.evidence_weight),('Verification','v',scoring.verification_weight),('Reachability','r',scoring.reachability_weight)] %}
      <div class="tbl"><table><thead><tr><th>{{ label }} \({{ sym }}\)</th><th class="num">weight</th></tr></thead><tbody>
        {% for k, v in d.items() %}<tr><td class="mono">{{ k }}</td><td class="num">{{ v }}</td></tr>{% endfor %}
      </tbody></table></div>
      {% endfor %}
    </div>
    <p>\(\beta_{\mathrm{KEV}} = {{ scoring.kev_bonus }}\), \(\beta_{\mathrm{EPSS}} = {{ scoring.epss_bonus }}\). Severity bands follow CVSS 4.0 qualitative ratings applied to \(P_f\).</p>
    <h3><span class="n">5.2</span>Process assurance</h3>
    <div class="math">\[ c_i = \begin{cases} 1 & \text{OK}\\ \text{coverage}_i & \text{OK\_WITH\_GAPS}\\ 0 & \text{BLOCKED, FAILED, NOT\_BUILT}\\ \varnothing & \text{SKIPPED\_NA (with probe receipt)} \end{cases} \qquad A_k = \frac{1}{|K_k|}\sum_{i\in K_k} c_i \cdot \kappa_k \]</div>
    <p>\(\kappa_k\) is the native tier cap (A = {{ scoring.tier_cap.A }}, B = {{ scoring.tier_cap.B }}, C = {{ scoring.tier_cap.C }}), applied only to the native family.</p>
    <h3><span class="n">5.3</span>Overall rating</h3>
    <div class="math">\[ \text{rating} = \operatorname{band}\Big(\max_{f\,\notin\,\text{refuted}} P_f\Big), \qquad \text{rating} \in \{\text{None},\text{Low}\} \wedge A < {{ scoring.assurance_floor_for_clean }} \;\Rightarrow\; \text{Indeterminate} \]</div>
    <p>A low score is only reported as low when enough of the process ran to support it.</p>
    {% endif %}
  </section>

  <section id="evidence">
    <h2><span class="n">A</span>Evidence register</h2>
    <div class="tbl"><table>
      <thead><tr><th>ID</th><th>Producer</th><th>Artifact</th><th>sha256</th></tr></thead>
      <tbody>{% for e in evidence %}<tr id="{{ e.id }}"><td class="mono">{{ e.id }}</td><td>{{ e.producer }}</td><td class="mono">{{ e.artifact }}</td><td class="mono">{{ e.sha256[:8] }}</td></tr>{% endfor %}</tbody>
    </table></div>
  </section>

  <section id="provenance">
    <h2><span class="n">B</span>Provenance</h2>
    <div class="tbl"><table><tbody>
      <tr><td class="eyebrow">Run</td><td><span class="mono">{{ report.run_id }}</span> (SAT <span class="mono">{{ report.sat_id }}</span>)</td></tr>
      <tr><td class="eyebrow">Pipeline</td><td class="mono">{{ report.pipeline_commit }}</td></tr>
      <tr><td class="eyebrow">Ledger head</td><td class="mono">{{ provenance.ledger_head }}</td></tr>
      <tr><td class="eyebrow">Native tier</td><td>{{ report.native_tier }} — {{ report.native_tier_note }}</td></tr>
      {% for name, digest in provenance.images %}<tr><td class="mono">{{ name }}</td><td class="mono">{{ digest }}</td></tr>{% endfor %}
      {% for m, note in provenance.models %}<tr><td>{{ m }}</td><td>{{ note }}</td></tr>{% endfor %}
    </tbody></table></div>
  </section>

  <details class="src" id="latex">
    <summary>Generated LaTeX source (report.tex)</summary>
    <div class="srcbar"><button type="button" id="copytex">Copy LaTeX</button><span class="muted" id="copymsg" style="font-size:13px"></span></div>
    <pre class="tex" id="texsrc">{{ tex_source }}</pre>
  </details>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/katex.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/contrib/auto-render.min.js"></script>
<script>
(function(){
  function go(){
    if (!window.renderMathInElement) return;
    renderMathInElement(document.querySelector('main'), {
      delimiters:[{left:'\\[',right:'\\]',display:true},{left:'\\(',right:'\\)',display:false}],
      ignoredTags:['script','noscript','style','textarea','pre','code'],
      throwOnError:false
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go); else go();
  var btn=document.getElementById('copytex'), msg=document.getElementById('copymsg'), pre=document.getElementById('texsrc');
  btn.addEventListener('click', function(){
    var done=function(){ msg.textContent='Copied'; };
    var fallback=function(){ var r=document.createRange(); r.selectNodeContents(pre); var s=getSelection(); s.removeAllRanges(); s.addRange(r); msg.textContent='Selected. Press Ctrl+C to copy.'; };
    try { navigator.clipboard.writeText(pre.textContent).then(done, fallback); } catch(e){ fallback(); }
  });
})();
</script>
