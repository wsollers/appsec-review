    {
      "id": "AR-001",
      "title": "Stack buffer overflow: strcpy of CLI name into 32-byte buffer",
      "cwe": "CWE-121, CWE-676",
      "location": "src/greet.cpp:18",
      "component": "cli/greeting",
      "cvss": "CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:P/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N",
      "evidence_strength": "DIRECT_EVIDENCE",
      "verification": "VERIFIED",
      "reachability": "reachable-default",
      "epss": null,
      "kev": false,
      "snippets": [
        {
          "path": "src/greet.cpp",
          "flaw": [
            18
          ],
          "note": "build_greeting(): buf is 32 bytes; strcpy has no bound.",
          "start": 13,
          "source": [
            "// This is intentional: it is the seeded defect this fixture target",
            "// exists to exercise for source/native SAST and dynamic tools. See",
            "// docs/VULNERABILITIES.md for details and the expected finding.",
            "std::string build_greeting(const std::string &name) {",
            "    char buf[32];",
            "    std::strcpy(buf, (\"Hello, \" + name + \"!\").c_str());",
            "    return std::string(buf);",
            "}"
          ]
        }
      ],
      "trail": [
        [
          "tool",
          "semgrep insecure-use-strcpy, CSA, CodeQL"
        ],
        [
          "07",
          "hypothesis RT-001"
        ],
        [
          "08",
          "refutation failed: no length check on any path"
        ],
        [
          "09",
          "VERIFIED: ASan stack-buffer-overflow at greet.cpp:18"
        ],
        [
          "11",
          "patch: bounded copy, retest OK"
        ],
        [
          "12",
          "scored"
        ]
      ],
      "evidence": [
        "E-014",
        "E-022",
        "E-023",
        "E-040"
      ],
      "summary": "The greeting \"Hello, \" + name + \"!\" is copied into char buf[32] with strcpy. A name of 24 or more characters overflows buf. Reached on every run. A hardened distro build aborts via _FORTIFY_SOURCE; an unhardened or ASan build shows the corruption.",
      "remediation": "Return the std::string directly, or use a bounded copy and reject oversize names."
    },
