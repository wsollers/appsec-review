{
  "schema": "appsec-review/tag-crosswalk/1",
  "version": "1",
  "authority": "docs/architecture/security-tag-taxonomy.md",
  "note": "Every emitted tag carries basis 'derived' and means applicable or relevant to review, never present or satisfied. Curated rules are lifted from the design tables and await human review sign-off.",
  "rules": [
    {"id": "cwe-89-sql-injection", "scope": "same_subject",
     "when": {"all": [{"tag": "cwe:89", "basis_at_least": "reported"}]},
     "emit": ["capec:66", "asvs5:v1"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "SQL injection reported here; CAPEC-66 and output encoding controls frame the review question."},
    {"id": "cwe-78-os-command-injection", "scope": "same_subject",
     "when": {"all": [{"tag": "cwe:78", "basis_at_least": "reported"}]},
     "emit": ["capec:88", "attack:t1059", "asvs5:v1"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "OS command injection reported here; command interpreter abuse is the review question."},
    {"id": "cwe-94-code-injection", "scope": "same_subject",
     "when": {"all": [{"any": [{"tag": "cwe:94", "basis_at_least": "reported"},
                                {"tag": "cwe:95", "basis_at_least": "reported"}]}]},
     "emit": ["capec:242", "attack:t1059", "asvs5:v1"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Code or eval injection reported here; interpreter execution is the review question."},
    {"id": "cwe-79-cross-site-scripting", "scope": "same_subject",
     "when": {"all": [{"tag": "cwe:79", "basis_at_least": "reported"}]},
     "emit": ["capec:63", "attack:t1189", "attack:t1539", "asvs5:v1"], "source": "curated",
     "reviewer": "pending-human-review",
     "rationale": "Cross-site scripting reported here; drive-by and session-cookie theft frame the review question."},
    {"id": "cwe-22-path-traversal", "scope": "same_subject",
     "when": {"all": [{"tag": "cwe:22", "basis_at_least": "reported"}]},
     "emit": ["capec:126", "asvs5:v5"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Path traversal reported here; file-handling controls frame the review question."},
    {"id": "cwe-502-deserialization", "scope": "same_subject",
     "when": {"all": [{"tag": "cwe:502", "basis_at_least": "reported"}]},
     "emit": ["capec:586", "asvs5:v1"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Untrusted deserialization reported here; object injection is the review question."},
    {"id": "cwe-611-xxe", "scope": "same_subject",
     "when": {"all": [{"tag": "cwe:611", "basis_at_least": "reported"}]},
     "emit": ["capec:221"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "XML external entity processing reported here; XXE is the review question."},
    {"id": "cwe-918-ssrf", "scope": "same_subject",
     "when": {"all": [{"tag": "cwe:918", "basis_at_least": "reported"}]},
     "emit": ["capec:664", "attack:t1552.005"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Server-side request forgery reported here; metadata-service credential access is the review question."},
    {"id": "cwe-352-csrf", "scope": "same_subject",
     "when": {"all": [{"tag": "cwe:352", "basis_at_least": "reported"}]},
     "emit": ["capec:62", "asvs5:v3"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Cross-site request forgery reported here; frontend request-origin controls frame the review question."},
    {"id": "cwe-347-signature-verification", "scope": "same_subject",
     "when": {"all": [{"tag": "cwe:347", "basis_at_least": "reported"}]},
     "emit": ["capec:196", "attack:t1606", "asvs5:v9"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Missing signature verification reported here; forged credentials are the review question."},
    {"id": "cwe-798-hard-coded-credential", "scope": "same_subject",
     "when": {"all": [{"tag": "cwe:798", "basis_at_least": "reported"}]},
     "emit": ["attack:t1552.001", "asvs5:v13"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "A credential is reported in a file; credential access from files is the review question."},
    {"id": "jwt-signature-applicability", "scope": "component",
     "when": {"all": [{"tag": "func:authn:jwt", "basis_at_least": "declared"}]},
     "emit": ["asvs5:v9", "cwe:347", "capec:196"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Self-contained token verification applies; signature verification is the review question."},
    {"id": "native-deserialization-applicability", "scope": "component",
     "when": {"all": [{"tag": "func:data:deserialize-native", "basis_at_least": "declared"}]},
     "emit": ["asvs5:v1", "cwe:502", "capec:586"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Native deserialization is available; untrusted object deserialization is the review question."},
    {"id": "xml-parser-applicability", "scope": "component",
     "when": {"all": [{"tag": "func:data:parse-xml", "basis_at_least": "declared"}]},
     "emit": ["cwe:611", "capec:221"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "An XML parser is available; external entity resolution is the review question."},
    {"id": "http-client-ssrf-applicability", "scope": "component",
     "when": {"all": [{"tag": "func:net:http-client", "basis_at_least": "declared"}]},
     "emit": ["cwe:918", "capec:664"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Outbound HTTP is available; server-side request forgery is the review question."},
    {"id": "template-injection-applicability", "scope": "component",
     "when": {"all": [{"tag": "func:data:template-render", "basis_at_least": "declared"}]},
     "emit": ["cwe:1336", "asvs5:v1"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Template rendering is available; template injection is the review question."},
    {"id": "archive-extraction-applicability", "scope": "component",
     "when": {"all": [{"tag": "func:data:archive-extract", "basis_at_least": "declared"}]},
     "emit": ["cwe:22", "asvs5:v5"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "Archive extraction is available; zip-slip path traversal is the review question."},
    {"id": "poisoned-pipeline-execution", "scope": "ci_job",
     "when": {"all": [
       {"tag": "infra:ci:trigger-untrusted", "basis_at_least": "invoked"},
       {"any": [{"tag": "infra:ci:secret-use", "basis_at_least": "invoked"},
                {"tag": "infra:ci:oidc-token", "basis_at_least": "invoked"},
                {"tag": "infra:ci:permissions", "basis_at_least": "invoked"}]}
     ]},
     "emit": ["surface:boundary:ci-trust", "attack:t1195.002", "cwe:829"], "source": "curated",
     "reviewer": "pending-human-review",
     "rationale": "Untrusted input reaches a job that holds secrets or write scope; poisoned pipeline execution is the review question."},
    {"id": "unpinned-ci-dependency", "scope": "same_subject",
     "when": {"all": [{"tag": "infra:ci:third-party-action", "basis_at_least": "reported"}]},
     "emit": ["attack:t1195.001", "capec:538"], "source": "curated", "reviewer": "pending-human-review",
     "rationale": "A CI dependency is selected by a mutable reference; dependency manipulation is the review question."}
  ]
}
