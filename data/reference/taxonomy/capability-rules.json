      {"id": "lex-go-env", "kind": "identifier", "languages": ["lang:go"],
       "patterns": ["\\bos\\.(?:Getenv|LookupEnv)\\s*\\(", "\\bviper\\.", "\\bgodotenv\\b"],
       "emit": ["role:config"],
       "rationale": "Environment configuration is read."},
      {"id": "lex-go-storage", "kind": "identifier", "languages": ["lang:go"],
       "patterns": ["\\bsql\\.Open\\s*\\(", "\\bdb\\.(?:Query|QueryRow|Exec|QueryContext|ExecContext)\\s*\\(", "\\bgorm\\.Open\\s*\\(", "\\bmongo\\.Connect\\s*\\("],
