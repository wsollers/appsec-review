       "rationale": "A caller's identity or credential is checked."},
      {"id": "lex-ruby-http-route", "kind": "identifier", "languages": ["lang:ruby"],
       "patterns": ["^\\s*(?:get|post|put|patch|delete)\\s+['\"/]", "\\bRails\\.application\\.routes\\.draw\\b", "\\bresources\\s+:", "\\bSinatra::Base\\b", "\\bApplicationController\\b"],
       "emit": ["mechanism:http", "mechanism:networked-listener"],
       "rationale": "An HTTP route or handler is registered."},
      {"id": "lex-ruby-request-input", "kind": "identifier", "languages": ["lang:ruby"],
       "patterns": ["\\bparams\\s*\\[", "\\bparams\\.(?:require|permit|fetch)\\b", "\\brequest\\.(?:body|params|headers|cookies)\\b"],
       "emit": ["trust:user-tainted", "role:input-parsing"],
       "rationale": "Request data from the caller is read."},
      {"id": "lex-ruby-session", "kind": "identifier", "languages": ["lang:ruby"],
       "patterns": ["\\bsession\\s*\\[", "\\bcookies\\.(?:signed|encrypted|permanent)\\b", "\\breset_session\\b"],
       "emit": ["role:session", "state:session", "asset:session-tokens"],
       "rationale": "Per-principal session state or a session cookie is handled."},
      {"id": "lex-ruby-auth", "kind": "identifier", "languages": ["lang:ruby"],
       "patterns": ["\\bhas_secure_password\\b", "\\bauthenticate(?:_user)?!?\\b", "\\bDevise\\b", "\\bBCrypt::Password\\b", "\\bJWT\\.(?:decode|encode)\\s*\\("],
       "emit": ["role:auth", "asset:credentials"],
       "rationale": "A caller's identity or credential is checked."},
      {"id": "lex-ruby-storage", "kind": "identifier", "languages": ["lang:ruby"],
       "patterns": ["\\bActiveRecord::Base\\b", "\\bApplicationRecord\\b", "\\b\\.(?:where|find_by|find|create!?|update!?|destroy!?)\\s*\\(", "\\bSequel\\.connect\\s*\\("],
       "emit": ["role:storage"],
       "rationale": "A database or persistent record is read or written."},
      {"id": "lex-php-http-route", "kind": "identifier", "languages": ["lang:php"],
       "patterns": ["\\bRoute::(?:get|post|put|patch|delete|any|resource)\\s*\\(", "#\\[Route\\(", "\\$app->(?:get|post|put|delete|patch)\\s*\\(", "\\b\\$_SERVER\\s*\\[\\s*['\"]REQUEST_METHOD"],
       "emit": ["mechanism:http", "mechanism:networked-listener"],
       "rationale": "An HTTP route or handler is registered."},
      {"id": "lex-php-request-input", "kind": "identifier", "languages": ["lang:php"],
       "patterns": ["\\$_(?:GET|POST|REQUEST|COOKIE|FILES)\\s*\\[", "\\$request->(?:input|get|post|all|json|query|header|cookie)\\s*\\(", "\\bfile_get_contents\\s*\\(\\s*['\"]php://input"],
       "emit": ["trust:user-tainted", "role:input-parsing"],
       "rationale": "Request data from the caller is read."},
      {"id": "lex-php-session", "kind": "identifier", "languages": ["lang:php"],
       "patterns": ["\\$_SESSION\\s*\\[", "\\bsession_start\\s*\\(", "\\bsetcookie\\s*\\(", "\\$request->session\\s*\\("],
       "emit": ["role:session", "state:session", "asset:session-tokens"],
       "rationale": "Per-principal session state or a session cookie is handled."},
      {"id": "lex-php-auth", "kind": "identifier", "languages": ["lang:php"],
       "patterns": ["\\bpassword_(?:verify|hash)\\s*\\(", "\\bAuth::(?:attempt|check|user|login)\\s*\\(", "\\bJWT::(?:decode|encode)\\s*\\("],
