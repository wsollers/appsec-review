      {"id": "lex-rust-env", "kind": "identifier", "languages": ["lang:rust"],
       "patterns": ["\\bstd::env::var\\s*\\(", "\\benv::var\\s*\\(", "\\bdotenvy?::"],
       "emit": ["role:config"],
       "rationale": "Environment configuration is read."},
      {"id": "lex-rust-storage", "kind": "identifier", "languages": ["lang:rust"],
       "patterns": ["\\bsqlx::", "\\bdiesel::", "\\brusqlite::", "\\bsea_orm::", "\\bmongodb::"],
