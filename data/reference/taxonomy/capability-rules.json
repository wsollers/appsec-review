       "patterns": ["\\bDbContext\\b", "\\bSqlCommand\\s*\\(", "\\bExecuteReader\\s*\\(", "\\bExecuteNonQuery\\s*\\(", "\\bDbSet<"],
       "emit": ["role:storage"],
       "rationale": "A database or persistent record is read or written."},
      {"id": "lex-rust-http-route", "kind": "identifier", "languages": ["lang:rust"],
       "patterns": ["\\bRouter::new\\s*\\(", "\\bHttpServer::new\\s*\\(", "#\\[(?:get|post|put|delete|patch|route)\\s*\\(", "\\bwarp::(?:path|serve)\\b", "\\brocket::build\\s*\\("],
       "emit": ["mechanism:http", "mechanism:networked-listener"],
       "rationale": "An HTTP route or handler is registered."},
      {"id": "lex-rust-argv", "kind": "identifier", "languages": ["lang:rust"],
       "patterns": ["\\bstd::env::args\\s*\\(", "\\benv::args\\s*\\(", "#\\[derive\\([^)]*Parser[^)]*\\)\\]", "\\bclap::"],
       "emit": ["mechanism:cli", "trust:user-tainted", "role:input-parsing"],
       "rationale": "Command-line arguments are read."},
      {"id": "lex-rust-rpc", "kind": "identifier", "languages": ["lang:rust"],
       "patterns": ["\\btonic::transport::Server\\b", "\\bServer::builder\\s*\\(\\s*\\)\\s*\\.add_service\\b", "\\btarpc::"],
       "emit": ["mechanism:rpc", "mechanism:networked-listener"],
