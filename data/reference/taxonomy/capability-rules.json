       "emit": ["role:storage"],
       "rationale": "A database or persistent record is read or written."},
      {"id": "lex-shell-argv", "kind": "identifier", "languages": ["lang:shell", "lang:powershell"],
       "patterns": ["\\$(?:[1-9]|\\{[1-9][0-9]*\\}|@|\\*|#)\\b", "\\bgetopts\\s", "\\bparam\\s*\\(", "\\$args\\b"],
       "emit": ["mechanism:cli", "trust:user-tainted"],
       "rationale": "Script arguments are read."}
    ],
    "path_rules": [
      {"id": "path-build-descriptor",
       "names": ["CMakeLists.txt", "Makefile", "GNUmakefile", "makefile", "meson.build", "meson_options.txt", "BUILD", "BUILD.bazel", "WORKSPACE",
                 "MODULE.bazel", "configure.ac", "configure", "setup.py", "setup.cfg", "pyproject.toml", "build.gradle", "build.gradle.kts",
                 "settings.gradle", "settings.gradle.kts", "pom.xml", "package.json", "Cargo.toml", "go.mod", "Gemfile", "Rakefile",
                 "composer.json", "Dockerfile", "Containerfile", "Jenkinsfile", ".gitlab-ci.yml", "azure-pipelines.yml", "SConstruct", "SConscript"],
       "suffixes": [".cmake", ".mk", ".csproj", ".fsproj", ".vbproj", ".sln", ".props", ".targets", ".gradle", ".bzl", ".dockerfile", ".nuspec"],
       "emit": ["role:build-glue"]},
      {"id": "path-ci-workflow", "prefixes": [".github/workflows/", ".circleci/", ".buildkite/"], "emit": ["role:build-glue"]}
    ],
    "tag_rules": [
      {"id": "facet-authn", "inputs": ["func:authn:*"], "emit": ["role:auth", "asset:credentials"]},
      {"id": "facet-session", "inputs": ["func:session:*"], "emit": ["role:session", "state:session", "asset:session-tokens"]},
      {"id": "facet-authz", "inputs": ["func:authz:*"], "emit": ["role:authorization"]},
      {"id": "facet-crypto-keys", "inputs": ["func:crypto:key-mgmt", "func:crypto:asymmetric-sign", "func:crypto:asymmetric-encrypt"],
       "emit": ["role:crypto", "asset:keys"]},
      {"id": "facet-crypto", "inputs": ["func:crypto:*"], "emit": ["role:crypto"]},
      {"id": "facet-serialization", "inputs": ["func:data:parse-json", "func:data:parse-xml", "func:data:parse-yaml", "func:data:deserialize-native"],
       "emit": ["role:serialization", "role:input-parsing"]},
      {"id": "facet-storage", "inputs": ["func:data:sql-query", "func:data:orm", "func:data:nosql-query", "func:data:ldap-query"],
       "emit": ["role:storage", "state:persistent-store"]},
      {"id": "facet-logging", "inputs": ["func:telemetry:*"], "emit": ["role:logging"]},
      {"id": "facet-secrets", "inputs": ["func:secrets:*"], "emit": ["role:config", "asset:credentials"]},
      {"id": "facet-http-route", "inputs": ["func:net:http-route"], "emit": ["mechanism:http", "mechanism:networked-listener"]},
      {"id": "facet-grpc", "inputs": ["func:net:grpc"], "emit": ["mechanism:rpc"]},
      {"id": "facet-listener", "inputs": ["func:net:tls-server", "func:net:websocket"], "emit": ["mechanism:networked-listener"]},
      {"id": "facet-exec-ipc", "inputs": ["func:exec:ipc"], "emit": ["mechanism:ipc"]},
      {"id": "facet-fs-read", "inputs": ["func:fs:read"], "emit": ["mechanism:file"]},
      {"id": "facet-fs-write", "inputs": ["func:fs:write"], "emit": ["state:persistent-store"]},
      {"id": "facet-remote-input", "inputs": ["surface:entry:remote-input"],
       "emit": ["mechanism:networked-listener", "trust:user-tainted", "role:input-parsing"]},
      {"id": "facet-cli-input", "inputs": ["surface:entry:cli"], "emit": ["mechanism:cli", "trust:user-tainted", "role:input-parsing"]},
      {"id": "facet-file-input", "inputs": ["surface:entry:file-input"], "emit": ["mechanism:file", "role:input-parsing"]},
      {"id": "facet-ipc-input", "inputs": ["surface:entry:local-ipc"], "emit": ["mechanism:ipc", "role:input-parsing"]},
      {"id": "facet-env-config", "inputs": ["surface:entry:env-config"], "emit": ["role:config"]},
      {"id": "facet-data-credential", "inputs": ["data:credential"], "emit": ["asset:credentials"]},
      {"id": "facet-data-session-token", "inputs": ["data:session-token"], "emit": ["asset:session-tokens"]},
      {"id": "facet-data-pii", "inputs": ["data:pii"], "emit": ["asset:pii"]},
      {"id": "facet-data-key-material", "inputs": ["data:key-material"], "emit": ["asset:keys"]},
      {"id": "facet-data-financial", "inputs": ["data:financial"], "emit": ["asset:money"]},
      {"id": "facet-build-glue", "inputs": ["infra:supply:*", "infra:ci:*", "infra:container:*"], "emit": ["role:build-glue"]}
    ],
    "facet_rules": [
      {"id": "exposure-from-listener", "any_of": ["mechanism:networked-listener", "mechanism:http", "mechanism:rpc"], "none_of": [],
       "emit": ["exposure:client-facing", "trust:user-tainted"]},
      {"id": "trust-from-cli", "any_of": ["mechanism:cli"], "none_of": [], "emit": ["trust:user-tainted"]},
      {"id": "exposure-from-operator-channel", "any_of": ["mechanism:cli", "mechanism:file"],
       "none_of": ["mechanism:networked-listener", "mechanism:http", "mechanism:rpc", "mechanism:ipc"],
       "emit": ["exposure:operator-only"]},
      {"id": "exposure-from-build-glue", "any_of": ["role:build-glue"], "none_of": [], "emit": ["exposure:build-time"]},
      {"id": "state-from-session", "any_of": ["role:session"], "none_of": [], "emit": ["state:session"]},
      {"id": "state-from-storage", "any_of": ["role:storage"], "none_of": [], "emit": ["state:persistent-store"]},
      {"id": "stateful", "any_of": ["state:session", "state:cache", "state:persistent-store"], "none_of": [], "emit": ["state:stateful"]},
