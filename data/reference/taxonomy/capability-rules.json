{
  "schema": "appsec-review/tag-capability-rules/1",
  "version": "1",
  "languages": {
    "Python": "lang:python", "JavaScript": "lang:javascript", "TypeScript": "lang:typescript",
    "Java": "lang:java", "Kotlin": "lang:kotlin", "Go": "lang:go", "Rust": "lang:rust", "C": "lang:c",
    "C/C++": "lang:c-cpp-header", "C++": "lang:cpp", "C#": "lang:csharp", "Ruby": "lang:ruby",
    "PHP": "lang:php", "Swift": "lang:swift", "Shell": "lang:shell", "PowerShell": "lang:powershell"
  },
  "path_rules": [
    {"id": "dockerfile", "names": ["Dockerfile", "Containerfile"], "suffixes": [".dockerfile"],
     "emit": ["infra:container:image-build", "platform:docker"]},
    {"id": "github-workflow", "prefixes": [".github/workflows/"], "suffixes": [".yml", ".yaml"],
     "emit": ["infra:ci:workflow", "platform:github-actions"]},
    {"id": "gitlab-ci", "names": [".gitlab-ci.yml"], "emit": ["infra:ci:workflow", "platform:gitlab-ci"]},
    {"id": "azure-pipelines", "names": ["azure-pipelines.yml", "azure-pipelines.yaml"],
     "emit": ["infra:ci:workflow", "platform:azure-pipelines"]},
    {"id": "jenkinsfile", "names": ["Jenkinsfile"], "emit": ["infra:ci:workflow", "platform:jenkins"]},
    {"id": "terraform", "suffixes": [".tf", ".tf.json"], "emit": ["infra:iac:terraform"]},
    {"id": "bicep", "suffixes": [".bicep"], "emit": ["infra:iac:bicep-arm", "platform:azure"]},
    {"id": "helm-chart", "names": ["Chart.yaml"], "emit": ["infra:kube:helm-chart", "platform:kubernetes"]},
    {"id": "kustomization", "names": ["kustomization.yaml", "kustomization.yml"],
     "emit": ["infra:kube:kustomization", "platform:kubernetes"]},
    {"id": "dependency-manifest",
     "names": ["package.json", "pyproject.toml", "requirements.txt", "setup.py", "setup.cfg", "Pipfile",
               "pom.xml", "build.gradle", "build.gradle.kts", "go.mod", "Cargo.toml", "Gemfile",
               "composer.json", "packages.config", "vcpkg.json", "conanfile.txt", "conanfile.py"],
     "suffixes": [".csproj", ".fsproj", ".vbproj"],
     "emit": ["infra:supply:dependency-manifest"]},
    {"id": "lockfile",
     "names": ["package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml", "poetry.lock",
               "Pipfile.lock", "uv.lock", "go.sum", "Cargo.lock", "Gemfile.lock", "composer.lock",
               "packages.lock.json", "gradle.lockfile"],
     "emit": ["infra:supply:lockfile"]},
    {"id": "registry-config", "names": [".npmrc", ".yarnrc", ".yarnrc.yml", "pip.conf", "NuGet.config",
                                         "nuget.config", "settings.xml", ".pypirc"],
     "emit": ["infra:supply:registry-config"]},
    {"id": "submodule", "names": [".gitmodules"], "emit": ["infra:supply:submodule"]},
    {"id": "update-bot", "names": ["dependabot.yml", "dependabot.yaml", "renovate.json", "renovate.json5",
                                    ".renovaterc", ".renovaterc.json"],
     "emit": ["infra:supply:update-bot"]}
  ],
  "package_rules": [
    {"id": "pkg-jwt", "packages": ["jsonwebtoken", "jose", "pyjwt", "python-jose", "jjwt", "jjwt-api",
                                    "java-jwt", "nimbus-jose-jwt", "github.com/golang-jwt/jwt",
                                    "github.com/golang-jwt/jwt/v5", "jsonwebtoken-rs",
                                    "system.identitymodel.tokens.jwt", "firebase/php-jwt"],
     "emit": ["func:authn:jwt"]},
    {"id": "pkg-oauth-oidc", "packages": ["passport-oauth2", "openid-client", "authlib", "oauthlib",
                                           "requests-oauthlib", "spring-security-oauth2-client",
                                           "golang.org/x/oauth2"],
     "emit": ["func:authn:oauth2-client"]},
    {"id": "pkg-saml", "packages": ["passport-saml", "@node-saml/node-saml", "python3-saml", "pysaml2",
                                     "opensaml"],
     "emit": ["func:authn:saml"]},
    {"id": "pkg-password-hash", "packages": ["bcrypt", "bcryptjs", "argon2", "argon2-cffi", "passlib",
                                              "golang.org/x/crypto/bcrypt", "golang.org/x/crypto/argon2"],
     "emit": ["func:crypto:password-hash"]},
    {"id": "pkg-crypto", "packages": ["cryptography", "pycryptodome", "pycryptodomex", "node-forge",
                                       "bouncycastle", "bcprov-jdk18on", "libsodium", "pynacl", "ring",
                                       "openssl"],
     "emit": ["func:crypto:symmetric"]},
    {"id": "pkg-http-client", "packages": ["requests", "httpx", "urllib3", "aiohttp", "axios", "node-fetch",
                                            "got", "superagent", "okhttp", "reqwest", "guzzlehttp/guzzle",
                                            "faraday"],
     "emit": ["func:net:http-client"]},
    {"id": "pkg-http-route", "packages": ["express", "koa", "fastify", "@nestjs/core", "flask", "django",
                                           "fastapi", "starlette", "spring-boot-starter-web", "spring-webmvc",
                                           "github.com/gin-gonic/gin", "github.com/labstack/echo/v4",
                                           "actix-web", "axum", "rails", "sinatra", "laravel/framework",
                                           "symfony/http-kernel"],
     "emit": ["func:net:http-route"]},
    {"id": "pkg-graphql", "packages": ["graphql", "apollo-server", "@apollo/server", "graphene",
                                        "strawberry-graphql", "graphql-java"],
     "emit": ["func:net:graphql"]},
    {"id": "pkg-grpc", "packages": ["grpcio", "@grpc/grpc-js", "grpc-netty", "google.golang.org/grpc", "tonic"],
     "emit": ["func:net:grpc"]},
    {"id": "pkg-xml", "packages": ["lxml", "xml2js", "fast-xml-parser", "xmldom", "@xmldom/xmldom",
                                    "libxmljs", "dom4j", "xerces", "xercesimpl", "nokogiri"],
     "emit": ["func:data:parse-xml"]},
    {"id": "pkg-yaml", "packages": ["pyyaml", "ruamel.yaml", "js-yaml", "yaml", "snakeyaml",
                                     "gopkg.in/yaml.v3", "serde_yaml"],
     "emit": ["func:data:parse-yaml"]},
    {"id": "pkg-native-deserialize", "packages": ["dill", "cloudpickle", "jsonpickle", "node-serialize",
                                                   "serialize-javascript", "xstream", "kryo", "fst"],
     "emit": ["func:data:deserialize-native"]},
    {"id": "pkg-sql", "packages": ["mysql", "mysql2", "pg", "sqlite3", "better-sqlite3", "psycopg2",
                                    "psycopg2-binary", "psycopg", "pymysql", "mysqlclient",
                                    "github.com/lib/pq", "github.com/go-sql-driver/mysql",
                                    "mysql-connector-java", "postgresql"],
     "emit": ["func:data:sql-query"]},
    {"id": "pkg-orm", "packages": ["sqlalchemy", "sequelize", "typeorm", "prisma", "@prisma/client",
                                    "hibernate-core", "gorm.io/gorm", "diesel", "activerecord",
                                    "doctrine/orm"],
     "emit": ["func:data:orm"]},
    {"id": "pkg-nosql", "packages": ["mongodb", "mongoose", "pymongo", "motor", "redis", "ioredis",
                                      "go.mongodb.org/mongo-driver"],
     "emit": ["func:data:nosql-query"]},
    {"id": "pkg-ldap", "packages": ["ldapjs", "ldap3", "python-ldap", "unboundid-ldapsdk",
                                     "github.com/go-ldap/ldap/v3"],
     "emit": ["func:data:ldap-query"]},
    {"id": "pkg-template", "packages": ["jinja2", "mako", "ejs", "pug", "handlebars", "nunjucks",
                                         "mustache", "freemarker", "velocity", "thymeleaf", "twig/twig",
                                         "tera", "askama"],
     "emit": ["func:data:template-render"]},
    {"id": "pkg-archive", "packages": ["adm-zip", "unzipper", "tar", "tar-fs", "decompress", "jszip",
                                        "zip", "commons-compress", "zip4j"],
     "emit": ["func:data:archive-extract"]},
    {"id": "pkg-upload", "packages": ["multer", "formidable", "busboy", "express-fileupload",
                                       "python-multipart", "commons-fileupload"],
     "emit": ["func:data:file-upload"]},
    {"id": "pkg-process", "packages": ["execa", "shelljs", "cross-spawn", "sh", "plumbum", "commons-exec"],
     "emit": ["func:exec:process-spawn"]},
    {"id": "pkg-ffi", "packages": ["ffi-napi", "node-ffi", "cffi", "jna", "jnr-ffi", "libc"],
     "emit": ["func:exec:ffi"]},
    {"id": "pkg-vault", "packages": ["node-vault", "hvac", "github.com/hashicorp/vault/api",
                                      "@aws-sdk/client-secrets-manager", "azure-keyvault-secrets",
                                      "google-cloud-secret-manager"],
     "emit": ["func:secrets:vault-client"]},
    {"id": "pkg-llm", "packages": ["openai", "anthropic", "@anthropic-ai/sdk", "langchain",
                                    "@langchain/core", "llama-index", "litellm"],
     "emit": ["func:ai:llm-call"]},
    {"id": "pkg-model-load", "packages": ["torch", "transformers", "joblib", "tensorflow", "keras",
                                           "onnxruntime", "safetensors"],
     "emit": ["func:ai:model-load"]},
    {"id": "pkg-vector-store", "packages": ["chromadb", "faiss-cpu", "pinecone-client", "pinecone",
                                             "weaviate-client", "qdrant-client", "pgvector"],
     "emit": ["func:ai:vector-store"]}
  ],
  "observation_rules": [
    {"id": "sarif-rule-cwe-tags", "producers": ["codeql"], "extract": "sarif-rule-cwe-tags"},
    {"id": "cert-rule-id", "producers": ["*"], "extract": "cert-rule-id"},
    {"id": "gitleaks-hard-coded-credential", "producers": ["tool-gitleaks"], "emit": ["cwe:798"]},
    {"id": "advisory-match", "producers": ["tool-grype", "tool-osv-scanner"], "extract": "advisory-severity",
     "emit": ["cwe:1395"]},
    {"id": "syft-package-capability", "producers": ["tool-syft"], "extract": "package-capability"},
    {"id": "ci-untrusted-trigger", "producers": ["ci:*"], "rule_ids": ["CI-UNTRUSTED-TRIGGER"],
     "emit": ["infra:ci:trigger-untrusted"]},
    {"id": "ci-pipe-command", "producers": ["ci:*"], "rule_ids": ["CI-PIPE-COMMAND"],
     "emit": ["infra:ci:script-step", "cwe:494"]},
    {"id": "ci-privileged-runner", "producers": ["ci:*"], "rule_ids": ["CI-PRIVILEGED-RUNNER"],
     "emit": ["infra:ci:self-hosted-runner"]},
    {"id": "ci-secret-output", "producers": ["ci:*"], "rule_ids": ["CI-SECRET-OUTPUT"],
     "emit": ["infra:ci:secret-use"]},
    {"id": "ci-mutable-dependency", "producers": ["ci:*"], "rule_ids": ["CI-MUTABLE-DEPENDENCY"],
     "emit": ["infra:ci:third-party-action", "cwe:829"]},
    {"id": "ci-static-cache-key", "producers": ["ci:*"], "rule_ids": ["CI-STATIC-CACHE-KEY"],
     "emit": ["infra:ci:cache"]},
    {"id": "ci-production-no-gate", "producers": ["ci:*"], "rule_ids": ["CI-PRODUCTION-NO-GATE"],
     "emit": ["infra:ci:deploy-step"]},
    {"id": "ci-write-all", "producers": ["ci:*"], "rule_ids": ["CI-WRITE-ALL"],
     "emit": ["infra:ci:permissions"]},
    {"id": "ci-unsigned-release", "producers": ["ci:*"], "rule_ids": ["CI-UNSIGNED-RELEASE"],
     "emit": ["infra:ci:artifact-publish"]}
  ],
  "coverage_gaps": {
    "observations": "gap:no-sast",
    "evidence": "gap:no-sast",
    "analysis": "gap:no-ast",
    "build": "gap:no-build",
    "compiled": "gap:no-build",
    "build_security": "gap:no-build",
    "artifacts": "gap:no-build",
    "source": "gap:scope-failed",
    "components": "gap:scope-failed"
  }
}
