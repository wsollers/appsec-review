      {"id": "lex-java-auth", "kind": "identifier", "languages": ["lang:java", "lang:kotlin"],
       "patterns": ["\\bAuthenticationManager\\b", "\\bUserDetailsService\\b", "\\bPasswordEncoder\\b", "\\bSecurityFilterChain\\b",
                    "\\bJwtParser\\b", "\\bJwts\\.(?:parser|builder)\\b", "\\bBCrypt\\.(?:checkpw|hashpw)\\s*\\(", "\\bauthenticate\\s*\\("],
