       "rationale": "A database or persistent record is read or written."},
      {"id": "lex-go-auth", "kind": "identifier", "languages": ["lang:go"],
       "patterns": ["\\bbcrypt\\.(?:CompareHashAndPassword|GenerateFromPassword)\\s*\\(", "\\bjwt\\.(?:Parse|ParseWithClaims|NewWithClaims)\\s*\\(",
