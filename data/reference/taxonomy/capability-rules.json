      {"id": "lex-java-http-route", "kind": "identifier", "languages": ["lang:java", "lang:kotlin"],
       "patterns": ["@(?:RequestMapping|GetMapping|PostMapping|PutMapping|DeleteMapping|PatchMapping|Path|GET|POST|RestController|WebServlet)\\b",
                    "\\bextends\\s+HttpServlet\\b", "\\brouting\\s*\\{", "\\bHttpServer\\.create\\s*\\("],
