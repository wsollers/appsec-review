{
  "schema": "appsec-review/tag-capability-rules/1",
  "version": "1",
  "languages": {
    "Python": "lang:python", "JavaScript": "lang:javascript", "TypeScript": "lang:typescript",
    "Java": "lang:java", "Kotlin": "lang:kotlin", "Go": "lang:go", "Rust": "lang:rust", "C": "lang:c",
    "C/C++": "lang:c-cpp-header", "C++": "lang:cpp", "C#": "lang:csharp", "Ruby": "lang:ruby",
    "PHP": "lang:php", "Swift": "lang:swift", "Shell": "lang:shell", "PowerShell": "lang:powershell"
  },
  "path_rules": [
    {"id": "dockerfile", "names": ["Dockerfile", "Containerfile"], "suffixes": [".dockerfile"],
     "emit": ["infra:container:image-build", "platform:docker"]},
    {"id": "github-workflow", "prefixes": [".github/workflows/"], "suffixes": [".yml", ".yaml"],
     "emit": ["infra:ci:workflow", "platform:github-actions"]},
    {"id": "gitlab-ci", "names": [".gitlab-ci.yml"], "emit": ["infra:ci:workflow", "platform:gitlab-ci"]},
    {"id": "azure-pipelines", "names": ["azure-pipelines.yml", "azure-pipelines.yaml"],
     "emit": ["infra:ci:workflow", "platform:azure-pipelines"]},
    {"id": "jenkinsfile", "names": ["Jenkinsfile"], "emit": ["infra:ci:workflow", "platform:jenkins"]},
    {"id": "terraform", "suffixes": [".tf", ".tf.json"], "emit": ["infra:iac:terraform"]},
    {"id": "bicep", "suffixes": [".bicep"], "emit": ["infra:iac:bicep-arm", "platform:azure"]},
    {"id": "helm-chart", "names": ["Chart.yaml"], "emit": ["infra:kube:helm-chart", "platform:kubernetes"]},
    {"id": "kustomization", "names": ["kustomization.yaml", "kustomization.yml"],
     "emit": ["infra:kube:kustomization", "platform:kubernetes"]},
    {"id": "dependency-manifest",
     "names": ["package.json", "pyproject.toml", "requirements.txt", "setup.py", "setup.cfg", "Pipfile",
               "pom.xml", "build.gradle", "build.gradle.kts", "go.mod", "Cargo.toml", "Gemfile",
               "composer.json", "packages.config", "vcpkg.json", "conanfile.txt", "conanfile.py"],
     "suffixes": [".csproj", ".fsproj", ".vbproj"],
     "emit": ["infra:supply:dependency-manifest"]},
    {"id": "lockfile",
     "names": ["package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml", "poetry.lock",
               "Pipfile.lock", "uv.lock", "go.sum", "Cargo.lock", "Gemfile.lock", "composer.lock",
               "packages.lock.json", "gradle.lockfile"],
     "emit": ["infra:supply:lockfile"]},
    {"id": "registry-config", "names": [".npmrc", ".yarnrc", ".yarnrc.yml", "pip.conf", "NuGet.config",
                                         "nuget.config", "settings.xml", ".pypirc"],
     "emit": ["infra:supply:registry-config"]},
    {"id": "submodule", "names": [".gitmodules"], "emit": ["infra:supply:submodule"]},
    {"id": "update-bot", "names": ["dependabot.yml", "dependabot.yaml", "renovate.json", "renovate.json5",
                                    ".renovaterc", ".renovaterc.json"],
     "emit": ["infra:supply:update-bot"]}
  ],
  "package_rules": [
    {"id": "pkg-jwt", "packages": ["jsonwebtoken", "jose", "pyjwt", "python-jose", "jjwt", "jjwt-api",
                                    "java-jwt", "nimbus-jose-jwt", "github.com/golang-jwt/jwt",
                                    "github.com/golang-jwt/jwt/v5", "jsonwebtoken-rs",
                                    "system.identitymodel.tokens.jwt", "firebase/php-jwt"],
     "emit": ["func:authn:jwt"]},
    {"id": "pkg-oauth-oidc", "packages": ["passport-oauth2", "openid-client", "authlib", "oauthlib",
                                           "requests-oauthlib", "spring-security-oauth2-client",
                                           "golang.org/x/oauth2"],
     "emit": ["func:authn:oauth2-client"]},
    {"id": "pkg-saml", "packages": ["passport-saml", "@node-saml/node-saml", "python3-saml", "pysaml2",
                                     "opensaml"],
     "emit": ["func:authn:saml"]},
    {"id": "pkg-password-hash", "packages": ["bcrypt", "bcryptjs", "argon2", "argon2-cffi", "passlib",
                                              "golang.org/x/crypto/bcrypt", "golang.org/x/crypto/argon2"],
     "emit": ["func:crypto:password-hash"]},
    {"id": "pkg-crypto", "packages": ["cryptography", "pycryptodome", "pycryptodomex", "node-forge",
                                       "bouncycastle", "bcprov-jdk18on", "libsodium", "pynacl", "ring",
                                       "openssl"],
     "emit": ["func:crypto:symmetric"]},
    {"id": "pkg-http-client", "packages": ["requests", "httpx", "urllib3", "aiohttp", "axios", "node-fetch",
                                            "got", "superagent", "okhttp", "reqwest", "guzzlehttp/guzzle",
                                            "faraday"],
     "emit": ["func:net:http-client"]},
    {"id": "pkg-http-route", "packages": ["express", "koa", "fastify", "@nestjs/core", "flask", "django",
                                           "fastapi", "starlette", "spring-boot-starter-web", "spring-webmvc",
                                           "github.com/gin-gonic/gin", "github.com/labstack/echo/v4",
                                           "actix-web", "axum", "rails", "sinatra", "laravel/framework",
                                           "symfony/http-kernel"],
     "emit": ["func:net:http-route"]},
    {"id": "pkg-graphql", "packages": ["graphql", "apollo-server", "@apollo/server", "graphene",
                                        "strawberry-graphql", "graphql-java"],
     "emit": ["func:net:graphql"]},
    {"id": "pkg-grpc", "packages": ["grpcio", "@grpc/grpc-js", "grpc-netty", "google.golang.org/grpc", "tonic"],
     "emit": ["func:net:grpc"]},
    {"id": "pkg-xml", "packages": ["lxml", "xml2js", "fast-xml-parser", "xmldom", "@xmldom/xmldom",
                                    "libxmljs", "dom4j", "xerces", "xercesimpl", "nokogiri"],
     "emit": ["func:data:parse-xml"]},
    {"id": "pkg-yaml", "packages": ["pyyaml", "ruamel.yaml", "js-yaml", "yaml", "snakeyaml",
                                     "gopkg.in/yaml.v3", "serde_yaml"],
     "emit": ["func:data:parse-yaml"]},
    {"id": "pkg-native-deserialize", "packages": ["dill", "cloudpickle", "jsonpickle", "node-serialize",
                                                   "serialize-javascript", "xstream", "kryo", "fst"],
     "emit": ["func:data:deserialize-native"]},
    {"id": "pkg-sql", "packages": ["mysql", "mysql2", "pg", "sqlite3", "better-sqlite3", "psycopg2",
                                    "psycopg2-binary", "psycopg", "pymysql", "mysqlclient",
                                    "github.com/lib/pq", "github.com/go-sql-driver/mysql",
                                    "mysql-connector-java", "postgresql"],
     "emit": ["func:data:sql-query"]},
    {"id": "pkg-orm", "packages": ["sqlalchemy", "sequelize", "typeorm", "prisma", "@prisma/client",
                                    "hibernate-core", "gorm.io/gorm", "diesel", "activerecord",
                                    "doctrine/orm"],
     "emit": ["func:data:orm"]},
    {"id": "pkg-nosql", "packages": ["mongodb", "mongoose", "pymongo", "motor", "redis", "ioredis",
                                      "go.mongodb.org/mongo-driver"],
     "emit": ["func:data:nosql-query"]},
    {"id": "pkg-ldap", "packages": ["ldapjs", "ldap3", "python-ldap", "unboundid-ldapsdk",
                                     "github.com/go-ldap/ldap/v3"],
     "emit": ["func:data:ldap-query"]},
    {"id": "pkg-template", "packages": ["jinja2", "mako", "ejs", "pug", "handlebars", "nunjucks",
                                         "mustache", "freemarker", "velocity", "thymeleaf", "twig/twig",
                                         "tera", "askama"],
     "emit": ["func:data:template-render"]},
    {"id": "pkg-archive", "packages": ["adm-zip", "unzipper", "tar", "tar-fs", "decompress", "jszip",
                                        "zip", "commons-compress", "zip4j"],
     "emit": ["func:data:archive-extract"]},
    {"id": "pkg-upload", "packages": ["multer", "formidable", "busboy", "express-fileupload",
                                       "python-multipart", "commons-fileupload"],
     "emit": ["func:data:file-upload"]},
    {"id": "pkg-process", "packages": ["execa", "shelljs", "cross-spawn", "sh", "plumbum", "commons-exec"],
     "emit": ["func:exec:process-spawn"]},
    {"id": "pkg-ffi", "packages": ["ffi-napi", "node-ffi", "cffi", "jna", "jnr-ffi", "libc"],
     "emit": ["func:exec:ffi"]},
    {"id": "pkg-vault", "packages": ["node-vault", "hvac", "github.com/hashicorp/vault/api",
                                      "@aws-sdk/client-secrets-manager", "azure-keyvault-secrets",
                                      "google-cloud-secret-manager"],
     "emit": ["func:secrets:vault-client"]},
    {"id": "pkg-llm", "packages": ["openai", "anthropic", "@anthropic-ai/sdk", "langchain",
                                    "@langchain/core", "llama-index", "litellm"],
     "emit": ["func:ai:llm-call"]},
    {"id": "pkg-model-load", "packages": ["torch", "transformers", "joblib", "tensorflow", "keras",
                                           "onnxruntime", "safetensors"],
     "emit": ["func:ai:model-load"]},
    {"id": "pkg-vector-store", "packages": ["chromadb", "faiss-cpu", "pinecone-client", "pinecone",
                                             "weaviate-client", "qdrant-client", "pgvector"],
     "emit": ["func:ai:vector-store"]}
  ],
  "observation_rules": [
    {"id": "sarif-rule-cwe-tags", "producers": ["codeql"], "extract": "sarif-rule-cwe-tags"},
    {"id": "cert-rule-id", "producers": ["*"], "extract": "cert-rule-id"},
    {"id": "gitleaks-hard-coded-credential", "producers": ["tool-gitleaks"], "emit": ["cwe:798"]},
    {"id": "advisory-match", "producers": ["tool-grype", "tool-osv-scanner", "tool-cve-bin-tool"], "extract": "advisory-severity",
     "emit": ["cwe:1395"]},
    {"id": "syft-package-capability", "producers": ["tool-syft"], "extract": "package-capability"},
    {"id": "ci-untrusted-trigger", "producers": ["ci:*"], "rule_ids": ["CI-UNTRUSTED-TRIGGER"],
     "emit": ["infra:ci:trigger-untrusted"]},
    {"id": "ci-pipe-command", "producers": ["ci:*"], "rule_ids": ["CI-PIPE-COMMAND"],
     "emit": ["infra:ci:script-step", "cwe:494"]},
    {"id": "ci-privileged-runner", "producers": ["ci:*"], "rule_ids": ["CI-PRIVILEGED-RUNNER"],
     "emit": ["infra:ci:self-hosted-runner"]},
    {"id": "ci-secret-output", "producers": ["ci:*"], "rule_ids": ["CI-SECRET-OUTPUT"],
     "emit": ["infra:ci:secret-use"]},
    {"id": "ci-mutable-dependency", "producers": ["ci:*"], "rule_ids": ["CI-MUTABLE-DEPENDENCY"],
     "emit": ["infra:ci:third-party-action", "cwe:829"]},
    {"id": "ci-static-cache-key", "producers": ["ci:*"], "rule_ids": ["CI-STATIC-CACHE-KEY"],
     "emit": ["infra:ci:cache"]},
    {"id": "ci-production-no-gate", "producers": ["ci:*"], "rule_ids": ["CI-PRODUCTION-NO-GATE"],
     "emit": ["infra:ci:deploy-step"]},
    {"id": "ci-write-all", "producers": ["ci:*"], "rule_ids": ["CI-WRITE-ALL"],
     "emit": ["infra:ci:permissions"]},
    {"id": "ci-unsigned-release", "producers": ["ci:*"], "rule_ids": ["CI-UNSIGNED-RELEASE"],
     "emit": ["infra:ci:artifact-publish"]}
  ],
  "graph_rules": [
    {"id": "graph-remote-input", "family": "entry_point", "classes": ["remote"],
     "emit": ["surface:entry:remote-input"],
     "rationale": "A modeled remote input is observed, without establishing HTTP, public deployment or trust policy."},
    {"id": "graph-command-line", "family": "entry_point", "classes": ["argv"],
     "emit": ["surface:entry:cli"], "rationale": "The accepted source class identifies command-line input."},
    {"id": "graph-environment", "family": "entry_point", "classes": ["environment"],
     "emit": ["surface:entry:env-config"], "rationale": "Environment input is observed; sensitivity is unknown."},
    {"id": "graph-file-input", "family": "entry_point", "classes": ["file"],
     "emit": ["surface:entry:file-input"], "rationale": "A file input is observed, without an upload or exposure claim."},
    {"id": "graph-ipc-input", "family": "entry_point", "classes": ["ipc"],
     "emit": ["surface:entry:local-ipc"], "rationale": "The native IPC source class identifies local interprocess input."},
    {"id": "graph-native-memory", "family": "sink_site", "classes": ["memory_read", "memory_write"],
     "languages": ["c", "cpp", "rust"], "emit": ["func:exec:unmanaged-memory"],
     "rationale": "Native memory access is observed, not an out-of-bounds or lifetime violation."},
    {"id": "graph-command-execution", "family": "sink_site", "classes": ["command_execution"],
     "emit": ["func:exec:process-spawn"], "rationale": "Command execution is observed; shell use and injection are not inferred."},
    {"id": "graph-sql-query", "family": "sink_site", "classes": ["sql_query"],
     "emit": ["func:data:sql-query"], "rationale": "SQL execution is observed, not SQL injection."},
    {"id": "graph-ldap-query", "family": "sink_site", "classes": ["ldap_query"],
     "emit": ["func:data:ldap-query"], "rationale": "An LDAP operation is observed, without a weakness claim."},
    {"id": "graph-xml-parser", "family": "sink_site", "classes": ["xml_external_entity"],
     "emit": ["func:data:parse-xml"], "rationale": "An XML parsing site is observed, not external-entity enablement."},
    {"id": "graph-template-render", "family": "sink_site", "classes": ["template_injection"],
     "emit": ["func:data:template-render"], "rationale": "A template operation is observed, not template injection."},
    {"id": "graph-regex", "family": "sink_site", "classes": ["regex_injection"],
     "emit": ["func:data:regex"], "rationale": "A regular-expression operation is observed, not injection or exhaustion."},
    {"id": "graph-redirect", "family": "sink_site", "classes": ["url_redirect"],
     "emit": ["func:net:redirect"], "rationale": "A redirect operation is observed, not an open redirect."},
    {"id": "graph-log-output", "family": "sink_site", "classes": ["log_output"],
     "emit": ["func:telemetry:app-log"], "rationale": "Logging is observed, not audit-control satisfaction or a disclosure."}
  ],
  "collation": {
    "note": "Collation pass rules (docs/architecture/collation-pass.md, T-5008). Lexical rules match hash-verified first-party source lines (basis declared; confidence high for include/import, medium for identifier). tag_rules derive facets from collected capability tags, facet_rules derive facets from facets (a none_of condition rests on absence and is recorded), target_rules derive a component class.",
    "lexical_rules": [
      {"id": "lex-c-socket-receive", "kind": "identifier", "languages": ["lang:c", "lang:cpp", "lang:c-cpp-header"],
       "patterns": ["\\b(?:listen|accept|accept4|recv|recvfrom|recvmsg)\\s*\\("],
       "emit": ["mechanism:networked-listener"],
       "rationale": "A socket is accepted or read; the data read is network input. Sending alone is not a listener."},
      {"id": "lex-c-argv", "kind": "identifier", "languages": ["lang:c", "lang:cpp"],
       "patterns": ["\\bargv\\s*\\[", "\\bgetopt(?:_long)?\\s*\\("],
       "emit": ["mechanism:cli", "trust:user-tainted", "role:input-parsing"],
       "rationale": "Command-line arguments are read; they are caller-supplied input."},
      {"id": "lex-c-env", "kind": "identifier", "languages": ["lang:c", "lang:cpp"],
       "patterns": ["\\bgetenv\\s*\\(", "\\bsecure_getenv\\s*\\("],
       "emit": ["role:config"],
       "rationale": "Environment configuration is read."},
      {"id": "lex-c-file-read", "kind": "identifier", "languages": ["lang:c", "lang:cpp"],
       "patterns": ["\\bfopen\\s*\\(", "\\bfread\\s*\\(", "\\bifstream\\b", "\\bopen\\s*\\(\\s*[A-Za-z_\"]"],
       "emit": ["mechanism:file"],
       "rationale": "A file named at run time is opened or read."},
      {"id": "lex-c-parse", "kind": "identifier", "languages": ["lang:c", "lang:cpp"],
       "patterns": ["\\b(?:strtol|strtoul|strtoll|strtoull|atoi|atol|sscanf|strtok|strtok_r)\\s*\\("],
       "emit": ["role:input-parsing"],
       "rationale": "Bytes are converted into structured values."},
      {"id": "lex-c-session", "kind": "identifier", "languages": ["lang:c", "lang:cpp", "lang:c-cpp-header"],
       "patterns": ["\\bsession_(?:open|create|new|touch|lookup|find|get|close|destroy|free|reset)\\s*\\(",
                    "\\bstruct\\s+Session\\b", "\\bSession\\s*\\*"],
       "emit": ["role:session"],
       "rationale": "Per-connection or per-principal session state is created, used or destroyed."},
      {"id": "lex-c-serialization", "kind": "include", "languages": ["lang:c", "lang:cpp", "lang:c-cpp-header"],
       "patterns": ["^\\s*#\\s*include\\s*[<\"](?:cJSON|json|jansson|yaml|rapidjson/\\S+|nlohmann/json|google/protobuf/\\S+|msgpack|tinyxml2|libxml/\\S+|expat)\\.?h?[>\"]"],
       "emit": ["role:serialization"],
       "rationale": "A serialization library is included."},
      {"id": "lex-c-crypto", "kind": "include", "languages": ["lang:c", "lang:cpp", "lang:c-cpp-header"],
       "patterns": ["^\\s*#\\s*include\\s*[<\"](?:openssl/|sodium|mbedtls/|gcrypt|nettle/|cryptopp/|botan/)"],
       "emit": ["role:crypto"],
       "rationale": "A cryptographic library is included."},
      {"id": "lex-c-logging", "kind": "identifier", "languages": ["lang:c", "lang:cpp"],
       "patterns": ["\\b(?:syslog|openlog|vsyslog)\\s*\\(", "\\bfprintf\\s*\\(\\s*stderr", "\\bspdlog::", "\\bLOG\\([A-Z]+\\)",
                    "\\blog_(?:message|write|line|error|warn|info|debug)\\s*\\("],
       "emit": ["role:logging"],
       "rationale": "Operational records are written."},
      {"id": "lex-c-ipc", "kind": "identifier", "languages": ["lang:c", "lang:cpp"],
       "patterns": ["\\bAF_UNIX\\b", "\\bmkfifo\\s*\\(", "\\bshm_open\\s*\\(", "\\bsocketpair\\s*\\(", "\\bdbus_", "\\bmq_open\\s*\\("],
       "emit": ["mechanism:ipc"],
       "rationale": "A local interprocess channel is used."},
      {"id": "lex-c-test", "kind": "include", "languages": ["lang:c", "lang:cpp", "lang:c-cpp-header"],
       "patterns": ["^\\s*#\\s*include\\s*[<\"](?:gtest/gtest|gmock/gmock|catch2/\\S+|catch\\.hpp|doctest|cmocka|check|unity)\\.?h?[>\"]"],
       "emit": ["role:test"],
       "rationale": "A test framework is included in a first-party file."},
      {"id": "lex-py-http-route", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["@\\w+\\.(?:route|get|post|put|patch|delete|api_route|websocket)\\s*\\(", "\\burlpatterns\\b",
                    "\\bpath\\s*\\(\\s*['\"]", "\\bre_path\\s*\\(", "\\bAPIRouter\\s*\\(", "\\badd_url_rule\\s*\\(",
                    "\\bweb\\.Application\\s*\\(", "\\bHTTPServer\\s*\\(", "\\bBaseHTTPRequestHandler\\b"],
       "emit": ["mechanism:http", "mechanism:networked-listener"],
       "rationale": "An HTTP route or handler is registered."},
      {"id": "lex-py-request-input", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["\\brequest\\.(?:get_json|json|data|form|args|values|files|body|POST|GET|query_params|headers|cookies)\\b",
                    "\\bawait\\s+request\\.(?:json|body|form)\\s*\\("],
       "emit": ["trust:user-tainted", "role:input-parsing"],
       "rationale": "Request data from the caller is read."},
      {"id": "lex-py-argv", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["\\bsys\\.argv\\b", "\\bargparse\\.ArgumentParser\\s*\\(", "\\bclick\\.(?:command|group|argument|option)\\b",
                    "\\btyper\\.(?:Typer|run)\\b"],
       "emit": ["mechanism:cli", "trust:user-tainted", "role:input-parsing"],
       "rationale": "Command-line arguments are read."},
      {"id": "lex-py-env", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["\\bos\\.(?:environ|getenv)\\b", "\\bdotenv\\b", "\\bload_dotenv\\s*\\("],
       "emit": ["role:config"],
       "rationale": "Environment configuration is read."},
      {"id": "lex-py-session", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["\\bsession\\s*\\[", "\\bsession\\.(?:get|pop|clear|modified|permanent)\\b", "\\bflask_session\\b",
                    "\\bSessionMiddleware\\b", "\\bset_cookie\\s*\\(", "\\brequest\\.session\\b", "\\blogin_user\\s*\\("],
       "emit": ["role:session", "state:session", "asset:session-tokens"],
       "rationale": "Per-principal session state or a session cookie is handled."},
      {"id": "lex-py-auth", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["\\b(?:verify_password|check_password|check_password_hash|authenticate|login_required|current_user|HTTPBasicAuth|HTTPBearer|OAuth2PasswordBearer|jwt\\.(?:decode|encode)|bcrypt\\.(?:checkpw|hashpw)|pbkdf2_hmac)\\b"],
       "emit": ["role:auth", "asset:credentials"],
       "rationale": "A caller's identity or credential is checked."},
      {"id": "lex-py-auth-import", "kind": "import", "languages": ["lang:python"],
       "patterns": ["^\\s*(?:from|import)\\s+(?:jwt|authlib|flask_login|flask_httpauth|passlib|bcrypt|argon2|oauthlib|django\\.contrib\\.auth)\\b"],
       "emit": ["role:auth", "asset:credentials"],
       "rationale": "An authentication library is imported."},
      {"id": "lex-py-authz", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["\\b(?:permission_required|has_perm|has_role|is_admin|is_staff|is_superuser|authorize|PermissionDenied|require_role)\\b"],
       "emit": ["role:authorization"],
       "rationale": "An authenticated principal's permission is decided."},
      {"id": "lex-py-crypto-import", "kind": "import", "languages": ["lang:python"],
       "patterns": ["^\\s*(?:from|import)\\s+(?:cryptography|Crypto|Cryptodome|nacl|hashlib|hmac|secrets)\\b"],
       "emit": ["role:crypto"],
       "rationale": "A cryptographic library is imported."},
      {"id": "lex-py-storage", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["\\bcursor\\.execute\\s*\\(", "\\b(?:sqlite3|psycopg2?|pymysql|MySQLdb)\\.connect\\s*\\(", "\\bcreate_engine\\s*\\(",
                    "\\bsession\\.(?:query|add|commit)\\s*\\(", "\\bobjects\\.(?:filter|get|create|all)\\s*\\(", "\\bMongoClient\\s*\\(",
                    "\\bredis\\.(?:Redis|StrictRedis)\\s*\\("],
       "emit": ["role:storage"],
       "rationale": "A database or persistent record is read or written."},
      {"id": "lex-py-serialization", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["\\b(?:json|yaml|pickle|marshal|xml\\.etree|lxml|msgpack|toml)\\.(?:loads?|dumps?|safe_load|full_load|parse|fromstring)\\s*\\("],
       "emit": ["role:serialization"],
       "rationale": "A structured interchange format is encoded or decoded."},
      {"id": "lex-py-logging", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["\\blogging\\.(?:getLogger|info|warning|error|debug|critical)\\s*\\(", "\\blogger\\.(?:info|warning|error|debug|critical|exception)\\s*\\(",
                    "\\bstructlog\\b", "\\bloguru\\b"],
       "emit": ["role:logging"],
       "rationale": "Operational records are written."},
      {"id": "lex-py-rpc", "kind": "identifier", "languages": ["lang:python"],
       "patterns": ["\\bgrpc\\.server\\s*\\(", "\\badd_\\w+Servicer_to_server\\s*\\(", "\\bSimpleXMLRPCServer\\b", "\\bjsonrpc\\b"],
       "emit": ["mechanism:rpc", "mechanism:networked-listener"],
       "rationale": "A remote-procedure interface is served."},
      {"id": "lex-py-file", "kind": "identifier", "languages": ["lang:python"],
