{
  "_meta": {
    "purpose": "Pinned end-of-life table for base-image operating systems (P41). Read offline by 02-iac-config-scan through base_image_cache.py; never queried live during a run.",
    "support_end": "The last day of free security support for the release: Debian LTS end (security_end is the end of regular security support), Ubuntu end of standard security maintenance (ESM needs an Ubuntu Pro subscription a container base does not carry), Alpine end of support for the branch's main repository. A release whose support_end is before the run date is end-of-life.",
    "matching": "debian: VERSION_ID major; ubuntu: VERSION_ID exactly; alpine: the major.minor branch of VERSION_ID. A distribution or release not listed is reported as not-listed, never as supported.",
    "sources": {
      "debian": "distro-info-data debian.csv (the Debian package; read from distro-info-data 0.60ubuntu0.6 on 2026-10-03), cross-checked against endoflife.date products/debian.md at commit 40b29773178321d338704bd93a4100ad9061299a; they differ only on the Debian 9 LTS end (2022-06-30 here, 2022-07-01 there).",
      "ubuntu": "distro-info-data ubuntu.csv eol column (same package and date), cross-checked against https://ubuntu.com/about/release-cycle on 2026-10-03, which gives months only and agrees for every row except 22.04 (May 2027 there, 2027-06-01 here).",
      "alpine": "https://alpinelinux.org/releases/ as transcribed in endoflife.date products/alpine-linux.md at commit 40b29773178321d338704bd93a4100ad9061299a (2026-10-03); alpinelinux.org itself was not reachable from the authoring host."
    },
    "omitted": "Debian 14 and later and Ubuntu interim (non-LTS) releases have no confirmed end date in these sources and are absent; they report not-listed.",
    "as_of": "2026-10-03"
  },
