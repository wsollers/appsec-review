              "raw": "{\n  \"customerId\": \"ALFKI\",\n  \"employeeId\": 1,\n  \"orderDate\": \"2024-05-01\",\n  \"freight\": 15.25,\n  \"shipName\": \"Alfreds\",\n  \"shipCity\": \"Berlin\",\n  \"shipCountry\": \"Germany\",\n  \"details\": [\n    { \"productId\": 1, \"unitPrice\": 18.0, \"quantity\": 4, \"discount\": 0 }\n  ]\n}"
            },
            "url": {
